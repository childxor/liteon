                        render: function (data, type, row) {
                            // แปลงรหัสเป็นชื่อ
                            var name = getStatusName(data);
                            // กำหนดสี badge ตามรหัส
                            var color = 'secondary';
                            switch (data) {
                                case '1': color = 'success'; break;      // ใช้งานได้
                                case '2': color = 'warning'; break;      // กำลังซ่อม
                                case '3': color = 'danger'; break;       // ชำรุด
                                case '4': color = 'secondary'; break;    // จำหน่าย
                                case '5': color = 'info'; break;         // ไม่ใช้งาน
                                case '6': color = 'custom-purple'; break; // อะไหล่
                            }
                            
                            // สร้าง dropdown สำหรับเปลี่ยนสถานะ
                            if (window.canEdit) {
                                return `<div class="dropdown status-dropdown">
                                    <button class="btn btn-sm btn-outline-${color} dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="คลิกเพื่อเปลี่ยนสถานะ (${name})" data-bs-toggle="tooltip">
                                        <span class="badge bg-${color}">${name}</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '1', 'ใช้งานได้');return false;"><span class="badge bg-success me-2">ใช้งานได้</span></a></li>
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '2', 'กำลังซ่อม');return false;"><span class="badge bg-warning me-2">กำลังซ่อม</span></a></li>
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '3', 'ชำรุด');return false;"><span class="badge bg-danger me-2">ชำรุด</span></a></li>
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '4', 'จำหน่าย');return false;"><span class="badge bg-secondary me-2">จำหน่าย</span></a></li>
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '5', 'ไม่ใช้งาน');return false;"><span class="badge bg-info me-2">ไม่ใช้งาน</span></a></li>
                                        <li><a class="dropdown-item" href="#" onclick="changeStatus(${row.Id}, '6', 'อะไหล่');return false;"><span class="badge bg-custom-purple me-2">อะไหล่</span></a></li>
                                    </ul>
                                </div>`;
                            } else {
                                return `<span class="badge bg-${color}">${name}</span>`;
                            }
                        }
                    },
                    {
                        data: 'OwnerName',
                        title: '<i class="fas fa-user me-1 text-info"></i>ผู้รับผิดชอบ',
                        className: 'text-nowrap',
                        render: function (data, type, row) {
                            var ownerName = data || '';
                            var empResignDate = row.EmpResignDate;
                            
                            if (empResignDate && empResignDate !== null && empResignDate !== '') {
                                // แปลงวันที่เป็นรูปแบบไทย
                                var resignDate = new Date(empResignDate);
                                var thaiDate = resignDate.toLocaleDateString('th-TH');
                                
                                return `<div>
                                    <span class="text-danger fw-medium">${ownerName}</span>
                                    <br>
                                    <small class="text-danger">
                                        <i class="fas fa-user-times me-1"></i>ลาออกแล้ว (${thaiDate})
                                    </small>
                                </div>`;
                            } else {
                                return `<span class="fw-medium">${ownerName}</span>`;
                            }
                        }
                    },
                    {
                        data: 'DepartmentName',
                        title: '<i class="fas fa-building me-1 text-secondary"></i>แผนก',
                        className: 'text-nowrap'
                    },
                    {
                        data: 'LineName',
                        title: '<i class="fas fa-industry me-1 text-dark"></i>ไลน์',
                        className: 'text-nowrap'
                    },
                    {
                        data: 'Location',
                        title: '<i class="fas fa-map-marker-alt me-1 text-danger"></i>สถานที่',
                        className: 'text-nowrap',
                        render: function (data) {
                            return getLocationName(data);
                        }
                    },
                    {
                        data: 'WindowsVersion',
                        title: '<i class="fab fa-windows me-1 text-info"></i>Windows',
                        className: 'text-nowrap'
                    },
                    {
                        data: 'MacAddressCount',
                        title: '<i class="fas fa-network-wired me-1 text-info"></i>Mac Address',
                        className: 'text-center',
                        render: function (data, type, row) {
                            const count = data || 0;
                            let badgeClass = 'bg-secondary';
                            let icon = 'fas fa-times';
                            
                            if (count > 0) {
                                badgeClass = 'bg-success';
                                icon = 'fas fa-check';
                            }
                            
                            return `<span class="badge ${badgeClass}">
                                        <i class="${icon}"></i> ${count}
                                    </span>`;
                        }
                    },
                    {
                        data: 'CreatedDate',
                        title: '<i class="fas fa-calendar-alt me-1 text-success"></i>วันที่สร้าง',
                        className: 'text-center text-nowrap',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('th-TH') : '';
                        }
                    },
                    {
                        data: null,
                        title: '<i class="fas fa-cogs me-1 text-primary"></i>จัดการ',
                        className: 'text-center',
                        orderable: false,
                        render: function (data, type, row) {
                            let dropdown = `<div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="เมนูจัดการ">
                                    <i class="fas fa-cogs"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    ${window.canEdit ? `<li><a class="dropdown-item" href="#" onclick="editAsset(${row.Id});return false;"><i class='fas fa-edit me-2 text-primary'></i>แก้ไข</a></li>` : ''}
                                    <li><a class="dropdown-item" href="#" onclick="duplicateAsset(${row.Id});return false;"><i class='fas fa-copy me-2 text-secondary'></i>ทำซ้ำ</a></li>
                                    ${window.canDelete ? `<li><a class="dropdown-item" href="#" onclick="deleteAsset(${row.Id}, '${row.Name}');return false;"><i class='fas fa-trash me-2 text-danger'></i>ลบ</a></li>` : ''}
                                    <li><a class="dropdown-item" href="#" onclick="manageMacAddress(${row.Id}, '${row.Name}');return false;"><i class='fas fa-network-wired me-2 text-info'></i>Mac Address</a></li>
                                </ul>
                            </div>`;
                            return dropdown;
                        }
                    }
                ],
                language: {
                    url: appBasePath + 'js/datatables/i18n/Thai.json',
                    searchPlaceholder: "ค้นหาทรัพย์สิน..."
                },
                dom: '<"row align-items-center mb-3"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row align-items-center mt-3"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
                ordering: true,
                order: [[3, 'asc']],
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], ['10', '25', '50', 'ทั้งหมด']],
                responsive: true,
                autoWidth: false,
                searching: true,
                processing: true,
                                initComplete: function () {
                    
                    // เพิ่ม class ให้กับ select
                    $('.dataTables_length select').addClass('form-select form-select-sm');
                    
                    // เพิ่ม tooltip สำหรับรายละเอียดเพิ่มเติม
                    $('[data-bs-toggle="tooltip"]').tooltip({
                        html: true,
                        placement: 'top',
                        trigger: 'hover',
                        container: 'body'
                    });
                    
                    // เพิ่ม tooltip สำหรับ status dropdown
                    $('.status-dropdown button[data-bs-toggle="tooltip"]').tooltip();
                    
                },
                rowCallback: function(row, data, index) {
                    // ลบคลาสสีเดิมก่อน
                    $(row).removeClass('table-primary table-success table-warning table-danger table-info table-secondary table-light table-dark');
                    // หาคีย์กลุ่มจาก 4 ตัวอักษรแรกของชื่อ
                    if (data.Name && data.Name.length >= 4) {
                        const prefix = data.Name.substring(0, 4);
                        if (groupColorMap[prefix]) {
                            $(row).addClass(groupColorMap[prefix]);
                        }
                    }
                },
            });

            // เพิ่มฟังก์ชันสำหรับ child row
            function formatChildRow(d) {
                return `
                            <div class="p-3 bg-light border-start border-primary border-4">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6 class="text-primary mb-3"><i class="fas fa-info-circle me-2"></i>รายละเอียดเพิ่มเติม</h6>
                                        <table class="table table-sm table-borderless">
                                            <tr><td class="fw-bold">รหัสทรัพย์สิน:</td><td>${d.AssetNo || '-'}</td></tr>
                                            <tr><td class="fw-bold">Serial Number:</td><td>${d.ProductSerial || '-'}</td></tr>
                                            <tr><td class="fw-bold">รุ่น/Model:</td><td>${d.Model || '-'}</td></tr>
                                            <tr><td class="fw-bold">ผู้ผลิต:</td><td>${d.Manufacturer || '-'}</td></tr>
                                            <tr><td class="fw-bold">เวอร์ชั่น Windows:</td><td>${d.WindowsVersion || '-'}</td></tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-primary mb-3"><i class="fas fa-network-wired me-2"></i>Mac Address</h6>
                                        <div id="macAddresses-${d.Id}">
                                            <div class="text-center text-muted">
                                                <i class="fas fa-spinner fa-spin"></i> กำลังโหลด...
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary mt-2" onclick="addMacAddress(${d.Id})">
                                            <i class="fas fa-plus me-1"></i>เพิ่ม Mac Address
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
            }

            // Event listener สำหรับเปิด/ปิด child row
            $('#assetTable tbody').on('click', 'td.details-control', function () {
                var tr = $(this).closest('tr');
                var row = assetTable.row(tr);

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    $(this).html('<i class="fas fa-plus-circle text-primary"></i>');
                } else {
                    row.child(formatChildRow(row.data())).show();
                    tr.addClass('shown');
                    $(this).html('<i class="fas fa-minus-circle text-primary"></i>');
                    // โหลด Mac Address
                    const assetId = row.data().Id;
                    if (assetId && assetId > 0) {
                        loadMacAddresses(assetId);
                    } else {
                        $('#macAddresses-' + assetId).html('<div class="text-center text-danger">ไม่พบข้อมูลทรัพย์สิน</div>');
                    }
                }
            });

            // ค้นหาแบบ real-time พร้อม debounce
            let searchTimeout;
            $('#searchInput').on('keyup', function () {
                clearTimeout(searchTimeout);
                const value = $(this).val();
                searchTimeout = setTimeout(() => {
                    assetTable.search(value).draw();
                }, 300);
            });

            // ฟังก์ชันสำหรับแก้ไข Asset
            window.editAsset = function (id) {
                if (!window.canEdit) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'ไม่มีสิทธิ์',
                        text: 'คุณไม่มีสิทธิ์ในการแก้ไขทรัพย์สิน',
                        confirmButtonText: 'ตกลง'
                    });
                    return;
                }

                $.ajax({
                    url: `${appBasePath}Asset/Get/${id}`,
                    type: 'GET',
                    success: function (data) {
                        $('#assetId').val(data.Id);
                        $('#assetNo').val(data.AssetNo || '');
                        $('#productSerial').val(data.ProductSerial || '');
                        $('#name').val(data.Name || '');
                        $('#type').val(data.Type || '');
                        $('#status').val(data.Status || '');
                        $('#windowsVersion').val(data.WindowsVersion || '');
                        $('#ownerName').val(data.OwnerName || '');
                        $('#department').val(data.Department || '');
                        $('#location').val(data.Location || '');
                        $('#model').val(data.Model || '');
                        $('#manufacturer').val(data.Manufacturer || '');
                        $('#installationDate').val(data.InstallationDate ? new Date(data.InstallationDate).toISOString().split('T')[0] : '');
                        $('#startDate').val(data.StartDate ? new Date(data.StartDate).toISOString().split('T')[0] : '');
                        $('#locationDetail').val(data.LocationDetail || '');
                        $('#countryOfOrigin').val(data.CountryOfOrigin || '');
                        $('#customerNo').val(data.CustomerNo || '');
                        $('#customerName').val(data.CustomerName || '');
                        $('#endDate').val(data.EndDate ? new Date(data.EndDate).toISOString().split('T')[0] : '');

                        loadLines(); // โหลดข้อมูลไลน์ใหม่

                        // เปิด Modal ก่อน
                        $('#assetModalLabel').html('<i class="fas fa-edit me-2"></i>แก้ไขทรัพย์สิน IT');
                        
                        // ใช้ Bootstrap 5 Modal API
                        var myModal = new bootstrap.Modal(document.getElementById('assetModal'));
                        myModal.show();

                        // รอให้ Modal เปิดเสร็จแล้วค่อย init Select2
                        $('#assetModal').on('shown.bs.modal', function () {
                            initSelect2();
                            $('#owner').val(null).trigger('change'); // Reset owner select2

                            // แสดงรายละเอียดเพิ่มเติมถ้ามีข้อมูล
                            if (data.AssetNo || data.ProductSerial || data.WindowsVersion || data.Model || 
                                data.Manufacturer || data.InstallationDate || data.StartDate || data.EndDate || 
                                data.LocationDetail || data.CountryOfOrigin || data.CustomerNo || data.CustomerName) {
                                $('#detailsSection').show();
                                $('#btnToggleDetails').html('<i class="fas fa-chevron-up"></i> ซ่อนรายละเอียด');
                            } else {
                                $('#detailsSection').hide();
                                $('#btnToggleDetails').html('<i class="fas fa-chevron-down"></i> แสดงรายละเอียด');
                            }

                            // รอให้ Select2 โหลดเสร็จแล้วค่อยตั้งค่า
                            setTimeout(() => {
                                if (data.Owner) {
                                    // ดึงข้อมูลชื่อพนักงานจาก API เพื่อตั้งค่า Select2
                                    $.get(appBasePath + 'Asset/GetPersonName', { empNo: data.Owner }, function (personData) {
                                        if (personData && personData.name) {
                                            var fullName = personData.name + ' (' + data.Owner + ')';
                                            setSelect2Value($('#owner'), data.Owner, fullName);
                                        } else {
                                            // ถ้าไม่พบข้อมูลชื่อ ให้ใช้แค่รหัสพนักงาน
                                            setSelect2Value($('#owner'), data.Owner, data.Owner);
                                        }
                                    });
                                }
                                if (data.Line) {
