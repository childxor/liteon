        $(document).ready(function () {
            // โหลดข้อมูลไลน์ผลิต
            function loadLines() {
                $.get(appBasePath + 'Asset/GetLines', function (data) {
                    var lineSelect = $('#line');
                    lineSelect.empty();
                    lineSelect.append('<option value="">-- เลือกไลน์ผลิต --</option>');

                    data.forEach(function (item) {
                        lineSelect.append('<option value="' + item.Id + '">' + item.Text + '</option>');
                    });
                });
            }

            // เรียกใช้ฟังก์ชันโหลดข้อมูลไลน์
            loadLines();

            // Event handler สำหรับการเลือกไลน์ผลิต
            $('#line').on('change', function () {
                var selectedLine = $(this).val();
                var locationSelect = $('#location');

                if (selectedLine && selectedLine !== "") {
                    // ถ้าเลือกไลน์ผลิตแล้ว ให้กำหนดสถานที่เป็น "พื้นที่ไลน์ผลิต" เท่านั้น
                    locationSelect.val('PD');
                    locationSelect.prop('disabled', true);
                } else {
                    // ถ้าไม่เลือกไลน์ผลิต ให้สามารถเลือกสถานที่ได้
                    locationSelect.prop('disabled', false);
                }
            });

            // ฟังก์ชันสำหรับตั้งค่า Select2 เมื่อมีข้อมูลเริ่มต้น
            function setSelect2Value(selectElement, value, text) {
                if (value && text) {
                    // สร้าง option ใหม่
                    var newOption = new Option(text, value, true, true);
                    selectElement.append(newOption).trigger('change');
                }
            }

            // กำหนดค่าเริ่มต้นสำหรับ Select2
            function initSelect2() {
                if (!$('#owner').hasClass('select2-hidden-accessible')) {
                    $('#owner').select2({
                        ajax: {
                            url: appBasePath + 'Asset/GetPersons',
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                return {
                                    q: params.term || '' // ส่งคำค้นหาไปที่ controller
                                };
                            },
                            processResults: function (data) {
                                return {
                                    results: data.map(function (item) {
                                        return { id: item.value, text: item.text };
                                    })
                                };
                            },
                            cache: true
                        },
                        theme: 'bootstrap-5',
                        placeholder: 'เลือกผู้รับผิดชอบ',
                        allowClear: false,
                        dropdownParent: $('#assetModal'),
                        minimumInputLength: 0,
                        language: {
                            noResults: function () {
                                return "ไม่พบข้อมูล";
                            },
                            searching: function () {
                                return "กำลังค้นหา...";
                            }
                        }
                    }).on('select2:open', function () {
                        setTimeout(function () {
                            document.querySelector('.select2-search__field').focus();
                        }, 100);
                    }).on('select2:select', function (e) {
                        var empNo = e.params.data.id;
                        if (empNo) {
                            $.get(appBasePath + 'Asset/GetPersonName', { empNo: empNo }, function (data) {
                                $('#ownerName').val(data.name || '');
                                $('#department').val(data.deptName || '');
                            });
                        }
                    }).on('change', function () {
                        var empNo = $(this).val();
                        if (empNo) {
                            $.get(appBasePath + 'Asset/GetPersonName', { empNo: empNo }, function (data) {
                                $('#ownerName').val(data.name || '');
                                $('#department').val(data.deptName || '');
                            });
                        } else {
                            $('#ownerName').val('');
                            $('#department').val('');
                        }
                    });
                }
            }

            // ฟังก์ชัน Mac Address ถูกย้ายไปยังไฟล์ mac-address-management.js แล้ว

            // Mapping กลุ่มกับคลาสสี Bootstrap
            const groupColorMap = {
                'THNA': 'table-primary',
                'THDA': 'table-success',
                'THDF': 'table-warning',
                // เพิ่มกลุ่มอื่นๆ ตามต้องการ
            };

            // DataTable
            assetTable = $('#assetTable').DataTable({
                ajax: {
                    url: appBasePath + 'Asset/GetAll',
                    type: 'POST',
                    dataSrc: function(json) {
                        return json;
                    }
                },
                columns: [
                    {
                        className: 'details-control',
