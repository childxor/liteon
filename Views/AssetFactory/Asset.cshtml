                    data.forEach(function (item) {
                        $sel.append('<option value=\"' + item.Id + '\">' + item.Text + '</option>');
                    });
                }
            }).fail(function(xhr, status, error) {
                console.error('ไม่สามารถโหลดประเภทได้:', error);
                // ใช้ข้อมูลประเภทแบบ hardcode เป็น fallback
                var fallbackTypes = [
                    { Id: '1', Text: 'คอมพิวเตอร์' },
                    { Id: '2', Text: 'โน๊ตบุ๊ค' },
                    { Id: '3', Text: 'แท็บเล็ต' },
                    { Id: '4', Text: 'โทรศัพท์' },
                    { Id: '5', Text: 'เครื่องพิมพ์' },
                    { Id: '6', Text: 'อุปกรณ์เครือข่าย' },
