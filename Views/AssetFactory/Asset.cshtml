            // เพิ่มการตรวจสอบข้อมูลก่อนบันทึก
            function validateForm() {
                const name = $('#name').val();
                const type = $('#type').val();
                const status = $('#status').val();
                const owner = $('#owner').val();
                const location = $('#location').val();

                let isValid = true;
                let errorMessage = '';

                if (!name) {
                    errorMessage += 'กรุณาระบุชื่อทรัพย์สิน\n';
                    isValid = false;
                }

                if (!type) {
                    errorMessage += 'กรุณาเลือกประเภททรัพย์สิน\n';
                    isValid = false;
                }

                if (!status) {
                    errorMessage += 'กรุณาเลือกสถานะ\n';
                    isValid = false;
                }

                if (!owner) {
                    errorMessage += 'กรุณาเลือกผู้รับผิดชอบ\n';
                    isValid = false;
                }

                if (!location) {
                    errorMessage += 'กรุณาเลือกสถานที่จัดเก็บ\n';
                    isValid = false;
                }

                // ตรวจสอบวันที่
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();
                if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
                    errorMessage += 'วันที่เริ่มใช้งานต้องไม่เกินวันที่สิ้นสุดการใช้งาน\n';
                    isValid = false;
                }

                // ตรวจสอบชื่อทรัพย์สินต้องเป็นภาษาอังกฤษพิมพ์ใหญ่เท่านั้น
                if (!/^[A-Z0-9 .\\-_/]+$/.test(name)) {
                    errorMessage += 'กรุณากรอกชื่อทรัพย์สินเป็นภาษาอังกฤษพิมพ์ใหญ่เท่านั้น\n';
                    isValid = false;
                }

                if (!isValid) {
                    Swal.fire({
                        icon: 'error',
                        title: 'กรุณาตรวจสอบข้อมูล',
                        text: errorMessage,
                        confirmButtonText: 'ตกลง'
                    });
                }

                return isValid;
            }

