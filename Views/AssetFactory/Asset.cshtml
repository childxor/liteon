            });

            // ปุ่มล้างตัวกรอง
            $('#btnClearFilter').on('click', function () {
                $('#filterStatus').val('');
                $('#filterType').val('');
                $('#filterDept').val('');
                $('#filterLocation').val('');
                $('#filterSearch').val('');
                assetTable.search('').draw();
            });

            // Custom filter สำหรับ DataTable
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var status = $('#filterStatus').val();
                var type = $('#filterType').val();
                var dept = $('#filterDept').val();
                var location = $('#filterLocation').val();
                var search = $('#filterSearch').val().toLowerCase();

                // ดึงข้อมูลจริงจาก DataTable row
                var rowData = assetTable.row(dataIndex).data();
                
                // ถ้าไม่มีข้อมูล rowData ให้ return true (แสดงแถว)
                if (!rowData) {
                    return true;
                }

                var rowStatusCode = rowData.Status || '';
                var rowType = rowData.Type || '';
                var rowDept = rowData.DepartmentName || '';
                var rowLocation = rowData.Location || '';
                var rowAssetNo = rowData.AssetNo || '';
                var rowSerial = rowData.ProductSerial || '';
                var rowName = rowData.Name || '';

                // ตรวจสอบสถานะ (เปรียบเทียบรหัส)
                if (status && rowStatusCode !== status) {
                    return false;
                }
                // ตรวจสอบประเภท (เปรียบเทียบรหัส)
                if (type && rowType !== type) {
                    return false;
                }
                // ตรวจสอบแผนก (เปรียบเทียบชื่อแผนก)
                if (dept && rowDept && !rowDept.toLowerCase().includes(dept.toLowerCase())) {
                    return false;
                }
                // ตรวจสอบสถานที่ (เปรียบเทียบรหัส)
                if (location && rowLocation !== location) {
                    return false;
                }
                // ตรวจสอบการค้นหา
                if (search) {
                    var searchText = (rowAssetNo + ' ' + rowSerial + ' ' + rowName).toLowerCase();
                    if (!searchText.includes(search)) {
                        return false;
                    }
                }
                
                return true;
            });



            // Event คลิก card เพื่อกรอง
            $('.dashboard-card').on('click', function() {
                const status = $(this).data('status');
                const cardTitle = $(this).find('h6').text().trim();
                const count = $(this).find('h2').text();
                
                if (status === 'all') {
                    $('#filterStatus').val('').trigger('change');
                    $('#filterType').val('').trigger('change');
                    $('#filterDept').val('').trigger('change');
                    $('#filterLocation').val('').trigger('change');
                    $('#filterSearch').val('').trigger('keyup');
                } else {
                    $('#filterStatus').val(status).trigger('change');
                }
                
                // Toast แจ้งเตือน
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                Toast.fire({
                    icon: 'info',
                    title: `กรองข้อมูล: ${cardTitle}`,
                    text: `จำนวน: ${count} รายการ`
                });
            });

            // เพิ่ม hover effect สำหรับ card
            $('.dashboard-card').hover(
                function() {
                    $(this).addClass('shadow-lg').css('transform', 'translateY(-2px)');
                    
                    // แสดง tooltip ข้อมูลเพิ่มเติม
                    const status = $(this).data('status');
                    const count = $(this).find('h2').text();
                    const percent = $(this).find('.small span').text();
                    
                    if (status && status !== 'all') {
                        const statusName = getStatusName(status);
                        $(this).attr('title', `${statusName}: ${count} รายการ (${percent})`);
                    } else if (status === 'all') {
                        $(this).attr('title', `คลิกเพื่อล้างตัวกรอง | คลิกขวาเพื่อดูข้อมูลเพิ่มเติม`);
                    }
                },
                function() {
                    $(this).removeClass('shadow-lg').css('transform', 'translateY(0)');
                    // ไม่ลบ title เพื่อให้ tooltip ยังทำงานได้
                }
            );



            // เรียกใช้ฟังก์ชันอัปเดตหลังจากบันทึก/ลบ/แก้ไข
            function onAssetDataChanged() {
                // โหลดข้อมูลสรุป Dashboard
                $.get(appBasePath + 'Asset/GetDashboardSummary', function(data) {
                    // อัปเดทข้อมูลสรุป Dashboard
                    const total = data.total || 0;
                    
                    // อัปเดทข้อมูลหลัก
                    $('#totalAssets').text(total);
                    $('#activeAssets').text(data.active || 0);
                    $('#repairAssets').text(data.repair || 0);
                    $('#damagedAssets').text(data.damaged || 0);
                    $('#disposedAssets').text(data.disposed || 0);
                    $('#inactiveAssets').text(data.inactive || 0);
                    $('#spareAssets').text(data.spare || 0);
                    $('#recentAssets').text(data.recentCount || 0);
                    $('#maintenanceCount').text(data.maintenanceCount || 0);

                    // อัปเดทข้อมูล Mac Address
                    $('#withMac').text('มี Mac: ' + (data.withMac || 0));
                    $('#withoutMac').text('ไม่มี Mac: ' + (data.withoutMac || 0));

                    // คำนวณเปอร์เซ็นต์
                    if (total > 0) {
                        $('#activePercent').text(Math.round((data.active || 0) / total * 100) + '%');
                        $('#repairPercent').text(Math.round((data.repair || 0) / total * 100) + '%');
                        $('#damagedPercent').text(Math.round((data.damaged || 0) / total * 100) + '%');
                        $('#disposedPercent').text(Math.round((data.disposed || 0) / total * 100) + '%');
                        $('#inactivePercent').text(Math.round((data.inactive || 0) / total * 100) + '%');
                        $('#sparePercent').text(Math.round((data.spare || 0) / total * 100) + '%');
                    } else {
                        // ถ้าไม่มีข้อมูล ให้แสดง 0%
                        $('#activePercent').text('0%');
                        $('#repairPercent').text('0%');
                        $('#damagedPercent').text('0%');
                        $('#disposedPercent').text('0%');
                        $('#inactivePercent').text('0%');
                        $('#sparePercent').text('0%');
                    }

                    // อัปเดทสรุปประเภท
                    if (data.byType && Object.keys(data.byType).length > 0) {
                        let typeText = [];
                        for (const [type, count] of Object.entries(data.byType)) {
                            typeText.push(getTypeName(type) + ': ' + count);
                        }
                        $('#typeSummary').text(typeText.slice(0, 3).join(' | '));
                    } else {
                        $('#typeSummary').text('ไม่มีข้อมูล');
                    }
                }).fail(function (xhr, status, error) {
                    // ไม่สามารถโหลดข้อมูลสรุปได้
                });
                
                // โหลดสถิติ
                $.get(appBasePath + 'Asset/GetStatistics', function (data) {
                    // อัปเดทสถิติ
                    $('#totalAssets').text(data.total || 0);
                    $('#activeAssets').text(data.active || 0);
                    $('#repairAssets').text(data.repair || 0);
                    $('#damagedAssets').text(data.damaged || 0);
                }).fail(function (xhr, status, error) {
                    // ไม่สามารถโหลดสถิติได้
                });
                
                // อัปเดตจำนวน Mac Address ในตารางหลัก
                setTimeout(function() {
                    loadAllMacAddressCounts();
                }, 500);
            }

            // Event คลิกขวาที่ card เพื่อแสดงข้อมูลเพิ่มเติม
            $('.dashboard-card').on('contextmenu', function(e) {
                e.preventDefault();
                
                const status = $(this).data('status');
                const cardTitle = $(this).find('h6').text().trim();
                const count = $(this).find('h2').text();
                
                if (status === 'all') {
                    Swal.fire({
                        title: cardTitle,
                        html: `
                            <div class="text-start">
                                <p><strong>จำนวนทั้งหมด:</strong> ${count} รายการ</p>
                                <p><strong>มี Mac Address:</strong> <span id="withMacDetail">0</span> รายการ</p>
                                <p><strong>ไม่มี Mac Address:</strong> <span id="withoutMacDetail">0</span> รายการ</p>
                                <hr>
                                <p><strong>สรุปตามประเภท:</strong></p>
                                <div id="typeDetail"></div>
                            </div>
                        `,
                        icon: 'info',
                        confirmButtonText: 'ปิด',
                        width: '500px'
                    });
                    
                    // โหลดข้อมูลเพิ่มเติม
                    $.get(appBasePath + 'Asset/GetDashboardSummary', function(data) {
                        $('#withMacDetail').text(data.withMac || 0);
                        $('#withoutMacDetail').text(data.withoutMac || 0);
                        
                        if (data.byType && Object.keys(data.byType).length > 0) {
                            let typeHtml = '';
                            for (const [type, count] of Object.entries(data.byType)) {
                                typeHtml += `<p class="mb-1">• ${getTypeName(type)}: ${count} รายการ</p>`;
                            }
                            $('#typeDetail').html(typeHtml);
                        }
                    });
                } else {
                    const statusName = getStatusName(status);
                    Swal.fire({
                        title: `${cardTitle} - ${statusName}`,
                        html: `
                            <div class="text-start">
                                <p><strong>จำนวน:</strong> ${count} รายการ</p>
                                <p><strong>สถานะ:</strong> ${statusName}</p>
                                <hr>
                                <p>คลิก "ดูรายการ" เพื่อดูข้อมูลทั้งหมดในตาราง</p>
                            </div>
                        `,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonText: 'ดูรายการ',
                        cancelButtonText: 'ปิด',
                        width: '400px'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // กรองข้อมูลในตาราง
                            $('#filterStatus').val(status).trigger('change');
                            // เลื่อนไปที่ตาราง
                            $('html, body').animate({
                                scrollTop: $('#assetTable').offset().top - 100
                            }, 500);
                        }
                    });
                }
            });
        });

        // ฟังก์ชันสำหรับโหลดจำนวน Mac Address ทั้งหมด
        function loadAllMacAddressCounts() {
            // ดึงข้อมูลทั้งหมดจากตาราง
            var data = assetTable.data().toArray();
            data.forEach(function (row) {
                loadMacAddressCount(row.Id);
            });
            
            // เพิ่ม tooltip สำหรับ status dropdown และรายละเอียดเพิ่มเติม หลังจากโหลดข้อมูล
            setTimeout(function() {
                $('.status-dropdown button[data-bs-toggle="tooltip"]').tooltip();
                // อัปเดต tooltip สำหรับรายละเอียดเพิ่มเติม
                $('[data-bs-toggle="tooltip"]').tooltip({
                    html: true,
                    placement: 'top',
                    trigger: 'hover',
                    container: 'body'
                });
            }, 100);
        }

        // ฟังก์ชันสำหรับโหลดจำนวน Mac Address ของทรัพย์สินเดียว
        function loadMacAddressCount(assetId) {
            const $badge = $(`.mac-count-badge[data-asset-id="${assetId}"]`);
            if ($badge.length === 0) return;

            $.get(appBasePath + 'Asset/GetAssetMacAddresses?assetId=' + assetId, function (data) {
                const count = data ? data.length : 0;
                let badgeClass = 'bg-secondary';
                let icon = 'fas fa-times';
                
                if (count > 0) {
                    badgeClass = 'bg-success';
                    icon = 'fas fa-check';
                }
                
                $badge.removeClass('bg-info bg-secondary bg-success')
                      .addClass(badgeClass)
                      .html(`<i class="${icon}"></i> ${count}`);
            }).fail(function () {
                $badge.removeClass('bg-info bg-secondary bg-success')
                      .addClass('bg-danger')
                      .html('<i class="fas fa-exclamation-triangle"></i>');
            });
        }

        // ฟังก์ชันสำหรับโหลด Mac Address ใน child row
        function loadMacAddresses(assetId) {
            const $container = $('#macAddresses-' + assetId);
            $container.empty().html('<div class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> กำลังโหลด...</div>');
            $.get(appBasePath + 'Asset/GetAssetMacAddresses?assetId=' + assetId, function (data) {
                if (data && data.length > 0) {
                    let html = '';
                    data.forEach(function (mac) {
                        html += `
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-info text-dark me-2">${mac.MacAddress ? mac.MacAddress : '-'}</span>
                                <div>
                                    <button class="btn btn-sm btn-outline-primary btn-action me-1" onclick="editMacAddress(${mac.Id}, ${assetId}, '${mac.MacAddress}')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-action" onclick="deleteMacAddress(${mac.Id}, ${assetId})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        `; 
                    });
                    $container.html(html);
                } else {
                    $container.html('<div class="text-center text-muted">ไม่พบ Mac Address</div>');
                }
                
                // อัปเดตจำนวน Mac Address ในตารางหลัก
                loadMacAddressCount(assetId);
            }).fail(function () {
                $container.html('<div class="text-center text-muted">ไม่สามารถโหลด Mac Address ได้</div>');
                loadMacAddressCount(assetId);
            });
        }

        // ฟังก์ชันสำหรับจัดการ Mac Address (Modal)
        window.manageMacAddress = function(assetId, assetName) {
            Swal.fire({
                title: `จัดการ Mac Address - ${assetName}`,
                html: `
                    <div class="text-start">
                        <p><strong>รหัสทรัพย์สิน:</strong> ${assetId}</p>
                        <p><strong>ชื่อทรัพย์สิน:</strong> ${assetName}</p>
                        <hr>
                        <div id="macAddressList-${assetId}">
                            <div class="text-center text-muted">
                                <i class="fas fa-spinner fa-spin"></i> กำลังโหลด...
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary btn-sm" onclick="addMacAddressFromModal(${assetId})">
                                <i class="fas fa-plus me-1"></i>เพิ่ม Mac Address
                            </button>
                        </div>
                    </div>
                `,
                width: '600px',
                showConfirmButton: false,
                showCloseButton: true,
                didOpen: () => {
                    loadMacAddressesForModal(assetId);
                }
            });
        };

        // ฟังก์ชันสำหรับโหลด Mac Address ใน Modal
        function loadMacAddressesForModal(assetId) {
            const $container = $(`#macAddressList-${assetId}`);
            $container.html('<div class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> กำลังโหลด...</div>');
            
            $.get(appBasePath + 'Asset/GetAssetMacAddresses?assetId=' + assetId, function (data) {
                if (data && data.length > 0) {
                    let html = '<div class="table-responsive"><table class="table table-sm">';
                    html += '<thead><tr><th>Mac Address</th><th>ประเภท</th><th>การจัดการ</th></tr></thead><tbody>';
                    
                    data.forEach(function (mac) {
                        html += `
                            <tr>
                                <td><span class="badge bg-info text-dark">${mac.MacAddress || '-'}</span></td>
                                <td>${mac.NetworkType || 'Ethernet'}</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="editMacAddress(${mac.Id}, ${assetId}, '${mac.MacAddress}')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteMacAddress(${mac.Id}, ${assetId})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += '</tbody></table></div>';
                    $container.html(html);
                } else {
                    $container.html('<div class="text-center text-muted">ไม่พบ Mac Address</div>');
                }
            }).fail(function () {
                $container.html('<div class="text-center text-danger">ไม่สามารถโหลด Mac Address ได้</div>');
            });
        }

        // ฟังก์ชันสำหรับเพิ่ม Mac Address จาก Modal
        window.addMacAddressFromModal = function(assetId) {
            addMacAddress(assetId);
        };

        function deleteMacAddress(macId, assetId) {
            Swal.fire({
                title: 'ยืนยันการลบ',
                text: 'คุณต้องการลบ Mac Address นี้ใช่หรือไม่?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: appBasePath + 'Asset/DeleteMacAddress/' + macId,
                        type: 'DELETE',
                        success: function () {
                            loadMacAddresses(assetId);
                            // อัปเดตจำนวน Mac Address ในตารางหลัก
                            loadMacAddressCount(assetId); 
                            // รีเฟรช Modal ถ้ามีการเปิดอยู่
                            if (Swal.isVisible()) {
                                loadMacAddressesForModal(assetId);
                            }
                            Swal.fire({
                                icon: 'success',
                                title: 'ลบ Mac Address สำเร็จ',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: xhr.responseText || 'ไม่สามารถลบ Mac Address ได้'
                            });
                        }
                    });
                }
            });
        }

        // ฟังก์ชันสำหรับแก้ไข Mac Address
        function editMacAddress(macId, assetId, oldMac) {
            Swal.fire({
                title: 'แก้ไข Mac Address',
                input: 'text',
                inputLabel: 'Mac Address ใหม่',
                inputValue: oldMac,
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก',
                inputValidator: (value) => {
                    if (!value) {
                        return 'กรุณากรอก Mac Address';
                    }
                    // แทนที่ - ด้วย :
                    const normalized = value.trim().replace(/-/g, ':').toUpperCase();
                    if (!/^([0-9A-F]{2}:){5}[0-9A-F]{2}$/.test(normalized)) {
                        return 'รูปแบบ Mac Address ไม่ถูกต้อง (เช่น: 00:1A:2B:3C:4D:5E)';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const newMac = result.value.trim().replace(/-/g, ':').toUpperCase();
                    $.ajax({
                        url: appBasePath + 'Asset/EditMacAddress',
                        type: 'PUT',
                        data: JSON.stringify({ Id: macId, MacAddress: newMac }),
                        contentType: 'application/json',
                        success: function () {
                            loadMacAddresses(assetId);
                            // อัปเดตจำนวน Mac Address ในตารางหลัก
                            loadMacAddressCount(assetId);
                            // รีเฟรช Modal ถ้ามีการเปิดอยู่
                            if (Swal.isVisible()) {
                                loadMacAddressesForModal(assetId);
                            }
                            Swal.fire({
                                icon: 'success',
                                title: 'แก้ไข Mac Address สำเร็จ',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: xhr.responseText || 'ไม่สามารถแก้ไข Mac Address ได้'
                            });
                        }
                    });
                }
            });
        }

        function addMacAddress(assetId) {
            Swal.fire({
                title: 'เพิ่ม Mac Address',
                input: 'text',
                inputLabel: 'Mac Address (เช่น: 00:1A:2B:3C:4D:5E หรือ 00-1A-2B-3C-4D-5E)',
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก',
                inputValidator: (value) => {
                    if (!value) {
                        return 'กรุณากรอก Mac Address';
                    }
                    // แทนที่ - ด้วย :
                    const normalized = value.trim().replace(/-/g, ':').toUpperCase();
                    if (!/^([0-9A-F]{2}:){5}[0-9A-F]{2}$/.test(normalized)) {
                        return 'รูปแบบ Mac Address ไม่ถูกต้อง (เช่น: 00:1A:2B:3C:4D:5E)';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const newMac = result.value.trim().replace(/-/g, ':').toUpperCase();
                    $.ajax({
                        url: appBasePath + 'Asset/AddMacAddress',
                        type: 'POST',
                        data: JSON.stringify({
                            AssetId: assetId,
                            MacAddress: newMac,
                            NetworkType: 'Ethernet'
                        }),
                        contentType: 'application/json',
                        success: function () {
                            loadMacAddresses(assetId);
                            // อัปเดตจำนวน Mac Address ในตารางหลัก
                            loadMacAddressCount(assetId);
                            // รีเฟรช Modal ถ้ามีการเปิดอยู่
                            if (Swal.isVisible()) {
                                loadMacAddressesForModal(assetId);
                            }
                            Swal.fire({
                                icon: 'success',
                                title: 'เพิ่ม Mac Address สำเร็จ',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: xhr.responseText || 'ไม่สามารถเพิ่ม Mac Address ได้'
                            });
                        }
                    });
                }
            });
        }

        // ฟังก์ชันสำหรับรีเฟรชข้อมูล Dashboard
        function refreshDashboardData() {
            // โหลดข้อมูลสรุป Dashboard
            $.get(appBasePath + 'Asset/GetDashboardSummary', function(data) {
                // อัปเดทข้อมูลสรุป Dashboard
                const total = data.total || 0;
                
                // อัปเดทข้อมูลหลัก
                $('#totalAssets').text(total);
                $('#activeAssets').text(data.active || 0);
                $('#repairAssets').text(data.repair || 0);
                $('#damagedAssets').text(data.damaged || 0);
                $('#disposedAssets').text(data.disposed || 0);
                $('#inactiveAssets').text(data.inactive || 0);
                $('#spareAssets').text(data.spare || 0);
                $('#recentAssets').text(data.recentCount || 0);
                $('#maintenanceCount').text(data.maintenanceCount || 0);

                // อัปเดทข้อมูล Mac Address
                $('#withMac').text('มี Mac: ' + (data.withMac || 0));
                $('#withoutMac').text('ไม่มี Mac: ' + (data.withoutMac || 0));

                // คำนวณเปอร์เซ็นต์
                if (total > 0) {
                    $('#activePercent').text(Math.round((data.active || 0) / total * 100) + '%');
                    $('#repairPercent').text(Math.round((data.repair || 0) / total * 100) + '%');
                    $('#damagedPercent').text(Math.round((data.damaged || 0) / total * 100) + '%');
                    $('#disposedPercent').text(Math.round((data.disposed || 0) / total * 100) + '%');
                    $('#inactivePercent').text(Math.round((data.inactive || 0) / total * 100) + '%');
                    $('#sparePercent').text(Math.round((data.spare || 0) / total * 100) + '%');
                } else {
                    // ถ้าไม่มีข้อมูล ให้แสดง 0%
                    $('#activePercent').text('0%');
                    $('#repairPercent').text('0%');
                    $('#damagedPercent').text('0%');
                    $('#disposedPercent').text('0%');
                    $('#inactivePercent').text('0%');
                    $('#sparePercent').text('0%');
                }

                // อัปเดทสรุปประเภท
                if (data.byType && Object.keys(data.byType).length > 0) {
                    let typeText = [];
                    for (const [type, count] of Object.entries(data.byType)) {
                        typeText.push(getTypeName(type) + ': ' + count);
                    }
                    $('#typeSummary').text(typeText.slice(0, 3).join(' | '));
                } else {
                    $('#typeSummary').text('ไม่มีข้อมูล');
                }
            }).fail(function (xhr, status, error) {
                console.error('ไม่สามารถโหลดข้อมูลสรุปได้:', error);
                console.error('Response:', xhr.responseText);
                // ลบ loading state และแสดงข้อความผิดพลาด
                $('.dashboard-card h2').removeClass('loading').text('0');
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถโหลดข้อมูลสรุปได้: ' + error,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            });
            
            // โหลดสถิติ
            $.get(appBasePath + 'Asset/GetStatistics', function (data) {
                // อัปเดทสถิติ
                $('#totalAssets').text(data.total || 0);
                $('#activeAssets').text(data.active || 0);
                $('#repairAssets').text(data.repair || 0);
                $('#damagedAssets').text(data.damaged || 0);
            }).fail(function (xhr, status, error) {
                console.error('ไม่สามารถโหลดสถิติได้:', error);
                console.error('Response:', xhr.responseText);
                // ใช้ข้อมูลสถิติแบบ default
                $('#totalAssets').text(0);
                $('#activeAssets').text(0);
                $('#repairAssets').text(0);
                $('#damagedAssets').text(0);
            });
        }

        // ฟังก์ชันสำหรับเปลี่ยนสถานะแบบ inline
        window.changeStatus = function(assetId, newStatus, statusName) {
            if (!window.canEdit) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่มีสิทธิ์',
                    text: 'คุณไม่มีสิทธิ์ในการแก้ไขทรัพย์สิน',
                    confirmButtonText: 'ตกลง'
                });
                return;
            }

            Swal.fire({
                title: 'ยืนยันการเปลี่ยนสถานะ',
                text: `คุณต้องการเปลี่ยนสถานะเป็น "${statusName}" ใช่หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'เปลี่ยนสถานะ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // แสดง loading state
                    const $dropdown = $(`.status-dropdown button[onclick*="changeStatus(${assetId}"]`).closest('.status-dropdown');
                    const $button = $dropdown.find('button');
                    const originalContent = $button.html();
                    
                    // เพิ่ม class สำหรับ animation
                    $dropdown.addClass('status-changing');
                    $button.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                    $.ajax({
                        url: `${appBasePath}Asset/ChangeStatus`,
                        type: 'PUT',
                        data: JSON.stringify({
                            Id: assetId,
                            Status: newStatus
                        }),
                        contentType: 'application/json',
                        success: function (response) {
                            // อัปเดตข้อมูลในตาราง
                            assetTable.ajax.reload(function() {
                                // โหลดจำนวน Mac Address หลังจาก reload ตาราง
                                setTimeout(function() {
                                    loadAllMacAddressCounts();
                                }, 500);
                                
                                // เพิ่ม tooltip ใหม่หลังจาก reload
                                setTimeout(function() {
                                    $('.status-dropdown button[data-bs-toggle="tooltip"]').tooltip();
                                    // อัปเดต tooltip สำหรับรายละเอียดเพิ่มเติม
                                    $('[data-bs-toggle="tooltip"]').tooltip({
                                        html: true,
                                        placement: 'top',
                                        trigger: 'hover',
                                        container: 'body'
                                    });
                                }, 100);
                            });
                            
                            // อัปเดตข้อมูลสรุป
                            onAssetDataChanged();
                            
                            // แสดง Toast แจ้งเตือน
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true,
                                didOpen: (toast) => {
                                    toast.addEventListener('mouseenter', Swal.stopTimer)
                                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                                }
                            });

                            Toast.fire({
                                icon: 'success',
                                title: `เปลี่ยนสถานะเป็น "${statusName}" สำเร็จ`
                            });
                        },
                        error: function (xhr) {
                            // คืนค่าเดิมเมื่อเกิดข้อผิดพลาด
                            $dropdown.removeClass('status-changing');
                            $button.html(originalContent).prop('disabled', false);
                            
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: xhr.responseText || 'ไม่สามารถเปลี่ยนสถานะได้'
                            });
                        }
                    });
                }
            });
        };

        // ฟังก์ชันสำหรับอัปเดตข้อมูลเมื่อมีการเปลี่ยนแปลง
        function onAssetDataChanged() {
            refreshDashboardData();
            // อัปเดตจำนวน Mac Address ในตารางหลัก
            setTimeout(function() {
                loadAllMacAddressCounts();
            }, 500);
        }

        $('#assetModal').on('hidden.bs.modal', function () {
            $('#btnAddAsset').focus();
        });
    </script>
}