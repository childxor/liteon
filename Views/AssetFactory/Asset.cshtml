        // โหลด option แผนก
        function loadDeptsForFilter() {
            $.get(appBasePath + 'Asset/GetDepartments', function (data) {
                var $sel = $('#filterDept');
                $sel.empty().append('<option value=\"">-- แผนกทั้งหมด --</option>');
                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        var deptName = item.name || item.Name || item.deptName || item.DeptName || item.Text || item.Id;
                        var deptId = item.Id || item.id || item.deptID || item.DeptID || deptName;
                        $sel.append('<option value=\"' + deptId + '\">' + deptName + '</option>');
                    });
