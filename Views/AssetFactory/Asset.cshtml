                    },
                    {
                        data: 'Name',
                        title: '<i class="fas fa-laptop me-1 text-success"></i>ชื่อทรัพย์สิน',
                        className: 'fw-medium',
                        render: function (data, type, row) {
                            // ตรวจสอบว่ามีรายละเอียดเพิ่มเติมหรือไม่
                            var hasDetails = row.AssetNo || row.ProductSerial || row.WindowsVersion || row.Model || 
                                           row.Manufacturer || row.InstallationDate || row.StartDate || row.EndDate || 
                                           row.LocationDetail || row.CountryOfOrigin || row.CustomerNo || row.CustomerName || row.Remarks;
                            
                            var tooltipText = '';
                            if (hasDetails) {
                                tooltipText = 'รายละเอียดเพิ่มเติม:\n';
                                if (row.AssetNo) tooltipText += '• รหัสทรัพย์สิน: ' + row.AssetNo + '\n';
                                if (row.ProductSerial) tooltipText += '• Serial Number: ' + row.ProductSerial + '\n';
                                if (row.WindowsVersion) tooltipText += '• Windows: ' + row.WindowsVersion + '\n';
