    <script>
        // ประกาศตัวแปร appBasePath และ permissions
        var appBasePath = '@Url.Content("~/")';
        var canAdd = @Json.Serialize(canAdd);
        var canEdit = @Json.Serialize(canEdit);
        var canDelete = @Json.Serialize(canDelete);
        var canView = @Json.Serialize(canView);

        window.statusMap = {
            '1': 'ใช้งานได้',
            '2': 'กำลังซ่อม',
            '3': 'ชำรุด',
            '4': 'จำหน่าย',
            '5': 'ไม่ใช้งาน',
            '6': 'อะไหล่'
        };

        // ใช้ใน DataTable render
        function getStatusName(status) {
            return window.statusMap[status] || 'ไม่ระบุ';
        }

        // โหลด option สถานะ
        function loadStatusesForFilter() {
            $.get(appBasePath + 'Asset/GetAssetStatuses', function (data) {
                var $sel = $('#filterStatus');
                $sel.empty().append('<option value=\"">-- สถานะทั้งหมด --</option>');
                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        $sel.append('<option value=\"' + item.Id + '\">' + item.Text + '</option>');
                    });
                }
            }).fail(function(xhr, status, error) {
                console.error('ไม่สามารถโหลดสถานะได้:', error);
                // ใช้ข้อมูลสถานะแบบ hardcode เป็น fallback
                var fallbackStatuses = [
                    { Id: '1', Text: 'ใช้งานได้' },
                    { Id: '2', Text: 'กำลังซ่อม' },
                    { Id: '3', Text: 'ชำรุด' },
                    { Id: '4', Text: 'จำหน่าย' },
                    { Id: '5', Text: 'ไม่ใช้งาน' },
                    { Id: '6', Text: 'อะไหล่' }
                ];
                var $sel = $('#filterStatus');
                $sel.empty().append('<option value=\"">-- สถานะทั้งหมด --</option>');
                fallbackStatuses.forEach(function (item) {
                    $sel.append('<option value=\"' + item.Id + '\">' + item.Text + '</option>');
                });
            });
        }

        // โหลด option ประเภท
        function loadTypesForFilter() {
            $.get(appBasePath + 'Asset/GetAssetTypes', function (data) {
                var $sel = $('#filterType');
                $sel.empty().append('<option value=\"">-- ประเภททั้งหมด --</option>');
