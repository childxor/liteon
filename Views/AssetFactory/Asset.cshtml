                                if (row.Manufacturer) tooltipText += '• ผู้ผลิต: ' + row.Manufacturer + '\n';
                                if (row.CountryOfOrigin) tooltipText += '• ประเทศผู้ผลิต: ' + row.CountryOfOrigin + '\n';
                                if (row.InstallationDate) tooltipText += '• วันที่ติดตั้ง: ' + new Date(row.InstallationDate).toLocaleDateString('th-TH') + '\n';
                                if (row.StartDate) tooltipText += '• วันที่เริ่มใช้งาน: ' + new Date(row.StartDate).toLocaleDateString('th-TH') + '\n';
                                if (row.EndDate) tooltipText += '• วันที่สิ้นสุด: ' + new Date(row.EndDate).toLocaleDateString('th-TH') + '\n';
                                if (row.LocationDetail) tooltipText += '• รายละเอียดสถานที่: ' + row.LocationDetail + '\n';
                                if (row.CustomerNo) tooltipText += '• รหัสลูกค้า: ' + row.CustomerNo + '\n';
                                if (row.CustomerName) tooltipText += '• ชื่อลูกค้า: ' + row.CustomerName + '\n';
                                if (row.Remarks) tooltipText += '• หมายเหตุ: ' + row.Remarks + '\n';
                                
                                return `<span class="text-primary fw-medium" data-bs-toggle="tooltip" data-bs-html="true" 
                                         title="${tooltipText.replace(/\n/g, '<br>')}" style="cursor: help;">
