@model IEnumerable<dynamic>
@using IPS_TH.Models.Employee
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "ระบบจัดการทรัพย์สิน IT";

    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false; 
    bool canView = permissions?["CanView"] ?? false;
}

<div class="container-fluid mt-4">
    <!-- สถิติทรัพย์สิน -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-primary">
                    <i class="fas fa-chart-bar me-2"></i>สรุปข้อมูลทรัพย์สิน
                </h5>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnRefreshDashboard" 
                        title="รีเฟรชข้อมูลสรุปทรัพย์สิน (อัปเดตอัตโนมัติทุก 30 วินาที)">
                    <i class="fas fa-sync-alt me-1"></i>รีเฟรช
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnTestFilter" 
                        title="ทดสอบการกรอง">
                    <i class="fas fa-filter me-1"></i>ทดสอบ
                </button>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white h-100 dashboard-card" data-status="all" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-laptop me-2"></i>ทรัพย์สินทั้งหมด</h6>
                            <h2 class="mb-2" id="totalAssets">0</h2>
                            <div class="small">
                                <span id="withMac" class="badge bg-success me-1">มี Mac: 0</span>
                                <span id="withoutMac" class="badge bg-light text-dark">ไม่มี Mac: 0</span>
                            </div>
                        </div>
                        <i class="fas fa-chart-pie fa-2x opacity-50"></i>
                    </div>
                    <div class="small mt-2" id="typeSummary"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white h-100 dashboard-card" data-status="1" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-check-circle me-2"></i>ใช้งานได้</h6>
                            <h2 class="mb-0" id="activeAssets">0</h2>
                            <div class="small mt-1">
                                <span id="activePercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white h-100 dashboard-card" data-status="2" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-tools me-2"></i>กำลังซ่อม</h6>
                            <h2 class="mb-0" id="repairAssets">0</h2>
                            <div class="small mt-1">
                                <span id="repairPercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-tools fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white h-100 dashboard-card" data-status="3" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-exclamation-triangle me-2"></i>ชำรุด</h6>
                            <h2 class="mb-0" id="damagedAssets">0</h2>
                            <div class="small mt-1">
                                <span id="damagedPercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- สถิติเพิ่มเติม -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-secondary text-white h-100 dashboard-card" data-status="4" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-recycle me-2"></i>จำหน่าย</h6>
                            <h2 class="mb-0" id="disposedAssets">0</h2>
                            <div class="small mt-1">
                                <span id="disposedPercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-recycle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white h-100 dashboard-card" data-status="5" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-pause-circle me-2"></i>ไม่ใช้งาน</h6>
                            <h2 class="mb-0" id="inactiveAssets">0</h2>
                            <div class="small mt-1">
                                <span id="inactivePercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-pause-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-purple text-white h-100 dashboard-card" data-status="6" style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-boxes me-2"></i>อะไหล่</h6>
                            <h2 class="mb-0" id="spareAssets">0</h2>
                            <div class="small mt-1">
                                <span id="sparePercent">0%</span> ของทั้งหมด
                            </div>
                        </div>
                        <i class="fas fa-boxes fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-dark text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="fas fa-clock me-2"></i>เพิ่มเดือนนี้</h6>
                            <h2 class="mb-0" id="recentAssets">0</h2>
                            <div class="small mt-1">
                                <span id="maintenanceCount">0</span> ต้องบำรุงรักษา
                            </div>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ฟิลเตอร์สำหรับตาราง -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h6 class="mb-0 text-primary">
                <i class="fas fa-filter me-2"></i>ตัวกรองข้อมูล
            </h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="filterStatus" class="form-label">สถานะ</label>
                    <select class="form-select" id="filterStatus">
                        <option value="">-- สถานะทั้งหมด --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filterType" class="form-label">ประเภท</label>
                    <select class="form-select" id="filterType">
                        <option value="">-- ประเภททั้งหมด --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filterDept" class="form-label">แผนก</label>
                    <select class="form-select" id="filterDept">
                        <option value="">-- แผนกทั้งหมด --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filterLocation" class="form-label">สถานที่</label>
                    <select class="form-select" id="filterLocation">
                        <option value="">-- สถานที่ทั้งหมด --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="filterSearch" class="form-label">ค้นหา</label>
                    <input type="text" class="form-control" id="filterSearch" placeholder="ค้นหาทรัพย์สิน...">
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearFilter">
                        <i class="fas fa-times me-1"></i>ล้างตัวกรอง
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ฟิลเตอร์และปุ่มจัดการ -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col-md-6 mb-2 mb-md-0">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-laptop me-2"></i>รายการทรัพย์สิน IT
                    </h5>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-2 justify-content-md-end">
                        @if (canAdd)
                        {
                            <button type="button" class="btn btn-primary" id="btnAddAsset">
                                <i class="fas fa-plus-circle me-1"></i>เพิ่มทรัพย์สิน
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive shadow-sm rounded-3 p-3">
                <table id="assetTable" class="table table-hover table-striped table-bordered align-middle fs-6 mb-0">
                    <!-- DataTable จะ render thead/tbody -->
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่ม/แก้ไขทรัพย์สิน -->
<div class="modal fade" id="assetModal" tabindex="-1" aria-labelledby="assetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="assetModalLabel"><i class="fas fa-plus-circle me-2"></i>เพิ่มทรัพย์สิน IT
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assetForm" class="needs-validation" novalidate>
                    <input type="hidden" id="assetId" name="Id" />

                    <!-- ข้อมูลหลัก (จำเป็น) -->
                    <div class="card mb-3">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="fas fa-star me-2"></i>ข้อมูลหลัก (จำเป็น)</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-bold"><i class="fas fa-laptop me-1"></i>ชื่อทรัพย์สิน *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                        <input type="text" class="form-control" id="name" name="Name" required
                                            placeholder="ระบุชื่อทรัพย์สินใหม่">
                                        <div class="invalid-feedback">
                                            กรุณาระบุชื่อทรัพย์สิน
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="type" class="form-label fw-bold"><i class="fas fa-tags me-1"></i>ประเภททรัพย์สิน *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-list"></i></span>
                                        <select class="form-select" id="type" name="Type" required>
                                            <option value="">-- เลือกประเภท --</option>
                                            <option value="1">คอมพิวเตอร์</option>
                                            <option value="2">โน๊ตบุ๊ค</option>
                                            <option value="3">แท็บเล็ต</option>
                                            <option value="4">โทรศัพท์</option>
                                            <option value="5">เครื่องพิมพ์</option>
                                            <option value="6">อุปกรณ์เครือข่าย</option>
                                            <option value="7">อื่นๆ</option>
                                        </select>
                                        <div class="invalid-feedback">
                                            กรุณาเลือกประเภททรัพย์สิน
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="status" class="form-label fw-bold"><i class="fas fa-toggle-on me-1"></i>สถานะ *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                                        <select class="form-select" id="status" name="Status" required>
                                            <option value="">-- เลือกสถานะ --</option>
                                            <option value="1">ใช้งานได้</option>
                                            <option value="2">กำลังซ่อม</option>
                                            <option value="3">ชำรุด</option>
                                            <option value="4">จำหน่าย</option>
                                            <option value="5">ไม่ใช้งาน</option>
                                            <option value="6">อะไหล่</option>
                                        </select>
                                        <div class="invalid-feedback">
                                            กรุณาเลือกสถานะ
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="location" class="form-label fw-bold"><i class="fas fa-map-marker-alt me-1"></i>สถานที่จัดเก็บ *</label>
                                    <select class="form-select" id="location" name="Location" required>
                                        <option value="">-- เลือกสถานที่จัดเก็บ --</option>
                                        <option value="PD">พื้นที่ไลน์ผลิต</option>
                                        <option value="RMW">Raw material WH</option>
                                        <option value="EW">Electronic WH</option>
                                        <option value="POR">ออฟฟิศ</option>
                                        <option value="MR">ห้องบอส</option>
                                        <option value="BTR">ห้องประชุม</option>
                                        <option value="MICR">ห้องเซิฟเวอร์</option>
                                        <option value="JIG">ห้องเก็บอะไหล่</option>
                                        <option value="DCC">ห้องเก็บของเล็กข้างห้องเซิฟเวอร์</option>
                                        <option value="TC">ห้องเทรนงานชั้น 2</option>
                                        <option value="CF">ห้องประชุมชั้น 2</option>
                                        <option value="OFPD">ออฟฟิศไลน์ผลิต</option>
                                        <option value="PR">ห้องปลิ้นติ้ง</option>
                                        <option value="OM">ห้องผสมสี</option>
                                        <option value="SC">ห้องแผ่นสกีนรูม</option>
                                        <option value="PTR">ห้องยาม</option>
                                        <option value="SLSC">ที่พักพนักงาน</option>
                                        <option value="CR">ห้องเปลี่ยนรองเท้า</option>
                                        <option value="RSFPW">Raw materials & semi Finished WH</option>
                                        <option value="DQE">DQE LAB</option>
                                        <option value="IQC">IQC room</option>
                                        <option value="FA">พื้นที่รับของสโตร์</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        กรุณาเลือกสถานที่จัดเก็บ
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <label for="owner" class="form-label fw-bold"><i class="fas fa-user me-1"></i>ผู้รับผิดชอบ *</label>
                                    <select class="form-select" id="owner" name="Owner" required>
                                        <option value="">-- เลือกผู้รับผิดชอบ --</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        กรุณาเลือกผู้รับผิดชอบ
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label for="ownerName" class="form-label"><i class="fas fa-user me-1"></i>ชื่อผู้รับผิดชอบ</label>
                                    <input type="text" class="form-control" id="ownerName" name="OwnerName" readonly>
                                </div>

                                <div class="col-md-6">
                                    <label for="department" class="form-label"><i class="fas fa-building me-1"></i>แผนก</label>
                                    <input type="text" class="form-control" id="department" name="Department" readonly>
                                </div>

                                <div class="col-md-6">
                                    <label for="line" class="form-label"><i class="fas fa-industry me-1"></i>ไลน์ผลิต</label>
                                    <select class="form-select" id="line" name="Line">
                                        <option value="">-- เลือกไลน์ผลิต --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ข้อมูลเพิ่มเติม (ไม่จำเป็น) -->
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fas fa-plus-circle me-2"></i>ข้อมูลเพิ่มเติม (ไม่จำเป็น)
                                <button type="button" class="btn btn-sm btn-outline-primary float-end" id="btnToggleDetails">
                                    <i class="fas fa-chevron-down"></i> แสดงรายละเอียด
                                </button>
                            </h6>
                        </div>
                        <div class="card-body" id="detailsSection" style="display: none;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="assetNo" class="form-label"><i class="fas fa-barcode me-1"></i>รหัสทรัพย์สิน</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-key"></i></span>
                                        <input type="text" class="form-control" id="assetNo" name="AssetNo" placeholder="ระบุรหัสทรัพย์สิน">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="productSerial" class="form-label"><i class="fas fa-laptop me-1"></i>Serial Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                        <input type="text" class="form-control" id="productSerial" name="ProductSerial" placeholder="ระบุ Serial Number">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="windowsVersion" class="form-label"><i class="fas fa-desktop me-1"></i>เวอร์ชั่น Windows</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fab fa-windows"></i></span>
                                        <select class="form-select" id="windowsVersion" name="WindowsVersion">
                                            <option value="">-- เลือกเวอร์ชั่น Windows --</option>
                                            <option value="Windows 10">Windows 10</option>
                                            <option value="Windows 11">Windows 11</option>
                                            <option value="Windows Server 2019">Windows Server 2019</option>
                                            <option value="Windows Server 2022">Windows Server 2022</option>
                                            <option value="อื่นๆ">อื่นๆ</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="model" class="form-label"><i class="fas fa-tag me-1"></i>รุ่น/Model</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                                        <input type="text" class="form-control" id="model" name="Model" placeholder="ระบุรุ่น/Model">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="manufacturer" class="form-label"><i class="fas fa-industry me-1"></i>ผู้ผลิต</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                                        <input type="text" class="form-control" id="manufacturer" name="Manufacturer" placeholder="ระบุผู้ผลิต">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="countryOfOrigin" class="form-label"><i class="fas fa-flag me-1"></i>ประเทศผู้ผลิต</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-globe"></i></span>
                                        <input type="text" class="form-control" id="countryOfOrigin" name="CountryOfOrigin" placeholder="ระบุประเทศผู้ผลิต">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="installationDate" class="form-label"><i class="fas fa-calendar-alt me-1"></i>วันที่ติดตั้ง</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                        <input type="date" class="form-control" id="installationDate" name="InstallationDate">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="startDate" class="form-label"><i class="fas fa-play-circle me-1"></i>วันที่เริ่มใช้งาน</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar-check"></i></span>
                                        <input type="date" class="form-control" id="startDate" name="StartDate">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="endDate" class="form-label"><i class="fas fa-stop-circle me-1"></i>วันที่สิ้นสุดการใช้งาน</label>
