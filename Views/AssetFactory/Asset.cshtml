                    },
                    {
                        data: 'AssetNo',
                        title: '<i class="fas fa-barcode me-1 text-primary"></i>รหัสทรัพย์สิน',
                        className: 'text-nowrap fw-medium'
                    },
                    {
                        data: 'ProductSerial',
