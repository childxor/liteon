                            resultContent += `
                                <div class="mb-3">
                                    <h6 class="text-danger"><i class="fas fa-times-circle me-1"></i>รายการตู้ที่เพิ่มไม่สำเร็จ (${result.TotalFailed} รายการ)</h6>
                                    <div class="bg-light p-2 rounded mb-2" style="max-height: 100px; overflow-y: auto;">
                                        ${failedList}
                                    </div>
                                </div>
