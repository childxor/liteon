            });
            
            // ปุ่มดาวน์โหลด HTML (fallback)
            $('#btnDownloadHTML').on('click', function() {
                $.ajax({
                    url: appBasePath + 'Cabinet/GetAll',
                    type: 'GET',
                    success: function(data) {
                        // สร้าง HTML content
                        const htmlContent = generateFullPageReport(data);
                        const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.html`;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'ดาวน์โหลดสำเร็จ',
                            text: 'ไฟล์ HTML ถูกดาวน์โหลดแล้ว',
                            showConfirmButton: false,
                            timer: 2000
                        });
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถสร้างไฟล์ HTML ได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            });
            
            // ปุ่มพิมพ์
            $('#btnPrintPDF').on('click', function() {
                if (currentPdfUrl) {
                    // เปิดในหน้าต่างใหม่เพื่อพิมพ์
