            // เพิ่ม Event handlers สำหรับการเปลี่ยนสถานะด้วย Switch
            $(document).on('change', '.status-switch', function() {
                const id = $(this).data('id');
                const current = $(this).data('current'); 
                const isChecked = $(this).prop('checked');
                var dataRow = $(this).closest('tr');
                var no = dataRow.find('td:eq(0)').text();
                
                let newStatus = isChecked ? "1" : "0";
                
                if (current === "2" && !isChecked) {
                    Swal.fire({
                        title: 'เปลี่ยนสถานะตู้',
                        text: 'ตู้นี้อยู่ในสถานะชำรุด คุณต้องการเปลี่ยนเป็น?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'ว่าง',
                        cancelButtonText: 'ยกเลิก',
                        showDenyButton: true,
                        denyButtonText: 'ยังชำรุดอยู่',
                        denyButtonColor: '#dc3545'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            updateCabinetStatus(id, "0", no);
                        } else if (result.isDenied) {
                            updateCabinetStatus(id, "2", no);
                            $(this).prop('checked', false);
                        } else {
                            $(this).prop('checked', !isChecked);
                        }
                    });
                    return;
                }
                
                updateCabinetStatus(id, newStatus, no);
            });
            
            // ฟังก์ชันอัปเดตสถานะตู้
            function updateCabinetStatus(id, newStatus, no) {
                $.ajax({
                    url: appBasePath + 'Cabinet/Get/' + id,
                    type: 'GET',
                    success: function(data) {
                        // ถ้าต้องการเปลี่ยนเป็นไม่ว่าง (1) แต่ยังไม่มีผู้ครอบครอง
                        if (newStatus === "1" && (!data.owner || data.owner === "")) {
                            // รอให้ข้อมูลพนักงานโหลดเสร็จก่อน
                            function waitForEmployeesData(callback) {
                                if (employeesData.length > 0) {
                                    callback();
                                } else {
                                    setTimeout(() => waitForEmployeesData(callback), 100);
                                }
                            }
                            
                            waitForEmployeesData(function() {
                                populateEmployeeSelect();
                                
                                $(document).find('#cabinetId').val(id);
                                $(document).find('#cabinetNo').val(data.No);
                                $(document).find('#cabinetStatus').val(newStatus);
                                $(document).find('#cabinetOwner').val(data.owner || '').trigger('change');
                                
                                $(document).find('#cabinetModalLabel').html('<i class="fas fa-user-plus me-2"></i>กรุณาระบุผู้ครอบครอง');
                                cabinetModal.show();
                            });
                            return;
                        }

                        // อัปเดตสถานะและข้อมูลผู้ครอบครอง
                        data.status = newStatus;
                        // ถ้าต้องการเปลี่ยนเป็นว่าง (0) ให้ล้างข้อมูลผู้ครอบครอง
                        if (newStatus === "0") {
                            data.owner = "";
                        }

                        $.ajax({
                            url: appBasePath + 'Cabinet/Update',
                            type: 'PUT',
                            data: JSON.stringify(data),
                            contentType: 'application/json',
                            success: function() {
                                table.ajax.reload(null, false);
                                
                                Swal.fire({
                                    icon: 'success',
                                    title: 'อัปเดตสถานะสำเร็จ',
                                    showConfirmButton: false,
                                    timer: 1500
                                });
                            },
                            error: function(xhr) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'อัปเดตสถานะไม่สำเร็จ',
                                    text: xhr.responseText || 'ไม่สามารถเปลี่ยนสถานะได้',
                                    confirmButtonText: 'ตกลง'
                                });
                                table.ajax.reload(null, false);
                            }
                        });
                    },
                    error: function(xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถดึงข้อมูลตู้ได้'
                        });
                        table.ajax.reload(null, false);
                    }
                });
            }

            // กำหนดค่าเริ่มต้นสำหรับ Select2
            function initSelect2() {
                $('.select2').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    dropdownParent: $('#cabinetModal'),
                    allowClear: true,
                    placeholder: "-- เลือกผู้ครอบครอง --",
                    language: {
                        noResults: function() {
                            return "ไม่พบข้อมูลพนักงาน";
                        },
                        searching: function() {
                            return "กำลังค้นหา...";
                        }
                    },
                    templateResult: function(option) {
                        if (!option.id) {
                            return option.text;
                        }
                        
                        // สร้าง template สำหรับแสดงผลในรายการ dropdown
                        var $option = $(
                            '<div class="d-flex align-items-center">' +
                                '<div class="me-2">' +
                                    '<i class="fas fa-user-circle text-primary"></i>' +
                                '</div>' +
                                '<div>' +
                                    '<div class="fw-semibold">' + option.text.split(' (')[0] + '</div>' +
                                    '<div class="text-muted small">รหัส: ' + option.element.dataset.employeeCode + '</div>' +
                                '</div>' +
                            '</div>'
                        );
                        return $option;
                    },
                    templateSelection: function(option) {
                        if (!option.id) {
                            return option.text;
                        }
                        
                        // สร้าง template สำหรับแสดงผลเมื่อเลือกแล้ว
                        return option.text.split(' (')[0]; // แสดงแค่ชื่อ ไม่แสดงรหัส
                    }
                });
            }

            // เรียกใช้ Select2 เมื่อเพจโหลดเสร็จ
            initSelect2();
            
            // โหลดข้อมูลพนักงานครั้งเดียวตอนเริ่มต้น
