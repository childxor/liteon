@model IEnumerable<dynamic>
@using IPS_TH.Models.Employee
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "จัดการตู้เก็บของพนักงาน";
    
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false;
    bool canView = permissions?["CanView"] ?? false;
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-box me-2"></i>จัดการตู้เก็บของพนักงาน</h5>
            @if (canAdd)
            {
                <div class="btn-group">
                    <button type="button" class="btn btn-success btn-sm" id="btnAddCabinet">
                        <i class="fas fa-plus-circle me-1"></i>เพิ่มตู้ใหม่
                    </button>
                    <button type="button" class="btn btn-info btn-sm" id="btnAddCabinetRange">
                        <i class="fas fa-layer-group me-1"></i>เพิ่มตู้แบบช่วง
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnShowReport">
                        <i class="fas fa-file-alt me-1"></i>แสดงรายงาน
                    </button>
                    <button type="button" class="btn btn-warning btn-sm" id="btnReleaseResignedOwners" title="คืนตู้ทั้งหมดที่เจ้าของลาออกแล้ว">
                        <i class="fas fa-user-minus me-1"></i>คืนตู้ (เจ้าของลาออก) ทั้งหมด
                    </button>
                </div>
            }
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="cabinetTable" class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-hashtag me-1"></i>เลขที่ตู้</th>
                            <th><i class="fas fa-user me-1"></i>ผู้ครอบครอง</th>
                            <th><i class="fas fa-info-circle me-1"></i>สถานะ</th>
                            <th><i class="fas fa-calendar-alt me-1"></i>อัพเดทล่าสุด</th>
                            <th><i class="fas fa-user-edit me-1"></i>อัพเดทโดย</th>
                            <th><i class="fas fa-cogs me-1"></i>การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ข้อมูลจะถูกเพิ่มผ่าน DataTable -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่ม/แก้ไขข้อมูล -->
<div class="modal fade" id="cabinetModal" tabindex="-1" aria-labelledby="cabinetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="cabinetModalLabel"><i class="fas fa-edit me-2"></i>เพิ่มตู้เก็บของพนักงาน</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <form id="cabinetForm">
                    <input type="hidden" id="cabinetId" name="Id" />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="cabinetNo" name="No" required placeholder="ระบุเลขที่ตู้">
                                <label for="cabinetNo">
                                    <i class="fas fa-hashtag me-1"></i>เลขที่ตู้ <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="cabinetOwner" class="form-label">
                                <i class="fas fa-user me-1"></i>ผู้ครอบครอง
                            </label>
                            <select class="form-select select2" id="cabinetOwner" name="Owner">
                                <option value="">-- เลือกผู้ครอบครอง --</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating">
                                <select class="form-select" id="cabinetStatus" name="status">
                                    <option value="0">ว่าง</option>
                                    <option value="1">มีผู้ใช้งาน</option>
                                    <option value="2">ชำรุด</option>
                                </select>
                                <label for="cabinetStatus">
                                    <i class="fas fa-info-circle me-1"></i>สถานะ
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="ยกเลิก">
                    <i class="fas fa-times me-1"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-primary" id="btnSaveCabinet" aria-label="บันทึก">
                    <i class="fas fa-save me-1"></i>บันทึก
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal ยืนยันการลบ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-trash-alt me-2"></i>ยืนยันการลบ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle text-warning fa-4x mb-3"></i>
                    <p>คุณต้องการลบตู้เก็บของหมายเลข <span id="deleteItemNo" class="fw-bold text-danger"></span> ใช่หรือไม่?</p>
                    <p class="text-muted small">การลบข้อมูลนี้ไม่สามารถเรียกคืนได้</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="ยกเลิก">
                    <i class="fas fa-times me-1"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete" aria-label="ยืนยันการลบ">
                    <i class="fas fa-trash-alt me-1"></i>ยืนยันการลบ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่มตู้แบบช่วง -->
<div class="modal fade" id="cabinetRangeModal" tabindex="-1" aria-labelledby="cabinetRangeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="cabinetRangeModalLabel"><i class="fas fa-layer-group me-2"></i>เพิ่มตู้เก็บของแบบช่วง</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <form id="cabinetRangeForm">
                    <div class="mb-3">
                        <label for="cabinetRange" class="form-label"><i class="fas fa-arrows-alt-h me-1"></i>ช่วงหมายเลขตู้ <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-hashtag"></i></span>
                            <input type="text" class="form-control" id="cabinetRange" name="range" required placeholder="ระบุช่วง เช่น 6-100">
                        </div>
                        <div class="form-text text-muted">ระบุช่วงตู้ที่ต้องการเพิ่ม เช่น 6-100 จะเพิ่มตู้หมายเลข 6 ถึง 100</div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>ระบบจะเพิ่มตู้ตามช่วงที่ระบุ โดยกรณีที่มีหมายเลขตู้อยู่แล้วจะข้ามไป
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="ยกเลิก">
                    <i class="fas fa-times me-1"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-info" id="btnSaveCabinetRange" aria-label="เพิ่มตู้">
                    <i class="fas fa-save me-1"></i>เพิ่มตู้
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal แสดงผลการเพิ่มตู้แบบช่วง -->
<div class="modal fade" id="cabinetRangeResultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>ผลการเพิ่มตู้แบบช่วง</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <div id="cabinetRangeResultContent">
                    <!-- ผลลัพธ์จะถูกเพิ่มด้วย JavaScript -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="ตกลง">
                    <i class="fas fa-check me-1"></i>ตกลง
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal แสดงรายงาน PDF -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title"><i class="fas fa-file-pdf me-2"></i>รายงานข้อมูลตู้เก็บของพนักงาน</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm" id="btnPrintReport">
                            <i class="fas fa-print me-1"></i>พิมพ์รายงาน
                        </button>
                        <button type="button" class="btn btn-success btn-sm" id="btnExportPDF">
                            <i class="fas fa-file-download me-1"></i>ดาวน์โหลด PDF
                        </button>
                        <button type="button" class="btn btn-info btn-sm" id="btnRefreshReport">
                            <i class="fas fa-sync-alt me-1"></i>รีเฟรช
                        </button>
                    </div>
                    <div class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>อัพเดทล่าสุด: <span id="reportLastUpdate"></span>
                    </div>
                </div>
                <div id="reportContent" class="p-3">
                    <div class="table-responsive">
                        <table id="reportTable" class="table table-bordered table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 80px;">เลขที่ตู้</th>
                                    <th>ผู้ครอบครอง</th>
                                    <th class="text-center" style="width: 120px;">สถานะ</th>
                                    <th class="text-center" style="width: 150px;">อัพเดทล่าสุด</th>
                                    <th>อัพเดทโดย</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- ข้อมูลจะถูกเพิ่มด้วย JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>ปิด
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal แสดง PDF ผ่าน iframe -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="pdfViewerModalLabel">
                    <i class="fas fa-file-pdf me-2"></i>รายงานข้อมูลตู้เก็บของพนักงาน (PDF)
                </h5>
                <div class="d-flex gap-2">
                    <!-- ปุ่มควบคุม PDF -->
                    <button type="button" class="btn btn-light btn-sm" id="btnDownloadPDF" title="ดาวน์โหลด PDF">
                        <i class="fas fa-download"></i>
                    </button>
                    <button type="button" class="btn btn-light btn-sm" id="btnOpenNewTab" title="เปิดในแท็บใหม่">
                        <i class="fas fa-external-link-alt"></i>
                    </button>
                    <button type="button" class="btn btn-light btn-sm" id="btnRefreshPDF" title="รีเฟรช PDF">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
                </div>
            </div>
            <div class="modal-body p-0" style="height: calc(100vh - 60px);">
                <!-- Loading indicator -->
                <div id="pdfLoadingIndicator" class="d-flex justify-content-center align-items-center h-100">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">กำลังโหลด...</span>
                        </div>
                        <h5 class="text-muted">กำลังสร้างรายงาน PDF</h5>
                        <p class="text-muted">กรุณารอสักครู่...</p>
                    </div>
                </div>
                
                <!-- Error indicator -->
                <div id="pdfErrorIndicator" class="d-none d-flex justify-content-center align-items-center h-100">
                    <div class="text-center">
                        <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 4rem;"></i>
                        <h5 class="text-muted">ไม่สามารถแสดง PDF ได้</h5>
                        <p class="text-muted mb-4" id="pdfErrorMessage">เกิดข้อผิดพลาดในการสร้างไฟล์ PDF</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary" id="btnRetryPDF">
                                <i class="fas fa-redo me-1"></i>ลองอีกครั้ง
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnDownloadHTML">
                                <i class="fas fa-file-code me-1"></i>ดาวน์โหลด HTML
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- PDF iframe -->
                <iframe 
                    id="pdfIframe" 
                    class="d-none w-100 h-100 border-0" 
                    title="PDF Viewer"
                    allow="fullscreen">
                </iframe>
            </div>
            <div class="modal-footer bg-light py-2">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        <span id="pdfStatus">กำลังเตรียมข้อมูล...</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnPrintPDF">
                            <i class="fas fa-print me-1"></i>พิมพ์
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>ปิด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal แสดงรายงาน HTML -->
<div class="modal fade" id="htmlReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-file-alt me-2"></i>รายงานข้อมูลตู้เก็บของพนักงาน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm" id="btnPrintHTMLReport">
                            <i class="fas fa-print me-1"></i>พิมพ์รายงาน
                        </button>
                        <button type="button" class="btn btn-success btn-sm" id="btnDownloadHTMLReport">
                            <i class="fas fa-file-download me-1"></i>ดาวน์โหลด HTML
                        </button>
                        <button type="button" class="btn btn-info btn-sm" id="btnRefreshHTMLReport">
                            <i class="fas fa-sync-alt me-1"></i>รีเฟรช
                        </button>
                    </div>
                    <div class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>รายการทั้งหมด: <span id="htmlReportTotalRecords">0</span> | 
                        อัพเดทล่าสุด: <span id="htmlReportLastUpdate"></span>
                    </div>
                </div>
                <div id="htmlReportContent" class="p-3">
                    <!-- เนื้อหารายงาน HTML จะถูกเพิ่มด้วย JavaScript -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>ปิด
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- นำเข้า Select2 CSS และ JS -->
    <!-- Select2 ถูกโหลดใน Layout แล้ว -->
    
    <style>
        /* ปรับตำแหน่ง Modal ให้อยู่ด้านบนกึ่งกลาง */ 
        .modal-dialog {
            margin-top: 70px !important;
            margin-bottom: auto !important;
        }
        
        /* ปรับแต่ง Modal เพื่อให้มีเอฟเฟกต์การเคลื่อนไหว */
        .modal.fade .modal-dialog {
            transition: transform 0.3s ease-out !important;
            transform: translateY(-50px) !important;
        }
        
        .modal.show .modal-dialog {
            transform: none !important;
        }
        
        /* เพิ่มเอฟเฟกต์ในการแสดง/ซ่อน */
        .animated {
            animation-duration: 0.3s;
            animation-fill-mode: both;
        }
        
        /* คำสั่ง keyframes สำหรับ bounceIn */
        @@keyframes bounceIn {
            from, 20%, 40%, 60%, a0% {
                animation-timing-function: cubic-bezier(0.215, 0.610, 0.355, 1.000);
            }
            0% {
                transform: scale3d(0.3, 0.3, 0.3);
            }
            20% {
                transform: scale3d(1.1, 1.1, 1.1);
            }
            40% {
                transform: scale3d(0.9, 0.9, 0.9);
            }
            60% {
                transform: scale3d(1.03, 1.03, 1.03);
            }
            80% {
                transform: scale3d(0.97, 0.97, 0.97);
            }
            to {
                transform: scale3d(1, 1, 1);
            }
        }
        
        .bounceIn {
            animation-name: bounceIn;
        }
        
        /* คำสั่ง keyframes สำหรับ fadeIn */
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        
        .fadeIn {
            animation-name: fadeIn;
        }
        
        /* ทำให้ backdrop ทึบแสดงมีสีเข้มขึ้น */
        .modal-backdrop.show {
            opacity: 0.7 !important;
            background-color: #1a2035 !important;
        }
        
        /* แก้ไขปัญหาเครื่องหมายถูกสีเขียวที่แสดงหลังการอัปเดต */
        svg.checkmark, 
        .swal2-success-circular-line-left, 
        .swal2-success-circular-line-right, 
        .swal2-success-fix, 
        .swal2-success-ring,
        .success-icon, 
        .check-icon {
            display: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
        }
        
        /* กำหนดให้ซ่อนเครื่องหมายถูกสีเขียว */
        .swal2-icon.swal2-success [class^="swal2-success-line"] {
            display: none !important;
        }
        
        /* ซ่อนวงกลมสีเขียวที่มักจะเป็นของ SweetAlert2 */
        .swal2-success-ring, .swal2-icon.swal2-success .swal2-success-ring {
            display: none !important;
        }
        
        /* Custom styles สำหรับ PDF Modal */
        #pdfViewerModal .modal-dialog {
            margin: 0;
            max-width: 100%;
            height: 100vh;
        }

        #pdfViewerModal .modal-content {
            height: 100vh;
            border-radius: 0;
        }

        #pdfViewerModal .modal-header {
            border-radius: 0;
            padding: 0.75rem 1rem;
        }

        #pdfViewerModal .modal-footer {
            padding: 0.5rem 1rem;
            border-top: 1px solid #dee2e6;
        }

        #pdfIframe {
            border: none;
            background: #f8f9fa;
        }

        /* Loading และ Error indicators */
        #pdfLoadingIndicator,
        #pdfErrorIndicator {
            background: #f8f9fa;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            #pdfViewerModal .modal-header .d-flex {
                flex-wrap: wrap;
                gap: 0.5rem;
            }
            
            #pdfViewerModal .modal-header .btn {
                padding: 0.25rem 0.5rem;
                font-size: 0.875rem;
            }
            
            #pdfViewerModal .modal-footer .d-flex {
                flex-direction: column;
                gap: 0.5rem;
            }
        }

        /* PDF Viewer enhancements */
        .pdf-controls {
            background: rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

        .loading-spinner {
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* เพิ่ม responsive สำหรับ mobile */
        @@media (max-width: 576px) {
            .pdf-fallback-content {
                padding: 1rem;
            }
            
            .pdf-fallback-content .btn {
                min-width: auto;
                width: 100%;
                margin-bottom: 0.5rem;
            }
            
            .pdf-fallback-content .d-flex {
                flex-direction: column;
            }
        }
    </style>
    
    <script>
        // ประกาศตัวแปร appBasePath
        var appBasePath = '@Url.Content("~/")';

        $(document).ready(function() {
            // ตั้งค่าสิทธิ์การใช้งาน
            const canEdit = @Json.Serialize(canEdit);
            const canDelete = @Json.Serialize(canDelete);
            
            // เก็บข้อมูลพนักงานไว้ใช้งาน
            let employeesData = [];
            
            // จัดการ Modal HTML Report
            const htmlReportModal = new bootstrap.Modal(document.getElementById('htmlReportModal'));
            
            // โหลดข้อมูลพนักงานครั้งเดียวตอนเริ่มต้น
            function loadEmployeesOnce() {
                $.ajax({
                    url: appBasePath + 'Cabinet/GetEmployees',
                    type: 'GET',
                    success: function(data) {
                        employeesData = data;
                        populateEmployeeSelect();
                    },
                    error: function(xhr) {
                        console.error('ไม่สามารถโหลดข้อมูลพนักงานได้:', xhr);
                    }
                });
            }
            
            // เติมข้อมูลพนักงานลงใน select
            function populateEmployeeSelect() {
                const select = $('#cabinetOwner');
                select.empty();
                select.append('<option value="">-- เลือกผู้ครอบครอง --</option>');
                
                $.each(employeesData, function(i, item) {
                    select.append(`<option value="${item.id}" data-employee-code="${item.id}">${item.fullName} (${item.id})</option>`);
                });
                
                select.trigger('change');
            }

            // =====  เปลี่ยนปุ่มรายงาน PDF เป็น HTML Report =====
            $('#btnShowReport').off('click').on('click', function() {
                showHTMLReport();
            });

            // ฟังก์ชันแสดงรายงาน HTML
            function showHTMLReport() {
                // แสดง loading
                Swal.fire({
                    title: 'กำลังโหลดรายงาน',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // เรียกใช้ API GetReportHtml
                $.ajax({
                    url: appBasePath + 'Cabinet/GetReportHtml',
                    type: 'GET',
                    success: function(response) {
                        Swal.close();
                        
                        if (response.success) {
                            // แสดงรายงาน HTML ใน modal
                            $('#htmlReportContent').html(response.htmlContent);
                            $('#htmlReportLastUpdate').text(response.generatedAt || new Date().toLocaleString('th-TH'));
                            $('#htmlReportTotalRecords').text(response.totalRecords || 0);
                            
                            // แสดง modal
                            htmlReportModal.show();
                            
                            // เพิ่ม tooltip สำหรับข้อมูลที่มี title attribute
                            $('[title]').tooltip();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: response.message || 'ไม่สามารถสร้างรายงานได้',
                                confirmButtonText: 'ตกลง'
                            });
                        }
                    },
                    error: function(xhr) {
                        Swal.close();
                        
                        let errorMessage = 'ไม่สามารถสร้างรายงานได้';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            errorMessage = errorResponse.message || errorMessage;
                        } catch (e) {
                            errorMessage = xhr.responseText || errorMessage;
                        }
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: errorMessage,
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            }

            // ปุ่มพิมพ์รายงาน HTML
            $(document).on('click', '#btnPrintHTMLReport', function() {
                // เปิดรายงานแบบเต็มหน้าใน tab ใหม่เพื่อพิมพ์
                const printWindow = window.open(appBasePath + 'Cabinet/GetFullPageReport?print=true', '_blank');
                
                // แสดงแจ้งเตือน
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true
                });
                
                Toast.fire({
                    icon: 'info',
                    title: 'กำลังเปิดหน้าพิมพ์...'
                });
            });

            // ปุ่มดาวน์โหลดรายงาน HTML
            $(document).on('click', '#btnDownloadHTMLReport', function() {
                downloadHTMLReport();
            });

            // ฟังก์ชันดาวน์โหลดรายงาน HTML
            function downloadHTMLReport() {
                // แสดง loading
                const btnHtml = $('#btnDownloadHTMLReport').html();
                $('#btnDownloadHTMLReport').html('<i class="fas fa-spinner fa-spin me-1"></i>กำลังสร้าง...').prop('disabled', true);
                
                $.ajax({
                    url: appBasePath + 'Cabinet/GetFullPageReport',
                    type: 'GET',
                    success: function(htmlContent) {
                        // สร้าง blob และดาวน์โหลด
                        const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.html`;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                        
                        // แสดงแจ้งเตือนสำเร็จ
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true
                        });
                        
                        Toast.fire({
                            icon: 'success',
                            title: 'ดาวน์โหลดรายงาน HTML สำเร็จ'
                        });
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถดาวน์โหลดรายงานได้',
                            confirmButtonText: 'ตกลง'
                        });
                    },
                    complete: function() {
                        // คืนค่าปุ่มเดิม
                        $('#btnDownloadHTMLReport').html(btnHtml).prop('disabled', false);
                    }
                });
            }

            // ปุ่มรีเฟรชรายงาน
            $(document).on('click', '#btnRefreshHTMLReport', function() {
                // แสดง loading ในปุ่ม
                const btnHtml = $(this).html();
                $(this).html('<i class="fas fa-spinner fa-spin"></i> กำลังรีเฟรช...').prop('disabled', true);
                
                // โหลดรายงานใหม่
                $.ajax({
                    url: appBasePath + 'Cabinet/GetReportHtml',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            // อัปเดตเนื้อหา
                            $('#htmlReportContent').html(response.htmlContent);
                            $('#htmlReportLastUpdate').text(response.generatedAt || new Date().toLocaleString('th-TH'));
                            $('#htmlReportTotalRecords').text(response.totalRecords || 0);
                            
                            // เพิ่ม tooltip ใหม่
                            $('[title]').tooltip();
                            
                            // แสดงแจ้งเตือนสำเร็จ
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 1500,
                                timerProgressBar: true
                            });
                            
                            Toast.fire({
                                icon: 'success',
                                title: 'รีเฟรชข้อมูลสำเร็จ'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'ไม่สามารถรีเฟรชข้อมูลได้',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถรีเฟรชข้อมูลได้',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    complete: function() {
                        // คืนค่าปุ่มเดิม
                        $('#btnRefreshHTMLReport').html(btnHtml).prop('disabled', false);
                    }
                });
            });

            // จัดการ Modal และ Focus
            function setupModal(modalId) {
                const modal = document.getElementById(modalId);
                const modalInstance = new bootstrap.Modal(modal);
                
                // เก็บ focus ไว้ใน Modal
                let previousActiveElement = null;
                
                modal.addEventListener('show.bs.modal', function() {
                    previousActiveElement = document.activeElement;
                    modal.removeAttribute('aria-hidden');
                    modal.setAttribute('aria-modal', 'true');
                });
                
                modal.addEventListener('shown.bs.modal', function() {
                    const focusableElements = modal.querySelectorAll(
                        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
                    );
                    if (focusableElements.length > 0) {
                        focusableElements[0].focus();
                    }
                });
                
                modal.addEventListener('hide.bs.modal', function() {
                    modal.setAttribute('aria-hidden', 'true');
                    modal.removeAttribute('aria-modal');
                });
                
                modal.addEventListener('hidden.bs.modal', function() {
                    if (previousActiveElement) {
                        previousActiveElement.focus();
                    }
                });
                
                // จัดการ focus เมื่อกด Tab
                modal.addEventListener('keydown', function(e) {
                    if (e.key === 'Tab') {
                        const focusableElements = modal.querySelectorAll(
                            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
                        );
                        const firstFocusable = focusableElements[0];
                        const lastFocusable = focusableElements[focusableElements.length - 1];
                        
                        if (e.shiftKey) {
                            if (document.activeElement === firstFocusable) {
                                e.preventDefault();
                                lastFocusable.focus();
                            }
                        } else {
                            if (document.activeElement === lastFocusable) {
                                e.preventDefault();
                                firstFocusable.focus();
                            }
                        }
                    }
                });
                
                // ป้องกันการคลิกนอก Modal
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modalInstance.hide();
                    }
                });
                
                return modalInstance;
            }
            
            // ตั้งค่า Modal ทั้งหมด
            const cabinetModal = setupModal('cabinetModal');
            const deleteModal = setupModal('deleteModal');
            const cabinetRangeModal = setupModal('cabinetRangeModal');
            const cabinetRangeResultModal = setupModal('cabinetRangeResultModal');

            // ตัวกรอง: แสดงเฉพาะเจ้าของลาออกแล้ว
            let showResignedOnly = false;
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                if (settings.nTable && settings.nTable.id === 'cabinetTable') {
                    if (!showResignedOnly) return true;
                    var api = new $.fn.dataTable.Api(settings);
                    var rowData = api.row(dataIndex).data();
                    if (!rowData) return true;
                    return rowData.IsResigned === true;
                }
                return true;
            });

            // DataTable
            const table = $('#cabinetTable').DataTable({
                ajax: {
                    url: appBasePath + 'Cabinet/GetAll',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    { 
                        data: 'No',
                        className: 'text-center'
                    },
                    { 
                        data: 'OwnerName', 
                        render: function(data, type, row) {
                            if (type === 'display') {
                                let html = '';
                                
                                if (data) {
                                    // มีชื่อพนักงาน
                                    if (row.IsResigned) {
                                        // พนักงานลาออกแล้ว - แสดงชื่อพร้อมป้ายลาออก
                                        html = `<div class="d-flex align-items-center gap-2">
                                                    <span>${data}</span>
                                                    <span class="badge bg-danger" data-bs-toggle="tooltip" title="วันที่ลาออก: ${row.ResignDate || 'ไม่ระบุ'}">ลาออกแล้ว</span>
                                                </div>`;
                                    } else {
                                        // พนักงานยังทำงานอยู่ - แสดงชื่อปกติ
                                        html = data;
                                    }
                                } else if (row.Owner) {
                                    // มีรหัสพนักงานแต่ไม่มีชื่อ
                                    html = `<span class="text-primary">${row.Owner}</span>`;
                                } else {
                                    // ไม่มีทั้งชื่อและรหัสพนักงาน
                                    html = '<span class="text-muted">-</span>';
                                }
                                
                                return html;
                            }
                            return data || row.Owner || '';
                        } 
                    },
                    { 
                        data: 'status', 
                        render: function(data, type, row) {
                            if (type === 'display') {
                                let statusText, statusClass, icon;
                                
                                switch(data) {
                                    case "0": 
                                        statusText = "ว่าง"; 
                                        statusClass = "bg-success";
                                        icon = "check-circle";
                                        break;
                                    case "1": 
                                        statusText = "มีผู้ใช้งาน"; 
                                        statusClass = "bg-primary";
                                        icon = "user-check";
                                        break;
                                    case "2": 
                                        statusText = "ชำรุด"; 
                                        statusClass = "bg-danger";
                                        icon = "exclamation-circle";
                                        break;
                                    default: 
                                        statusText = "ไม่ระบุ"; 
                                        statusClass = "bg-secondary";
                                        icon = "question-circle";
                                }
                                
                                if (!canEdit) {
                                    return `<span class="badge ${statusClass}"><i class="fas fa-${icon} me-1"></i>${statusText}</span>`;
                                }
                                
                                // สร้าง Switch Toggle
                                const isActive = data === "1"; // เช็คว่าสถานะเป็น "มีผู้ใช้งาน" หรือไม่
                                
                                return `
                                <div class="d-flex align-items-center gap-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input status-switch" type="checkbox" role="switch" 
                                            id="statusSwitch${row.Id}" 
                                            data-id="${row.Id}" 
                                            data-current="${data}"
                                            ${isActive ? 'checked' : ''}>
                                    </div>
                                    <span class="badge ${statusClass}"><i class="fas fa-${icon} me-1"></i>${statusText}</span>
                                </div>`;
                            }
                            
                            return data;
                        } 
                    },
                    { data: 'updated_at', render: function(data) { return data || '<span class="text-muted">-</span>'; } },
                    { data: 'updated_by', render: function(data) { return data || '<span class="text-muted">-</span>'; } },
                    {
                        data: null,
                        render: function(data) {
                            let actions = '';
                            if (canEdit) {
                                actions += `<button class="btn btn-warning btn-sm me-1 btn-edit" data-id="${data.Id}" data-bs-toggle="tooltip" title="แก้ไข"><i class="fas fa-edit"></i></button>`;
                            }
                            if (canDelete) {
                                actions += `<button class="btn btn-danger btn-sm btn-delete" data-id="${data.Id}" data-no="${data.No}" data-bs-toggle="tooltip" title="ลบ"><i class="fas fa-trash-alt"></i></button>`;
                            }
                            return actions || '<span class="text-muted">ไม่มีสิทธิ์</span>';
                        },
                        orderable: false
                    }
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Thai.json"
                }, 
                responsive: true,
                order: [[0, 'asc']],
                pageLength: 25,
                dom: '<"d-flex justify-content-between align-items-center mb-3"<"d-flex align-items-center"l><"d-flex"f>>t<"d-flex justify-content-between align-items-center mt-3"<"d-flex align-items-center"i><"d-flex"p>>',
                initComplete: function() {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                    $('.dataTables_length select').addClass('form-select form-select-sm');
                    $('.dataTables_filter input').addClass('form-control form-control-sm');
                    $('.dataTables_filter input').attr('placeholder', 'ค้นหา...');
                    $('.dataTables_filter label').addClass('d-flex align-items-center gap-2');
                    $('.dataTables_filter label').html(`<i class="fas fa-search"></i>${$('.dataTables_filter label').html()}`);

                    // เพิ่มสวิตช์กรองเฉพาะเจ้าของลาออกแล้ว
                    const $filterContainer = $('<div class="ms-3"></div>');
                    $filterContainer.html(`
                        <div class="form-check form-switch ms-2">
                            <input class="form-check-input" type="checkbox" id="filterResignedOnly">
                            <label class="form-check-label" for="filterResignedOnly">
                                <i class="fas fa-user-minus me-1"></i>เฉพาะเจ้าของลาออกแล้ว
                            </label>
                        </div>
                    `);
                    $('.dataTables_filter').append($filterContainer);
                    $('#filterResignedOnly').on('change', function() {
                        showResignedOnly = this.checked;
                        table.draw();
                    });
                }
            });

            // ปุ่มคืนตู้ทั้งหมดของเจ้าของที่ลาออกแล้ว
            $(document).on('click', '#btnReleaseResignedOwners', function() {
                Swal.fire({
                    title: 'ยืนยันการคืนตู้',
                    html: '<div class="text-start">ระบบจะคืนตู้ทั้งหมดที่มีผู้ครอบครองซึ่งลาออกแล้ว และเปลี่ยนสถานะเป็น "ว่าง"<br/>ต้องการดำเนินการต่อหรือไม่?</div>',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ยืนยัน',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    Swal.fire({
                        title: 'กำลังดำเนินการ',
                        text: 'โปรดรอ...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: appBasePath + 'api/Cabinet/ReleaseResignedOwners',
                        type: 'POST',
                        success: function(resp) {
                            Swal.close();
                            const affected = resp && resp.affected !== undefined ? resp.affected : (resp?.Affected || 0);
                            Swal.fire({
                                icon: 'success',
                                title: 'เสร็จสิ้น',
                                text: `คืนตู้สำเร็จ ${affected} รายการ`,
                                confirmButtonText: 'ตกลง'
                            });
                            table.ajax.reload(null, false);
                        },
                        error: function(xhr) {
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: xhr.responseText || 'ไม่สามารถดำเนินการได้'
                            });
                        }
                    });
                });
            });

            // เปิด Modal เพิ่มข้อมูล
            $('#btnAddCabinet').click(function() {
                // รอให้ข้อมูลพนักงานโหลดเสร็จก่อน
                function waitForEmployeesData(callback) {
                    if (employeesData.length > 0) {
                        callback();
                    } else {
                        setTimeout(() => waitForEmployeesData(callback), 100);
                    }
                }
                
                waitForEmployeesData(function() {
                    $('#cabinetForm')[0].reset();
                    $('#cabinetId').val('');
                    $('#cabinetModalLabel').html('<i class="fas fa-plus-circle me-2"></i>เพิ่มตู้เก็บของพนักงาน');
                    populateEmployeeSelect();
                    cabinetModal.show();
                });
            });

            // เปิด Modal เพิ่มตู้แบบช่วง
            $('#btnAddCabinetRange').click(function() {
                $('#cabinetRangeForm')[0].reset();
                cabinetRangeModal.show();
            });

            // บันทึกการเพิ่มตู้แบบช่วง
            $('#btnSaveCabinetRange').click(function() {
                if (!$('#cabinetRangeForm')[0].checkValidity()) {
                    $('#cabinetRangeForm')[0].reportValidity();
                    return;
                }
                
                const jsonData = {
                    Range: $('#cabinetRange').val()
                };
                
                Swal.fire({
                    title: 'กำลังดำเนินการ',
                    text: 'กำลังเพิ่มตู้เก็บของแบบช่วง...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                $.ajax({
                    url: appBasePath + 'api/Cabinet/BatchCreate',
                    type: 'POST',
                    data: JSON.stringify(jsonData),
                    contentType: 'application/json',
                    success: function(result) {
                        Swal.close();
                        table.ajax.reload();
                        cabinetRangeModal.hide();
                        
                        // แสดงผลลัพธ์
                        let resultContent = `
                            <div class="mb-4">
                                <h5>สรุปผลการดำเนินการ</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <tr>
                                            <th class="bg-light">ช่วงที่ระบุ</th>
                                            <td>${result.Range}</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">จำนวนตู้ทั้งหมดที่ต้องการเพิ่ม</th>
                                            <td>${result.TotalRequested}</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">จำนวนตู้ที่เพิ่มสำเร็จ</th>
                                            <td><span class="text-success">${result.TotalCreated}</span></td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">จำนวนตู้ที่ข้าม (มีอยู่แล้ว)</th>
                                            <td><span class="text-warning">${result.TotalSkipped}</span></td>
                                        </tr>
                                        <tr>
