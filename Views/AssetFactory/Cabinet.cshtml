            });
            
            // เปิดรายงานใน tab ใหม่ (แบบเต็มหน้า)
            $('#btnPrintReport').click(function() {
                // แสดง loading
                Swal.fire({
                    title: 'กำลังสร้างรายงาน',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // เรียกใช้ API เพื่อสร้างรายงานแบบเต็มหน้า
                $.ajax({
                    url: appBasePath + 'Cabinet/GetAll',
                    type: 'GET',
                    success: function(data) {
                        Swal.close();
                        
                        // สร้าง HTML สำหรับรายงานแบบเต็มหน้า
                        const reportWindow = window.open('', '_blank');
                        reportWindow.document.write(generateFullPageReport(data));
                        reportWindow.document.close();
                        
                        // รอให้หน้าโหลดเสร็จแล้วเรียกใช้ print
                        reportWindow.onload = function() {
                            setTimeout(() => {
                                reportWindow.print();
                            }, 500);
                        };
                    },
                    error: function(xhr) {
                        Swal.close();
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถสร้างรายงานได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            });
            
            // ดาวน์โหลด PDF
            $('#btnExportPDF').click(function() {
                // แสดง loading
                Swal.fire({
                    title: 'กำลังสร้าง PDF',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // เรียกใช้ API เพื่อสร้าง PDF
                fetch(appBasePath + 'Cabinet/ExportPDF', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/pdf, application/json'
                    }
                })
                .then(response => {
                    Swal.close();
                    
                    // ตรวจสอบ Content-Type
                    const contentType = response.headers.get('content-type');
                    
                    if (contentType && contentType.includes('application/pdf')) {
                        // กรณีได้ไฟล์ PDF
                        return response.blob().then(blob => {
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.pdf`;
                            document.body.appendChild(a);
                            a.click();
                            window.URL.revokeObjectURL(url);
                            document.body.removeChild(a);
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'ดาวน์โหลดสำเร็จ',
                                text: 'ไฟล์ PDF ถูกดาวน์โหลดแล้ว',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        });
                    } else {
                        // กรณีได้ response แบบ JSON (error หรือ fallback)
                        return response.json().then(data => {
                            if (data.success === false) {
                                // แสดงข้อความแจ้งเตือน
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'ไม่สามารถสร้าง PDF ได้',
                                    text: data.message || 'กรุณาตรวจสอบการตั้งค่า DinkToPdf',
                                    showCancelButton: true,
                                    confirmButtonText: 'ดาวน์โหลด HTML แทน',
                                    cancelButtonText: 'ยกเลิก'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // ดาวน์โหลดเป็น HTML แทน
                                        downloadAsHTML();
                                    }
                                });
                            } else {
                                throw new Error(data.message || 'เกิดข้อผิดพลาดไม่ทราบสาเหตุ');
                            }
                        });
                    }
                })
                .catch(error => {
                    Swal.close();
                    console.error('Export PDF Error:', error);
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'ไม่สามารถสร้างไฟล์ PDF ได้',
                        showCancelButton: true,
                        confirmButtonText: 'ลองดาวน์โหลด HTML',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            downloadAsHTML();
                        }
                    });
                });
            });
            
            // ฟังก์ชันดาวน์โหลดเป็น HTML
            function downloadAsHTML() {
                $.ajax({
                    url: appBasePath + 'Cabinet/GetAll',
                    type: 'GET',
                    success: function(data) {
                        const htmlContent = generateFullPageReport(data);
                        const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.html`;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'ดาวน์โหลดสำเร็จ',
                            text: 'ไฟล์ HTML ถูกดาวน์โหลดแล้ว',
                            showConfirmButton: false,
                            timer: 2000
                        });
                    },
                    error: function(xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถสร้างไฟล์ HTML ได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            }

            // ฟังก์ชันสร้างรายงานแบบเต็มหน้า
            function generateFullPageReport(data) {
                // คำนวณสถิติ
                const stats = calculateStats(data);
                
                const htmlContent = `
            <!DOCTYPE html>
            <html lang="th">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>รายงานข้อมูลตู้เก็บของพนักงาน</title>
                <!-- Bootstrap, Font Awesome, และ Sarabun font ถูกโหลดใน Layout แล้ว -->
<style>
                    
                    body {
                        font-family: 'Sarabun', sans-serif;
                        font-size: 14px;
                        line-height: 1.6;
                    }
                    
                    .report-header {
                        background: linear-gradient(135deg, #007bff, #0056b3);
                        color: white;
                        padding: 2rem;
                        margin-bottom: 2rem;
                        border-radius: 15px;
                    }
                    
                    .stats-card {
                        border: none;
                        border-radius: 10px;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                    }
                    
                    .table {
                        font-size: 13px;
                    }
                    
                    .badge {
                        font-size: 11px;
                        padding: 6px 10px;
                        border-radius: 20px;
                    }
                    
                    @@media print {
                        body { print-color-adjust: exact; }
                        .no-print { display: none !important; }
                    }
                </style>
            </head>
            <body>
                <div class="container-fluid p-4">
                    <div class="report-header text-center">
                        <h1><i class="fas fa-box me-3"></i>รายงานข้อมูลตู้เก็บของพนักงาน</h1>
                        <div class="fs-6 opacity-75">Employee Cabinet Management Report</div>
                        <div class="fs-6 opacity-75">สร้างเมื่อ: ${new Date().toLocaleString('th-TH')}</div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-light">
                                    <h3 class="text-secondary mb-1">${stats.total}</h3>
                                    <small class="text-muted">ตู้ทั้งหมด</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-success text-white">
                                    <h3 class="mb-1">${stats.available}</h3>
                                    <small>ตู้ว่าง</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-primary text-white">
                                    <h3 class="mb-1">${stats.occupied}</h3>
                                    <small>มีผู้ใช้งาน</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-danger text-white">
                                    <h3 class="mb-1">${stats.damaged}</h3>
                                    <small>ชำรุด</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-warning text-white">
                                    <h3 class="mb-1">${stats.resigned}</h3>
                                    <small>เจ้าของลาออก</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card stats-card">
                                <div class="card-body text-center bg-info text-white">
                                    <h3 class="mb-1">-</h3>
                                    <small>พนักงานไม่มีตู้</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>รายละเอียดตู้เก็บของ (${data.length} รายการ)</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th class="text-center" style="width: 60px;">#</th>
                                            <th class="text-center" style="width: 100px;">เลขที่ตู้</th>
                                            <th>ผู้ครอบครอง</th>
                                            <th class="text-center" style="width: 130px;">สถานะ</th>
                                            <th class="text-center" style="width: 160px;">อัพเดทล่าสุด</th>
                                            <th class="text-center" style="width: 120px;">อัพเดทโดย</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${generateTableRows(data)}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center text-muted">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            รายงานนี้สร้างอัตโนมัติจากระบบจัดการตู้เก็บของพนักงาน
                        </small>
                    </div>
                </div>`;

                return htmlContent;
            }

            // ฟังก์ชันคำนวณสถิติ
            function calculateStats(data) {
                const total = data.length;
                const available = data.filter(item => item.status === "0").length;
                const occupied = data.filter(item => item.status === "1").length;
                const damaged = data.filter(item => item.status === "2").length;
                const resigned = data.filter(item => item.IsResigned === true).length;
                
                return { total, available, occupied, damaged, resigned };
            }

            // ฟังก์ชันสร้างแถวตาราง
            function generateTableRows(data) {
                return data.map((cabinet, index) => {
                    let statusText, statusClass, icon;
                    switch (cabinet.status) {
                        case "0":
                            statusText = "ว่าง";
                            statusClass = "bg-success";
                            icon = "check-circle";
                            break;
                        case "1":
                            statusText = "มีผู้ใช้งาน";
                            statusClass = "bg-primary";
                            icon = "user-check";
                            break;
                        case "2":
                            statusText = "ชำรุด";
                            statusClass = "bg-danger";
                            icon = "exclamation-circle";
                            break;
                        default:
                            statusText = "ไม่ระบุ";
                            statusClass = "bg-secondary";
                            icon = "question-circle";
                    }

                    let ownerDisplay = '<span class="text-muted">-</span>';
                    if (cabinet.OwnerName) {
                        ownerDisplay = cabinet.OwnerName;
                        if (cabinet.IsResigned) {
                            ownerDisplay += ' <span class="badge bg-danger ms-1">ลาออกแล้ว</span>';
                        }
                    } else if (cabinet.Owner) {
                        ownerDisplay = `<span class="text-primary">${cabinet.Owner}</span>`;
                    }

                    return `
                        <tr>
                            <td class="text-center">${index + 1}</td>
                            <td class="text-center fw-bold">${cabinet.No}</td>
                            <td>${ownerDisplay}</td>
                            <td class="text-center">
                                <span class="badge ${statusClass}">
                                    <i class="fas fa-${icon} me-1"></i>${statusText}
                                </span>
                            </td>
                            <td class="text-center">${cabinet.updated_at || '-'}</td>
                            <td class="text-center">${cabinet.updated_by || '-'}</td>
                        </tr>`;
                }).join('');
            }

            // รีเฟรชรายงาน
            $('#btnRefreshReport').click(function() {
                // แสดง loading ในปุ่ม
                const btnHtml = $(this).html();
                $(this).html('<i class="fas fa-spinner fa-spin"></i> กำลังรีเฟรช...');
                $(this).prop('disabled', true);
                
                // เรียกใช้ API GetReportHtml เพื่อดึงเนื้อหา HTML โดยตรง
                $.ajax({
                    url: appBasePath + 'Cabinet/GetReportHtml',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            // แสดงเนื้อหา HTML โดยตรงใน modal
                            $('#reportContent').html(response.htmlContent);
                            
                            // ปรับแต่ง CSS ให้รายงานแสดงผลได้อย่างเหมาะสม
                            $('#reportContent').css({
                                'max-height': '70vh',
                                'overflow-y': 'auto',
                                'padding': '15px'
                            });
                            
                            // อัพเดทเวลาล่าสุด
                            $('#reportLastUpdate').text(new Date().toLocaleString('th-TH'));
                            
                            // เพิ่ม tooltip สำหรับข้อมูลที่มี title attribute
                            $('[title]').tooltip();
                            
                            // แสดงแจ้งเตือนเล็กๆ ด้วย SweetAlert2
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 1500,
                                timerProgressBar: true
                            });
                            
                            Toast.fire({
                                icon: 'success',
                                title: 'รีเฟรชข้อมูลสำเร็จ'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'ไม่สามารถรีเฟรชข้อมูลได้',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function(xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถรีเฟรชข้อมูลได้',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    complete: () => {
                        // คืนค่าปุ่มเดิม
                        $(this).html(btnHtml);
                        $(this).prop('disabled', false);
                    }
                });
            });

            // ตัวแปรสำหรับจัดการ PDF
            let pdfBlobUrl = null;
            let isGeneratingPDF = false;

            // ตรวจสอบสถานะ PDF service เมื่อโหลดหน้า
            checkPDFServiceStatus();

            // ฟังก์ชันตรวจสอบสถานะ PDF service
            function checkPDFServiceStatus() {
                $.ajax({
                    url: appBasePath + 'Cabinet/CheckPDFStatus',
                    type: 'GET',
                    timeout: 5000,
                    success: function(response) {
                        if (response.success) {
                            console.log('PDF Service Status:', response.message);
                            
                            // อัปเดต UI ตามสถานะ service
                            if (!response.pdfServiceAvailable) {
                                // แสดงแจ้งเตือนว่า PDF service ไม่พร้อม
                                $('#btnShowReport').attr('title', 'PDF service ไม่พร้อมใช้งาน - จะใช้ HTML แทน');
                                $('#btnShowReport').addClass('btn-warning').removeClass('btn-secondary');
                            } else {
                                $('#btnShowReport').attr('title', 'แสดงรายงาน PDF');
                                $('#btnShowReport').addClass('btn-secondary').removeClass('btn-warning');
                            }
                        }
                    },
                    error: function() {
                        console.warn('ไม่สามารถตรวจสอบสถานะ PDF service ได้');
                    }
                });
            }

            // ปรับปรุงฟังก์ชันสร้างและแสดง PDF
            function generatePDFAndShow() {
                if (isGeneratingPDF) {
                    console.log('PDF กำลังสร้างอยู่แล้ว');
                    return;
                }

                isGeneratingPDF = true;
                $('#pdfStatus').text('กำลังสร้างรายงาน PDF...');

                // ล้าง blob URL เก่า
                if (pdfBlobUrl) {
                    URL.revokeObjectURL(pdfBlobUrl);
                    pdfBlobUrl = null;
                } 

                // สร้าง timestamp เพื่อป้องกัน cache
                const timestamp = Date.now();
                const pdfUrl = `/Cabinet/ExportPDFWithiText?timestamp=${timestamp}`;

                // ใช้ fetch เพื่อดึงข้อมูล PDF
                fetch(pdfUrl, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/pdf, application/json',
                        'Cache-Control': 'no-cache',
                        'Pragma': 'no-cache'
                    },
                    credentials: 'same-origin'
                })
                .then(response => {
                    const contentType = response.headers.get('content-type');
                    
                    if (response.ok && contentType && contentType.includes('application/pdf')) {
                        // สำเร็จ - ได้ PDF
                        return response.blob().then(blob => {
                            // สร้าง blob URL
                            pdfBlobUrl = URL.createObjectURL(blob);
                            currentPdfUrl = pdfBlobUrl;
                            showPDFContent(pdfBlobUrl);
                            
                            $('#pdfStatus').text(`แสดง PDF สำเร็จ - ขนาดไฟล์: ${formatFileSize(blob.size)}`);
                        });
                    } else if (response.ok && contentType && contentType.includes('application/json')) {
                        // ได้ JSON response (error หรือ fallback info)
                        return response.json().then(data => {
                            console.log('PDF Service Response:', data);
                            
                            if (data.success === false) {
                                if (data.fallbackAvailable) {
                                    // แสดงตัวเลือกให้ผู้ใช้
                                    showPDFServiceUnavailable(data.message);
                                } else {
                                    showPDFError(data.message);
                                }
                            } else {
                                showPDFError('ได้รับข้อมูลไม่ถูกต้อง');
                            }
                        });
                    } else {
                        // HTTP error
                        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                    }
                })
                .catch(error => {
                    console.error('PDF Generation Error:', error);
                    showPDFError(`เกิดข้อผิดพลาด: ${error.message}`);
                })
                .finally(() => {
                    isGeneratingPDF = false;
                });
            }

            // ฟังก์ชันแสดงข้อความเมื่อ PDF service ไม่พร้อม
            function showPDFServiceUnavailable(message) {
                $('#pdfLoadingIndicator').addClass('d-none');
                $('#pdfIframe').addClass('d-none');
                
                const fallbackContent = `
                    <div class="d-flex justify-content-center align-items-center h-100">
                        <div class="text-center">
                            <i class="fas fa-info-circle text-info mb-3" style="font-size: 4rem;"></i>
                            <h5 class="text-muted mb-3">PDF Service ไม่พร้อมใช้งาน</h5>
                            <p class="text-muted mb-4">${message}</p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <button type="button" class="btn btn-primary" id="btnShowHTMLReport">
                                    <i class="fas fa-file-code me-1"></i>แสดงรายงาน HTML
                                </button>
                                <button type="button" class="btn btn-success" id="btnDownloadHTMLFallback">
                                    <i class="fas fa-download me-1"></i>ดาวน์โหลด HTML
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnRetryPDFService">
                                    <i class="fas fa-redo me-1"></i>ลองอีกครั้ง
                                </button>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    คุณยังสามารถดูรายงานในรูปแบบ HTML ได้
                                </small>
                            </div>
                        </div>
                    </div>`;
                
                $('#pdfErrorIndicator').html(fallbackContent).removeClass('d-none');
                $('#pdfStatus').text('PDF Service ไม่พร้อมใช้งาน');

                // เพิ่ม event listeners สำหรับปุ่มใน fallback content
                setupFallbackEventListeners();
            }

            // ตั้งค่า event listeners สำหรับ fallback options
            function setupFallbackEventListeners() {
                // แสดงรายงาน HTML ใน modal
                $(document).on('click', '#btnShowHTMLReport', function() {
                    $('#pdfViewerModal').modal('hide');
                    
                    // เรียกใช้ modal รายงาน HTML เดิม
                    setTimeout(() => {
                        $('#btnShowReport').data('force-html', true);
                        showHTMLReportInModal();
                    }, 500);
                });

                // ดาวน์โหลด HTML
                $(document).on('click', '#btnDownloadHTMLFallback', function() {
                    downloadAsHTML();
                });

                // ลองสร้าง PDF อีกครั้ง
                $(document).on('click', '#btnRetryPDFService', function() {
                    showPDFLoading();
                    setTimeout(generatePDFAndShow, 1000);
                });
            }

            // ฟังก์ชันแสดงรายงาน HTML ใน modal
            function showHTMLReportInModal() {
                $.ajax({
                    url: appBasePath + 'Cabinet/GetReportHtml',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            // สร้าง modal ใหม่สำหรับ HTML
                            const htmlModal = `
                                <div class="modal fade" id="htmlReportModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-xl">
                                        <div class="modal-content">
                                            <div class="modal-header bg-info text-white">
                                                <h5 class="modal-title">
                                                    <i class="fas fa-file-code me-2"></i>รายงานข้อมูลตู้เก็บของพนักงาน (HTML)
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-3" style="max-height: 70vh; overflow-y: auto;">
                                                ${response.htmlContent}
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-primary" onclick="window.print()">
                                                    <i class="fas fa-print me-1"></i>พิมพ์
                                                </button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="fas fa-times me-1"></i>ปิด
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>`;
                            
                            // เพิ่ม modal เข้าไปใน DOM ถ้ายังไม่มี
                            if (!document.getElementById('htmlReportModal')) {
                                $('body').append(htmlModal);
                            }
                            
                            // แสดง modal
                            $('#htmlReportModal').modal('show');
                            
                            // ลบ modal เมื่อปิด
                            $('#htmlReportModal').on('hidden.bs.modal', function() {
                                $(this).remove();
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถสร้างรายงาน HTML ได้'
                        });
                    }
                });
            }

            // ฟังก์ชันแปลงขนาดไฟล์
            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }

            // ปรับปรุง event handler สำหรับปุ่มดาวน์โหลด PDF
            $('#btnDownloadPDF').off('click').on('click', function() {
                if (pdfBlobUrl) {
                    // ใช้ blob URL สำหรับดาวน์โหลด
                    const link = document.createElement('a');
                    link.href = pdfBlobUrl;
                    link.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.pdf`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    
                    showDownloadToast('เริ่มดาวน์โหลด PDF แล้ว', 'success');
                } else if (currentPdfUrl && !currentPdfUrl.startsWith('blob:')) {
                    // ใช้ URL ปกติ
                    window.open(currentPdfUrl, '_blank');
                } else {
                    // สร้าง PDF ใหม่สำหรับดาวน์โหลด
                    fetch(appBasePath + 'Cabinet/DownloadPDF', {
                        method: 'GET',
                        headers: { 'Accept': 'application/pdf' }
                    })
                    .then(response => {
                        if (response.ok) {
                            return response.blob();
                        }
                        throw new Error('ไม่สามารถดาวน์โหลด PDF ได้');
                    })
                    .then(blob => {
                        const url = URL.createObjectURL(blob);
                        const link = document.createElement('a');
                        link.href = url;
                        link.download = `cabinet_report_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.pdf`;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);
                        
                        showDownloadToast('ดาวน์โหลด PDF สำเร็จ', 'success');
                    })
                    .catch(error => {
                        console.error('Download error:', error);
                        showDownloadToast('ไม่สามารถดาวน์โหลด PDF ได้', 'error');
                    });
                }
            });

            // ฟังก์ชันแสดงแจ้งเตือนการดาวน์โหลด
            function showDownloadToast(message, type = 'info') {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                
                Toast.fire({
                    icon: type,
                    title: message
                });
            }

            // จัดการเมื่อ PDF Modal ปิด
            $('#pdfViewerModal').on('hidden.bs.modal', function() {
                // ล้าง blob URL
                if (pdfBlobUrl) {
                    URL.revokeObjectURL(pdfBlobUrl);
                    pdfBlobUrl = null;
                }
                
                // รีเซ็ต state
                currentPdfUrl = null;
                isGeneratingPDF = false;
                
                // ล้าง iframe
                const iframe = document.getElementById('pdfIframe');
                if (iframe) {
                    iframe.src = '';
                }
                
                // รีเซ็ต UI
                $('#pdfLoadingIndicator').removeClass('d-none');
                $('#pdfErrorIndicator').addClass('d-none').html(getOriginalErrorContent());
                $('#pdfIframe').addClass('d-none');
                $('#pdfStatus').text('กำลังเตรียมข้อมูล...');
            });

            // ฟังก์ชันรีเซ็ต error content เป็นค่าเดิม
            function getOriginalErrorContent() {
                return `
                    <div class="text-center">
                        <i class="fas fa-exclamation-triangle text-warning fa-4x mb-3"></i>
                        <h5 class="text-muted">ไม่สามารถแสดง PDF ได้</h5>
                        <p class="text-muted mb-4" id="pdfErrorMessage">เกิดข้อผิดพลาดในการสร้างไฟล์ PDF</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary" id="btnRetryPDF">
                                <i class="fas fa-redo me-1"></i>ลองอีกครั้ง
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnDownloadHTML">
                                <i class="fas fa-file-code me-1"></i>ดาวน์โหลด HTML
                            </button>
                        </div>
                    </div>`;
            }

            // เพิ่มการตรวจสอบ memory usage
            function checkMemoryUsage() {
                if (performance.memory) {
                    const used = Math.round(performance.memory.usedJSHeapSize / 1048576);
                    const total = Math.round(performance.memory.totalJSHeapSize / 1048576);
                    console.log(`Memory usage: ${used}MB / ${total}MB`);
                    
                    // ถ้าใช้ memory มากเกินไป ให้ล้าง blob URLs
                    if (used > 100 && pdfBlobUrl) {
                        URL.revokeObjectURL(pdfBlobUrl);
                        pdfBlobUrl = null;
                        console.log('Cleaned up PDF blob URL due to high memory usage');
                    }
                }
            }

            // ตรวจสอบ memory ทุก 30 วินาที
            setInterval(checkMemoryUsage, 30000);
        });
    </script>

    <!-- เพิ่ม CSS เพิ่มเติมสำหรับ UI improvements -->
    <style>
        .pdf-service-warning {
            background: linear-gradient(45deg, #ffc107, #fd7e14);
            color: white;
            border: none;
        }
        
        .pdf-service-warning:hover {
            background: linear-gradient(45deg, #e0a800, #dc6502);
            color: white;
        }
        
        .pdf-fallback-content {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            border-radius: 10px;
            padding: 2rem;
        }
        
        .pdf-fallback-content .btn {
            min-width: 140px;
        }
        
        .pdf-loading-spinner {
            animation: spin 2s linear infinite;
        }
        
        .pdf-status-bar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(5px);
        }
        
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* เพิ่ม responsive สำหรับ mobile */
        @@media (max-width: 576px) {
            .pdf-fallback-content {
                padding: 1rem;
            }
            
            .pdf-fallback-content .btn {
                min-width: auto;
                width: 100%;
                margin-bottom: 0.5rem;
            }
            
            .pdf-fallback-content .d-flex {
                flex-direction: column;
            }
        }
    </style>
}
