            $('#cabinetModal').on('shown.bs.modal', function() {
                initSelect2();
            });

            // จัดการ Modal รายงาน
            const reportModal = setupModal('reportModal');
            let reportTable;

            // ตัวแปรสำหรับเก็บ URL ของ PDF
            let currentPdfUrl = null;
            let pdfModal = null;
            
            // Initialize PDF Modal
            const pdfModalElement = document.getElementById('pdfViewerModal');
            if (pdfModalElement) {
                pdfModal = new bootstrap.Modal(pdfModalElement);
            }
            
            // ฟังก์ชันแสดง PDF ใน Modal
            function showPDFInModal() {
                if (!pdfModal) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเปิด Modal ได้',
                        confirmButtonText: 'ตกลง'
                    });
                    return;
                }
                
                // แสดง Modal และ loading
                pdfModal.show();
                showPDFLoading();
                
                // สร้างและเรียกใช้ API
                generatePDFAndShow();
            }
            
            // ฟังก์ชันแสดง loading
            function showPDFLoading() {
                $('#pdfLoadingIndicator').removeClass('d-none');
                $('#pdfErrorIndicator').addClass('d-none');
                $('#pdfIframe').addClass('d-none');
                $('#pdfStatus').text('กำลังสร้างรายงาน PDF...');
            }
            
            // ฟังก์ชันแสดง error
            function showPDFError(message) {
                $('#pdfLoadingIndicator').addClass('d-none');
                $('#pdfErrorIndicator').removeClass('d-none');
                $('#pdfIframe').addClass('d-none');
                $('#pdfErrorMessage').text(message || 'เกิดข้อผิดพลาดในการสร้างไฟล์ PDF');
                $('#pdfStatus').text('เกิดข้อผิดพลาด');
            }
            
            // ฟังก์ชันแสดง PDF
            function showPDFContent(url) {
                $('#pdfLoadingIndicator').addClass('d-none');
                $('#pdfErrorIndicator').addClass('d-none');
                $('#pdfIframe').removeClass('d-none');
                
                // ตั้งค่า iframe
                const iframe = document.getElementById('pdfIframe');
                iframe.src = url;
                currentPdfUrl = url;
                
                $('#pdfStatus').text('แสดง PDF สำเร็จ');
                
                // จัดการ iframe load event
                iframe.onload = function() {
                    $('#pdfStatus').text(`แสดง PDF สำเร็จ - ${new Date().toLocaleString('th-TH')}`);
                };
                
                iframe.onerror = function() {
                    showPDFError('ไม่สามารถโหลด PDF ได้');
                };
            }
            
            // ฟังก์ชันสร้างและแสดง PDF
            function generatePDFAndShow() {
                // สร้าง URL สำหรับ PDF พร้อม timestamp เพื่อป้องกัน cache
                const pdfUrl = `/Cabinet/ExportPDF?timestamp=${Date.now()}`;
                
                // ตรวจสอบว่า PDF สร้างได้หรือไม่
                fetch(pdfUrl, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/pdf, application/json'
                    }
                })
                .then(response => {
                    const contentType = response.headers.get('content-type');
                    
                    if (response.ok && contentType && contentType.includes('application/pdf')) {
                        // สำเร็จ - แสดง PDF
                        showPDFContent(pdfUrl);
                    } else if (response.ok && contentType && contentType.includes('application/json')) {
                        // ได้ JSON response (อาจเป็น error หรือ fallback)
                        return response.json().then(data => {
                            if (data.success === false) {
                                showPDFError(data.message || 'ไม่สามารถสร้าง PDF ได้');
                            } else {
                                showPDFError('ได้รับข้อมูลไม่ถูกต้อง');
                            }
                        });
                    } else {
                        // HTTP error
                        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                    }
                })
                .catch(error => {
                    console.error('PDF Generation Error:', error);
                    showPDFError(`เกิดข้อผิดพลาด: ${error.message}`);
                });
            }

            // เปิด Modal รายงาน
            $('#btnShowReport').off('click').on('click', function() {
                showPDFInModal();
            });
            
            // ปุ่มดาวน์โหลด PDF ใน Modal
            $('#btnDownloadPDF').on('click', function() {
                if (currentPdfUrl) {
                    const link = document.createElement('a');
