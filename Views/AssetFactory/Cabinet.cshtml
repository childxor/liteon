                        }
                        
                        if (result.TotalSkipped > 0) {
                            resultContent += `
                                <div class="mb-3">
                                    <h6 class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>รายการตู้ที่ข้าม (มีอยู่แล้ว) (${result.TotalSkipped} รายการ)</h6>
                                    <div class="bg-light p-2 rounded mb-2" style="max-height: 100px; overflow-y: auto;">
                                        ${result.SkippedCabinets.join(', ')}
                                    </div>
                                </div>
