                                    // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                    loadShiftHistoryData(personId.split('-')[0]);
                                    
                                    // รีโหลดตารางหลัก
                                    dataTable.ajax.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message
                                });
                            }
