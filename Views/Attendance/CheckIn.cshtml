            </div>
            <div class="modal-body">
                <form id="addOTForm" class="needs-validation" novalidate>
                    <input type="hidden" id="otPersonId" name="personId">
                    <input type="hidden" id="shift_group" name="shift_group">
                    
                    <!-- ข้อมูลพนักงาน -->
                    <div class="card border-0 shadow-sm mb-4 bg-light">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
