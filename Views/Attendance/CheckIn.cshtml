                                const currentValue = $('#otStartWorkDate').val();
                                if (currentValue) {
                                    const momentDate = moment(currentValue, 'YYYY-MM-DD');
                                    if (momentDate.isValid()) {
                                        instance.setDate(momentDate.toDate(), false);
                                    }
                                }
                            }
                        });

                        // ตั้งค่า Flatpickr สำหรับวันที่สิ้นสุด (หลายวัน)
                        const endDatePicker = flatpickr("#otEndWorkDate", {
                            locale: "th",
                            dateFormat: "d/m/Y",
                            altFormat: "d/m/Y",
                            altInput: true,
                            allowInput: false,
                            clickOpens: true,
                            theme: "material_blue",
                            disableMobile: true,
                            // อนุญาตให้เลือกวันย้อนหลังได้ (30 วันย้อนหลัง)
                            minDate: new Date().fp_incr(-30),
                            maxDate: new Date().fp_incr(365),
                            onChange: function(selectedDates, dateStr, instance) {
                                if (selectedDates[0]) {
                                    const formattedDate = selectedDates[0].toISOString().split('T')[0];
                                    $('#otEndWorkDate').val(formattedDate);
                                    
                                    // อัพเดทวันที่เริ่มต้นให้ไม่มากกว่าวันที่สิ้นสุด
                                    const startPicker = document.querySelector("#otStartWorkDate")._flatpickr;
                                    if (startPicker) {
                                        startPicker.set('maxDate', selectedDates[0]);
                                        // ถ้าวันที่เริ่มต้นมากกว่าวันที่สิ้นสุด ให้อัพเดทวันที่เริ่มต้น
                                        const currentStartDate = startPicker.selectedDates[0];
                                        if (currentStartDate && currentStartDate > selectedDates[0]) {
                                            startPicker.setDate(selectedDates[0]);
                                        }
                                    }
                                    
                                    updateDateRangeInfo();
                                }
                            },
                            onReady: function(selectedDates, dateStr, instance) {
                                // ตรวจสอบว่าวันที่ถูกตั้งค่าไว้แล้วหรือไม่
                                const currentValue = $('#otEndWorkDate').val();
                                if (currentValue) {
                                    const momentDate = moment(currentValue, 'YYYY-MM-DD');
                                    if (momentDate.isValid()) {
                                        instance.setDate(momentDate.toDate(), false);
                                    }
                                }
                            }
                        });

                        // ฟังก์ชันอัพเดทข้อมูลช่วงวันที่
                        window.updateDateRangeInfo = function() {
                            const startDate = $('#otStartWorkDate').val();
                            const endDate = $('#otEndWorkDate').val();
                            
                            if (startDate && endDate) {
                                // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                                let rangeFormattedStartDate = formatDateForMoment(startDate);
                                let rangeFormattedEndDate = formatDateForMoment(endDate);
                                
                                const start = moment(rangeFormattedStartDate, 'YYYY-MM-DD');
                                const end = moment(rangeFormattedEndDate, 'YYYY-MM-DD');
                                
                                // ตรวจสอบว่า moment objects ถูกต้อง
                                if (start.isValid() && end.isValid() && rangeFormattedStartDate && rangeFormattedEndDate) {
                                    const daysDiff = end.diff(start, 'days') + 1;
                                    
                                    if (daysDiff > 0) {
                                        $('#dateRangeText').text(`${start.format('DD/MM/YYYY')} ถึง ${end.format('DD/MM/YYYY')} (${daysDiff} วัน)`);
                                        $('#dateRangeInfo').show();
                                    } else {
                                        $('#dateRangeInfo').hide();
                                    }
                                } else {
                                    $('#dateRangeInfo').hide();
                                }
                            } else {
                                $('#dateRangeInfo').hide();
                            }
                        };

                        // ปุ่มสร้างช่วงวันที่
                        $('#generateDateRangeBtn').on('click', function() {
                            const startDate = $('#otStartWorkDate').val();
                            const endDate = $('#otEndWorkDate').val();
                            
                            if (!startDate || !endDate) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'กรุณาเลือกวันที่',
                                    text: 'กรุณาเลือกวันที่เริ่มต้นและวันที่สิ้นสุด'
                                });
                                return;
                            }
                            
                            // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                            let btnFormattedStartDate = formatDateForMoment(startDate);
                            let btnFormattedEndDate = formatDateForMoment(endDate);
                            
                            const start = moment(btnFormattedStartDate, 'YYYY-MM-DD');
                            const end = moment(btnFormattedEndDate, 'YYYY-MM-DD');
                            
                            if (start.isValid() && end.isValid() && btnFormattedStartDate && btnFormattedEndDate && end.isBefore(start)) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'วันที่ไม่ถูกต้อง',
                                    text: 'วันที่สิ้นสุดต้องไม่น้อยกว่าวันที่เริ่มต้น'
                                });
                                return;
                            }
                            
                            updateDateRangeInfo();
                        });

                        // ตั้งค่าวันที่เริ่มต้นเป็นวันนี้
                        const today = new Date();
                        const formattedToday = today.toISOString().split('T')[0];
                        
                        // ตั้งค่า input values
                        $('#otWorkDate').val(formattedToday);
                        $('#otStartWorkDate').val(formattedToday);
                        $('#otEndWorkDate').val(formattedToday);
                        $('#otStartDate').val(formattedToday);
                        $('#otEndDate').val(formattedToday);
                        
                        // เรียกใช้ Flatpickr เพื่อแสดงวันที่ในรูปแบบไทย
                        if (singleDatePicker) {
                            singleDatePicker.setDate(today, false);
                        }
                        if (startDatePicker) {
                            startDatePicker.setDate(today, false);
                        }
                        if (endDatePicker) {
                            endDatePicker.setDate(today, false);
                        }
                        
                        // ตรวจสอบว่าวันที่ถูกตั้งค่าไว้แล้วหรือไม่
                        setTimeout(function() {
                            const workDate = $('#otWorkDate').val();
                            const startDate = $('#otStartDate').val();
                            const endDate = $('#otEndDate').val();
                            
                            if (!workDate || !startDate || !endDate) {
                                $('#otWorkDate').val(formattedToday);
                                $('#otStartDate').val(formattedToday);
                                $('#otEndDate').val(formattedToday);
                                $('#otStartWorkDate').val(formattedToday);
                                $('#otEndWorkDate').val(formattedToday);
                                
                                // อัพเดท Flatpickr instances อีกครั้ง
                                if (singleDatePicker) {
                                    singleDatePicker.setDate(today, false);
                                }
                                if (startDatePicker) {
                                    startDatePicker.setDate(today, false);
                                }
                                if (endDatePicker) {
                                    endDatePicker.setDate(today, false);
                                }
                            }
                        }, 500);
                    }

                    // เรียกใช้ Flatpickr เมื่อหน้าเว็บโหลดเสร็จ
                    $(document).ready(function() {
                        initializeFlatpickr();
                    });

    </script> 
}