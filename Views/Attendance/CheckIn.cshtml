                    // ฟังก์ชันเก็บข้อมูลล่าสุดใน localStorage
                    function saveLastOTData(personId, data) {
                        var key = 'lastOTData_' + personId;
                        var lastData = JSON.parse(localStorage.getItem(key) || '{}');
                        var updatedData = { ...lastData, ...data, lastUpdated: new Date().toISOString() };
                        localStorage.setItem(key, JSON.stringify(updatedData));
                    }

                    // ฟังก์ชันดึงข้อมูลล่าสุดจาก localStorage
                    function getLastOTData(personId, field) {
                        var key = 'lastOTData_' + personId;
                        var lastData = JSON.parse(localStorage.getItem(key) || '{}');
                        return lastData[field];
                    }

                    // ฟังก์ชันโหลดข้อมูลล่าสุดทั้งหมด
                    function loadLastOTData(personId) {
                        var key = 'lastOTData_' + personId;
                        var lastData = JSON.parse(localStorage.getItem(key) || '{}');
                        return lastData;
                    }

                    // ฟังก์ชันโหลดข้อมูลกะและตั้งค่าเวลาโอที
                    function loadShiftDataAndSetOTTimes(shift, workDate) {
                        
                        // ดึงข้อมูลกะจากฐานข้อมูล
                        $.ajax({
                            url: appBasePath + 'Attendance/GetShifts',
                            type: 'GET',
                            success: function(response) {
                                // ตรวจสอบ response format
                                var shifts = response.data;
                                
                                // ตรวจสอบว่า shifts เป็น array หรือไม่
                                if (!Array.isArray(shifts)) {
                                    console.error('Shifts data is not an array:', shifts);
                                    setDefaultTimes(shift);
                                    return;
                                }

                                // หาข้อมูลกะที่ตรงกับ shift_code
                                var shiftData = shifts.find(function(s) {
                                    return s.shift_code === shift;
                                });

                                if (shiftData) {
                                    // แสดงข้อมูลกะ
                                    var workTime = formatTime24Hour(shiftData.start_time) + ' - ' + formatTime24Hour(shiftData.end_time);
                                    var otTime = formatTime24Hour(shiftData.ot_start_time || '17:30') + ' - ' + formatTime24Hour(shiftData.ot_end_time || '19:30');
                                    
                                    var breakTime = formatTime24Hour(shiftData.break_start_time || '12:00') + ' - ' + formatTime24Hour(shiftData.break_end_time || '13:00');
                                    if (shiftData.is_break2) {
                                        breakTime += ' และ ' + formatTime24Hour(shiftData.break2_start_time || '17:30') + ' - ' + formatTime24Hour(shiftData.break2_end_time || '18:00');
                                    }

                                    $('#shiftWorkTime').text('งาน: ' + workTime);
                                    $('#shiftOTTime').text('โอที: ' + otTime);
                                    $('#shiftBreakTime').text('เบรค: ' + breakTime);

                                    // ตั้งค่าเวลาเริ่มต้นโอที
                                    var otStartTime = shiftData.ot_start_time || '17:30';
                                    $('#otStartTime').val(otStartTime);
                                    
                                    // ตั้งค่าเวลาสิ้นสุดโอที (1 ชั่วโมงหลังเวลาเริ่มต้น)
                                    var endTime = moment(otStartTime, 'HH:mm').add(1, 'hour').format('HH:mm');
                                    $('#otEndTime').val(endTime);

                                    // ตั้งค่าวันที่ให้ถูกต้อง
                                    // ใช้วันที่ทำงานเป็นวันที่เริ่มต้นและสิ้นสุด
                                    const formattedWorkDate = formatDateForMoment(workDate);
                                    $('#otStartDate').val(formattedWorkDate);
                                    $('#otEndDate').val(formattedWorkDate);
                                    
                                    // อัปเดตการแสดงผลเวลา
                                    updateOTTimeDisplay(otStartTime, endTime, 1);

                                    // เก็บข้อมูลกะไว้ใช้ในปุ่มเลือกเวลา
                                    window.currentShiftData = {
                                        ...shiftData,
                                        ot_start_time: otStartTime,
                                        ot_end_time: shiftData.ot_end_time || '19:30',
                                        workDate: workDate,
                                        isNightShift: isNightShift
                                    };
                                } else {
                                    // ถ้าไม่พบข้อมูลกะ ให้ใช้ค่าเริ่มต้น
                                    setDefaultTimes(shift);
                                }

                                // คำนวณจำนวนชั่วโมง
                                calculateOTHours();
                            },
                            error: function(xhr, status, error) {
                                console.error('Error loading shifts:', error);
                                // ถ้าเกิดข้อผิดพลาด ให้ใช้ค่าเริ่มต้น
                                setDefaultTimes(shift);
                            }
                        });
                    }

                    // ฟังก์ชันแปลงเวลาเป็นรูปแบบ 24 ชั่วโมง
                    function formatTime24Hour(timeStr) {
                        if (!timeStr) return '';
                        
                        // ถ้าเวลาเป็นรูปแบบ 24 ชั่วโมงอยู่แล้ว ให้คืนค่าเดิม
                        if (timeStr.includes(':')) {
                            var parts = timeStr.split(':');
                            var hours = parseInt(parts[0]);
                            var minutes = parts[1];
                            
                            // ถ้าเป็นรูปแบบ 12 ชั่วโมง (มี AM/PM)
                            if (timeStr.toLowerCase().includes('am') || timeStr.toLowerCase().includes('pm')) {
                                var isPM = timeStr.toLowerCase().includes('pm');
                                if (isPM && hours !== 12) {
                                    hours += 12;
                                } else if (!isPM && hours === 12) {
                                    hours = 0;
                                }
                            }
                            
                            return hours.toString().padStart(2, '0') + ':' + minutes;
                        }
                        
                        return timeStr;
                    }

                    // ฟังก์ชันตั้งค่าเวลาเริ่มต้นตามกะ (fallback)
                    function setDefaultTimes(shift) {
                        const shiftTimes = {
                            'D01': { start: '08:00', end: '17:00' },
                            'N01': { start: '20:00', end: '05:00' },
                            'D02': { start: '08:00', end: '17:00' },
                            'N02': { start: '20:00', end: '05:00' },
                            'DAYTCH': { start: '08:00', end: '17:00' },
                            'DAYSHF': { start: '08:00', end: '17:00' },
                            'DT1NT1': { start: '08:00', end: '17:00' },
                            'NT1DT1': { start: '20:00', end: '05:00' },
                            'DT2NT2': { start: '08:00', end: '17:00' },
                            'NT2DT2': { start: '20:00', end: '05:00' },
                            'OFFICE': { start: '08:00', end: '17:00' },
                            'OF02': { start: '08:00', end: '17:00' }
                        };

                        const defaultTime = shiftTimes[shift] || { start: '08:00', end: '17:00' };
                        
                        // ตั้งค่าเวลาเริ่มต้น (หลังเวลางานปกติ)
                        const startTime = moment(defaultTime.end, 'HH:mm').add(1, 'hour').format('HH:mm');
                        $('#otStartTime').val(startTime);
                        
                        // ตั้งค่าเวลาสิ้นสุด (2 ชั่วโมงหลังเวลาเริ่มต้น)
                        const endTime = moment(startTime, 'HH:mm').add(2, 'hours').format('HH:mm');
                        $('#otEndTime').val(endTime);
                        
                        // ตั้งค่าวันที่ให้ถูกต้อง
                        const workDate = $('#otWorkDate').val();
                        if (workDate) {
                            const formattedWorkDate = formatDateForMoment(workDate);
                            $('#otStartDate').val(formattedWorkDate);
                            $('#otEndDate').val(formattedWorkDate);
                        }
                        
                        // อัปเดตการแสดงผลเวลา
                        updateOTTimeDisplay(startTime, endTime, 2);
                        
                        // คำนวณจำนวนชั่วโมง
                        calculateOTHours();
                    }

                    // Event handlers สำหรับปุ่มเลือกเวลาโอที
                    $(document).on('click', '.ot-time-btn', function() {
                        var hours = parseFloat($(this).data('hours'));
                        setOTTimeByHours(hours);
                        
                        // เปลี่ยนสถานะปุ่ม
                        $('.ot-time-btn').removeClass('btn-primary').addClass('btn-outline-primary');
                        $(this).removeClass('btn-outline-primary').addClass('btn-primary');
                        
                        // ซ่อนฟอร์มกำหนดเอง
                        $('#customTimeForm').hide();
                    });

                    // Event handler สำหรับปุ่มกำหนดเอง
                    $(document).on('click', '#customTimeBtn', function() {
                        // แสดงฟอร์มกำหนดเอง
                        $('#customTimeForm').show();
                        
                        // เปลี่ยนสถานะปุ่ม
