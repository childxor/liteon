                    // ฟังก์ชันช่วยแปลงวันที่ให้ถูกต้องสำหรับ moment.js
                    function formatDateForMoment(dateString) {
                        if (!dateString) return '';
                        
                        // ลองใช้ moment.js แปลงวันที่ก่อน
                        const momentDate = moment(dateString, 'DD/MM/YYYY');
                        if (momentDate.isValid()) {
                            return momentDate.format('YYYY-MM-DD');
                        }
                        
                        // ถ้าวันที่เป็นรูปแบบ DD/MM/YYYY ให้แปลงเป็น YYYY-MM-DD
                        if (typeof dateString === 'string' && dateString.includes('/')) {
                            var dateParts = dateString.split('/');
                            if (dateParts.length === 3) {
                                var year = dateParts[2];
                                var month = dateParts[1].padStart(2, '0');
                                var day = dateParts[0].padStart(2, '0');
                                
                                // ตรวจสอบความถูกต้องของวันที่
                                if (year && month && day) {
                                    return year + '-' + month + '-' + day;
                                }
                            }
                        }
                        
                        // ถ้าวันที่เป็นรูปแบบ YYYY-MM-DD อยู่แล้ว ให้คืนค่าเดิม
                        if (typeof dateString === 'string' && dateString.includes('-')) {
                            var parts = dateString.split('-');
                            if (parts.length === 3) {
                                var year = parts[0];
                                var month = parts[1].padStart(2, '0');
                                var day = parts[2].padStart(2, '0');
                                
                                // ตรวจสอบความถูกต้องของวันที่
                                if (year && month && day) {
                                    return year + '-' + month + '-' + day;
                                }
                            }
                        }
                        
                        return dateString;
                    }

