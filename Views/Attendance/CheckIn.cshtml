        @section Scripts {
        <!-- นำเข้า Select2 CSS และ JS -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        
        <script>
            const userPermissions = {
                canView: @Json.Serialize(canView),
                canAdd: @Json.Serialize(canAdd),
                canEdit: @Json.Serialize(canEdit),
                canDelete: @Json.Serialize(canDelete),
                userDepartment: '@ViewBag.UserDepartment',
                userDepartmentName: '@ViewBag.UserDepartmentName',
                userName: '@ViewBag.UserName'
            };
            let dataTable;
            let dataTableforDoorHistory;
            $(document).ready(function() {
                $(document).on('click', '.view-door-history', function() {
                    const empId = $(this).data('empid');
                    const date = $(this).data('date');
                    const shift = $(this).data('shift');
                    var row = $(this).closest('tr');
                    // เปิด modal ก่อนโหลดข้อมูล
                    const doorHistoryModal = new bootstrap.Modal(document.getElementById(
                        'doorHistoryModal'));
                    doorHistoryModal.show();
                    // แสดง loading
                    $('#doorHistoryTable tbody').html(`
                    <tr>
                        <td colspan="5" class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                            </div>
                        </td>
                    </tr>
                     `);
                    $('#doorActivityTimeline').html(`
                    <div class="d-flex justify-content-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                        </div>
                    </div>
                    `);
                    // ทำลาย DataTable เดิมถ้ามีอยู่
                    if (dataTableforDoorHistory) {
                        dataTableforDoorHistory.destroy();
                    }
                    // สร้าง DataTable ใหม่
                    dataTableforDoorHistory = $('#doorHistoryTable').DataTable({
                        ajax: {
                            url: '@Url.Action("GetDoorHistory", "Attendance")',
                            type: 'POST',
                            data: {
                                empId: empId,
                                date: date,
                                shift: shift
                            },
                            dataSrc: function(response) {
                                if (response.success) {
                                    // แสดงข้อมูลพนักงาน
                                    // แสดงข้อมูลพนักงาน
                                    $('#doorHistoryEmpName').text(response.data[0] ? response.data[0].personName || '-' : '-');
                                    $('#doorHistoryEmpId').text(response.data[0] ? response.data[0].personID || '-' : '-');
                                    $('#doorHistoryDept').text(response.data[0] ? response.data[0].deptName || '-' : '-');
                                    // กรองและจัดเรียงข้อมูล
                                    const processedData = [];
                                    const uniqueKeys = new Set();
                                    // กรองข้อมูลซ้ำและแปลง eventType เป็น IN/OUT
                                    response.data.forEach(item => {
                                        const key =
                                            `${item.eventTime}_${item.deviceName}`;
                                        if (!uniqueKeys.has(key)) {
                                            uniqueKeys.add(key);
                                            // แปลง eventType เป็น IN/OUT ตามค่า eventType ที่เป็นตัวเลข
                                            item.eventType = item.eventType ===
                                                '1' ? 'IN' : 'OUT';
                                            processedData.push(item);
                                        }
                                    });
                                    // เรียงลำดับตามเวลา
                                    const sortedData = processedData.sort((a, b) => {
                                        return moment(a.eventTime).diff(moment(b
                                            .eventTime));
                                    });
                                    // หาข้อมูลเข้า-ออกงาน น้อยที่สุดคือเข้างานแรก มากที่สุดคือออกงานล่าสุด
                                    const inRecords = sortedData.filter(item => item
                                        .eventType === 'IN');
                                    let firstEntry = null;
                                    let lastExit = null;
                                    // หาเวลาเข้างานแรกและออกงานล่าสุด
                                    if (inRecords.length > 0) {
                                        firstEntry = inRecords[0].eventTime;
                                        lastExit = inRecords[inRecords.length - 1]
                                            .eventTime;
                                    }
                                    // คำนวณเวลาทำงาน
                                    let workHours = '-';
                                    if (firstEntry && lastExit) {
                                        const duration = moment.duration(moment(lastExit)
                                            .diff(moment(firstEntry)));
                                        const hours = Math.floor(duration.asHours());
                                        const minutes = duration.minutes();
                                        workHours = `${hours} ชั่วโมง ${minutes} นาที`;
                                    }
                                    // แสดงผลข้อมูล
                                    $('#doorHistoryFirstEntry').html(
                                        firstEntry ?
                                        `<div class="small text-muted">${moment(firstEntry).format('DD/MM/YYYY')}</div>
                                     <div class="fw-bold">${moment(firstEntry).format('HH:mm:ss')}</div>` :
                                        '<div class="text-muted">-</div>'
                                    );
                                    //ถ้าเวลาออกมีค่าแตกต่างจากเวลาเข้าไม่ถึง 1 ชั่วโมง ให้แสดงผลเป็นยังไม่แสกนออก
                                    if (lastExit && moment(lastExit).diff(moment(
                                            firstEntry), 'hours') < 1) {
                                        $('#doorHistoryLastExit').html(
                                            '<div class="text-muted">ยังไม่แสกนออก</div>'
                                        );
                                    } else {
                                        $('#doorHistoryLastExit').html(
                                            lastExit ?
                                            `<div class="small text-muted">${moment(lastExit).format('DD/MM/YYYY')}</div>
                                     <div class="fw-bold">${moment(lastExit).format('HH:mm:ss')}</div>` :
                                            '<div class="text-muted">-</div>'
                                        );
                                    }
                                    $('#doorHistoryWorkHours').html(
                                        `<div class="fw-bold">${workHours}</div>`
                                    );
                                    return sortedData;
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: response.message ||
                                            'ไม่สามารถโหลดข้อมูลได้'
                                    });
                                    return [];
                                }
                            }
                        },
                        columns: [{
                                data: 'eventTime',
                                title: '<i class="fas fa-calendar-alt me-2"></i>วันที่',
                                className: 'text-nowrap',
                                render: function(data) {
                                    return `<div class="small text-muted">${moment(data).format('DD/MM/YYYY')}</div>
                                        <div class="fw-bold">${moment(data).format('HH:mm:ss')}</div>`;
                                }
                            },
                            {
                                data: 'eventType',
                                title: '<i class="fas fa-exchange-alt me-2"></i>ประเภท',
                                className: 'text-center align-middle',
                                render: function(data, type, row) {
                                    if (data === 'IN') {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-success bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-sign-in-alt text-success"></i>
                                            </div>
                                            <span class="badge bg-success">เข้างาน</span>
                                        </div>`;
                                    } else if (data === 'OUT') {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-danger bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-sign-out-alt text-danger"></i>
                                            </div>
                                            <span class="badge bg-danger">ออกงาน</span>
                                        </div>`;
                                    } else {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-secondary bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-question-circle text-secondary"></i>
                                            </div>
                                            <span class="badge bg-secondary">${data || 'ไม่ระบุ'}</span>
                                        </div>`;
                                    }
                                }
                            },
                            {
                                data: 'deviceName',
                                title: '<i class="fas fa-hdd me-2"></i>อุปกรณ์',
                                className: 'align-middle',
                                render: function(data, type, row) {
                                    const location = row.location || 'ไม่ระบุสถานที่';
                                    return `<div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                                            <i class="fas fa-hdd text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">${data || 'ไม่ระบุอุปกรณ์'}</div>
                                            <div class="small text-muted">${location}</div>
                                        </div>
                                    </div>`;
                                }
                            },
                            {
                                data: 'personID',
                                title: '<i class="fas fa-fingerprint me-2"></i>วิธีการสแกน',
                                className: 'text-center align-middle',
                                render: function(data, type, row) {
                                    // ตรวจสอบว่า data มีค่าหรือไม่
                                    if (!data) {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-secondary bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-question-circle text-secondary"></i>
                                            </div>
                                            <span class="badge bg-secondary">ไม่ระบุ</span>
                                        </div>`;
                                    }
                                    // ถ้า มีคำว่า -1 แสดงบัตรพนักงาน
                                    if (data.toString().includes('-1')) {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-info bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-id-card text-info"></i>
                                            </div>
                                            <span class="badge bg-info">บัตรพนักงาน</span>
                                        </div>`;
                                    } else if (data.toString().includes('-2')) {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-warning bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-fingerprint text-warning"></i>
                                            </div>
                                            <span class="badge bg-warning">ลายนิ้วมือ</span>
                                        </div>`;
                                    } else {
                                        return `<div class="d-flex align-items-center justify-content-center">
                                            <div class="rounded-circle bg-secondary bg-opacity-10 p-2 me-2">
                                                <i class="fas fa-question-circle text-secondary"></i>
                                            </div>
                                            <span class="badge bg-secondary">ไม่ระบุ</span>
                                        </div>`;
                                    }
                                }
                            }
                        ],
                        paging: false,
                        language: {
                            "emptyTable": "ไม่พบข้อมูลการเข้าออก",
                            "info": "แสดงทั้งหมด _TOTAL_ รายการ",
                            "infoEmpty": "ไม่มีข้อมูล",
                            "infoFiltered": "",
                            "search": "ค้นหา:",
                            "zeroRecords": "ไม่พบข้อมูลที่ค้นหา"
                        },
                        ordering: false,
                        pageLength: -1,
                        searching: false,
                        responsive: true,
                        drawCallback: function() {
                            // เพิ่ม animation เมื่อโหลดข้อมูลเสร็จ
                            $(this).find('tbody tr').each(function(index) {
                                $(this).css('opacity', 0).animate({
                                    opacity: 1
                                }, 200 * (index + 1));
                            });
                        }
                    });
                });
                // ฟังก์ชันสร้างไทม์ไลน์กิจกรรมการเข้าออก
                function createDoorActivityTimeline(data) {
                    if (!data || data.length === 0) {
                        $('#doorActivityTimeline').html(`
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>ไม่พบข้อมูลการเข้าออกในวันที่เลือก
                        </div>
                    `);
                        return;
                    }
                    // เพิ่ม animation
                    $('.timeline-item').each(function(index) {
                        $(this).css('opacity', 0);
                        setTimeout(() => {
                            $(this).animate({
                                opacity: 1
                            }, 300);
                        }, index * 100);
                    });
                }
                // ฟังก์ชันแปลงวิธีการสแกนเป็นข้อความ
                function getScanMethodText(method) {
                    switch (method) {
                        case 'FINGER':
                            return 'ลายนิ้วมือ';
                        case 'CARD':
                            return 'บัตร';
                        case 'FACE':
                            return 'ใบหน้า';
                        default:
                            return method || 'ไม่ระบุ';
                    }
                }
                // โหลด filter ที่บันทึกไว้
                const savedFilters = loadFilters();
                // ถ้ามี filter ที่บันทึกไว้ ให้ใช้ค่านั้น
                const initialFilters = savedFilters || {
                    dept: 'all',
                    personName: 'all',
                    startDate: moment().format('YYYY-MM-DD'),
                    endDate: moment().format('YYYY-MM-DD'),
                    shiftFilter: 'all'
                };
                // สร้าง DataTable โดยใช้ค่า filter เริ่มต้น
                dataTable = createDataTable(initialFilters);
                // จัดการ Date Range Toggle
                $('#dateRangeToggle').change(function() {
                    const isChecked = $(this).prop('checked');
                    if (isChecked) {
                        $('#singleDateContainer').addClass('d-none');
                        $('#dateRangeContainer').removeClass('d-none');
                        // ตั้งค่าวันที่เริ่มต้นเป็นวันที่เลือกในโหมดวันเดียว
                        const selectedDate = moment($('#selectedDate').val());
                        $('#startDate').val(selectedDate.format('YYYY-MM-DD'));
                        $('#endDate').val(selectedDate.format('YYYY-MM-DD'));
                    } else {
                        $('#singleDateContainer').removeClass('d-none');
                        $('#dateRangeContainer').addClass('d-none');
                        // ตั้งค่าวันที่เดี่ยวเป็นวันที่เริ่มต้นของช่วง
                        $('#selectedDate').val($('#startDate').val());
                    }
                });
                // ปุ่มเลือกช่วงวันที่ด่วน
                $('.btn-group [data-range]').click(function() {
                    const days = $(this).data('range');
                    const endDate = moment();
                    const startDate = moment().subtract(days - 1, 'days');
                    $('#startDate').val(startDate.format('YYYY-MM-DD'));
                    $('#endDate').val(endDate.format('YYYY-MM-DD'));
                });
                // ปุ่มวันที่
                $('#btnToday').click(function(e) {
                    e.preventDefault();
                    $('#selectedDate').val(moment().format('YYYY-MM-DD'));
                    saveFilters();
                    dataTable.ajax.reload();
                });
                $('#btnPrevDate').click(function(e) {
                    e.preventDefault();
                    const currentDate = moment($('#selectedDate').val());
                    $('#selectedDate').val(currentDate.subtract(1, 'day').format('YYYY-MM-DD'));
                    saveFilters();
                    dataTable.ajax.reload();
                });
                $('#btnNextDate').click(function(e) {
                    e.preventDefault();
                    const currentDate = moment($('#selectedDate').val());
                    const tomorrow = currentDate.add(1, 'day');
                    // ลบเงื่อนไขการตรวจสอบวันในอนาคตออก
                    $('#selectedDate').val(tomorrow.format('YYYY-MM-DD'));
                    saveFilters();
                    dataTable.ajax.reload();
                });
                // ป้องกันการ submit form และใช้ ajax แทน
                $('#formFilter').on('submit', function(e) {
                    e.preventDefault();
                    saveFilters();
                    dataTable.ajax.reload();
                });
                // บันทึก filter เมื่อกดปุ่มค้นหา
                $('#btnSearch').click(function(e) {
                    e.preventDefault();
                    saveFilters();
                    dataTable.ajax.reload();
                });
                // เพิ่ม event listener สำหรับปุ่ม clear
                $('#clearFilter').click(function(e) {
                    e.preventDefault();
                    localStorage.removeItem('attendanceFilters');
                    // Reset all filters
                    $('#dateRangeToggle').prop('checked', false);
                    $('#singleDateContainer').removeClass('d-none');
                    $('#dateRangeContainer').addClass('d-none');
                    if (userPermissions.canEdit) {
                        $('#selectDistrup').val('all');
                    }
                    $('#employeeNameSearch').val('');
                    $('#selectedDate').val(moment().format('YYYY-MM-DD'));
                    $('#startDate').val(moment().format('YYYY-MM-DD'));
                    $('#endDate').val(moment().format('YYYY-MM-DD'));
                    $('#shiftFilter').val('all');
                    // $('#hideResignedSwitch').prop('checked', false);
                    // $('#hideAbsentSwitch').prop('checked', false);
                    // $('#showIncompleteSwitch').prop('checked', false);
                    dataTable.ajax.reload();
                });
                // เปิดใช้งาน tooltip
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
                // เปิดใช้งาน tooltip สำหรับ element ที่เพิ่มใหม่
                $('#mTable').on('draw.dt', function() {
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll(
                        '[data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.forEach(function(tooltipTriggerEl) {
                        new bootstrap.Tooltip(tooltipTriggerEl, {
                            html: true,
                            container: 'body'
                        });
                    });
                });
                // เพิ่ม event handler สำหรับปุ่มลบสิทธิ์ประตูของพนักงานที่ลาออกทั้งหมด
                $('#removeAllResignedAccess').on('click', function() {
                    Swal.fire({
                        title: 'ยืนยันการลบสิทธิ์',
                        text: "คุณต้องการลบสิทธิ์การเข้าประตูของพนักงานที่ลาออกทั้งหมดใช่หรือไม่?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'ใช่, ลบสิทธิ์',
                        cancelButtonText: 'ยกเลิก',
                        confirmButtonColor: '#d33'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // แสดง loading
                            Swal.fire({
                                title: 'กำลังลบสิทธิ์...',
                                allowOutsideClick: false,
                                showConfirmButton: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                            $.ajax({
                                url: '/Employee/RemoveResignedAccess',
                                type: 'POST',
                                success: function(response) {
                                    if (response.success) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'สำเร็จ',
                                            text: response.message ||
                                                'ลบสิทธิ์การเข้าประตูของพนักงานที่ลาออกทั้งหมดเรียบร้อยแล้ว',
                                            timer: 1500,
                                            showConfirmButton: false
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'เกิดข้อผิดพลาด',
                                            text: response.message ||
                                                'ไม่สามารถลบสิทธิ์การเข้าประตูได้'
                                        });
                                    }
                                },
                                error: function() {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                    });
                                }
                            });
                        }
                    });
                });
                // แก้ไข: เปลี่ยนจากการกดที่แถวเป็นการกดที่คอลัมน์กะเท่านั้น
                $('#mTable').on('click', 'tbody td:nth-child(7)', function() {
                    const data = dataTable.row($(this).closest('tr')).data();
                    if (data) {
                        showShiftHistory(data);
                    }
                });
                // โหลดข้อมูลกะการทำงานสำหรับ dropdown
                loadShifts();
            });
            // ฟังก์ชันโหลดข้อมูลกะการทำงาน
            function loadShifts() {
                $.ajax({
                    url: '/Employee/GetShifts',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            const shifts = response.data;
                            $('#shiftSelect').empty().append(
                                '<option value="">-- เลือกกะการทำงาน --</option>');
                            shifts.forEach(function(shift) {
                                $('#shiftSelect').append(
                                    `<option value="${shift.shiftGroup}">${shift.shiftName} (${shift.shiftGroup})</option>`
                                );
                            });
                        }
                    },
                    error: function(error) {
                        console.error('Error loading shifts:', error);
                    }
                });
            }
            // ฟังก์ชันแสดงประวัติการเปลี่ยนกะ
            function showShiftHistory(data) {
                const personId = data.personID.split('-')[0];
                const personName = data.personName;
                const deptName = data.deptName;
                // แสดงข้อมูลพนักงานในหัว modal
                $('#employeeInfo').text(`${personName} (${personId})`);
                $('#departmentInfo').text(deptName);
                // เก็บข้อมูลสำหรับการเพิ่มกะ
                $('#shiftPersonId').val(personId);
                // แสดง loading
                $('.shift-history-container').html(`
            <div class="d-flex justify-content-center p-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                </div>
            </div>
            `);
                // เปิด modal
                const shiftHistoryModal = new bootstrap.Modal(document.getElementById('shiftHistoryModal'));
                shiftHistoryModal.show();
                // โหลดข้อมูลประวัติการเปลี่ยนกะ
                loadShiftHistoryData(personId);
            }
            // ฟังก์ชันโหลดข้อมูลประวัติการเปลี่ยนกะ
            function loadShiftHistoryData(personId) {
                $.ajax({
                    url: `/Employee/GetShiftHistory?personId=${personId}`,
                    type: 'GET',
                    success: function(data) {
                        if (!Array.isArray(data) || data.length === 0) {
                            $('.shift-history-container').html(`
                        <div class="alert alert-info mb-3 border-0 bg-info bg-opacity-10">
                            <i class="fas fa-info-circle me-2"></i>
                            ไม่พบประวัติการเข้ากะ Shift
                        </div>
                    `);
                            return;
                        }
                        // เรียงข้อมูลตามวันที่จากเก่าไปใหม่
                        data.sort((a, b) => new Date(a.date) - new Date(b.date));
                        // หาวันที่ปัจจุบัน
                        const currentDate = new Date();
                        currentDate.setHours(0, 0, 0, 0);
                        // หา record ที่ active อยู่ในปัจจุบัน
                        let activeRecord = null;
                        for (let i = data.length - 1; i >= 0; i--) {
                            const recordDate = new Date(data[i].date);
                            if (recordDate <= currentDate) {
                                activeRecord = data[i];
                                break;
                            }
                        }

                        $('#shiftPersonName').val(activeRecord.name);

                        // สร้าง timeline แสดงประวัติแบบเรียบง่าย
                        let timelineHtml = `
                    <div class="timeline-container">
                        <div class="d-flex align-items-center mb-3">
                            <div class="current-shift-badge me-2">
                                <span class="badge bg-primary">
                                    กะปัจจุบัน: ${activeRecord ? activeRecord.shiftMent : 'ไม่ระบุ'}
                                </span>
                            </div>
                            <div class="timeline-legend d-flex align-items-center ms-auto">
                                <span class="badge bg-success me-1"></span>
                                <small class="text-muted me-3">ใช้งานอยู่</small>
                                <span class="badge bg-warning me-1"></span>
                                <small class="text-muted me-3">รอดำเนินการ</small>
                                <span class="badge bg-secondary me-1"></span>
                                <small class="text-muted">ไม่ได้ใช้งาน</small>
                            </div>
                        </div>
                        <div class="timeline">`;
                        data.forEach(function(item, index) {
                            const itemDate = new Date(item.date);
                            itemDate.setMinutes(itemDate.getMinutes() + itemDate
                            .getTimezoneOffset());
                            // กำหนดสถานะและสี
                            let statusClass, statusText;
                            if (itemDate > currentDate) {
                                statusClass = 'warning';
                                statusText = 'รอดำเนินการ';
                            } else if (activeRecord && item.date === activeRecord.date) {
                                statusClass = 'success';
                                statusText = 'ใช้งานอยู่';
                            } else {
                                statusClass = 'secondary';
                                statusText = 'ไม่ได้ใช้งาน';
                            }
                            const isActive = activeRecord && item.date === activeRecord.date;
                            timelineHtml += `
                        <div class="timeline-item mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="badge bg-${statusClass}">
                                                <i class="fas fa-calendar me-1"></i>${formatDate(item.date)}
                                            </span>
                                            ${itemDate > currentDate ? '<span class="badge bg-info ms-2">อนาคต</span>' : ''}
                                        </div>
                                        <span class="badge bg-${statusClass}">${statusText}</span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-2">
                                                <small class="text-muted">กะการทำงาน</small>
                                                <div>
                                                    <span class="badge bg-${isActive ? 'success' : 'primary'}">
                                                        <i class="fas fa-clock me-1"></i>${item.shiftMent}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-2">
                                                <small class="text-muted">แผนก</small>
                                                <div>${item.deptName} ${item.deptCode ? `(${item.deptCode})` : ''}</div>
                                            </div>
                                        </div>
                                        ${item.remark ? `
                                        <div class="col-12 mt-2">
                                            <div class="mb-0">
                                                <small class="text-muted">หมายเหตุ</small>
                                                <div class="bg-light p-2 rounded border">
                                                    <i class="fas fa-quote-left text-muted me-1 small"></i>
                                                    ${item.remark}
                                                </div>
                                            </div>
                                        </div>
                                        ` : ''}
                                    </div>

                                    ${(userPermissions.canEdit || userPermissions.canDelete) ? `
                                    <div class="text-end mt-2">
                                        ${userPermissions.canEdit ? `
                                        <button class="btn btn-sm btn-outline-primary me-2 edit-shift-btn"
                                                data-shift="${item.shiftMent}"
                                                data-date="${item.date}"
                                                data-person-id="${item.personID}"
                                                data-id="${item.id}"
                                                data-remark="${item.remark || ''}"
                                                data-department="${item.deptName}">
                                            <i class="fas fa-edit"></i> แก้ไข
                                        </button>
                                        ` : ''}
                                        ${userPermissions.canDelete ? `
                                        <button class="btn btn-sm btn-outline-danger delete-shift-btn"
                                                data-shift="${item.shiftMent}"
                                                data-date="${item.date}"
                                                data-person-id="${item.personID}"
                                                data-id="${item.id}"
                                                data-department="${item.deptName}">
                                            <i class="fas fa-trash"></i> ลบ
                                        </button>
                                        ` : ''}
                                    </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>`;
                        });
                        timelineHtml += `</div></div>`;
                        // แสดงผลใน container
                        $('.shift-history-container').html(timelineHtml);
                        // เพิ่ม animation แบบง่าย
                        $('.timeline-item').hide().each(function(index) {
                            $(this).delay(index * 100).fadeIn(300);
                        });
                        // เพิ่ม event handlers
                        setupShiftHistoryEvents();
                    },
                    error: function(xhr, status, error) {
                        $('.shift-history-container').html(`
                    <div class="alert alert-danger mb-0 border-0 bg-danger bg-opacity-10">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        ไม่สามารถโหลดข้อมูลประวัติได้: ${error}
                    </div>
                `);
                    }
                });
            }
            // ฟังก์ชันสำหรับจัดการ events ในประวัติการเปลี่ยนกะ
            function setupShiftHistoryEvents() {
                // Event สำหรับปุ่มแก้ไขกะ
                $('.edit-shift-btn').on('click', function() {
                    const shiftId = $(this).data('id');
                    const personId = $(this).data('person-id');
                    const date = $(this).data('date');
                    const shift = $(this).data('shift');
                    const namePerson = $('#shiftPersonName').val();
                    const remark = $(this).data('remark') || '';
                    const department = $(this).data('department');                    
                    // รีเซ็ต form ก่อน
                    $('#shiftForm')[0].reset();
                    
                    // ตั้งค่าข้อมูลใน form
                    $('#shiftId').val(shiftId);
                    $('#shiftPersonId').val(personId);
                    $('#shiftDate').val(formatDateForInput(date));
                    $('#shiftEndDate').val(''); // ไม่มีวันที่สิ้นสุดในการแก้ไข
                    $('#shiftSelect').val(shift);
                    $('#shiftRemark').val(remark);
                    $('#shiftAction').val('edit');
                    $('#shiftPersonNameAddEdit').val(namePerson);
                    $('#departmentSelect').val(department);
                    // แสดงข้อมูลพนักงานใน modal
                    const employeeInfo = $('#employeeInfo').text();
                    const departmentInfo = $('#departmentInfo').text();
                    $('#employeeNameDisplay').text(namePerson || '-');
                    $('#employeeIdDisplay').text(personId || '-');
                    $('#departmentDisplay').text(departmentInfo || '-');
                    
                    // แสดงเวลาเข้า-ออกงานของกะที่เลือก
                    const selectedOption = $('#shiftSelect').find(`option[value="${shift}"]`);
                    const startTime = selectedOption.data('start') || '-';
                    const endTime = selectedOption.data('end') || '-';
                    $('#shiftStartTimeDisplay').text(startTime);
                    $('#shiftEndTimeDisplay').text(endTime);
                    
                    // เปลี่ยนชื่อ modal
                    $('#manageShiftModalLabel').html('<i class="fas fa-edit me-2"></i>แก้ไขกะการทำงาน');
                    
                    // เปิด modal
                    const manageShiftModal = new bootstrap.Modal(document.getElementById('manageShiftModal'));
                    manageShiftModal.show();
                });
                // Event สำหรับปุ่มลบกะ
                $('.delete-shift-btn').on('click', function() {
                    const shiftId = $(this).data('id');
                    const personId = $(this).data('person-id');
                    const date = $(this).data('date');
                    const shift = $(this).data('shift');
                    const namePerson = $(this).data('name');
                    Swal.fire({
                        title: 'ยืนยันการลบ',
                        text: `คุณต้องการลบกะการทำงาน ${shift} วันที่ ${formatDate(date)} ใช่หรือไม่?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'ใช่, ลบเลย',
                        cancelButtonText: 'ยกเลิก',
                        confirmButtonColor: '#d33'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // ส่งคำขอลบกะ
                            $.ajax({
                                url: '/Attendance/DeleteShiftForperson',
                                type: 'POST',
                                data: {
                                    personId: personId,
                                    date: date,
                                    name: namePerson,
                                    shift: shift
                                },
                                success: function(response) {
                                    if (response.success) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'สำเร็จ',
                                            text: response.message,
                                            timer: 1500,
                                            showConfirmButton: false
                                        }).then(() => {
                                            // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                            loadShiftHistoryData(personId.split(
                                                '-')[0]);
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'เกิดข้อผิดพลาด',
                                            text: response.message
                                        });
                                    }
                                },
                                error: function() {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                    });
                                }
                            });
                        }
                    });
                });
            }
            // Event สำหรับปุ่มเพิ่มกะการทำงาน
            $('#addShiftBtn').on('click', function() {
                // รีเซ็ต form
                $('#shiftForm')[0].reset();
                $('#shiftAction').val('add');
                $('#shiftId').val('');
                
