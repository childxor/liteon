                    // ฟังก์ชันปรับขนาดตาราง
                    function resizeTable() {
                        if (dataTable && dataTable.columns) {
                                // ปรับขนาดคอลัมป์
                                dataTable.columns.adjust();

                                // ตรวจสอบว่า responsive extension มีอยู่และพร้อมใช้งาน
                                if (dataTable.responsive && typeof dataTable.responsive.recalc === 'function') {
                                    dataTable.responsive.recalc();
                                }

                                // วาดตารางใหม่โดยไม่ reset pagination
                                dataTable.draw(false);

                        
                        }
                    }

                    // เพิ่ม event listener สำหรับการเปลี่ยนขนาดหน้าจอ
                    let resizeTimeout;
                    $(window).on('resize', function() {
                        // ใช้ debounce เพื่อไม่ให้เรียกบ่อยเกินไป
                        clearTimeout(resizeTimeout);
                        resizeTimeout = setTimeout(function() {
                            resizeTable();
                        }, 250);
                    });

                    // เพิ่ม event listener สำหรับการเปลี่ยน orientation (หมุนหน้าจอ)
                    $(window).on('orientationchange', function() {
