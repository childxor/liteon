    </style>
    
    <script>
                    // ประกาศตัวแปร appBasePath
                    var appBasePath = '@Url.Content("~/")';

                    const userPermissions = {
                        canView: @Json.Serialize(canView),
                        canAdd: @Json.Serialize(canAdd),
                        canEdit: @Json.Serialize(canEdit),
                        canDelete: @Json.Serialize(canDelete),
                        userDepartment: '@ViewBag.UserDepartment',
                        userDepartmentName: '@ViewBag.UserDepartmentName',
                        userName: '@ViewBag.UserName'
                    };
                    let dataTable;
                    let dataTableforDoorHistory;
                    $(document).ready(function() {
                        $(document).on('click', '.view-door-history', function() {
                            const empId = $(this).data('empid');
                            const date = $(this).data('date');
                            const shift = $(this).data('shift');
                            var row = $(this).closest('tr');
                            // เปิด modal ก่อนโหลดข้อมูล
                            const doorHistoryModal = new bootstrap.Modal(document.getElementById(
                                'doorHistoryModal'));
                            doorHistoryModal.show();
                            // แสดง loading
                            $('#doorHistoryTable tbody').html(`
                            <tr>
                                <td colspan="5" class="text-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                                    </div>
                                </td>
                            </tr>
                             `);
                            $('#doorActivityTimeline').html(`
                            <div class="d-flex justify-content-center p-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                                </div>
                            </div>
                            `);
                            // ทำลาย DataTable เดิมถ้ามีอยู่
                            if (dataTableforDoorHistory) {
                                dataTableforDoorHistory.destroy();
                            }
                            // สร้าง DataTable ใหม่
                            dataTableforDoorHistory = $('#doorHistoryTable').DataTable({
                                ajax: {
                                    url: appBasePath + 'Attendance/GetDoorHistory',
                                    type: 'POST',
                                    data: {
                                        empId: empId,
                                        date: date,
                                        shift: shift
                                    },
                                    dataSrc: function(response) {
                                        if (response.success) {
                                            // แสดงข้อมูลพนักงาน
                                            // แสดงข้อมูลพนักงาน
                                            $('#doorHistoryEmpName').text(response.data[0] ? response.data[0].personName || '-' : '-');
                                            $('#doorHistoryEmpId').text(response.data[0] ? response.data[0].personID || '-' : '-');
                                            $('#doorHistoryDept').text(response.data[0] ? response.data[0].deptName || '-' : '-');
                                            // กรองและจัดเรียงข้อมูล
                                            const processedData = [];
                                            const uniqueKeys = new Set();
                                            // กรองข้อมูลซ้ำและแปลง eventType เป็น IN/OUT
                                            response.data.forEach(item => {
                                                const key =
                                                    `${item.eventTime}_${item.deviceName}`;
                                                if (!uniqueKeys.has(key)) {
                                                    uniqueKeys.add(key);
                                                    // แปลง eventType เป็น IN/OUT ตามค่า eventType ที่เป็นตัวเลข
                                                    item.eventType = item.eventType ===
                                                        '1' ? 'IN' : 'OUT';
                                                    processedData.push(item);
                                                }
                                            });
                                            // เรียงลำดับตามเวลา
                                            const sortedData = processedData.sort((a, b) => {
                                                return moment(a.eventTime).diff(moment(b
                                                    .eventTime));
                                            });
                                            // หาข้อมูลเข้า-ออกงาน น้อยที่สุดคือเข้างานแรก มากที่สุดคือออกงานล่าสุด
                                            const inRecords = sortedData.filter(item => item
                                                .eventType === 'IN');
                                            let firstEntry = null;
                                            let lastExit = null;
                                            // หาเวลาเข้างานแรกและออกงานล่าสุด
                                            if (inRecords.length > 0) {
                                                firstEntry = inRecords[0].eventTime;
                                                lastExit = inRecords[inRecords.length - 1]
                                                    .eventTime;
                                            }
                                            // คำนวณเวลาทำงาน
                                            let workHours = '-';
                                            if (firstEntry && lastExit) {
                                                const duration = moment.duration(moment(lastExit)
                                                    .diff(moment(firstEntry)));
                                                const hours = Math.floor(duration.asHours());
                                                const minutes = duration.minutes();
                                                workHours = `${hours} ชั่วโมง ${minutes} นาที`;
                                            }
                                            // แสดงผลข้อมูล
                                            $('#doorHistoryFirstEntry').html(
                                                firstEntry ?
                                                `<div class="small text-muted">${moment(firstEntry).format('DD/MM/YYYY')}</div>
                                             <div class="fw-bold">${moment(firstEntry).format('HH:mm:ss')}</div>` :
                                                '<div class="text-muted">-</div>'
                                            );
                                            //ถ้าเวลาออกมีค่าแตกต่างจากเวลาเข้าไม่ถึง 1 ชั่วโมง ให้แสดงผลเป็นยังไม่แสกนออก
                                            if (lastExit && moment(lastExit).diff(moment(
                                                    firstEntry), 'hours') < 1) {
                                                $('#doorHistoryLastExit').html(
                                                    '<div class="text-muted">ยังไม่แสกนออก</div>'
                                                );
                                            } else {
                                                $('#doorHistoryLastExit').html(
                                                    lastExit ?
                                                    `<div class="small text-muted">${moment(lastExit).format('DD/MM/YYYY')}</div>
                                             <div class="fw-bold">${moment(lastExit).format('HH:mm:ss')}</div>` :
                                                    '<div class="text-muted">-</div>'
                                                );
                                            }
                                            $('#doorHistoryWorkHours').html(
                                                `<div class="fw-bold">${workHours}</div>`
                                            );
                                            return sortedData;
                                        } else {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'เกิดข้อผิดพลาด',
                                                text: response.message ||
                                                    'ไม่สามารถโหลดข้อมูลได้'
