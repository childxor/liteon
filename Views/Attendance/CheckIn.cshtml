                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ข้อมูลโอที -->
                    <div class="row g-3">
                        <!-- ประเภทการเพิ่มโอที -->
                        <div class="col-md-12">
                            <label class="form-label">
                                <i class="fas fa-calendar-plus me-1 text-primary"></i>ประเภทการเพิ่มโอที <span class="text-danger">*</span>
                            </label>
                            <div class="d-flex align-items-center gap-3">
