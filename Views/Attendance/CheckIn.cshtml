    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="manageShiftModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>เพิ่มกะการทำงาน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <form id="shiftForm" class="needs-validation" novalidate>
                    <input type="hidden" id="shiftPersonId" name="personId">
                    <input type="hidden" id="shiftId" name="id">
                    <input type="hidden" id="shiftAction" name="action" value="add">
                    <input type="hidden" id="shiftPersonNameAddEdit" name="name">

                    <!-- ข้อมูลพนักงาน -->
                    <div class="card border-0 shadow-sm mb-3 bg-light">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                    <i class="fas fa-user fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1" id="employeeNameDisplay">-</h6>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-primary me-2" id="employeeIdDisplay">-</span>
                                        <small class="text-muted" id="departmentDisplay">-</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="shiftDate" class="form-label">
                                    <i class="fas fa-calendar-alt me-1 text-primary"></i>วันที่เริ่มต้น
                                </label>
                                <input type="date" class="form-control" id="shiftDate" name="date" required>
                                <div class="invalid-feedback">กรุณาระบุวันที่</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="shiftEndDate" class="form-label">
                                    <i class="fas fa-calendar-alt me-1 text-primary"></i>วันที่สิ้นสุด (ถ้ามี)
                                </label>
                                <input type="date" class="form-control" id="shiftEndDate" name="endDate">
                                <small class="form-text text-muted">ใช้เฉพาะกรณีที่ต้องการกำหนดหลายวัน</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="departmentSelect" class="form-label">
                            <i class="fas fa-building me-1 text-primary"></i>แผนก
                        </label>
                        <select class="form-select" id="departmentSelect" name="department" required>
                            <option value="" selected>-- เลือกแผนก --</option>
                            @if (canEdit)
                            {
                                foreach (var dept in ViewBag.Dept)
                                {
                                    <option value="@dept.name">@dept.name</option>
                                }
                            }
                            else
                            {
                                foreach (var dept in ViewBag.Dept)
                                {
                                    if (ViewData["CurrentUserDepartment"] != null && dept.name == ViewData["CurrentUserDepartment"].ToString())
                                    {
                                        <option value="@dept.name" selected>@dept.name</option>
                                    }
                                }
                            }
                        </select>
                        <div class="invalid-feedback">กรุณาเลือกแผนก</div>
                    </div>

                    <div class="mb-3">
                        <label for="shiftSelect" class="form-label">
                            <i class="fas fa-clock me-1 text-primary"></i>กะการทำงาน
                        </label>
                        <select class="form-select" id="shiftSelect" name="shift" required>
                            <option value="" selected>-- เลือกกะการทำงาน --</option>
                            @foreach (var shift in ViewBag.Shiftdept)
                            {
                                <option value="@shift.shift_group" data-start="@shift.start_time" data-end="@shift.end_time">
                                    @shift.shift_name (@shift.shift_group) - @shift.start_time - @shift.end_time
                                </option>
                            }
                        </select>
                        <div class="invalid-feedback">กรุณาเลือกกะการทำงาน</div>
                    </div>

                    <div class="row mb-3" id="shiftTimeInfoContainer">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100 bg-success bg-opacity-10">
                                <div class="card-body p-3">
                                    <label class="form-label small">
                                        <i class="fas fa-sign-in-alt me-1 text-success"></i>เวลาเข้างาน
                                    </label>
                                    <h5 class="mb-0 text-success" id="shiftStartTimeDisplay">-</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100 bg-danger bg-opacity-10">
                                <div class="card-body p-3">
                                    <label class="form-label small">
                                        <i class="fas fa-sign-out-alt me-1 text-danger"></i>เวลาออกงาน
                                    </label>
                                    <h5 class="mb-0 text-danger" id="shiftEndTimeDisplay">-</h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="shiftRemark" class="form-label">
                            <i class="fas fa-comment me-1 text-primary"></i>หมายเหตุ
                        </label>
                        <textarea class="form-control" id="shiftRemark" name="remark" rows="2" placeholder="ระบุหมายเหตุ (ถ้ามี)"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="saveShiftBtn">
                    <i class="fas fa-save me-2"></i>บันทึก
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>ยกเลิก
                </button>
            </div>
        </div>
    </div>
</div>

