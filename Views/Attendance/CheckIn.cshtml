                                    }, 300);
                                }, index * 100);
                            });
                        }
                        // ฟังก์ชันแปลงวิธีการสแกนเป็นข้อความ
                        function getScanMethodText(method) {
                            switch (method) {
                                case 'FINGER':
                                    return 'ลายนิ้วมือ';
                                case 'CARD':
                                    return 'บัตร';
                                case 'FACE':
                                    return 'ใบหน้า';
                                default:
                                    return method || 'ไม่ระบุ';
                            }
                        }
                        // โหลด filter ที่บันทึกไว้
                        const savedFilters = loadFilters();
