                                                Swal.fire({
                                                    icon: 'error',
                                                    title: 'เกิดข้อผิดพลาด', 
                                                    text: response.message ||
                                                        'ไม่สามารถลบสิทธิ์การเข้าประตูได้'
                                                });
                                            }
                                        },
                                        error: function() {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'เกิดข้อผิดพลาด',
                                                text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                            });
                                        }
                                    });
                                }
                            });
                        });
                        // แก้ไข: เปลี่ยนจากการกดที่แถวเป็นการกดที่คอลัมน์กะเท่านั้น
                        $('#mTable').on('click', 'tbody td:nth-child(7)', function() {
