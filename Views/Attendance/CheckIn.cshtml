                            row.firstTime, // ส่งค่า firstTime
                            row.lastTime, // ส่งค่า lastTime
                            row.scanData, // ส่งข้อมูลการสแกนทั้งหมด
                            row.status // ส่งสถานะ
                        ];
                    }

                    function renderScanStatus(time, label, row) {
                        // ถ้าเป็นการลา
                        if (row.leaveInfo) {
                            // ถ้าไม่มีเวลาลาระบุ (ลาเต็มวัน)
                            if (!row.leaveInfo.dteTmeIn && !row.leaveInfo.dteTmeOut) {
                                const leaveType = leaveTypes[row.leaveInfo.attenCode] || {
                                    name: `ลาประเภท ${row.leaveInfo.attenCode}`,
                                    color: 'warning',
                                    icon: 'fa-calendar-minus'
                                };
                                return `<span class="badge bg-${leaveType.color} text-dark">
                            <i class="fas ${leaveType.icon} me-1"></i>${leaveType.name}
                        </span>`;
                            }
                        }

                        // ฟังก์ชันสำหรับตรวจสอบสถานะการสแกน
                        const getScanStatusInfo = () => {
                            if (!row.scanData || !Array.isArray(row.scanData) || row.scanData.length === 0) {
                                return {
                                    hasError: false,
                                    scanTypes: [],
                                    errorMessages: []
                                };
                            }

                            const scanTypes = [];
                            const errorMessages = [];
                            let hasError = false;

                            // ตรวจสอบข้อมูลการสแกนทั้งหมด
                            row.scanData.forEach(scan => {
                                const eventName = scan.eventName?.toString() || '';

                                // ตรวจสอบสถานะการสแกน
                                if (eventName.includes('Card not Found') || eventName.includes('Invalid Card')) {
                                    hasError = true;
                                    errorMessages.push('บัตรไม่ถูกต้องหรือไม่พบ');
                                } else if (eventName.includes('Access Granted') || eventName.includes('Valid Card')) {
                                    scanTypes.push('card');
                                } else if (eventName.includes('Fingerprint Matching')) {
                                    scanTypes.push('fingerprint');
                                } else if (eventName.includes('Access Denied') || eventName.includes('Invalid Fingerprint')) {
                                    hasError = true;
                                    errorMessages.push('การเข้าถึงถูกปฏิเสธ');
                                }
                            });

                            return {
                                hasError,
                                scanTypes: [...new Set(scanTypes)], // ลบค่าซ้ำ
                                errorMessages: [...new Set(errorMessages)] // ลบค่าซ้ำ
                            };
                        };

                        // สร้างไอคอนวิธีการสแกน
                        const getScanTypeIcons = () => {
                            const scanInfo = getScanStatusInfo();
                            const scanTypes = [];

                            if (scanInfo.scanTypes.includes('fingerprint')) {
                                scanTypes.push(`<i class="fas fa-fingerprint" title="สแกนลายนิ้วมือ"></i>`);
                            }
                            if (scanInfo.scanTypes.includes('card')) {
                                scanTypes.push(`<i class="fas fa-id-card" title="สแกนบัตร"></i>`);
                            }

                            return scanTypes.length > 0 ?
                                scanTypes.join(' ') :
                                '<i class="fas fa-question-circle" title="ไม่ทราบวิธีสแกน"></i>';
                        };

                        // ตรวจสอบสถานะการสแกน
                        const scanInfo = getScanStatusInfo();

                        // แสดงผลตามประเภทการสแกน
                        if (label === 'เข้างาน') {
                            // กรณีสแกนเข้า
                            if (!time) {
                                return `<span class="badge bg-danger">
                            <i class="fas fa-times-circle me-1"></i>
                            ไม่ได้สแกนเข้า
                            </span>`;
                            }

                            // ตรวจสอบการมาสาย
                            let badgeClass = 'bg-success';
                            let extraInfo = '';
                            let tooltipContent = '';

                            if (row.shiftInfo && row.shiftInfo.startTime) {
                                const scanTime = moment(time);
                                const shiftStart = moment(row.rDate + ' ' + row.shiftInfo.startTime);
                                if (scanTime.isAfter(shiftStart)) {
                                    badgeClass = 'bg-warning';
                                    extraInfo = ' (สาย)';
                                }
                            }

                            // เพิ่มข้อมูลสถานะการสแกนใน tooltip
                            if (scanInfo.hasError) {
                                badgeClass = 'bg-warning';
                                tooltipContent = `สถานะผิดปกติ: ${scanInfo.errorMessages.join(', ')}`;
                            } else if (scanInfo.scanTypes.length > 0) {
                                const scanTypeNames = scanInfo.scanTypes.map(type =>
                                    type === 'card' ? 'บัตร' : 'ลายนิ้วมือ'
                                );
                                tooltipContent = `วิธีสแกน: ${scanTypeNames.join(', ')}`;
                            }

                            const tooltipAttr = tooltipContent ?
                                `data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="${tooltipContent}"` : '';

                            return `<span class="badge ${badgeClass}" ${tooltipAttr}>
                        ${getScanTypeIcons()}
                        ${moment(time).format('HH:mm')}${extraInfo}
                        ${scanInfo.hasError ? '<i class="fas fa-exclamation-triangle ms-1" title="มีสถานะผิดปกติ"></i>' : ''}
                    </span>`;
                        } else {
                            // กรณีสแกนออก
                            if (!time) {
                                return `<span class="badge bg-danger">
                            <i class="fas fa-times-circle me-1"></i>
                            ไม่ได้สแกนออก
                    </span>`;
                            }

                            // เพิ่มข้อมูลสถานะการสแกนใน tooltip
                            let badgeClass = 'bg-success';
                            let tooltipContent = '';

                            if (scanInfo.hasError) {
                                badgeClass = 'bg-warning';
                                tooltipContent = `สถานะผิดปกติ: ${scanInfo.errorMessages.join(', ')}`;
                            } else if (scanInfo.scanTypes.length > 0) {
                                const scanTypeNames = scanInfo.scanTypes.map(type =>
                                    type === 'card' ? 'บัตร' : 'ลายนิ้วมือ'
                                );
                                tooltipContent = `วิธีสแกน: ${scanTypeNames.join(', ')}`;
                            }

                            const tooltipAttr = tooltipContent ?
                                `data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="${tooltipContent}"` : '';

                            return `<span class="badge ${badgeClass}" ${tooltipAttr}>
                        ${getScanTypeIcons()}
                        ${moment(time).format('HH:mm')}
                        ${scanInfo.hasError ? '<i class="fas fa-exclamation-triangle ms-1" title="มีสถานะผิดปกติ"></i>' : ''}
                    </span>`;
                        }
                    }

                    function calculateWorkHours(row) {
                        if (!row.firstTime || !row.lastTime) {
                            return `<span class="badge bg-warning text-dark">
                        <i class="fas fa-clock me-1"></i>รอการคำนวณ
                        </span>`;
                        }
                        let firstTime = moment(row.firstTime);
                        let lastTime = moment(row.lastTime);
                        let workDate = moment(row.rDate);
                        let shiftInfo = row.shiftInfo || {};
                        // ปรับเวลาสำหรับกะกลางคืน
                        if (isNightShift(row.shift)) {
                            // สร้างวันที่อ้างอิงสำหรับกะกลางคืน
                            let nightShiftDate = moment(workDate);
                            // ถ้าเวลาสแกนเข้าเป็นช่วงเย็น (มากกว่า 12:00)
                            if (firstTime.hour() >= 12) {
                                firstTime = moment(nightShiftDate.format('YYYY-MM-DD') + ' ' + firstTime.format('HH:mm:ss'));
                            } else {
                                // ถ้าเป็นช่วงเช้า ให้ย้อนกลับไป 1 วัน
                                firstTime = moment(nightShiftDate.clone().subtract(1, 'days').format('YYYY-MM-DD') + ' ' +
                                    firstTime.format('HH:mm:ss'));
                            }
                            // ถ้าเวลาสแกนออกเป็นช่วงเช้า (น้อยกว่า 12:00)
                            if (lastTime.hour() < 12) {
                                lastTime = moment(nightShiftDate.format('YYYY-MM-DD') + ' ' + lastTime.format('HH:mm:ss'));
                            } else {
                                // ถ้าเป็นช่วงเย็น ให้ใช้วันเดียวกับวันที่ทำงาน
                                lastTime = moment(nightShiftDate.clone().subtract(1, 'days').format('YYYY-MM-DD') + ' ' +
                                    lastTime.format('HH:mm:ss'));
                            }
                        }
                        // คำนวณเวลาทำงานทั้งหมดเป็นนาที
                        let totalMinutes = lastTime.diff(firstTime, 'minutes');
                        // ถ้าเป็นกะกลางคืนและเวลาติดลบ ให้บวกเพิ่ม 24 ชั่วโมง
                        if (isNightShift(row.shift) && totalMinutes < 0) {
                            totalMinutes += 24 * 60;
                        }
                        // จัดการเวลาพัก
                        if (shiftInfo.breakStartTime && shiftInfo.breakEndTime) {
                            let breakStart = moment(workDate.format('YYYY-MM-DD') + ' ' + shiftInfo.breakStartTime);
                            let breakEnd = moment(workDate.format('YYYY-MM-DD') + ' ' + shiftInfo.breakEndTime);
                            // ปรับเวลาพักสำหรับกะกลางคืน
                            if (isNightShift(row.shift)) {
                                // ถ้าเวลาพักเป็นช่วงเช้า
                                if (breakStart.hour() < 12) {
                                    breakStart = moment(workDate.format('YYYY-MM-DD') + ' ' + shiftInfo.breakStartTime);
                                    breakEnd = moment(workDate.format('YYYY-MM-DD') + ' ' + shiftInfo.breakEndTime);
                                }
                            }
                            // หักเวลาพักถ้าทำงานคร่อมช่วงเวลาพัก
                            if (firstTime.isSameOrBefore(breakEnd) && lastTime.isSameOrAfter(breakStart)) {
                                let breakMinutes = breakEnd.diff(breakStart, 'minutes');
                                totalMinutes -= breakMinutes;
                            }
                        }
                        let hours = Math.max(0, (totalMinutes / 60)).toFixed(2);
                        return `<span class="badge bg-info">
                    <i class="fas fa-business-time me-1"></i>${hours} ชั่วโมง
                </span>`;
                    }

                    // ย้าย leaveTypes มาไว้ด้านนอก เพื่อให้ใช้ได้ทั่วไป
                    const leaveTypes = {
                        'AAL': {
                            name: 'ลาพักร้อนล่วงหน้า',
                            color: 'primary',
                            icon: 'fa-umbrella-beach'
                        },
                        'ABS': {
                            name: 'ขาดงาน',
                            color: 'danger',
                            icon: 'fa-user-times'
                        },
                        'ACL': {
                            name: 'ลาเนื่องจากอุบัติเหตุ',
                            color: 'danger',
                            icon: 'fa-first-aid'
                        },
                        'AL': {
                            name: 'ลาพักร้อนประจำปี',
                            color: 'primary',
                            icon: 'fa-umbrella-beach'
                        },
                        'ATR': {
                            name: 'อบรมภายนอก',
                            color: 'info',
                            icon: 'fa-chalkboard-teacher'
                        },
                        'ATW': {
                            name: 'ทำงานนอกสถานที่',
                            color: 'info',
                            icon: 'fa-building'
                        },
                        'BL': {
                            name: 'ลาเนื่องจากการเสียชีวิตของญาติ',
                            color: 'secondary',
                            icon: 'fa-praying-hands'
                        },
                        'CPS': {
                            name: 'แลกวันลา',
                            color: 'info',
                            icon: 'fa-exchange-alt'
                        },
                        'ML': {
                            name: 'ลารับราชการทหาร',
                            color: 'dark',
                            icon: 'fa-shield-alt'
                        },
                        'MO': {
                            name: 'ลาอุปสมบท (มีเงินเดือน)',
                            color: 'warning',
                            icon: 'fa-pray'
                        },
                        'PL': {
                            name: 'ลากิจ',
                            color: 'success',
                            icon: 'fa-user-clock'
                        },
                        'SL': {
                            name: 'ลาป่วย',
                            color: 'warning',
                            icon: 'fa-thermometer-half'
                        },
                        'WL': {
                            name: 'ลาแต่งงาน',
                            color: 'success',
                            icon: 'fa-heart'
                        },
                        'UL': {
                            name: 'ลาไม่รับค่าจ้าง',
                            color: 'danger',
                            icon: 'fa-ban'
                        }
                    };

                    function generateStatus(row) {
                        const statuses = [];

                        // ตรวจสอบสถานะการสแกน
                        const getScanStatusInfo = () => {
                            if (!row.scanData || !Array.isArray(row.scanData) || row.scanData.length === 0) {
                                return {
                                    hasError: false,
                                    scanTypes: [],
                                    errorMessages: []
                                };
                            }

                            const scanTypes = [];
                            const errorMessages = [];
                            let hasError = false;

                            // ตรวจสอบข้อมูลการสแกนทั้งหมด
                            row.scanData.forEach(scan => {
                                const eventName = scan.eventName?.toString() || '';

                                // ตรวจสอบสถานะการสแกน
                                if (eventName.includes('Card not Found') || eventName.includes('Invalid Card')) {
                                    hasError = true;
                                    errorMessages.push('บัตรไม่ถูกต้องหรือไม่พบ');
                                } else if (eventName.includes('Access Granted') || eventName.includes('Valid Card')) {
                                    scanTypes.push('card');
                                } else if (eventName.includes('Fingerprint Matching')) {
                                    scanTypes.push('fingerprint');
                                } else if (eventName.includes('Access Denied') || eventName.includes('Invalid Fingerprint')) {
                                    hasError = true;
                                    errorMessages.push('การเข้าถึงถูกปฏิเสธ');
                                }
                            });

                            return {
                                hasError,
                                scanTypes: [...new Set(scanTypes)], // ลบค่าซ้ำ
                                errorMessages: [...new Set(errorMessages)] // ลบค่าซ้ำ
                            };
                        };

                        const scanInfo = getScanStatusInfo();

                        // แสดงสถานะการสแกนผิดปกติ
                        if (scanInfo.hasError) {
                            const tooltipContent = `สถานะผิดปกติ: ${scanInfo.errorMessages.join(', ')}`;
                            statuses.push(`
                                <span class="badge bg-warning text-dark"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    data-bs-title="${tooltipContent}">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    สแกนผิดปกติ
                                </span>
                            `);
                        }

                        // ตรวจสอบสถานะการลาออก
                        if (row.isResigned) {
                            const resignDate = row.resignDate ? moment(row.resignDate).format('DD/MM/YYYY') : 'ไม่ระบุวันที่';
                            statuses.push(`
                            <span class="badge bg-danger"
                                data-bs-toggle="tooltip"
                                data-bs-html="true"
                                data-bs-placement="right"
                                data-bs-title="ลาออกเมื่อ: ${resignDate}">
                                <i class="fas fa-user-times me-1 fa-xs"></i>
                                ลาออกแล้ว
                                ${userPermissions.canEdit ? `
                                <button class="btn btn-sm btn-outline-light ms-1 remove-door-access py-0 px-1"
                                        data-person-id="${row.personID.split('-')[0]}"
                                        data-bs-toggle="tooltip"
                                        data-bs-title="ลบสิทธิ์ประตู">
                                    <i class="fas fa-door-closed fa-xs"></i>
                                </button>
                                ` : ''}
                            </span>
                            `);
                        }
                        // ตรวจสอบการลา
                        if (row.leaveInfo) {
                            const tooltipContent = generateLeaveTooltip(row.leaveInfo);
                            const leaveType = leaveTypes[row.leaveInfo.attenCode] || {
                                name: `ลาประเภท ${row.leaveInfo.attenCode}`,
                                color: 'warning',
                                icon: 'fa-calendar-minus'
                            };
                            // คำนวณเวลาจากเวลาเริ่มต้นและสิ้นสุด
                            const calculateLeaveHours = () => {
                                if (!row.leaveInfo.dteTmeIn || !row.leaveInfo.dteTmeOut) {
                                    return row.leaveInfo.leaveQty * 24; // ถ้าไม่มีเวลาระบุ ให้ใช้จำนวนวันคูณ 24
                                }
                                const startTime = moment(row.leaveInfo.dteTmeIn);
                                const endTime = moment(row.leaveInfo.dteTmeOut);
                                const hours = endTime.diff(startTime, 'hours', true);
                                if (hours >= 24) {
                                    const days = Math.floor(hours / 24);
                                    const remainingHours = hours % 24;
                                    return `${days} วัน ${remainingHours > 0 ? remainingHours + ' ชม.' : ''}`;
                                } else {
                                    const wholeHours = Math.floor(hours);
                                    const minutes = Math.round((hours - wholeHours) * 60);
                                    return wholeHours > 0 ?
                                        `${wholeHours} ชม. ${minutes > 0 ? minutes + ' นาที' : ''}` :
                                        `${minutes} นาที`;
                                }
                            };
                            statuses.push(`
                                <span class="badge bg-${leaveType.color}"
                                    data-bs-toggle="tooltip"
                                    data-bs-html="true"
                                    data-bs-placement="right"
                                    data-bs-title="${tooltipContent}">
                                    <i class="fas ${leaveType.icon} me-1"></i>
                                    ${leaveType.name}
                                    <span class="badge bg-light text-dark ms-1">
                                        ${row.leaveInfo.attenCode}
                                    </span>
                                    <span class="badge bg-light text-dark ms-1">
                                        ${calculateLeaveHours()}
                                    </span>
                                </span>
                            `);
                        }
                        // 2. ตรวจสอบวันหยุด
                        if (isHoliday(row.dayType)) {
                            statuses.push(`<span class="badge bg-dark text-light">
                            <i class="fas fa-calendar-times me-1"></i>วันหยุด
                            </span>`);
                        }
                        // 3. ตรวจสอบวันทำงานปกติ
                        if (isWorkingDay(row.dayType)) {
                            // ตรวจสอบการขาดงาน
                            if (!row.firstTime && !row.lastTime) {
                                const absType = leaveTypes['ABS'];
                                statuses.push(`<span class="badge bg-${absType.color}">
                                <i class="fas ${absType.icon} me-1"></i>${absType.name}
                                </span>`);
                            }
                                            // ตรวจสอบการสแกนไม่ครบ
                        else if (!row.firstTime || !row.lastTime) {
                            // เพิ่มข้อมูลวิธีการสแกนในสถานะสแกนไม่ครบ
                            let scanMethodInfo = '';
                            if (scanInfo.scanTypes.length > 0) {
                                const scanTypeNames = scanInfo.scanTypes.map(type =>
                                    type === 'card' ? 'บัตร' : 'ลายนิ้วมือ'
                                );
                                scanMethodInfo = ` (${scanTypeNames.join(', ')})`;
                            }

                            statuses.push(`<span class="badge bg-warning text-dark"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                data-bs-title="สแกนไม่ครบ${scanMethodInfo}">
                            <i class="fas fa-exclamation-triangle me-1"></i>สแกนไม่ครบ${scanMethodInfo}
                            </span>`);
                        }
                            // สถานะปกติ
                            else {
                                // เพิ่มข้อมูลวิธีการสแกนในสถานะปกติ
                                let scanMethodInfo = '';
                                if (scanInfo.scanTypes.length > 0) {
                                    const scanTypeNames = scanInfo.scanTypes.map(type =>
                                        type === 'card' ? 'บัตร' : 'ลายนิ้วมือ'
                                    );
                                    scanMethodInfo = ` (${scanTypeNames.join(', ')})`;
                                }

                                statuses.push(`<span class="badge bg-success text-light"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    data-bs-title="สแกนปกติ${scanMethodInfo}">
                                <i class="fas fa-check-circle me-1"></i>ปกติ${scanMethodInfo}
                                </span>`);
                            }
                        }
                        if (row.overtimeInfo && row.overtimeInfo.otReqNo) {
                            const otInfo = row.overtimeInfo;
                            const isApproved = otInfo.approvalStatus === 'Approved';
                            const badgeColor = isApproved ? 'success' : 'warning';
                            const badgeIcon = isApproved ? 'fa-check-circle' : 'fa-clock';
                            // ฟังก์ชันสำหรับคำนวณเวลาจากเวลาเริ่มและเวลาสิ้นสุด
                            const calculateHours = (startTime, endTime) => {
                                if (!startTime || !endTime) return 0;
                                const start = moment(startTime);
                                const end = moment(endTime);
                                return end.diff(start, 'minutes') / 60;
                            };
                            // ฟังก์ชันสำหรับแปลงเวลาเป็นชั่วโมงและนาที
                            const formatHours = (hours) => {
                                if (!hours) return '0 นาที';
                                const totalMinutes = Math.round(hours * 60);
                                if (totalMinutes < 60) return `${totalMinutes} นาที`;
                                const wholeHours = Math.floor(hours);
                                const remainingMinutes = Math.round((hours - wholeHours) * 60);
                                return remainingMinutes > 0 ? `${wholeHours} ชม. ${remainingMinutes} นาที` :
                                    `${wholeHours} ชม.`;
                            };
                            // คำนวณจำนวนชั่วโมงจากเวลาเริ่มและเวลาสิ้นสุด
                            const calculatedHours = calculateHours(otInfo.startTime, otInfo.endTime);
                            const tooltipContent = `
                            <div class='text-start'>
                                <strong>เลขที่คำขอ:</strong> ${otInfo.otReqNo || '-'}
                                <br><strong>จำนวนชั่วโมง:</strong> ${formatHours(calculatedHours)}
                                <br><strong>สถานะ:</strong> ${otInfo.approvalStatus || '-'}
                                <br><strong>เวลา:</strong> ${otInfo.startTime ? moment(otInfo.startTime).format('HH:mm') : '-'} - ${otInfo.endTime ? moment(otInfo.endTime).format('HH:mm') : '-'}
                                <br><strong>รายละเอียด:</strong>
                                <br>- OT ก่อนกะ: ${formatHours(otInfo.beforeHours)}
                                <br>- OT ปกติ: ${formatHours(otInfo.normalHours)}
                                <br>- OT หลังกะ: ${formatHours(otInfo.afterHours)}
                                ${otInfo.remark ? `<br><strong>หมายเหตุ:</strong> ${otInfo.remark}` : ''}
                                <br><strong>วันที่สร้าง:</strong> ${otInfo.createDate ? moment(otInfo.createDate).format('DD/MM/YYYY HH:mm') : '-'}
                            </div>`;
                            statuses.push(`<span class="badge bg-${badgeColor} text-light"
                            data-bs-toggle="tooltip"
                            data-bs-html="true"
                            data-bs-placement="right"
                            data-bs-title="${tooltipContent}">
                            <i class="fas ${badgeIcon} me-1"></i>OT
                            <span class="badge bg-light text-dark ms-1">
                                ${formatHours(calculatedHours)}
                            </span>
                        </span>`);
                            //ถ้าเวลาออกงานไม่มีหรือน้อยกว่าโอทีขอไว้ให้แสดงว่าไม่ได้ทำโอที
                            if (row.lastTime < row.overtimeInfo.endTime) {
                                statuses.push(`<span class="badge bg-warning text-dark">
                            <i class="fas fa-exclamation-triangle me-1"></i>โอทีไม่ครบ
                            </span>`);
                            }
                        }
                        return `<div class="d-flex flex-wrap gap-1">${statuses.join('')}</div>`;
                    }
                    // Helper functions
                    function generateLeaveTooltip(leaveInfo) {
                        // Escape HTML special characters
                        const escapeHtml = (text) => {
                            if (!text) return '-';
                            return text.toString()
                                .replace(/&/g, '&amp;')
                                .replace(/</g, '&lt;')
                                .replace(/>/g, '&gt;')
                                .replace(/"/g, '&quot;')
                                .replace(/'/g, '&#039;');
                        };
                        const content = [
                            `<div class='text-start'>`,
                            `<strong>ประเภทการลา:</strong> ${escapeHtml(leaveInfo.leaveType)}`,
                            `<br><strong>รหัสการลา:</strong> ${escapeHtml(leaveInfo.attenCode)}`,
                            `<br><strong>จำนวนวัน:</strong> ${escapeHtml(leaveInfo.leaveQty)} วัน`,
                            `<br><strong>เวลาลาเริ่มต้น:</strong> ${leaveInfo.dteTmeIn ? moment(leaveInfo.dteTmeIn).format('HH:mm') : '-'}`,
                            `<br><strong>เวลาลาสิ้นสุด:</strong> ${leaveInfo.dteTmeOut ? moment(leaveInfo.dteTmeOut).format('HH:mm') : '-'}`,
                            `<br><strong>สถานะ:</strong> ${escapeHtml(leaveInfo.approvalStatus)}`,
                            leaveInfo.remark ? `<br><strong>หมายเหตุ:</strong> ${escapeHtml(leaveInfo.remark)}` : '',
                            `<br><strong>อนุมัติเมื่อ:</strong> ${leaveInfo.apprDate ? moment(leaveInfo.apprDate).format('DD/MM/YYYY HH:mm') : '-'}`,
                            `<br><strong>ผู้อนุมัติ:</strong> ${escapeHtml(leaveInfo.bossName || leaveInfo.bossId || '-')}`,
                            `</div>`
                        ].join('');
                        return content;
                    }

                    function isHoliday(dayType) {
                        return dayType === 'H' || dayType === 'P';
                    }

                    function generateHolidayBadge() {
                        return `<span class="badge bg-dark text-light">
                    <i class="fas fa-calendar-times me-1"></i>วันหยุด
                </span>`;
                    }

                    function isWorkingDay(dayType) {
                        return dayType === 'W';
                    }

                    // จัดการ Assign Cabinet Modal
                    $(document).on('click', '[data-bs-target="#assignCabinetModal"]', function() {
                        const personId = $(this).data('person-id');
                        const personName = $(this).data('person-name');

                        // ตั้งค่าข้อมูลพนักงาน
                        $('#assignPersonId').val(personId);
                        $('#assignPersonName').text(personName);
                        $('#assignPersonIdDisplay').text(personId);

                        // โหลดข้อมูลตู้ที่ว่าง
                        loadAvailableCabinets();
                    });

                    // ฟังก์ชันโหลดตู้ทั้งหมด
                    function loadAvailableCabinets() {
                        // ทำลาย Select2 เดิมก่อน
                        if ($('#cabinetSelect').hasClass('select2-hidden-accessible')) {
                            $('#cabinetSelect').select2('destroy');
                        }

                        $('#cabinetSelect').html('<option value="">กำลังโหลด...</option>');

                        $.ajax({
                            url: appBasePath + 'Cabinet/GetAvailable',
                            type: 'GET',
                            success: function(data) {
                                $('#cabinetSelect').empty();
                                $('#cabinetSelect').append('<option value="">-- เลือกตู้ --</option>');

                                if (data && data.length > 0) {
                                    $.each(data, function(i, cabinet) {
                                        const statusInfo = getStatusInfo(cabinet.status);
                                        const ownerInfo = cabinet.OwnerName ?
                                            (cabinet.IsResigned ? `${cabinet.OwnerName} (ลาออกแล้ว)` : cabinet.OwnerName) : '';

                                        $('#cabinetSelect').append(
                                            `<option value="${cabinet.Id}"
                                                     data-cabinet-no="${cabinet.No}"
                                                     data-status="${cabinet.status}"
                                                     data-owner="${cabinet.Owner || ''}"
                                                     data-owner-name="${cabinet.OwnerName || ''}"
                                                     data-is-resigned="${cabinet.IsResigned || false}">
                                                ตู้ ${cabinet.No} (${statusInfo.text}) ${ownerInfo ? '- ' + ownerInfo : ''}
                                            </option>`
                                        );
                                    });
                                } else {
                                    $('#cabinetSelect').append('<option value="">ไม่มีตู้ในระบบ</option>');
                                }

                                // เริ่มต้น Select2
                                initCabinetSelect2();
                            },
                            error: function(xhr) {
                                console.error('Error loading cabinets:', xhr);
                                $('#cabinetSelect').html('<option value="">เกิดข้อผิดพลาดในการโหลดข้อมูล</option>');

                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'ไม่สามารถโหลดข้อมูลตู้ได้',
                                    confirmButtonText: 'ตกลง'
                                });
                            }
                        });
                    }

                    // ฟังก์ชันสำหรับแปลงสถานะ
                    function getStatusInfo(status) {
                        status = status.toString();
                        switch(status) {
                            case '0': return { text: 'ว่าง', color: 'success', icon: 'check-circle' };
                            case '1': return { text: 'มีผู้ใช้งาน', color: 'primary', icon: 'user-check' };
                            case '2': return { text: 'ชำรุด', color: 'warning', icon: 'exclamation-triangle' };
                            default: return { text: 'ไม่ทราบสถานะ', color: 'secondary', icon: 'question-circle' };
                        }
                    }

                    // ฟังก์ชันเริ่มต้น Select2
                    function initCabinetSelect2() {
                        $('#cabinetSelect').select2({
                            theme: 'bootstrap-5',
                            width: '100%',
                            dropdownParent: $('#assignCabinetModal'),
                            placeholder: "-- เลือกตู้ --",
                            allowClear: true,
                            language: {
                                noResults: function() {
                                    return "ไม่พบตู้ที่ค้นหา";
                                },
                                searching: function() {
                                    return "กำลังค้นหา...";
                                }
                            },
                            templateResult: function(option) {
                                if (!option.id) {
                                    return option.text;
                                }

                                const $option = $(option.element);
                                const cabinetNo = $option.data('cabinet-no');
                                const status = $option.data('status');
                                const ownerName = $option.data('owner-name');
                                const isResigned = $option.data('is-resigned');

                                const statusInfo = getStatusInfo(status);

                                let html = `
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            <i class="fas fa-archive text-${statusInfo.color}"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">ตู้ ${cabinetNo}</div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-${statusInfo.color} small">
                                                    <i class="fas fa-${statusInfo.icon} me-1"></i>${statusInfo.text}
                                                </span>`;

                                if (ownerName) {
                                    const ownerClass = isResigned ? 'bg-danger' : 'bg-info';
                                    const ownerText = isResigned ? `${ownerName} (ลาออก)` : ownerName;
                                    html += `<span class="badge ${ownerClass} small">${ownerText}</span>`;
                                }

                                html += `
                                            </div>
                                        </div>
                                    </div>`;

                                return $(html);
                            },
                            templateSelection: function(option) {
                                if (!option.id) {
                                    return option.text;
                                }

                                const $option = $(option.element);
                                const cabinetNo = $option.data('cabinet-no');
                                const status = $option.data('status');
                                const statusInfo = getStatusInfo(status);

                                return $(`<span><i class="fas fa-archive text-${statusInfo.color} me-1"></i>ตู้ ${cabinetNo}</span>`);
                            }
                        });
                    }

                    // เมื่อเลือกตู้
                    $(document).on('change', '#cabinetSelect', function() {
                        const selectedOption = $(this).find('option:selected');
                        const cabinetNo = selectedOption.data('cabinet-no');
                        const status = selectedOption.data('status');
                        const ownerName = selectedOption.data('owner-name');
                        const isResigned = selectedOption.data('is-resigned');

                        if (cabinetNo) {
                            const statusInfo = getStatusInfo(status);
                            const alertClass = status === '0' ? 'alert-success' :
                                             status === '2' ? 'alert-warning' : 'alert-primary';

                            let infoHtml = `<strong>ตู้ที่เลือก:</strong> ${cabinetNo}<br>`;
                            infoHtml += `<strong>สถานะ:</strong> <span class="badge bg-${statusInfo.color}"><i class="fas fa-${statusInfo.icon} me-1"></i>${statusInfo.text}</span>`;

                            if (ownerName) {
                                const ownerClass = isResigned ? 'bg-danger' : 'bg-info';
                                const ownerText = isResigned ? `${ownerName} (ลาออกแล้ว)` : ownerName;
                                infoHtml += `<br><strong>เจ้าของปัจจุบัน:</strong> <span class="badge ${ownerClass}">${ownerText}</span>`;

                                if (status === '1') {
                                    infoHtml += `<br><small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>การกำหนดตู้นี้จะแทนที่เจ้าของเดิม</small>`;
                                }
                            }

                            $('#selectedCabinetInfo .d-flex > div').html(infoHtml);
                            $('#selectedCabinetInfo').removeClass('d-none alert-success alert-warning alert-primary').addClass(alertClass);
                        } else {
                            $('#selectedCabinetInfo').addClass('d-none');
                        }
                    });

                    // บันทึกการกำหนดตู้
                    $('#btnAssignCabinet').click(function() {
                        const form = $('#assignCabinetForm')[0];
                        const personId = $('#assignPersonId').val();
                        const cabinetId = $('#cabinetSelect').val();

                        if (!cabinetId) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'กรุณาเลือกตู้',
                                text: 'กรุณาเลือกตู้เก็บของที่ต้องการกำหนด',
                                confirmButtonText: 'ตกลง'
                            });
                            return;
                        }

                        // แสดง loading
                        Swal.fire({
                            title: 'กำลังดำเนินการ',
                            text: 'กำลังกำหนดตู้ให้พนักงาน...',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: appBasePath + 'Cabinet/AssignToEmployee',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                Id: parseInt(cabinetId),
                                Owner: personId
                            }),
                            success: function(response) {
                                Swal.close();

                                Swal.fire({
                                    icon: 'success',
                                    title: 'กำหนดตู้สำเร็จ',
                                    text: 'กำหนดตู้เก็บของให้พนักงานเรียบร้อยแล้ว',
                                    confirmButtonText: 'ตกลง'
                                }).then(() => {
                                    // ปิด modal
                                    $('#assignCabinetModal').modal('hide');

                                    // รีเฟรช DataTable
                                    if (dataTable) {
                                        dataTable.ajax.reload(null, false);
                                    }
                                });
                            },
                            error: function(xhr) {
                                Swal.close();

                                const errorMessage = xhr.responseText || 'ไม่สามารถกำหนดตู้ได้';
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: errorMessage,
                                    confirmButtonText: 'ตกลง'
                                });
                            }
                        });
                    });

                    // ล้างข้อมูลเมื่อปิด modal
                    $('#assignCabinetModal').on('hidden.bs.modal', function() {
                        $('#assignCabinetForm')[0].reset();
                        $('#selectedCabinetInfo').addClass('d-none');
                        $('#assignPersonName').text('-');
                        $('#assignPersonIdDisplay').text('-');

                        // ทำลาย Select2 และสร้างใหม่
                        if ($('#cabinetSelect').hasClass('select2-hidden-accessible')) {
                            $('#cabinetSelect').select2('destroy');
                        }
                        $('#cabinetSelect').html('<option value="">-- เลือกตู้ --</option>');
                    });

                    // ฟังก์ชันลบคนออกจากตู้
                    window.removeCabinet = function(personID, cabinetNo) {
                        // แสดง confirmation dialog
                        Swal.fire({
                            title: 'ยืนยันการลบ',
                            html: `<div class="text-start">
                                <p><strong>พนักงาน:</strong> ${personID}</p>
                                <p><strong>ตู้:</strong> ${cabinetNo}</p>
                                <p class="text-warning mt-3"><i class="fas fa-exclamation-triangle me-2"></i>การดำเนินการนี้จะ:</p>
                                <ul class="text-muted">
                                    <li>ลบพนักงานออกจากตู้ ${cabinetNo}</li>
                                    <li>เปลี่ยนสถานะตู้เป็น "ว่าง"</li>
                                </ul>
                            </div>`,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#dc3545',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: '<i class="fas fa-trash me-1"></i>ยืนยันลบ',
                            cancelButtonText: '<i class="fas fa-times me-1"></i>ยกเลิก',
                            focusConfirm: false,
                            focusCancel: true
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // หา Cabinet ID จากข้อมูลใน DataTable
                                findCabinetIdAndRemove(personID, cabinetNo);
                            }
                        });
                    };

                    // ฟังก์ชันหา Cabinet ID และลบ
                    function findCabinetIdAndRemove(personID, cabinetNo) {
                        // แสดง loading
                        Swal.fire({
                            title: 'กำลังดำเนินการ',
                            text: 'กำลังลบคนออกจากตู้...',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        // หา Cabinet ID จากการค้นหาตู้ที่มีเจ้าของ
                        $.ajax({
                            url: appBasePath + 'Cabinet/GetByOwner',
                            type: 'GET',
                            data: { owner: personID },
                            success: function(cabinets) {
                                // หาตู้ที่ตรงกับหมายเลขที่ต้องการลบ
                                const targetCabinet = cabinets.find(cabinet => cabinet.No === cabinetNo);

                                if (targetCabinet) {
                                    // เรียก API ลบคนออกจากตู้
                                    releaseCabinet(targetCabinet.Id, personID, cabinetNo);
                                } else {
                                    Swal.close();
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'ไม่พบข้อมูลตู้',
                                        text: `ไม่พบตู้หมายเลข ${cabinetNo} ที่ผูกกับพนักงาน ${personID}`,
                                        confirmButtonText: 'ตกลง'
                                    });
                                }
                            },
                            error: function(xhr) {
                                Swal.close();
                                console.error('Error finding cabinet:', xhr);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'ไม่สามารถค้นหาข้อมูลตู้ได้',
                                    confirmButtonText: 'ตกลง'
                                });
                            }
                        });
                    }

                    // ฟังก์ชันลบคนออกจากตู้
                    function releaseCabinet(cabinetId, personID, cabinetNo) {
                        $.ajax({
                            url: appBasePath + 'Cabinet/ReleaseCabinet',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                Id: parseInt(cabinetId)
                            }),
                            success: function(response) {
                                Swal.close();

                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ',
                                    html: `<div class="text-start">
                                        <p><i class="fas fa-check-circle text-success me-2"></i>ลบพนักงาน <strong>${personID}</strong> ออกจากตู้ <strong>${cabinetNo}</strong> เรียบร้อยแล้ว</p>
                                        <p class="text-muted mt-2"><i class="fas fa-info-circle me-2"></i>ตู้ ${cabinetNo} ได้เปลี่ยนสถานะเป็น "ว่าง" แล้ว</p>
                                    </div>`,
                                    confirmButtonText: 'ตกลง',
                                    timer: 3000,
                                    timerProgressBar: true
                                }).then(() => {
                                    // รีเฟรช DataTable
                                    if (dataTable) {
                                        dataTable.ajax.reload(null, false);
                                    }
                                });
                            },
                            error: function(xhr) {
                                Swal.close();

                                const errorMessage = xhr.responseText || 'ไม่สามารถลบคนออกจากตู้ได้';
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: errorMessage,
                                    confirmButtonText: 'ตกลง'
                                });
                            }
                        });
                    }

                    // ================== ฟังก์ชันสำหรับการซ่อน/แสดงคอลัมป์ ==================

                    // ตัวแปรเก็บสถานะของการแสดงคอลัมป์
                    let columnVisibility = {
                        0: true,  // expand button
                        1: true,  // รหัสพนักงาน
                        2: true,  // ชื่อ-นามสกุล
                        3: true,  // แผนก
                        4: true,  // วันที่
                        5: false, // กลุ่มของกะ
                        6: true,  // กะ
                        7: false, // ประเภทวันทำงาน
                        8: true,  // เวลาเข้า-ออก
                        9: false, // เวลาทำงาน
                        10: true, // สถานะ
                        11: true  // จัดการ
                    };

                    // ฟังก์ชันโหลดสถานะคอลัมป์จาก localStorage
                    function loadColumnVisibility() {
                        const saved = localStorage.getItem('checkinTableColumnVisibility');
                        if (saved) {
                            columnVisibility = JSON.parse(saved);
                        }

                        // อัพเดต checkbox ตามสถานะที่โหลดมา
                        $('.column-toggle').each(function() {
                            const columnIndex = parseInt($(this).val());
                            $(this).prop('checked', columnVisibility[columnIndex]);
                        });
                    }

                    // ฟังก์ชันบันทึกสถานะคอลัมป์ลง localStorage
                    function saveColumnVisibility() {
                        localStorage.setItem('checkinTableColumnVisibility', JSON.stringify(columnVisibility));
                    }

                    // ฟังก์ชันอัพเดตการแสดงคอลัมป์ในตาราง
                    function updateColumnVisibility() {
                        if (dataTable && dataTable.column) {
                                Object.keys(columnVisibility).forEach(function(columnIndex) {
                                    const column = dataTable.column(parseInt(columnIndex));
                                    if (column && typeof column.visible === 'function') {
                                        column.visible(columnVisibility[columnIndex]);
                                    }
                                });

                                // ปรับขนาดตารางหลังจากเปลี่ยนการแสดงคอลัมป์
                                setTimeout(function() {
                                    resizeTable();
                                }, 100);
                        }
                    }

                    // เหตุการณ์เมื่อคลิกปุ่มซ่อน/แสดงการตั้งค่า
                    $('#toggleColumnControls').click(function() {
                        $('#columnControls').toggle();
                        const isVisible = $('#columnControls').is(':visible');
                        $(this).html(isVisible ?
                            '<i class="fas fa-eye-slash me-1"></i>ซ่อนการตั้งค่า' :
                            '<i class="fas fa-eye me-1"></i>แสดงการตั้งค่า'
                        );
                    });

                    // เหตุการณ์เมื่อเปลี่ยนแปลงสถานะ checkbox
                    $(document).on('change', '.column-toggle', function() {
                        const columnIndex = parseInt($(this).val());
                        const isChecked = $(this).prop('checked');

                        columnVisibility[columnIndex] = isChecked;
                        saveColumnVisibility();
                        updateColumnVisibility();
                    });

                    // เหตุการณ์เมื่อคลิกปุ่มเลือกทั้งหมด
                    $('#selectAllColumns').click(function() {
                        $('.column-toggle').prop('checked', true);
                        $('.column-toggle').each(function() {
                            const columnIndex = parseInt($(this).val());
                            columnVisibility[columnIndex] = true;
                        });
                        saveColumnVisibility();
                        updateColumnVisibility();
                    });

                    // เหตุการณ์เมื่อคลิกปุ่มไม่เลือกทั้งหมด
                    $('#unselectAllColumns').click(function() {
                        $('.column-toggle').prop('checked', false);
                        $('.column-toggle').each(function() {
                            const columnIndex = parseInt($(this).val());
                            columnVisibility[columnIndex] = false;
                        });
                        // เสมอแสดงคอลัมป์รหัสพนักงานและชื่อ (จำเป็น)
                        columnVisibility[1] = true;
                        columnVisibility[2] = true;
                        $('#col-personID, #col-personName').prop('checked', true);

                        saveColumnVisibility();
                        updateColumnVisibility();
                    });

                    // โหลดสถานะคอลัมป์เมื่อเริ่มต้น
                    $(document).ready(function() {
                        loadColumnVisibility();

                        // ซ่อนส่วนควบคุมคอลัมป์ตอนเริ่มต้น
                        $('#columnControls').hide();

                        // รอให้ตารางโหลดเสร็จก่อนอัพเดตการแสดงคอลัมป์
                        if (typeof dataTable !== 'undefined' && dataTable) {
                            updateColumnVisibility();
                        }
                    });

