                                'ATL : ลางาน',
                                'CP6 : ปรับแก้โอที',
                                'CP7 : ไม่มีโอที/ CPS',
                                'CP8 : ขอ CPS',
                                'CP9 : ขอโอที'
                            ],
                            'Request OT' : [
                                'OR1 : ขอทำโอที',
                                'OR2 : เร่งส่งสินค้า',
                                'OR3 : ออเดอร์เร่งด่วน',
                                'OR4 : ขาดพนักงานกระทบงาน',
                                'OR5 : พนักงานไม่เพียงพอ',
                                'OR6 : เครื่องจักรขัดข้อง',
                                'OR7 : ไฟฟ้าดับ',
                                'OR8 : สนับสนุนไลน์ (เทคนิค, QC)',
                                'OR9 : ฝึกอบรมใหม่ (ย้ายพนักงาน)',
                                'OR0 : สิ้นเดือน',
                                'ORC : งานเอกสาร'
                            ],
                            'Request Compensate' : [
                                'CPS1 : สิ้นเดือน',
                                'CPS2 : ขอชดเชยโอที',
                                'CPS3 : เร่งส่งสินค้า'
                            ]
                        };

                        $('#selActionType').change(function() {
                            const actionType = $(this).val();
                            const reasonSelect = $('#otActionReason');
                            
                            reasonSelect.empty().append('<option value="">-- เลือกเหตุผล --</option>');
                            
                            if (actionType && actionReasons[actionType]) {
                                actionReasons[actionType].forEach((reason, idx) => {
                                    reasonSelect.append(`<option value="${reason}">${reason}</option>`);
                                });
                                // เลือกเหตุผลอันแรกทันที (index 1 เพราะ index 0 คือ -- เลือกเหตุผล --)
                                if (actionReasons[actionType].length > 0) {
                                    reasonSelect.prop('selectedIndex', 1).trigger('change');
                                }
                            }
                        });
                    }

                    // Event handlers สำหรับฟอร์มกำหนดเอง
                    $(document).on('change', '#otStartTime, #otEndTime, #otStartDate, #otEndDate', function() {
                        if ($('#customTimeForm').is(':visible')) {
                            calculateCustomOTHours();
                        }
                    });

                    // ฟังก์ชันคำนวณจำนวนชั่วโมงโอทีสำหรับฟอร์มกำหนดเอง
                    function calculateCustomOTHours() {
                        var startDate = $('#otStartDate').val();
                        var startTime = $('#otStartTime').val();
                        var endDate = $('#otEndDate').val();
                        var endTime = $('#otEndTime').val();

                        if (startDate && startTime && endDate && endTime) {
                            // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                            const formattedStartDate = formatDateForMoment(startDate);
                            const formattedEndDate = formatDateForMoment(endDate);
                            
                            var startDateTime = moment(`${formattedStartDate} ${startTime}`, 'YYYY-MM-DD HH:mm');
                            var endDateTime = moment(`${formattedEndDate} ${endTime}`, 'YYYY-MM-DD HH:mm');

                            // ตรวจสอบความถูกต้องของวันที่และเวลา
                            if (!startDateTime.isValid() || !endDateTime.isValid()) {
                                $('#calculatedHours').text('0');
                                return;
                            }

                            // ถ้าเป็นวันเดียวกันและเวลาสิ้นสุดน้อยกว่าเวลาเริ่มต้น แสดงว่าข้ามวัน
                            if (formattedStartDate === formattedEndDate && moment(endTime, 'HH:mm').isBefore(moment(startTime, 'HH:mm'))) {
                                endDateTime.add(1, 'day');
                            }

                            var duration = moment.duration(endDateTime.diff(startDateTime));
                            var hours = duration.asHours();

                            if (hours > 0) {
                                $('#calculatedHours').text(hours.toFixed(2));
                                $('#selectedStartTime').text(startDateTime.format('DD/MM/YYYY HH:mm'));
                                $('#selectedEndTime').text(endDateTime.format('DD/MM/YYYY HH:mm'));
                            } else {
                                $('#calculatedHours').text('0');
                                $('#selectedStartTime').text('-');
                                $('#selectedEndTime').text('-');
                            }
                        } else {
                            $('#calculatedHours').text('0');
                            $('#selectedStartTime').text('-');
                            $('#selectedEndTime').text('-');
                        }
                    }

                    // ฟังก์ชันคำนวณจำนวนชั่วโมงโอที
                    function calculateOTHours() {
                        const startDate = $('#otStartDate').val();
                        const startTime = $('#otStartTime').val();
                        const endDate = $('#otEndDate').val();
                        const endTime = $('#otEndTime').val();

                        if (startDate && startTime && endDate && endTime) {
                            // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                            const formattedStartDate = formatDateForMoment(startDate);
                            const formattedEndDate = formatDateForMoment(endDate);
                            
                            const startDateTime = moment(`${formattedStartDate} ${startTime}`, 'YYYY-MM-DD HH:mm');
                            const endDateTime = moment(`${formattedEndDate} ${endTime}`, 'YYYY-MM-DD HH:mm');
                            
                            // ตรวจสอบความถูกต้องของวันที่และเวลา
                            if (!startDateTime.isValid() || !endDateTime.isValid()) {
                                $('#calculatedHours').text('0');
                                return;
                            }
                            
                            // ถ้าเป็นวันเดียวกันและเวลาสิ้นสุดน้อยกว่าเวลาเริ่มต้น แสดงว่าข้ามวัน
                            if (formattedStartDate === formattedEndDate && moment(endTime, 'HH:mm').isBefore(moment(startTime, 'HH:mm'))) {
                                endDateTime.add(1, 'day');
                            }
                            
                            const duration = moment.duration(endDateTime.diff(startDateTime));
                            const hours = duration.asHours();
                            
                            if (hours > 0) {
                                $('#calculatedHours').text(hours.toFixed(2));
                                $('#selectedStartTime').text(startDateTime.format('DD/MM/YYYY HH:mm'));
                                $('#selectedEndTime').text(endDateTime.format('DD/MM/YYYY HH:mm'));
                            } else {
                                $('#calculatedHours').text('0');
                                $('#selectedStartTime').text('-');
                                $('#selectedEndTime').text('-');
                            }
                        } else {
                            $('#calculatedHours').text('0');
                            $('#selectedStartTime').text('-');
                            $('#selectedEndTime').text('-');
                        }
                    }

                    // Event listeners สำหรับการคำนวณเวลา
                    $('#otStartDate, #otStartTime, #otEndDate, #otEndTime').on('change', calculateOTHours);

