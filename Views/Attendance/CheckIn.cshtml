                    // ฟังก์ชันสำหรับจัดการ dropdown actions
                    function handleTimeAction(type, rowId, rDate, shift, time) {
                        const data = {
                            type: type,
                            personId: rowId,
                            date: rDate,
                            shift: shift,
                            time: time
                        };
                        Swal.fire({
                            title: 'ยืนยันการดำเนินการ',
                            text: 'คุณต้องการดำเนินการต่อหรือไม่?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'ยืนยัน',
                            cancelButtonText: 'ยกเลิก'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.ajax({
                                    url: appBasePath + 'Attendance/HandleTimeAction',
                                    type: 'POST',
                                    data: data,
                                    success: function(response) {
                                        if (response.success) {
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'สำเร็จ',
                                                text: response.message,
                                                timer: 1500,
                                                showConfirmButton: false
                                            }).then(() => {
                                                // รีโหลดตาราง
                                                table.ajax.reload();
                                                table.draw();
                                            });
                                        } else {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'เกิดข้อผิดพลาด',
                                                text: response.message
                                            });
                                        }
                                    },
                                    error: function() {
