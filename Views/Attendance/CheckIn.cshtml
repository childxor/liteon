                            dateFormat: "d/m/Y",
                            altFormat: "d/m/Y",
                            altInput: true,
                            allowInput: false,
                            clickOpens: true,
                            theme: "material_blue",
                            disableMobile: true,
                            // อนุญาตให้เลือกวันย้อนหลังได้ (30 วันย้อนหลัง)
                            minDate: new Date().fp_incr(-30),
                            maxDate: new Date().fp_incr(365),
                            onChange: function(selectedDates, dateStr, instance) {
                                if (selectedDates[0]) {
                                    const formattedDate = selectedDates[0].toISOString().split('T')[0];
                                    $('#otStartWorkDate').val(formattedDate);
                                    
                                    // อัพเดทวันที่สิ้นสุดให้ไม่น้อยกว่าวันที่เริ่มต้น
                                    const endPicker = document.querySelector("#otEndWorkDate")._flatpickr;
                                    if (endPicker) {
                                        endPicker.set('minDate', selectedDates[0]);
                                        // ถ้าวันที่สิ้นสุดน้อยกว่าวันที่เริ่มต้น ให้อัพเดทวันที่สิ้นสุด
                                        const currentEndDate = endPicker.selectedDates[0];
                                        if (currentEndDate && currentEndDate < selectedDates[0]) {
                                            endPicker.setDate(selectedDates[0]);
                                        }
                                    }
                                    
                                    updateDateRangeInfo();
                                }
                            },
                            onReady: function(selectedDates, dateStr, instance) {
