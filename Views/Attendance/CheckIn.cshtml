                        var addType = $('#addType').val();
                        
                        // ใช้ข้อมูลจากฟอร์มโดยตรง ไม่ต้องปรับแต่งวันที่
                        // สำหรับกะดึก (N01, NT1) วันที่จะถูกตั้งค่าไว้แล้วในฟังก์ชัน setOTTimeByHours
                        // สำหรับกะกลางวัน ถ้าเวลาสิ้นสุดน้อยกว่าเวลาเริ่มต้น แสดงว่าข้ามวัน
                        if (shiftCode !== 'N01' && shiftCode !== 'NT1') {
                            if (moment(endTime, 'HH:mm').isBefore(moment(startTime, 'HH:mm'))) {
                                endDate = moment(endDate).add(1, 'day').format('YYYY-MM-DD');
                            }
                        }
                        
                        // สร้างรายการวันที่สำหรับการเพิ่มหลายวัน
                        var workDates = [];
                        if (addType === 'single') {
                            var workDate = $('#otWorkDate').val();
                            if (workDate) {
                                workDates.push(workDate);
                            }
                        } else {
                            var startWorkDate = $('#otStartWorkDate').val();
                            var endWorkDate = $('#otEndWorkDate').val();
                            
                            if (!startWorkDate || !endWorkDate) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'ข้อมูลไม่ครบถ้วน',
                                    text: 'กรุณาเลือกวันที่เริ่มต้นและวันที่สิ้นสุด'
                                });
                                return;
                            }
                            
                            // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                            var formattedStartDate = formatDateForMoment(startWorkDate);
                            var formattedEndDate = formatDateForMoment(endWorkDate);
                            
                            var start = moment(formattedStartDate, 'YYYY-MM-DD');
                            var end = moment(formattedEndDate, 'YYYY-MM-DD');
                            
                            // ตรวจสอบความถูกต้องของวันที่
                            if (!start.isValid() || !end.isValid()) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'วันที่ไม่ถูกต้อง',
                                    text: 'กรุณาตรวจสอบรูปแบบวันที่ที่กรอก'
                                });
                                return;
                            }
                            
                            if (start.isAfter(end)) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'วันที่ไม่ถูกต้อง',
                                    text: 'วันที่เริ่มต้นต้องไม่เกินวันที่สิ้นสุด'
                                });
                                return;
                            }
                            
                            var current = start.clone();
                            while (current.isSameOrBefore(end)) {
                                workDates.push(current.format('YYYY-MM-DD'));
                                current.add(1, 'day');
                            }
                        }
                        
                        const formData = {
                            personId: $('#otPersonId').val(),
                            addType: addType,
                            workDates: workDates,
                            actionType: $('#selActionType').val(),
                            actionReason: $('#otActionReason').val(),
                            empGroup: $('#otEmpGroup').val(),
                            shift_group: $('#shift_group').val(),
                            startDate: startDate,
                            startTime: $('#otStartTime').val(),
                            endDate: endDate,
                            endTime: $('#otEndTime').val(),
                            calculatedHours: parseFloat($('#calculatedHours').text()),
                            remark: $('#otRemark').val()
                        };

                        // ตรวจสอบข้อมูลที่จำเป็น
                        if (!formData.personId || !formData.workDates || formData.workDates.length === 0 || 
                            !formData.actionType || !formData.actionReason || !formData.startDate || 
                            !formData.startTime || !formData.endDate || !formData.endTime) {
                            Swal.fire({
                                icon: 'error',
                                title: 'ข้อมูลไม่ครบถ้วน',
                                text: 'กรุณากรอกข้อมูลให้ครบถ้วน'
                            });
                            return;
                        }
                        
                        // ตรวจสอบความถูกต้องของเวลา
                        const timeFormattedStartDate = formatDateForMoment(formData.startDate);
                        const timeFormattedEndDate = formatDateForMoment(formData.endDate);
                        var startDateTime = moment(`${timeFormattedStartDate} ${formData.startTime}`, 'YYYY-MM-DD HH:mm');
                        var endDateTime = moment(`${timeFormattedEndDate} ${formData.endTime}`, 'YYYY-MM-DD HH:mm');
                        
                        if (!startDateTime.isValid() || !endDateTime.isValid()) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เวลาไม่ถูกต้อง',
                                text: 'กรุณาตรวจสอบรูปแบบวันที่และเวลาที่กรอก'
                            });
                            return;
                        }
                        
                        // ตรวจสอบว่าเวลาสิ้นสุดไม่น้อยกว่าเวลาเริ่มต้น (ยกเว้นกรณีข้ามวัน)
                        if (timeFormattedStartDate === timeFormattedEndDate && 
                            moment(formData.endTime, 'HH:mm').isBefore(moment(formData.startTime, 'HH:mm'))) {
                            // กรณีข้ามวัน ให้เพิ่มวันให้เวลาสิ้นสุด
                            endDateTime.add(1, 'day');
                            formData.endDate = endDateTime.format('YYYY-MM-DD');
                        } else if (endDateTime.isBefore(startDateTime)) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เวลาไม่ถูกต้อง',
                                text: 'เวลาสิ้นสุดต้องไม่น้อยกว่าเวลาเริ่มต้น'
                            });
                            return;
                        }


                        // ตรวจสอบข้อมูล
                        if (!formData.calculatedHours || formData.calculatedHours <= 0) {
                            Swal.fire({
                                icon: 'error',
                                title: 'ข้อมูลไม่ถูกต้อง',
                                text: 'กรุณาตรวจสอบเวลาเริ่มต้นและสิ้นสุด'
                            });
                            return;
                        }

                        if (formData.calculatedHours < 0.5) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เวลาโอทีไม่เพียงพอ',
                                text: 'เวลาโอทีต้องไม่น้อยกว่า 0.5 ชั่วโมง'
                            });
                            return;
                        }
                        
                        // แสดง loading
                        Swal.fire({
                            title: 'กำลังบันทึกโอที...',
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        
                        // บันทึกข้อมูลล่าสุดใน localStorage (ใช้วันที่แรกสำหรับการบันทึก)
                        saveLastOTData(formData.personId, {
                            workDate: formData.workDates[0],
                            actionType: formData.actionType,
                            actionReason: formData.actionReason,
                            empGroup: formData.empGroup,
                            shift_group: formData.shift_group,
                            startDate: formData.startDate,
                            startTime: formData.startTime,
                            endDate: formData.endDate,
                            endTime: formData.endTime,
                            remark: formData.remark
                        });

                        // ส่งข้อมูลไปบันทึก
                        $.ajax({
                            url: appBasePath + 'Attendance/AddOT',
                            type: 'POST',
                            data: formData,
                            success: function(response) {
                                if (response.success) {
                                    var message = response.message || 'เพิ่มโอทีเรียบร้อยแล้ว';
                                    var icon = 'success';
                                    var title = 'บันทึกโอทีสำเร็จ';
                                    
                                    // ถ้าเป็นการเพิ่มหลายวัน ให้แสดงข้อมูลเพิ่มเติม
                                    if (response.data && response.data.totalDays > 1) {
                                        title = `บันทึกโอทีสำเร็จ ${response.data.processedDays} วัน`;
                                        
                                        // ถ้ามีวันที่ข้าม ให้แสดงรายละเอียดในรูปแบบตาราง
                                        if (response.data.hasSkipped && response.data.skippedDates.length > 0) {
                                            var tableHtml = `
                                                <div class="text-start">
                                                    <div class="alert alert-success mb-3">
                                                        <i class="fas fa-check-circle me-2"></i>
                                                        <strong>${response.message}</strong>
                                                    </div>
                                                    <div class="alert alert-info mb-3">
                                                        <i class="fas fa-info-circle me-2"></i>
                                                        <strong>รหัสคำขอ: ${response.data.otReqNo}</strong>
                                                    </div>
                                                    <p class="mb-3 text-muted">วันที่ข้าม (มีการขอโอทีแล้ว):</p>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered table-striped">
                                                            <thead class="table-warning">
                                                                <tr>
                                                                    <th class="text-center" style="width: 30%">วันที่</th>
                                                                    <th class="text-center" style="width: 70%">OTReqNo ที่มีอยู่</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>`;
                                            
                                            response.data.skippedDates.forEach(function(skipped) {
                                                const momentDate = moment(skipped.date, 'YYYY-MM-DD');
                                                var formattedDate = momentDate.isValid() ? 
                                                    momentDate.format('DD/MM/YYYY') : 
                                                    new Date(skipped.date).toLocaleDateString('th-TH', {
                                                        day: '2-digit',
                                                        month: '2-digit',
                                                        year: 'numeric'
                                                    });
                                                tableHtml += `
                                                    <tr>
                                                        <td class="text-center fw-bold">${formattedDate}</td>
                                                        <td class="text-center">
                                                            <span class="badge bg-primary">${skipped.otReqNo}</span>
                                                        </td>
                                                    </tr>`;
                                            });
                                            
                                            tableHtml += `
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>`;
                                            
                                            Swal.fire({
                                                icon: icon,
                                                title: title,
                                                html: tableHtml,
                                                width: '600px',
                                                timer: 5000,
                                                showConfirmButton: true,
                                                confirmButtonText: 'เข้าใจแล้ว'
                                            });
                                        } else {
                                            // ไม่มีวันที่ข้าม แสดงข้อความปกติ
                                            message = `${response.message}\n\nรหัสคำขอ: ${response.data.otReqNo}`;
                                            Swal.fire({
                                                icon: icon,
                                                title: title,
                                                text: message,
                                                timer: 3000,
                                                showConfirmButton: true
                                            });
                                        }
                                    } else {
                                        // กรณีวันเดียว
                                        Swal.fire({
                                            icon: icon,
                                            title: title,
                                            text: message,
                                            timer: 3000,
                                            showConfirmButton: true
                                        });
                                    }
                                    
                                    // ปิด Modal
                                    const addOTModal = bootstrap.Modal.getInstance(document.getElementById('addOTModal'));
                                    addOTModal.hide();
                                    
                                    // ย้าย focus ออกจาก modal
                                    setTimeout(function() {
                                        $('body').focus();
                                    }, 100);
                                    
                                    // ไม่รีเซ็ตฟอร์มเพราะจะทำให้วันที่หายไป
                                    // form.reset();
                                    form.classList.remove('was-validated');
                                    
                                    // รีโหลดตาราง
                                    if (dataTable) {
                                        dataTable.ajax.reload();
                                    }
                                } else {
                                    var errorMessage = response.message || 'ไม่สามารถบันทึกโอทีได้';
                                    var errorIcon = 'warning';
                                    var errorTitle = 'ไม่สามารถบันทึกโอทีได้';
                                    
                                    // ถ้ามีวันที่ข้าม ให้แสดงรายละเอียดในรูปแบบตาราง
                                    if (response.data && response.data.hasSkipped && response.data.skippedDates.length > 0) {
                                        var tableHtml = `
                                            <div class="text-start">
                                                <p class="mb-3">ไม่สามารถบันทึกโอทีได้ เนื่องจากมีการขอโอทีในวันที่เลือกแล้ว:</p>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered table-striped">
                                                        <thead class="table-warning">
                                                            <tr>
                                                                <th class="text-center" style="width: 30%">วันที่</th>
                                                                <th class="text-center" style="width: 70%">OTReqNo ที่มีอยู่</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>`;
                                        
                                        response.data.skippedDates.forEach(function(skipped) {
                                            const momentDate = moment(skipped.date, 'YYYY-MM-DD');
                                            var formattedDate = momentDate.isValid() ? 
                                                momentDate.format('DD/MM/YYYY') : 
                                                new Date(skipped.date).toLocaleDateString('th-TH', {
                                                    day: '2-digit',
                                                    month: '2-digit',
                                                    year: 'numeric'
                                                });
                                            tableHtml += `
                                                <tr>
                                                    <td class="text-center fw-bold">${formattedDate}</td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary">${skipped.otReqNo}</span>
                                                    </td>
                                                </tr>`;
                                        });
                                        
                                        tableHtml += `
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>`;
                                        
                                        Swal.fire({
                                            icon: errorIcon,
                                            title: errorTitle,
                                            html: tableHtml,
                                            width: '600px',
                                            showConfirmButton: true,
                                            confirmButtonText: 'เข้าใจแล้ว'
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: errorIcon,
                                            title: errorTitle,
                                            text: errorMessage,
                                            showConfirmButton: true
                                        });
                                    }
                                }
                            },
                            error: function(xhr, status, error) {
                                console.error('AddOT Ajax error:', {xhr, status, error});
                                let errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์';
                                
                                if (xhr.responseJSON && xhr.responseJSON.message) {
                                    errorMessage = xhr.responseJSON.message;
                                } else if (xhr.status === 500) {
                                    errorMessage = 'เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์ (500) - กรุณาตรวจสอบข้อมูลที่กรอก';
                                } else if (xhr.status === 404) {
                                    errorMessage = 'ไม่พบ URL ที่ร้องขอ (404)';
                                }
                                
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: errorMessage
                                });
                            }
                        });
                    });

                    // ฟังก์ชันดูข้อมูลโอที
                    function viewOTData(personId) {
                        $.ajax({
                            url: appBasePath + 'Attendance/GetOTData',
                            type: 'GET',
                            data: { personId: personId },
                            success: function(response) {
                                if (response.success) {
                                    showOTDataModal(response.data);
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: response.message || 'ไม่สามารถดึงข้อมูลโอทีได้'
                                    });
                                }
                            },
                            error: function() {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                });
                            }
                        });
                    }

                    // ฟังก์ชันแสดง Modal ข้อมูลโอที
                    function showOTDataModal(otData) {
                        let tableRows = '';
                        if (otData && otData.length > 0) {
                            otData.forEach(function(ot) {
                                const wrkDate = moment(ot.WrkDate, 'YYYY-MM-DD').format('DD/MM/YYYY');
                                const startTime = moment(ot.DteTmeStr, 'YYYY-MM-DD HH:mm:ss').format('DD/MM/YYYY HH:mm');
                                const endTime = moment(ot.DteTmeEnd, 'YYYY-MM-DD HH:mm:ss').format('DD/MM/YYYY HH:mm');
                                const createDate = moment(ot.CreateDate, 'YYYY-MM-DD HH:mm:ss').format('DD/MM/YYYY HH:mm');
                                
                                tableRows += `
                                    <tr>
                                        <td>${ot.OTReqNo}</td>
                                        <td>${ot.FullName || ot.EmpNo}</td>
                                        <td>${wrkDate}</td>
                                        <td>${startTime}</td>
                                        <td>${endTime}</td>
                                        <td>${ot.TotalOTHrs} ชม.</td>
                                        <td>${ot.ActionType}</td>
                                        <td>${ot.ActionReason}</td>
                                        <td>${ot.ApprStatus}</td>
                                        <td>${createDate}</td>
                                        <td>${ot.OTSeqNo || '-'}</td>
                                    </tr>
                                `;
                            });
                        } else {
                            tableRows = '<tr><td colspan="10" class="text-center">ไม่พบข้อมูลโอที</td></tr>';
                        }

                        $('#otDataTable tbody').html(tableRows);
                        
                        const otDataModal = new bootstrap.Modal(document.getElementById('otDataModal'));
                        otDataModal.show();
                    }

                    // ฟังก์ชันสำหรับ Flatpickr Date Picker
                    function initializeFlatpickr() {
                        // ตั้งค่า Flatpickr สำหรับวันที่เดียว
                        const singleDatePicker = flatpickr("#otWorkDate", {
                            locale: "th",
                            dateFormat: "d/m/Y",
                            altFormat: "d/m/Y",
                            altInput: true,
                            allowInput: false,
                            clickOpens: true,
                            theme: "material_blue",
                            disableMobile: true,
                            // อนุญาตให้เลือกวันย้อนหลังได้ (30 วันย้อนหลัง)
                            minDate: new Date().fp_incr(-30),
                            maxDate: new Date().fp_incr(365),
                            onChange: function(selectedDates, dateStr, instance) {
                                if (selectedDates[0]) {
                                    const formattedDate = selectedDates[0].toISOString().split('T')[0];
                                    $('#otWorkDate').val(formattedDate);
                                    
                                    // อัพเดทวันที่เริ่มต้นและสิ้นสุดสำหรับหลายวัน
                                    $('#otStartWorkDate').val(formattedDate);
                                    $('#otEndWorkDate').val(formattedDate);
                                    
                                    // อัพเดท Flatpickr instances สำหรับหลายวัน
                                    const startPicker = document.querySelector("#otStartWorkDate")._flatpickr;
                                    const endPicker = document.querySelector("#otEndWorkDate")._flatpickr;
                                    if (startPicker) {
                                        startPicker.setDate(selectedDates[0]);
                                    }
                                    if (endPicker) {
                                        endPicker.setDate(selectedDates[0]);
                                    }
                                    
                                    // โหลดข้อมูลกะ
                                    loadShiftDataAndSetOTTimes('', formattedDate);
                                }
                            },
                            onReady: function(selectedDates, dateStr, instance) {
                                // ตรวจสอบว่าวันที่ถูกตั้งค่าไว้แล้วหรือไม่
                                const currentValue = $('#otWorkDate').val();
                                if (currentValue) {
                                    const momentDate = moment(currentValue, 'YYYY-MM-DD');
                                    if (momentDate.isValid()) {
                                        instance.setDate(momentDate.toDate(), false);
                                    }
                                }
                            }
                        });

                        // ตั้งค่า Flatpickr สำหรับวันที่เริ่มต้น (หลายวัน)
                        const startDatePicker = flatpickr("#otStartWorkDate", {
