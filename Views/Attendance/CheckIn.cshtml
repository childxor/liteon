                        loadShifts();
                    });
                    // ฟังก์ชันโหลดข้อมูลกะการทำงาน
                    function loadShifts() {
                        $.ajax({
                            url: appBasePath + 'Attendance/GetShifts',
                            type: 'GET',
                            success: function(response) {
                                if (response.success) {
                                    const shifts = response.data;
                                    $('#shiftSelect').empty().append(
                                        '<option value="">-- เลือกกะการทำงาน --</option>');
                                    shifts.forEach(function(shift) {
                                        $('#shiftSelect').append(
                                            `<option value="${shift.shift_group}" data-start="${shift.start_time}" data-end="${shift.end_time}">
                                            ${shift.shift_name} (${shift.shift_group})</option>`
                                        );
                                    });
                                }
                            },
                            error: function(error) {
                                console.error('Error loading shifts:', error);
                            }
                        });
                    }
                    // ฟังก์ชันแสดงประวัติการเปลี่ยนกะ
                    function showShiftHistory(data) {
                        const personId = data.personID.split('-')[0];
                        const personName = data.personName;
                        const deptName = data.deptName;
                        // แสดงข้อมูลพนักงานในหัว modal
                        $('#employeeInfo').text(`${personName} (${personId})`);
                        $('#departmentInfo').text(deptName);
                        // เก็บข้อมูลสำหรับการเพิ่มกะ
                        $('#shiftPersonId').val(personId);
                        // แสดง loading
                        $('.shift-history-container').html(`
                    <div class="d-flex justify-content-center p-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                        </div>
                    </div>
                    `);
                        // เปิด modal
                        const shiftHistoryModal = new bootstrap.Modal(document.getElementById('shiftHistoryModal'));
                        shiftHistoryModal.show();
                        // โหลดข้อมูลประวัติการเปลี่ยนกะ
                        loadShiftHistoryData(personId);
                    }
                    // ฟังก์ชันโหลดข้อมูลประวัติการเปลี่ยนกะ
                    function loadShiftHistoryData(personId) {
                        $.ajax({
                            url: appBasePath + 'Employee/GetShiftHistory?personId=' + personId,
                            type: 'GET',
                            success: function(data) {
                                if (!Array.isArray(data) || data.length === 0) {
                                    $('.shift-history-container').html(`
                                <div class="alert alert-info mb-3 border-0 bg-info bg-opacity-10">
                                    <i class="fas fa-info-circle me-2"></i>
                                    ไม่พบประวัติการเข้ากะ Shift
                                </div>
                            `);
                                    return;
                                }
                                // เรียงข้อมูลตามวันที่จากเก่าไปใหม่
                                data.sort((a, b) => new Date(a.date) - new Date(b.date));
                                // หาวันที่ปัจจุบัน
                                const currentDate = new Date();
                                currentDate.setHours(0, 0, 0, 0);
                                // หา record ที่ active อยู่ในปัจจุบัน
                                let activeRecord = null;
                                for (let i = data.length - 1; i >= 0; i--) {
                                    const recordDate = new Date(data[i].date);
                                    if (recordDate <= currentDate) {
                                        activeRecord = data[i];
                                        break;
                                    }
                                }

                                $('#shiftPersonName').val(activeRecord.name);

                                // สร้าง timeline แสดงประวัติแบบเรียบง่าย
                                let timelineHtml = `
                            <div class="timeline-container">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="current-shift-badge me-2">
                                        <span class="badge bg-primary">
                                            กะปัจจุบัน: ${activeRecord ? activeRecord.shiftMent : 'ไม่ระบุ'}
                                        </span>
                                    </div>
                                    <div class="timeline-legend d-flex align-items-center ms-auto">
                                        <span class="badge bg-success me-1"></span>
                                        <small class="text-muted me-3">ใช้งานอยู่</small>
                                        <span class="badge bg-warning me-1"></span>
                                        <small class="text-muted me-3">รอดำเนินการ</small>
                                        <span class="badge bg-secondary me-1"></span>
                                        <small class="text-muted">ไม่ได้ใช้งาน</small>
                                    </div>
                                </div>
                                <div class="timeline">`;
                                data.forEach(function(item, index) {
                                    const itemDate = new Date(item.date);
                                    itemDate.setMinutes(itemDate.getMinutes() + itemDate
                                    .getTimezoneOffset());
                                    // กำหนดสถานะและสี
                                    let statusClass, statusText;
                                    if (itemDate > currentDate) {
                                        statusClass = 'warning';
                                        statusText = 'รอดำเนินการ';
                                    } else if (activeRecord && item.date === activeRecord.date) {
                                        statusClass = 'success';
                                        statusText = 'ใช้งานอยู่';
                                    } else {
                                        statusClass = 'secondary';
                                        statusText = 'ไม่ได้ใช้งาน';
                                    }
                                    const isActive = activeRecord && item.date === activeRecord.date;
                                    timelineHtml += `
                                <div class="timeline-item mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div>
                                                    <span class="badge bg-${statusClass}">
                                                        <i class="fas fa-calendar me-1"></i>${formatDate(item.date)}
                                                    </span>
                                                    ${itemDate > currentDate ? '<span class="badge bg-info ms-2">อนาคต</span>' : ''}
                                                </div>
                                                <span class="badge bg-${statusClass}">${statusText}</span>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-2">
                                                        <small class="text-muted">กะการทำงาน</small>
                                                        <div>
                                                            <span class="badge bg-${isActive ? 'success' : 'primary'}">
                                                                <i class="fas fa-clock me-1"></i>${item.shiftMent}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-2">
                                                        <small class="text-muted">แผนก</small>
                                                        <div>${item.deptName} ${item.deptCode ? `(${item.deptCode})` : ''}</div>
                                                    </div>
                                                </div>
                                                ${item.remark ? `
                                                <div class="col-12 mt-2">
                                                    <div class="mb-0">
                                                        <small class="text-muted">หมายเหตุ</small>
                                                        <div class="bg-light p-2 rounded border">
                                                            <i class="fas fa-quote-left text-muted me-1 small"></i>
                                                            ${item.remark}
                                                        </div>
                                                    </div>
                                                </div>
                                                ` : ''}
                                            </div>

                                            ${(userPermissions.canEdit || userPermissions.canDelete) ? `
                                            <div class="text-end mt-2">
                                                ${userPermissions.canEdit ? `
                                                <button class="btn btn-sm btn-outline-primary me-2 edit-shift-btn"
                                                        data-shift="${item.shiftMent}"
                                                        data-date="${item.date}"
                                                        data-person-id="${item.personID}"
                                                        data-id="${item.id}"
                                                        data-remark="${item.remark || ''}"
                                                        data-department="${item.deptName}">
                                                    <i class="fas fa-edit"></i> แก้ไข
                                                </button>
                                                ` : ''}
                                                ${userPermissions.canDelete ? `
                                                <button class="btn btn-sm btn-outline-danger delete-shift-btn"
                                                        data-shift="${item.shiftMent}"
                                                        data-date="${item.date}"
                                                        data-person-id="${item.personID}"
                                                        data-id="${item.id}"
                                                        data-department="${item.deptName}">
                                                    <i class="fas fa-trash"></i> ลบ
                                                </button>
                                                ` : ''}
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>`;
                                });
                                timelineHtml += `</div></div>`;
                                // แสดงผลใน container
                                $('.shift-history-container').html(timelineHtml);
                                // เพิ่ม animation แบบง่าย
                                $('.timeline-item').hide().each(function(index) {
                                    $(this).delay(index * 100).fadeIn(300);
                                });
                                // เพิ่ม event handlers
                                setupShiftHistoryEvents();
                            },
                            error: function(xhr, status, error) {
                                $('.shift-history-container').html(`
                            <div class="alert alert-danger mb-0 border-0 bg-danger bg-opacity-10">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                ไม่สามารถโหลดข้อมูลประวัติได้: ${error}
                            </div>
                        `);
                            }
                        });
                    }
                    // ฟังก์ชันสำหรับจัดการ events ในประวัติการเปลี่ยนกะ
                    function setupShiftHistoryEvents() {
                        // Event สำหรับปุ่มแก้ไขกะ
                        $('.edit-shift-btn').on('click', function() {
                            const shiftId = $(this).data('id');
                            const personId = $(this).data('person-id');
                            const date = $(this).data('date');
                            const shift = $(this).data('shift');
                            const namePerson = $('#shiftPersonName').val();
                            const remark = $(this).data('remark') || '';
                            const department = $(this).data('department');
                            // รีเซ็ต form ก่อน
                            $('#shiftForm')[0].reset();

                            // ตั้งค่าข้อมูลใน form
                            $('#shiftId').val(shiftId);
                            $('#shiftPersonId').val(personId);
                            $('#shiftDate').val(formatDateForInput(date));
                            $('#shiftEndDate').val(''); // ไม่มีวันที่สิ้นสุดในการแก้ไข
                            $('#shiftSelect').val(shift);
                            $('#shiftRemark').val(remark);
                            $('#shiftAction').val('edit');
                            $('#shiftPersonNameAddEdit').val(namePerson);
                            $('#departmentSelect').val(department);
                            // แสดงข้อมูลพนักงานใน modal
                            const employeeInfo = $('#employeeInfo').text();
                            const departmentInfo = $('#departmentInfo').text();
                            $('#employeeNameDisplay').text(namePerson || '-');
                            $('#employeeIdDisplay').text(personId || '-');
                            $('#departmentDisplay').text(departmentInfo || '-');

                            // แสดงเวลาเข้า-ออกงานของกะที่เลือก
                            const selectedOption = $('#shiftSelect').find(`option[value="${shift}"]`);
                            const startTime = selectedOption.data('start') || '-';
                            const endTime = selectedOption.data('end') || '-';
                            $('#shiftStartTimeDisplay').text(startTime);
                            $('#shiftEndTimeDisplay').text(endTime);

                            // เปลี่ยนชื่อ modal
                            $('#manageShiftModalLabel').html('<i class="fas fa-edit me-2"></i>แก้ไขกะการทำงาน');

                            // เปิด modal
                            const manageShiftModal = new bootstrap.Modal(document.getElementById('manageShiftModal'));
                            manageShiftModal.show();
                        });
                        // Event สำหรับปุ่มลบกะ
                        $('.delete-shift-btn').on('click', function() {
                            const shiftId = $(this).data('id');
                            const personId = $(this).data('person-id');
                            const date = $(this).data('date');
                            const shift = $(this).data('shift');
                            const namePerson = $(this).data('name');
                            Swal.fire({
                                title: 'ยืนยันการลบ',
                                text: `คุณต้องการลบกะการทำงาน ${shift} วันที่ ${formatDate(date)} ใช่หรือไม่?`,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'ใช่, ลบเลย',
                                cancelButtonText: 'ยกเลิก',
                                confirmButtonColor: '#d33'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // ส่งคำขอลบกะ
                                    $.ajax({
                                        url: appBasePath + 'Attendance/DeleteShiftForperson',
                                        type: 'POST',
                                        data: {
                                            personId: personId,
                                            date: date,
                                            name: namePerson,
                                            shift: shift
                                        },
                                        success: function(response) {
                                            if (response.success) {
                                                Swal.fire({
                                                    icon: 'success',
                                                    title: 'สำเร็จ',
                                                    text: response.message,
                                                    timer: 1500,
                                                    showConfirmButton: false
                                                }).then(() => {
                                                    // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                                    loadShiftHistoryData(personId.split(
                                                        '-')[0]);
                                                });
                                            } else {
                                                Swal.fire({
                                                    icon: 'error',
                                                    title: 'เกิดข้อผิดพลาด',
                                                    text: response.message
                                                });
                                            }
                                        },
                                        error: function() {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'เกิดข้อผิดพลาด',
                                                text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                            });
                                        }
                                    });
                                }
                            });
                        });
                    }
                    // Event สำหรับปุ่มเพิ่มกะการทำงาน
                    $('#addShiftBtn').on('click', function() {
                        // รีเซ็ต form
                        $('#shiftForm')[0].reset();
                        $('#shiftAction').val('add');
                        $('#shiftId').val('');

                        // ตั้งค่าวันที่เป็นวันปัจจุบัน
                        $('#shiftDate').val(moment().format('YYYY-MM-DD'));
                        $('#shiftEndDate').val('');

                        // ดึงข้อมูลพนักงานจาก modal ประวัติกะ
                        const personId = $('#shiftPersonId').val();
                        const personName = $('#shiftPersonName').val();
                        const employeeInfo = $('#employeeInfo').text();
                        const departmentInfo = $('#departmentInfo').text();

                        // แสดงข้อมูลพนักงานใน modal
                        $('#employeeNameDisplay').text(personName || '-');
                        $('#employeeIdDisplay').text(personId || '-');
                        $('#departmentDisplay').text(departmentInfo || '-');
                        $('#shiftPersonNameAddEdit').val(personName);

                        // รีเซ็ตข้อมูลเวลาเข้า-ออกงาน
                        $('#shiftStartTimeDisplay').text('-');
                        $('#shiftEndTimeDisplay').text('-');

                        // เปลี่ยนชื่อ modal
                        $('#manageShiftModalLabel').html('<i class="fas fa-plus-circle me-2"></i>เพิ่มกะการทำงาน');

                        // เปิด modal
                        const manageShiftModal = new bootstrap.Modal(document.getElementById('manageShiftModal'));
                        manageShiftModal.show();
                    });

                    // Event เมื่อเลือกกะการทำงาน ให้แสดงเวลาเข้า-ออกงาน
                    $('#shiftSelect').on('change', function() {
                        const selectedOption = $(this).find('option:selected');
                        const startTime = selectedOption.data('start') || '-';
                        const endTime = selectedOption.data('end') || '-';
                        console.log(startTime, endTime);

                        $('#shiftStartTimeDisplay').text(startTime);
                        $('#shiftEndTimeDisplay').text(endTime);
                    });

                    // Event สำหรับปุ่มบันทึกกะการทำงาน
                    $('#saveShiftBtn').on('click', function() {
                        // ตรวจสอบความถูกต้องของข้อมูล
                        const form = $('#shiftForm')[0];
                        form.classList.add('was-validated');

                        if (!form.checkValidity()) {
                            return;
                        }

                        const personId = $('#shiftPersonId').val();
                        const date = $('#shiftDate').val();
                        const endDate = $('#shiftEndDate').val();
                        const shift = $('#shiftSelect').val();
                        const action = $('#shiftAction').val();
                        const shiftId = $('#shiftId').val();
                        const namePerson = $('#shiftPersonNameAddEdit').val();
                        const remark = $('#shiftRemark').val();
                        const department = $('#departmentSelect').val();

                        // ตรวจสอบช่วงวันที่
                        if (endDate && new Date(endDate) < new Date(date)) {
                            Swal.fire({
                                icon: 'error',
                                title: 'วันที่ไม่ถูกต้อง',
                                text: 'วันที่สิ้นสุดต้องมากกว่าหรือเท่ากับวันที่เริ่มต้น'
                            });
                            return;
                        }

                        // สร้างข้อมูลสำหรับส่ง API
                        const requestData = {
                            personId: personId,
                            shift: shift,
                            date: date,
                            namePerson: namePerson,
                            remark: remark || '',
                            department: department
                        };

                        // เพิ่มวันที่สิ้นสุดถ้ามีการระบุ
                        if (endDate) {
                            requestData.endDate = endDate;
                        }

                        // แสดง loading
                        Swal.fire({
                            title: 'กำลังบันทึกข้อมูล...',
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        // ส่งคำขอบันทึกกะ
                        if (action === 'add') {
                            $.ajax({
                                url: appBasePath + 'Attendance/AddShiftForPerson',
                                type: 'POST',
                                data: requestData,
                                success: function(response) {
                                    if (response.success) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'สำเร็จ',
                                            text: response.message,
                                            timer: 1500,
                                            showConfirmButton: false
                                        }).then(() => {
                                            // ปิด modal
                                            const manageShiftModal = bootstrap.Modal.getInstance(
                                                document.getElementById('manageShiftModal'));
                                            manageShiftModal.hide();
                                            // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                            loadShiftHistoryData(personId);

                                            // รีโหลดตารางหลักถ้าอยู่ในช่วงวันที่เดียวกัน
                                            const currentStartDate = $('#dateRangeToggle').prop('checked') ?
                                                $('#startDate').val() : $('#selectedDate').val();
                                            const currentEndDate = $('#dateRangeToggle').prop('checked') ?
                                                $('#endDate').val() : $('#selectedDate').val();

                                            if (isDateInRange(date, currentStartDate, currentEndDate) ||
                                                (endDate && isDateInRange(endDate, currentStartDate, currentEndDate))) {
                                                dataTable.ajax.reload();
                                            }
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'เกิดข้อผิดพลาด',
                                            text: response.message
                                        });
                                    }
                                },
                                error: function() {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                    });
                                }
                            });
                        } else {
                            // เพิ่ม ID สำหรับการแก้ไข
                            requestData.id = shiftId;
                            requestData.shiftMent = shift;

                            $.ajax({
                                url: appBasePath + 'Attendance/EditShift',
                                type: 'POST',
                                data: requestData,
                                success: function(response) {
                                    if (response.success) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'สำเร็จ',
                                            text: response.message,
                                            timer: 1500,
                                            showConfirmButton: false
                                        }).then(() => {
                                            // ปิด modal
                                            const manageShiftModal = bootstrap.Modal.getInstance(
                                                document.getElementById('manageShiftModal'));
                                            manageShiftModal.hide();
                                            // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                            loadShiftHistoryData(personId.split('-')[0]);

                                            // รีโหลดตารางหลัก
                                            dataTable.ajax.reload();
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'เกิดข้อผิดพลาด',
                                            text: response.message
                                        });
                                    }
                                },
                                error: function() {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                                    });
                                }
                            });
                        }
                    });

                    // ฟังก์ชั่นตรวจสอบว่าวันที่อยู่ในช่วงที่กำหนดหรือไม่
                    function isDateInRange(date, startDate, endDate) {
                        const targetDate = new Date(date);
                        const rangeStart = new Date(startDate);
                        const rangeEnd = new Date(endDate);

                        return targetDate >= rangeStart && targetDate <= rangeEnd;
                    }
                    // ฟังก์ชันสำหรับจัดรูปแบบวันที่
                    function formatDate(dateString) {
                        if (!dateString) return '-';
                        // แปลง UTC เป็น local time
                        const date = new Date(dateString);
                        date.setMinutes(date.getMinutes() + date.getTimezoneOffset());
                        return date.toLocaleDateString('th-TH', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    }
                    // ฟังก์ชันสำหรับจัดรูปแบบวันที่สำหรับ input
                    function formatDateForInput(dateString) {
                        const date = new Date(dateString);
                        date.setMinutes(date.getMinutes() + date.getTimezoneOffset());
                        return date.toISOString().split('T')[0];
                    }
                    // เพิ่มฟังก์ชันสำหรับจัดการ filter
                    function saveFilters() {
                        const isDateRange = $('#dateRangeToggle').prop('checked');
                        const currentDate = moment().format('YYYY-MM-DD');
                        const filters = {
                            dept: $(document.getElementById('selectDistrup')).val(),
                            personName: $('#employeeNameSearch').val(),
                            startDate: isDateRange ?
                                ($('#startDate').val() || currentDate) : ($('#selectedDate').val() || currentDate),
                            endDate: isDateRange ?
                                ($('#endDate').val() || currentDate) : ($('#selectedDate').val() || currentDate),
                            shiftFilter: $('#shiftFilter').val(),
                            dateRangeToggle: isDateRange,
                            hideResigned: $('#hideResignedSwitch').prop('checked'),
                            hideAbsent: $('#hideAbsentSwitch').prop('checked'),
                            showIncomplete: $('#showIncompleteSwitch').prop('checked')
                        };
                        localStorage.setItem('attendanceFilters', JSON.stringify(filters));
                    }

                    function loadFilters() {
                        const savedFilters = localStorage.getItem('attendanceFilters');
                        if (savedFilters) {
                            const filters = JSON.parse(savedFilters);
                            // ตั้งค่า date range toggle
                            $('#dateRangeToggle').prop('checked', filters.dateRangeToggle);
                            if (filters.dateRangeToggle) {
                                $('#singleDateContainer').addClass('d-none');
                                $('#dateRangeContainer').removeClass('d-none');
                                $('#startDate').val(filters.startDate);
                                $('#endDate').val(filters.endDate);
                            } else {
                                $('#singleDateContainer').removeClass('d-none');
                                $('#dateRangeContainer').addClass('d-none');
                                $('#selectedDate').val(filters.startDate);
                            }
                            // ตั้งค่า filters อื่นๆ
                            if (userPermissions.canEdit) {
                                $('#selectDistrup').val(filters.dept);
                            }
                            $('#employeeNameSearch').val(filters.personName);
                            $('#shiftFilter').val(filters.shiftFilter);
                            $('#hideAbsentSwitch').prop('checked', filters.hideAbsent);
                            $('#hideResignedSwitch').prop('checked', filters.hideResigned);
                            $('#showIncompleteSwitch').prop('checked', filters.showIncomplete);
                            return filters;
                        }
                        return null;
                    }
                    // ฟังก์ชันสร้าง DataTable
                    function createDataTable(initialFilters) {
                        // กำหนดคอลัมน์พื้นฐาน
                        var columns = [{
                                className: 'details-control text-center',
                                orderable: false,
                                data: null,
                                defaultContent: '<i class="fas fa-plus-circle text-primary"></i>',
                                width: "15px"
                            },
                            {
                                title: "<i class='fas fa-id-card me-2'></i>รหัสพนักงาน",
                                data: "personID",
                                orderable: false,
                                className: "align-middle"
                            },
                            {
                                title: "<i class='fas fa-user me-2'></i>ชื่อ-นามสกุล",
                                data: "personName",
                                className: "align-middle",
                                render: function(data, type, row) {
                                    let displayText = row.personName;

                                    // แสดงข้อมูลตู้เก็บของหรือปุ่มเพิ่มตู้
                                    if (row.cabinetInfo && row.cabinetInfo.No) {
