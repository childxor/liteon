                                    <input class="form-check-input" type="checkbox" id="addTypeToggle" name="addTypeToggle">
                                    <label class="form-check-label" for="addTypeToggle">
                                        <span class="fw-bold text-primary">เพิ่มหลายวัน</span>
                                    </label>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success" id="addTypeLabel">
                                        <i class="fas fa-calendar-day me-1"></i>เพิ่มวันเดียว
                                    </span>
                                    <small class="text-muted" id="addTypeDescription">เลือกเฉพาะวันที่ต้องการ</small>
