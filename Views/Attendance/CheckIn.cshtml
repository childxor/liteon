@model IEnumerable<emp_wrkplan>
    @using IPS_TH.Models.Employee
    @using System.Web

    @{
    ViewData["Title"] = "ข้อมูลการลงเวลา";
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
        bool canView = permissions?["CanView"] ?? false;
        bool canAdd = permissions?["CanAdd"] ?? false;
        bool canEdit = permissions?["CanEdit"] ?? false;
        bool canDelete = permissions?["CanDelete"] ?? false;
        }

        <style>
            .badge.bg-info {
                font-size: 0.9rem;
                padding: 0.5rem 0.75rem;
                font-weight: normal;
            }

            /* Timeline Styles */
            .timeline-container {
                padding: 1rem;
            }

            .timeline {
                position: relative;
                padding: 0;
                margin: 0;
            }

            .timeline.compact .timeline-item {
                margin-bottom: 1.5rem;
                position: relative;
            }

            .timeline-content {
                position: relative;
                padding-left: 1.5rem;
                border-left: 2px solid #e9ecef;
            }

            .timeline-item:last-child .timeline-content {
                border-left-color: transparent;
            }

            .timeline-item.active .timeline-content {
                border-left-color: #28a745;
            }

            .timeline-item .card {
                transition: all 0.3s ease;
                border-radius: 0.5rem;
            }

            .timeline-item .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            }

            .timeline-item.active .card.highlight {
                border-left: 3px solid #28a745;
            }

            .badge-dot {
                display: inline-block;
                width: 8px;
                height: 8px;
                border-radius: 50%;
            }

            .date-badge {
                font-weight: 500;
                font-size: 0.9rem;
            }

            .status-indicator {
                font-size: 0.8rem;
            }

            .shift-badge .badge,
            .current-shift-badge .badge {
                font-weight: 500;
                padding: 0.35rem 0.65rem;
                border-radius: 0.375rem;
            }

            .current-shift-badge .badge {
                background: linear-gradient(45deg, #4e73df, #2e59d9);
                box-shadow: 0 2px 5px rgba(78, 115, 223, 0.2);
                border: none;
                font-weight: 600;
            }

            .dept-info {
                font-size: 0.9rem;
            }

            .action-buttons .btn-link {
                text-decoration: none;
                transition: all 0.2s;
            }

            .action-buttons .btn-link:hover {
                transform: translateY(-2px);
            }

            /* Modal Styles */
            .modal-header.bg-primary {
                background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
            }

            .modal-content {
                border: none;
                border-radius: 0.5rem;
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            }

            /* Animation */
            [data-aos] {
                opacity: 0;
                transition-property: opacity, transform;
                transition-duration: 0.6s;
            }

            [data-aos="fade-right"] {
                transform: translateX(-20px);
            }

            [data-aos].aos-animate {
                opacity: 1;
                transform: translateX(0);
            }

            /* Hover effect for table rows */
            #mTable tbody tr {
                transition: all 0.2s;
            }

            #mTable tbody tr:hover {
                background-color: rgba(78, 115, 223, 0.05) !important;
                transform: translateY(-2px);
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            }

            #mTable tbody td:nth-child(7):hover {
                background-color: rgba(78, 115, 223, 0.15) !important;
                transform: translateY(-2px);
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            }

            #mTable tbody td:nth-child(7)::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 2px;
                background: linear-gradient(90deg, transparent, rgba(78, 115, 223, 0.5), transparent);
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            #mTable tbody td:nth-child(7):hover::after {
                transform: scaleX(1);
            }

            .shift-column .fas.fa-history {
                opacity: 0.7;
                transition: all 0.3s ease;
            }

            #mTable tbody td:nth-child(7):hover .fas.fa-history {
                opacity: 1;
                transform: rotate(20deg);
            }

            /* Tooltip custom style */
            .tooltip .tooltip-inner {
                background-color: #4e73df;
                box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.2);
                border-radius: 0.375rem;
                padding: 0.5rem 0.75rem;
                max-width: 300px;
            }

            .tooltip.bs-tooltip-auto[data-popper-placement^=top] .tooltip-arrow::before,
            .tooltip.bs-tooltip-top .tooltip-arrow::before {
                border-top-color: #4e73df;
            }

            .tooltip.bs-tooltip-auto[data-popper-placement^=right] .tooltip-arrow::before,
            .tooltip.bs-tooltip-end .tooltip-arrow::before {
                border-right-color: #4e73df;
            }

            .tooltip.bs-tooltip-auto[data-popper-placement^=bottom] .tooltip-arrow::before,
            .tooltip.bs-tooltip-bottom .tooltip-arrow::before {
                border-bottom-color: #4e73df;
            }

            .tooltip.bs-tooltip-auto[data-popper-placement^=left] .tooltip-arrow::before,
            .tooltip.bs-tooltip-start .tooltip-arrow::before {
                border-left-color: #4e73df;
            }

            /* Button styles */
            .btn-primary {
                background: linear-gradient(45deg, #4e73df, #2e59d9);
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(78, 115, 223, 0.4);
                transition: all 0.3s;
            }

            .btn-primary:hover {
                background: linear-gradient(45deg, #2e59d9, #224abb);
                transform: translateY(-1px);
                box-shadow: 0 0.25rem 0.5rem rgba(78, 115, 223, 0.5);
            }

            .btn-danger {
                background: linear-gradient(45deg, #e74a3b, #c72a1c);
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(231, 74, 59, 0.4);
                transition: all 0.3s;
            }

            .btn-danger:hover {
                background: linear-gradient(45deg, #c72a1c, #a52312);
                transform: translateY(-1px);
                box-shadow: 0 0.25rem 0.5rem rgba(231, 74, 59, 0.5);
            }

            /* Form controls */
            .form-control,
            .form-select {
                border-radius: 0.375rem;
                border: 1px solid #d1d3e2;
                padding: 0.75rem 1rem;
                transition: all 0.2s;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: #bac8f3;
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
            }

            /* Badge styles */
            .badge {
                font-weight: 600;
                letter-spacing: 0.3px;
            }

            .bg-gradient-primary {
                background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
            }


            /* เพิ่มเอฟเฟกต์เรืองแสงเมื่อโฮเวอร์ที่คอลัมน์กะ */
            @@keyframes pulse-border {
                0% {
                    box-shadow: 0 0 0 0 rgba(78, 115, 223, 0.4);
                }

                70% {
                    box-shadow: 0 0 0 5px rgba(78, 115, 223, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(78, 115, 223, 0);
                }
            }

            #mTable tbody td:nth-child(7):hover {
                animation: pulse-border 1.5s infinite;
            }

            .bg-gradient-primary {
                background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
            }

            .btn-gradient-primary {
                background: linear-gradient(45deg, #4e73df, #2e59d9);
                border: none;
                color: white;
                transition: all 0.3s ease;
            }

            .btn-gradient-primary:hover {
                background: linear-gradient(45deg, #2e59d9, #224abb);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

            .hover-shadow {
                transition: all 0.3s ease;
            }

            .hover-shadow:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

            .shadow-sm {
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
            }

            .hover-shadow-lg {
                transition: all 0.3s ease;
            }

            .hover-shadow-lg:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            }

            .transition-all {
                transition: all 0.3s ease;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: #bac8f3;
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
            }

            .input-group-text {
                border: none;
            }

            .form-control,
            .form-select {
                border: 1px solid #d1d3e2;
            }

            .btn-outline-primary {
                border-color: #4e73df;
                color: #4e73df;
            }

            .btn-outline-primary:hover {
                background-color: #4e73df;
                color: white;
            }
        </style>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <!-- Card ค้นหาข้อมูล -->
                    <div class="card shadow mt-4 border-0">
                        <div class="card-header bg-gradient-primary text-white py-3">
                            <h5 class="mb-0 text-light">
                                <i class="fas fa-search me-2"></i> ค้นหาข้อมูล
                            </h5>
                        </div>
                        <div class="card-body bg-light-subtle">
                            <form id="formFilter" method="post" class="needs-validation" novalidate>
                                <div class="row g-4 mb-4">
                                    <!-- ส่วนเลือกวันที่ -->
                                    <div class="col-lg-6">
                                        <div class="card h-100 border-0 shadow-sm hover-shadow-lg transition-all">
                                            <div class="card-body">
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox"
                                                        id="dateRangeToggle">
                                                    <label class="form-check-label fw-bold text-primary"
                                                        for="dateRangeToggle">
                                                        <i class="fas fa-calendar-week me-2"></i>ค้นหาหลายวัน
                                                    </label>
                                                </div>

                                                <!-- ส่วนเลือกวันเดียว -->
                                                <div id="singleDateContainer">
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-gradient-primary text-white">
                                                            <i class="far fa-calendar-alt"></i>
                                                        </span>
                                                        <input type="date" class="form-control shadow-none"
                                                            id="selectedDate" name="selectedDate"
                                                            value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                                        <button type="button"
                                                            class="btn btn-outline-primary hover-shadow" id="btnToday"
                                                            data-toggle="tooltip" title="วันนี้">
                                                            <i class="fas fa-calendar-day"></i>
                                                        </button>
                                                        <button type="button"
                                                            class="btn btn-outline-primary hover-shadow"
                                                            id="btnPrevDate" data-toggle="tooltip"
                                                            title="วันที่ก่อนหน้า">
                                                            <i class="fas fa-chevron-left"></i>
                                                        </button>
                                                        <button type="button"
                                                            class="btn btn-outline-primary hover-shadow"
                                                            id="btnNextDate" data-toggle="tooltip" title="วันที่ถัดไป">
                                                            <i class="fas fa-chevron-right"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- ส่วนเลือกช่วงวันที่ -->
                                                <div id="dateRangeContainer" class="d-none">
                                                    <div class="row g-2">
                                                        <div class="col-md-6">
                                                            <label class="form-label text-primary fw-bold">
                                                                <i class="fas fa-calendar-minus me-1"></i>วันที่เริ่มต้น
                                                            </label>
                                                            <div class="input-group">
                                                                <span
                                                                    class="input-group-text bg-gradient-primary text-white">
                                                                    <i class="fas fa-calendar-minus"></i>
                                                                </span>
                                                                <input type="date" class="form-control shadow-none"
                                                                    id="startDate" name="startDate">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label text-primary fw-bold">
                                                                <i class="fas fa-calendar-plus me-1"></i>วันที่สิ้นสุด
                                                            </label>
                                                            <div class="input-group">
                                                                <span
                                                                    class="input-group-text bg-gradient-primary text-white">
                                                                    <i class="fas fa-calendar-plus"></i>
                                                                </span>
                                                                <input type="date" class="form-control shadow-none"
                                                                    id="endDate" name="endDate">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mt-3">
                                                        <div class="btn-group w-100">
                                                            <button type="button"
                                                                class="btn btn-outline-primary hover-shadow"
                                                                data-range="7">
                                                                <i class="fas fa-calendar-week me-1"></i>7 วัน
                                                            </button>
                                                            <button type="button"
                                                                class="btn btn-outline-primary hover-shadow"
                                                                data-range="15">
                                                                <i class="fas fa-calendar-week me-1"></i>15 วัน
                                                            </button>
                                                            <button type="button"
                                                                class="btn btn-outline-primary hover-shadow"
                                                                data-range="30">
                                                                <i class="fas fa-calendar-week me-1"></i>30 วัน
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ส่วนตัวกรอง -->
                                    <div class="col-lg-6">
                                        <div class="card h-100 border-0 shadow-sm hover-shadow-lg transition-all">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-6">
                                                        <div class="input-group mb-2">
                                                            <span
                                                                class="input-group-text bg-gradient-primary text-white">
                                                                <i class="far fa-clock"></i>
                                                            </span>
                                                            <select class="form-select shadow-none" id="shiftFilter">
                                                                <option value="all">ทั้งหมด</option>
                                                                <!-- { shift_code = "OF01", shift_name = "กะออฟฟิศ (ไม่เข้ากะ)", shift_group = "OFFICE", start_time = "08:00", end_time = "18:00", sort = 7 } -->
                                                                @foreach (var shift in ViewBag.Shiftdept)
                                                                {
                                                                <option value="@shift.shift_code">@shift.shift_name
                                                                    (@shift.shift_group)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="input-group mb-2">
                                                            <span
                                                                class="input-group-text bg-gradient-primary text-white">
                                                                <i class="fas fa-users"></i>
                                                            </span>
                                                            <select class="form-control shadow-none" id="selectDistrup"
                                                                name="selectDistrup">
                                                                @if(canEdit){
                                                                <option value="all" selected>ทั้งหมด</option>
                                                                }
                                                                @foreach (var dept in ViewBag.Dept)
                                                                {
                                                                <option value="@dept.name">@dept.name</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="input-group">
                                                            <span
                                                                class="input-group-text bg-gradient-primary text-white">
                                                                <i class="fas fa-user"></i>
                                                            </span>
                                                            <input type="text" class="form-control shadow-none"
                                                                id="employeeNameSearch" name="employeeNameSearch"
                                                                placeholder="ค้นหาชื่อพนักงาน" autocomplete="off">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ปุ่มค้นหาและล้างการค้นหา -->
                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm hover-shadow-lg transition-all">
                                            <div class="card-body">
                                                <div class="d-flex gap-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox"
                                                            id="hideResignedSwitch" checked>
                                                        <label class="form-check-label text-primary fw-bold"
                                                            for="hideResignedSwitch">
                                                            <i class="fas fa-user-slash me-1"></i>ซ่อนพนักงานลาออก
                                                        </label>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox"
                                                            id="hideAbsentSwitch">
                                                        <label class="form-check-label text-primary fw-bold"
                                                            for="hideAbsentSwitch">
                                                            <i class="fas fa-user-times me-1"></i>ซ่อนพนักงานขาดงาน
                                                        </label>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox"
                                                            id="showIncompleteSwitch">
                                                        <label class="form-check-label text-primary fw-bold"
                                                            for="showIncompleteSwitch">
                                                            <i
                                                                class="fas fa-exclamation-triangle me-1"></i>แสดงเฉพาะสแกนไม่ครบ
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-gradient-primary px-4 hover-shadow"
                                                id="btnSearch" data-toggle="tooltip" title="ค้นหาข้อมูล">
                                                <i class="fas fa-search me-2"></i>ค้นหา
                                            </button>
                                            <button type="button" class="btn btn-outline-primary px-4 hover-shadow"
                                                id="clearFilter" data-toggle="tooltip" title="ล้างตัวกรองทั้งหมด">
                                                <i class="fas fa-undo me-2"></i>ล้างการค้นหา
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Card แสดงผลการค้นหา -->
                    <div class="card mt-4 shadow-hover fade-in">
                        <div class="card-header bg-success">
                            <h5 class="mb-0 text-light"><i class="fas fa-table me-2"></i> ผลการค้นหา</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                @if (canEdit)
                                {
                                <button type="button" id="exportExcel" class="btn btn-success me-2 btn-hover-translate">
                                    <i class="fas fa-file-excel me-2"></i>Export Excel
                                </button>
                                <button type="button" id="removeAllResignedAccess"
                                    class="btn btn-danger me-2 btn-hover-translate">
                                    <i class="fas fa-door-closed me-2"></i>ลบสิทธิ์ประตูพนักงานลาออกทั้งหมด
                                </button>
                                }
                            </div>
                            <div class="table-responsive">
                                <table id="mTable" class="table table-bordered table-striped table-hover table-modern">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal แสดงประวัติการเปลี่ยนกะ -->
        <div class="modal fade" id="shiftHistoryModal" tabindex="-1" aria-labelledby="shiftHistoryModalLabel"
            aria-hidden="true" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="shiftHistoryModalLabel">
                            <i class="fas fa-history me-2"></i>ประวัติการเปลี่ยนกะการทำงาน
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="ปิด"></button>
                            <input type="hidden" id="shiftPersonName" name="personName">
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <h6 class="mb-0 me-2">ข้อมูลพนักงาน:</h6>
                                <span class="badge bg-primary" id="employeeInfo"></span>
                            </div>
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 me-2">แผนก:</h6>
                                <span class="badge bg-info" id="departmentInfo"></span>
                            </div>
                        </div>

                        <div class="shift-history-container">
                            <div class="d-flex justify-content-center p-3">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="addShiftBtn">
                            <i class="fas fa-plus-circle me-2"></i>เพิ่มกะการทำงาน
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>ปิด
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal เพิ่ม/แก้ไขกะการทำงาน -->
        <div class="modal fade" id="manageShiftModal" tabindex="-1" aria-labelledby="manageShiftModalLabel"
            aria-hidden="true" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="manageShiftModalLabel">
                            <i class="fas fa-plus-circle me-2"></i>เพิ่มกะการทำงาน
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="ปิด"></button>
                    </div>
                    <div class="modal-body">
                        <form id="shiftForm" class="needs-validation" novalidate>
                            <input type="hidden" id="shiftPersonId" name="personId">
                            <input type="hidden" id="shiftId" name="id">
                            <input type="hidden" id="shiftAction" name="action" value="add">
                            <input type="hidden" id="shiftPersonNameAddEdit" name="name">

                            <!-- ข้อมูลพนักงาน -->
                            <div class="card border-0 shadow-sm mb-3 bg-light">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                            <i class="fas fa-user fs-4 text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" id="employeeNameDisplay">-</h6>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-primary me-2" id="employeeIdDisplay">-</span>
