                                                    text: response.message ||
                                                        'ลบสิทธิ์การเข้าประตูของพนักงานที่ลาออกทั้งหมดเรียบร้อยแล้ว',
                                                    timer: 1500,
                                                    showConfirmButton: false
                                                });
