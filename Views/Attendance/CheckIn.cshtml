@model IEnumerable<emp_wrkplan>
@using IPS_TH.Models.Employee
@using System.Web

@{
    ViewData["Title"] = "ข้อมูลการลงเวลา";
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canView = permissions?["CanView"] ?? false;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false;
    var sessionDept = ViewData["CurrentUserDepartment"]?.ToString();
}

@section Styles {
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
}

<style>
    .badge.bg-info {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
        font-weight: normal;
    }

    /* Timeline Styles */
    .timeline-container {
        padding: 1rem;
    }

    .timeline {
        position: relative;
        padding: 0;
        margin: 0;
    }

        .timeline.compact .timeline-item {
            margin-bottom: 1.5rem;
            position: relative;
        }

    .timeline-content {
        position: relative;
        padding-left: 1.5rem;
        border-left: 2px solid #e9ecef;
    }

    .timeline-item:last-child .timeline-content {
        border-left-color: transparent;
    }

    .timeline-item.active .timeline-content {
        border-left-color: #28a745;
    }

    .timeline-item .card {
        transition: all 0.3s ease;
        border-radius: 0.5rem;
    }

        .timeline-item .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .timeline-item.active .card.highlight {
        border-left: 3px solid #28a745;
    }

    .badge-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .date-badge {
        font-weight: 500;
        font-size: 0.9rem;
    }

    .status-indicator {
        font-size: 0.8rem;
    }

    .shift-badge .badge,
    .current-shift-badge .badge {
        font-weight: 500;
        padding: 0.35rem 0.65rem;
        border-radius: 0.375rem;
    }

    .current-shift-badge .badge {
        background: linear-gradient(45deg, #4e73df, #2e59d9);
        box-shadow: 0 2px 5px rgba(78, 115, 223, 0.2);
        border: none;
        font-weight: 600;
    }

    .dept-info {
        font-size: 0.9rem;
    }

    .action-buttons .btn-link {
        text-decoration: none;
        transition: all 0.2s;
    }

        .action-buttons .btn-link:hover {
            transform: translateY(-2px);
        }

    /* Modal Styles */
    .modal-header.bg-primary {
        background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
    }

    .modal-content {
        border: none;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    /* Animation */
    [data-aos] {
        opacity: 0;
        transition-property: opacity, transform;
        transition-duration: 0.6s;
    }

    [data-aos="fade-right"] {
        transform: translateX(-20px);
    }

    [data-aos].aos-animate {
        opacity: 1;
        transform: translateX(0);
    }

    /* Hover effect for table rows */
    #mTable tbody tr {
        transition: all 0.2s;
    }

        #mTable tbody tr:hover {
            background-color: rgba(78, 115, 223, 0.05) !important;
            transform: translateY(-2px);
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

    #mTable tbody td:nth-child(7):hover {
        background-color: rgba(78, 115, 223, 0.15) !important;
        transform: translateY(-2px);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    #mTable tbody td:nth-child(7)::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(78, 115, 223, 0.5), transparent);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    #mTable tbody td:nth-child(7):hover::after {
        transform: scaleX(1);
    }

    .shift-column .fas.fa-history {
        opacity: 0.7;
        transition: all 0.3s ease;
    }

    #mTable tbody td:nth-child(7):hover .fas.fa-history {
        opacity: 1;
        transform: rotate(20deg);
    }

    /* Tooltip custom style */
    .tooltip .tooltip-inner {
        background-color: #4e73df;
        box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.2);
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        max-width: 300px;
    }

    .tooltip.bs-tooltip-auto[data-popper-placement^=top] .tooltip-arrow::before,
    .tooltip.bs-tooltip-top .tooltip-arrow::before {
        border-top-color: #4e73df;
    }

    .tooltip.bs-tooltip-auto[data-popper-placement^=right] .tooltip-arrow::before,
    .tooltip.bs-tooltip-end .tooltip-arrow::before {
        border-right-color: #4e73df;
    }

    .tooltip.bs-tooltip-auto[data-popper-placement^=bottom] .tooltip-arrow::before,
    .tooltip.bs-tooltip-bottom .tooltip-arrow::before {
        border-bottom-color: #4e73df;
    }

    /* CSS สำหรับการควบคุมคอลัมป์ */
    #columnControls {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 0.5rem;
        padding: 1rem;
        border: 1px solid #dee2e6;
    }

        #columnControls .form-check {
            padding: 0.5rem 0.75rem;
            margin: 0.25rem 0;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
            position: relative;
        }

            #columnControls .form-check:hover {
                background-color: rgba(78, 115, 223, 0.05);
                transform: translateY(-1px);
            }

        #columnControls .form-check-input {
            width: 1.125rem;
            height: 1.125rem;
            margin-top: 0.125rem;
            margin-right: 0.5rem;
            border: 2px solid #dee2e6;
            border-radius: 0.25rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            #columnControls .form-check-input:checked {
                background-color: #4e73df;
                border-color: #4e73df;
                box-shadow: 0 0 0 2px rgba(78, 115, 223, 0.25);
            }

            #columnControls .form-check-input:focus {
                border-color: #80bdff;
                box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
            }

            #columnControls .form-check-input:hover:not(:checked) {
                border-color: #4e73df;
                box-shadow: 0 0 0 1px rgba(78, 115, 223, 0.15);
            }

        #columnControls .form-check-label {
            color: #5a5c69;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            line-height: 1.5;
            margin-left: 0.25rem;
            transition: color 0.2s ease;
        }

            #columnControls .form-check-label:hover {
                color: #4e73df;
            }

            #columnControls .form-check-label i {
                margin-right: 0.375rem;
                width: 1rem;
                text-align: center;
                opacity: 0.7;
                transition: opacity 0.2s ease;
            }

        #columnControls .form-check:hover .form-check-label i {
            opacity: 1;
        }

    /* CSS สำหรับ badge ตู้เก็บของขนาดเล็ก */
    .badge-sm {
        font-size: 0.7rem !important;
        padding: 0.2rem 0.5rem !important;
        border-radius: 0.25rem !important;
        font-weight: 500 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.25rem !important;
        line-height: 1.2 !important;
    }

        .badge-sm .btn {
            font-size: 0.65rem !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 1rem !important;
            height: 1rem !important;
            border-radius: 50% !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: all 0.2s ease !important;
        }

            .badge-sm .btn:hover {
                background-color: rgba(220, 53, 69, 0.1) !important;
                transform: scale(1.1) !important;
            }

    /* ปรับปุ่มเพิ่มตู้ให้เล็กและกระชับ */
    .btn-cabinet-add {
        font-size: 0.7rem !important;
        padding: 0.2rem 0.4rem !important;
        line-height: 1 !important;
        border-radius: 0.25rem !important;
        transition: all 0.2s ease !important;
    }

        .btn-cabinet-add:hover {
            transform: scale(1.05) !important;
            box-shadow: 0 2px 4px rgba(0, 123, 255, 0.2) !important;
        }

    #toggleColumnControls {
        transition: all 0.3s ease;
    }

        #toggleColumnControls:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.25rem 0.75rem rgba(78, 115, 223, 0.2);
        }

    /* CSS สำหรับการปรับขนาดตารางให้ responsive */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
    }

    #mTable {
        width: 100% !important;
        table-layout: auto;
        border-collapse: collapse;
    }

        #mTable th,
        #mTable td {
            white-space: nowrap;
            padding: 0.5rem 0.75rem;
            vertical-align: middle;
        }

        /* ให้คอลัมป์ที่มีเนื้อหายาวสามารถขยายได้ */
        #mTable th,
        #mTable td {
            max-width: none;
            width: auto;
        }

            /* คอลัมป์สำคัญกำหนด min-width เท่านั้น เพื่อให้ยืดได้ */
            #mTable th:nth-child(2), /* รหัสพนักงาน */
            #mTable td:nth-child(2) {
                min-width: 100px;
                width: auto;
            }

            #mTable th:nth-child(3), /* ชื่อ-นามสกุล */
            #mTable td:nth-child(3) {
                min-width: 150px;
                width: auto;
                white-space: normal;
                word-wrap: break-word;
            }

            /* ปรับคอลัมป์เวลาเข้า-ออกให้ยืดได้ตามเนื้อหา */
            #mTable th:nth-child(9), /* เวลาเข้า-ออก */
            #mTable td:nth-child(9) {
                min-width: 180px;
                width: auto;
                white-space: normal;
            }

            /* ปรับคอลัมป์สถานะ */
            #mTable th:nth-child(11), /* สถานะ */
            #mTable td:nth-child(11) {
                min-width: 100px;
                width: auto;
                text-align: center;
            }

            /* ปรับคอลัมป์จัดการ */
            #mTable th:nth-child(12), /* จัดการ */
            #mTable td:nth-child(12) {
                min-width: 80px;
                width: auto;
                text-align: center;
            }

            /* คอลัมป์อื่นๆ ให้ยืดอัตโนมัติ */
            #mTable th:nth-child(4), /* แผนก */
            #mTable td:nth-child(4),
            #mTable th:nth-child(5), /* วันที่ */
            #mTable td:nth-child(5),
            #mTable th:nth-child(6), /* กลุ่มของกะ */
            #mTable td:nth-child(6),
            #mTable th:nth-child(7), /* กะ */
            #mTable td:nth-child(7),
            #mTable th:nth-child(8), /* ประเภทวันทำงาน */
            #mTable td:nth-child(8),
            #mTable th:nth-child(10), /* เวลาทำงาน */
            #mTable td:nth-child(10) {
                width: auto;
                min-width: fit-content;
            }

    /* สำหรับหน้าจอขนาดเล็ก */
    @@media (max-width: 768px) {
        #mTable th,
        #mTable td {
            font-size: 0.875rem;
            padding: 0.25rem 0.5rem;
        }

        .table-responsive {
            font-size: 0.875rem;
        }
    }

    /* สำหรับหน้าจอขนาดใหญ่ */
    @@media (min-width: 1200px) {
        #mTable {
            font-size: 0.9rem;
        }
    }

    /* ป้องกัน layout shift */
    #mTable.dataTable {
        border-collapse: collapse !important;
    }

    /* ปรับ DataTable responsive controls */
    table.dataTable.dtr-inline.collapsed > tbody > tr > td.dtr-control,
    table.dataTable.dtr-inline.collapsed > tbody > tr > th.dtr-control {
        position: relative;
        padding-left: 30px;
        cursor: pointer;
    }

        table.dataTable.dtr-inline.collapsed > tbody > tr > td.dtr-control:before,
        table.dataTable.dtr-inline.collapsed > tbody > tr > th.dtr-control:before {
            top: 50%;
            left: 5px;
            height: 1em;
            width: 1em;
            margin-top: -9px;
            display: block;
            position: absolute;
            color: #4e73df;
            border: 2px solid #4e73df;
            border-radius: 3px;
            box-shadow: 0 0 3px rgba(78, 115, 223, 0.2);
            box-sizing: content-box;
            text-align: center;
            text-indent: 0 !important;
            font-family: "FontAwesome";
            line-height: 1em;
            content: "\f067";
            background-color: #fff;
        }

    table.dataTable.dtr-inline.collapsed > tbody > tr.parent > td.dtr-control:before,
    table.dataTable.dtr-inline.collapsed > tbody > tr.parent > th.dtr-control:before {
        content: "\f068";
        background-color: #4e73df;
        color: white;
    }

    .tooltip.bs-tooltip-auto[data-popper-placement^=left] .tooltip-arrow::before,
    .tooltip.bs-tooltip-start .tooltip-arrow::before {
        border-left-color: #4e73df;
    }

    /* Button styles */
    .btn-primary {
        background: linear-gradient(45deg, #4e73df, #2e59d9);
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(78, 115, 223, 0.4);
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #2e59d9, #224abb);
            transform: translateY(-1px);
            box-shadow: 0 0.25rem 0.5rem rgba(78, 115, 223, 0.5);
        }

    .btn-danger {
        background: linear-gradient(45deg, #e74a3b, #c72a1c);
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(231, 74, 59, 0.4);
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: linear-gradient(45deg, #c72a1c, #a52312);
            transform: translateY(-1px);
            box-shadow: 0 0.25rem 0.5rem rgba(231, 74, 59, 0.5);
        }

    /* Form controls */
    .form-control,
    .form-select {
        border-radius: 0.375rem;
        border: 1px solid #d1d3e2;
        padding: 0.75rem 1rem;
        transition: all 0.2s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #bac8f3;
            box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
        }

    /* Badge styles */
    .badge {
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .bg-gradient-primary {
        background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
    }


    /* เพิ่มเอฟเฟกต์เรืองแสงเมื่อโฮเวอร์ที่คอลัมน์กะ */
    @@keyframes pulse-border {
        0% {
            box-shadow: 0 0 0 0 rgba(78, 115, 223, 0.4);
        }

        70% {
            box-shadow: 0 0 0 5px rgba(78, 115, 223, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(78, 115, 223, 0);
        }
    }

    #mTable tbody td:nth-child(7):hover {
        animation: pulse-border 1.5s infinite;
    }

    .bg-gradient-primary {
        background: linear-gradient(45deg, #4e73df, #2e59d9) !important;
    }

    .btn-gradient-primary {
        background: linear-gradient(45deg, #4e73df, #2e59d9);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-gradient-primary:hover {
            background: linear-gradient(45deg, #2e59d9, #224abb);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }

    .hover-shadow-lg {
        transition: all 0.3s ease;
    }

        .hover-shadow-lg:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .transition-all {
        transition: all 0.3s ease;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
    }

    .input-group-text {
        border: none;
    }

    .form-control,
    .form-select {
        border: 1px solid #d1d3e2;
    }

    .btn-outline-primary {
        border-color: #4e73df;
        color: #4e73df;
    }

            .btn-outline-primary:hover {
        background-color: #4e73df;
        color: white;
    }

    /* CSS สำหรับปุ่มเพิ่มโอที */
    .add-ot-btn {
        transition: all 0.2s ease;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #ffc107;
        color: #ffc107;
        background-color: transparent;
    }

    .add-ot-btn:hover {
        background-color: #ffc107;
        color: #000;
        transform: scale(1.1);
        box-shadow: 0 2px 4px rgba(255, 193, 7, 0.3);
    }

    .add-ot-btn:focus {
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    /* CSS สำหรับ Toggle Switch ประเภทการเพิ่มโอที */
    .form-check-input[type="checkbox"] {
        width: 3rem !important;
        height: 1.5rem !important;
        margin-top: 0.125rem !important;
        margin-right: 0.75rem !important;
        border: 2px solid #dee2e6 !important;
        border-radius: 1rem !important;
        transition: all 0.3s ease !important;
        cursor: pointer !important;
        position: relative !important;
        background-color: #e9ecef !important;
    }

    .form-check-input[type="checkbox"]:checked {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25) !important;
    }

    .form-check-input[type="checkbox"]:focus {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }

    .form-check-input[type="checkbox"]:hover:not(:checked) {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 1px rgba(13, 110, 253, 0.15) !important;
    }

    .form-check-label {
        color: #495057 !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        user-select: none !important;
        line-height: 1.5 !important;
        transition: color 0.2s ease !important;
        padding: 0.5rem !important;
        border-radius: 0.375rem !important;
        border: 1px solid transparent !important;
        transition: all 0.2s ease !important;
    }

    .form-check-label:hover {
        color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.05) !important;
        border-color: rgba(13, 110, 253, 0.1) !important;
    }

    .form-check-input[type="checkbox"]:checked + .form-check-label {
        color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.1) !important;
        border-color: rgba(13, 110, 253, 0.2) !important;
    }

    /* Animation สำหรับ toggle switch */
    .form-check-input[type="checkbox"]:checked {
        animation: toggle-pulse 0.3s ease-in-out !important;
    }

    @@keyframes toggle-pulse {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
        100% {
            transform: scale(1);
        }
    }

    /* Badge styles สำหรับแสดงสถานะ */
    #addTypeLabel {
        transition: all 0.3s ease !important;
        font-size: 0.875rem !important;
        padding: 0.5rem 0.75rem !important;
    }

    #addTypeLabel.bg-success {
        background: linear-gradient(45deg, #198754, #20c997) !important;
        box-shadow: 0 2px 4px rgba(25, 135, 84, 0.2) !important;
    }

    #addTypeLabel.bg-primary {
        background: linear-gradient(45deg, #0d6efd, #0b5ed7) !important;
        box-shadow: 0 2px 4px rgba(13, 110, 253, 0.2) !important;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .form-check-input[type="checkbox"] {
            width: 2.5rem !important;
            height: 1.25rem !important;
        }
        
        .form-check-label {
            padding: 0.75rem !important;
        }
        
        #addTypeLabel {
            font-size: 0.8rem !important;
            padding: 0.4rem 0.6rem !important;
        }
    }

    /* CSS สำหรับ SweetAlert2 ตาราง */
    .swal2-popup .table {
        margin-bottom: 0 !important;
        font-size: 0.875rem !important;
    }

    .swal2-popup .table th {
        background-color: #ffc107 !important;
        color: #000 !important;
        font-weight: 600 !important;
        border-color: #dee2e6 !important;
        padding: 0.5rem !important;
        font-size: 0.8rem !important;
    }

    .swal2-popup .table td {
        padding: 0.5rem !important;
        border-color: #dee2e6 !important;
        vertical-align: middle !important;
