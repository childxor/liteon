                            <div class="invalid-feedback">กรุณาเลือกประเภทการเพิ่มโอที</div>
                        </div>

                        <!-- วันที่ทำงาน (วันเดียว) -->
                        <div class="col-md-6" id="singleDateSection">
                            <label for="otWorkDate" class="form-label">
                                <i class="fas fa-calendar-day me-1 text-primary"></i>วันที่ทำงาน <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-calendar-alt"></i>
                                </span>
                                <input type="text" class="form-control flatpickr-single" id="otWorkDate" name="workDate" placeholder="เลือกวันที่ทำงาน" readonly required>
                            </div>
                            <div class="invalid-feedback">กรุณาเลือกวันที่ทำงาน</div>
                        </div>

                        <!-- วันที่ทำงาน (หลายวัน) -->
                        <div class="col-md-12" id="multipleDateSection" style="display: none;">
                            <label class="form-label">
                                <i class="fas fa-calendar-week me-1 text-primary"></i>เลือกวันที่ทำงาน <span class="text-danger">*</span>
                            </label>
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label for="otStartWorkDate" class="form-label">
                                        <i class="fas fa-calendar-plus me-1 text-success"></i>วันที่เริ่มต้น
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-calendar-alt"></i>
                                        </span>
                                        <input type="text" class="form-control flatpickr-start" id="otStartWorkDate" name="startWorkDate" placeholder="เลือกวันที่เริ่มต้น" readonly>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <label for="otEndWorkDate" class="form-label">
                                        <i class="fas fa-calendar-minus me-1 text-danger"></i>วันที่สิ้นสุด
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-calendar-alt"></i>
                                        </span>
                                        <input type="text" class="form-control flatpickr-end" id="otEndWorkDate" name="endWorkDate" placeholder="เลือกวันที่สิ้นสุด" readonly>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="button" class="btn btn-primary w-100" id="generateDateRangeBtn">
                                        <i class="fas fa-calendar-check me-1"></i>สร้าง
                                    </button>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="alert alert-info d-flex align-items-center" id="dateRangeInfo" style="display: none;">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <div>
                                        <strong>ช่วงวันที่ที่เลือก:</strong>
                                        <span id="dateRangeText" class="ms-2">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>

