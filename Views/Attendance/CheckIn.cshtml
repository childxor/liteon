                    });

                    // ฟังก์ชันตั้งค่าเวลาโอทีตามจำนวนชั่วโมง
                    function setOTTimeByHours(hours) {
                        if (window.currentShiftData) {
                            var startTime = window.currentShiftData.ot_start_time;
                            var endTime = moment(startTime, 'HH:mm').add(hours, 'hours').format('HH:mm');
                            
                            $('#otStartTime').val(startTime);
                            $('#otEndTime').val(endTime);
                            
                            // ตั้งค่าวันที่ให้ถูกต้อง
                            // ใช้วันที่ทำงานเป็นวันที่เริ่มต้นและสิ้นสุด
                            const workDate = window.currentShiftData.workDate;
                            const formattedWorkDate = formatDateForMoment(workDate);
                            $('#otStartDate').val(formattedWorkDate);
                            $('#otEndDate').val(formattedWorkDate);
                            
                            // อัปเดตการแสดงผล
                            updateOTTimeDisplay(startTime, endTime, hours);
                        } else {
                            // ถ้าไม่มีข้อมูลกะ ให้ใช้ค่าเริ่มต้น
                            var defaultStartTime = '17:30';
                            var endTime = moment(defaultStartTime, 'HH:mm').add(hours, 'hours').format('HH:mm');
                            
                            $('#otStartTime').val(defaultStartTime);
                            $('#otEndTime').val(endTime);
                            
                            // ใช้วันที่ทำงานเป็นวันที่เริ่มต้นและสิ้นสุด
                            var workDate = $('#otWorkDate').val();
                            if (workDate) {
                                const formattedWorkDate = formatDateForMoment(workDate);
                                $('#otStartDate').val(formattedWorkDate);
                                $('#otEndDate').val(formattedWorkDate);
                            }
                            
                            // อัปเดตการแสดงผล
                            updateOTTimeDisplay(defaultStartTime, endTime, hours);
                        }
                    }

                    // ฟังก์ชันอัปเดตการแสดงผลเวลาโอที
                    function updateOTTimeDisplay(startTime, endTime, hours) {
                        var date = $('#otWorkDate').val();
                        
                        // แปลงวันที่ให้ถูกต้องสำหรับ moment.js
                        const formattedDate = formatDateForMoment(date);
                        var startDateTime = formattedDate + ' ' + startTime;
                        var endDateTime = formattedDate + ' ' + endTime;
                        
                        // ตรวจสอบความถูกต้องของวันที่และเวลา
                        if (!formattedDate || !startTime || !endTime) {
                            $('#selectedStartTime').text('-');
                            $('#selectedEndTime').text('-');
                            $('#calculatedHours').text('0');
                            return;
                        }
                        
                        // ตรวจสอบว่า moment objects ถูกต้อง
                        var startMoment = moment(startDateTime, 'YYYY-MM-DD HH:mm');
                        var endMoment = moment(endDateTime, 'YYYY-MM-DD HH:mm');
                        
                        if (!startMoment.isValid() || !endMoment.isValid()) {
                            $('#selectedStartTime').text('-');
                            $('#selectedEndTime').text('-');
                            $('#calculatedHours').text('0');
                            return;
                        }
                        
                        // ถ้าเป็นวันเดียวกันและเวลาสิ้นสุดน้อยกว่าเวลาเริ่มต้น แสดงว่าข้ามวัน
                        if (moment(endTime, 'HH:mm').isBefore(moment(startTime, 'HH:mm'))) {
                            endDateTime = moment(formattedDate).add(1, 'day').format('YYYY-MM-DD') + ' ' + endTime;
                            endMoment = moment(endDateTime, 'YYYY-MM-DD HH:mm');
                        }
                        
                        $('#selectedStartTime').text(startMoment.format('DD/MM/YYYY HH:mm'));
                        $('#selectedEndTime').text(endMoment.format('DD/MM/YYYY HH:mm'));
                        $('#calculatedHours').text(hours);
                    }

                    // ฟังก์ชันโหลดเหตุผลการทำงาน
