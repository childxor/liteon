            // Event เมื่อเลือกกะการทำงาน ให้แสดงเวลาเข้า-ออกงาน
            $('#shiftSelect').on('change', function() {
                const selectedOption = $(this).find('option:selected');
                const startTime = selectedOption.data('start') || '-';
                const endTime = selectedOption.data('end') || '-';
                
                $('#shiftStartTimeDisplay').text(startTime);
                $('#shiftEndTimeDisplay').text(endTime);
            });
            
            // Event สำหรับปุ่มบันทึกกะการทำงาน
            $('#saveShiftBtn').on('click', function() {
                // ตรวจสอบความถูกต้องของข้อมูล
                const form = $('#shiftForm')[0];
                form.classList.add('was-validated');
                
                if (!form.checkValidity()) {
                    return;
                }
                
                const personId = $('#shiftPersonId').val();
                const date = $('#shiftDate').val();
                const endDate = $('#shiftEndDate').val();
                const shift = $('#shiftSelect').val();
                const action = $('#shiftAction').val();
                const shiftId = $('#shiftId').val();
                const namePerson = $('#shiftPersonNameAddEdit').val();
                const remark = $('#shiftRemark').val();
                const department = $('#departmentSelect').val();
                
                // ตรวจสอบช่วงวันที่
                if (endDate && new Date(endDate) < new Date(date)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'วันที่ไม่ถูกต้อง',
                        text: 'วันที่สิ้นสุดต้องมากกว่าหรือเท่ากับวันที่เริ่มต้น'
                    });
                    return;
                }
                
                // สร้างข้อมูลสำหรับส่ง API
                const requestData = {
                    personId: personId,
                    shift: shift,
                    date: date,
                    namePerson: namePerson,
                    remark: remark || '',
                    department: department
                };
                
                // เพิ่มวันที่สิ้นสุดถ้ามีการระบุ
                if (endDate) {
                    requestData.endDate = endDate;
                }
                
                // แสดง loading
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล...',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // ส่งคำขอบันทึกกะ
                if (action === 'add') {
                    $.ajax({
                        url: '/Attendance/AddShiftForPerson',
                        type: 'POST',
                        data: requestData,
                        success: function(response) { 
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'สำเร็จ',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    // ปิด modal
                                    const manageShiftModal = bootstrap.Modal.getInstance(
                                        document.getElementById('manageShiftModal'));
                                    manageShiftModal.hide();
                                    // โหลดข้อมูลประวัติการเปลี่ยนกะใหม่
                                    loadShiftHistoryData(personId);
                                    
                                    // รีโหลดตารางหลักถ้าอยู่ในช่วงวันที่เดียวกัน
                                    const currentStartDate = $('#dateRangeToggle').prop('checked') ? 
                                        $('#startDate').val() : $('#selectedDate').val();
                                    const currentEndDate = $('#dateRangeToggle').prop('checked') ? 
                                        $('#endDate').val() : $('#selectedDate').val();
                                    
                                    if (isDateInRange(date, currentStartDate, currentEndDate) ||
                                        (endDate && isDateInRange(endDate, currentStartDate, currentEndDate))) {
                                        dataTable.ajax.reload();
                                    }
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์'
                            });
                        }
                    });
                } else {
                    // เพิ่ม ID สำหรับการแก้ไข
                    requestData.id = shiftId;
                    requestData.shiftMent = shift;
                    
                    $.ajax({
                        url: '/Attendance/EditShift',
                        type: 'POST',
                        data: requestData,
