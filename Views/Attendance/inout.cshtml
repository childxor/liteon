                saveFilterSettings(); // บันทึกการเปลี่ยนแปลงวันที่
            });
            
            // บันทึกค่าเมื่อมีการเปลี่ยนแปลงใน filter
            $('#selectedDate, #departmentFilter, #shiftFilter').on('change', function() {
                saveFilterSettings();
            });
            
            // บันทึกค่า filter เมื่อมีการออกจากหน้า
            $(window).on('beforeunload', function() {
                saveFilterSettings();
            });
        });
    </script>
}