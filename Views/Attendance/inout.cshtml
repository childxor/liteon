            // ฟังก์ชันคำนวณสถิติการพัก
            function calculateBreakStats(events, shiftType) {
                var totalBreakTime = 0;
                var breakCount = 0;
                var longestBreak = 0;
                var breakTimes = [];
                if (!events || events.length < 2) {
                    return {
                        totalBreakTime: 0,
                        breakCount: 0,
                        longestBreak: 0,
                        averageBreak: 0,
                        shiftType: shiftType
                    };
                }
                
                // กำหนดช่วงเวลาพักตามกะการทำงาน
                var morningBreakStart, morningBreakEnd, lunchBreakStart, lunchBreakEnd;
                
                if (shiftType === 'night') {
                    // กะกลางคืน
                    morningBreakStart = '02:00';
                    morningBreakEnd = '02:10';
                    lunchBreakStart = '00:00';
                    lunchBreakEnd = '01:00';
                } else if (shiftType === 'day') {
                    // กะกลางวัน
                    morningBreakStart = '10:00';
                    morningBreakEnd = '10:10';
                    lunchBreakStart = '12:00';
                    lunchBreakEnd = '13:00';
                } else {
                    // กะออฟฟิศหรือกะอื่นๆ
                    morningBreakStart = '10:00';
                    morningBreakEnd = '10:10';
                    lunchBreakStart = '12:00';
                    lunchBreakEnd = '13:00';
                }
                
                // คำนวณเวลาพัก
                for (var i = 2; i < events.length; i += 2) {
                    if (i % 2 === 0) { // เฉพาะเลขคู่ (การเข้าหลังจากออก)
                        var breakEndTime = moment(events[i].time);
                        var breakStartTime = moment(events[i-1].time);
                        var breakDuration = breakEndTime.diff(breakStartTime, 'minutes');
                        
                        // ตรวจสอบว่าเป็นช่วงเวลาพักตามตารางหรือไม่
                        var breakStartTimeStr = breakStartTime.format('HH:mm');
                        var breakEndTimeStr = breakEndTime.format('HH:mm');
                        
                        // ไม่นับเวลาพักที่น้อยกว่า 1 นาที
                        if (breakDuration >= 1) {
                            totalBreakTime += breakDuration;
                            breakCount++;
                            breakTimes.push(breakDuration);
                            if (breakDuration > longestBreak) {
                                longestBreak = breakDuration;
                            }
                        }
                    }
                }
                
                var averageBreak = breakCount > 0 ? Math.round(totalBreakTime / breakCount) : 0;
                
                return {
                    totalBreakTime: totalBreakTime,
                    breakCount: breakCount,
                    longestBreak: longestBreak,
                    averageBreak: averageBreak,
                    shiftType: shiftType
                };
            }
            
