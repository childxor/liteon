@model IEnumerable<emp_wrkplan>
@using IPS_TH.Models.Employee
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "ข้อมูลการเข้าออก";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canView = permissions?["CanView"] ?? false;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false; 
    @using IPS_TH.Extensions
}

<!-- เพิ่มการอ้างอิงไลบรารี SheetJS (XLSX) -->
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<div class="container-fluid p-3">
    <div class="card">
        <div class="card-header">
            <h5 data-translate="attendance_data">@Context.Session.GetTranslation("attendance_data")</h5>
        </div>
        <div class="card-body">
            <!-- ส่วนกรอง -->
            <div class="card mb-4"> 
                <div class="card-body">
                    <div class="row g-3">
                        <!-- ส่วนเลือกวันที่ -->
                        <div class="col-md-4">
                            <div class="date-selection-container">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="dateRangeSwitch">
                                        <label class="form-check-label ms-2" for="dateRangeSwitch">
                                            <i class="fas fa-calendar-alt me-1"></i><span data-translate="select_multiple_days">@Context.Session.GetTranslation("select_multiple_days")</span>
                                        </label>
                                    </div>
                                </div>
                                <div id="singleDateContainer" class="date-input-group">
                                    <label for="selectedDate" class="form-label" data-translate="date">@Context.Session.GetTranslation("date")</label>
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary date-nav-btn" id="prevDateBtn" type="button">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                        <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                        <input type="date" class="form-control" id="selectedDate">
                                        <button class="btn btn-outline-secondary date-nav-btn" id="nextDateBtn" type="button">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>
                                <div id="dateRangeContainer" class="date-range-group" style="display: none;">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label for="startDate" class="form-label" data-translate="start_date">@Context.Session.GetTranslation("start_date")</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-calendar-minus"></i></span>
                                                <input type="date" class="form-control" id="startDate">
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <label for="endDate" class="form-label" data-translate="end_date">@Context.Session.GetTranslation("end_date")</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-calendar-plus"></i></span>
                                                <input type="date" class="form-control" id="endDate">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ส่วนเลือกแผนกและกะ -->
                        <div class="col-md-5">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label for="departmentFilter" class="form-label" data-translate="department">@Context.Session.GetTranslation("department")</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                                        <select class="form-select" id="departmentFilter">
                                            <option value="" data-translate="all">@Context.Session.GetTranslation("all")</option>
                                            @foreach (var dept in ViewBag.Departments)
                                            {
                                                <option value="@dept.SecDsc">@dept.SecDsc</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="shiftFilter" class="form-label" data-translate="shift">@Context.Session.GetTranslation("shift")</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-clock"></i></span>
                                        <select class="form-select" id="shiftFilter">
                                            <option value="" data-translate="all">@Context.Session.GetTranslation("all")</option>
                                            <option value="day" data-translate="day_shift">@Context.Session.GetTranslation("day_shift")</option>
                                            <option value="night" data-translate="night_shift">@Context.Session.GetTranslation("night_shift")</option>
                                            <option value="office" data-translate="office_shift">@Context.Session.GetTranslation("office_shift")</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ส่วนปุ่มดำเนินการ -->
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="button-group w-100">
                                <button id="searchBtn" class="btn btn-primary">
                                    <i class="fas fa-search me-1"></i><span data-translate="search">@Context.Session.GetTranslation("search")</span>
                                </button>
                                <button id="resetBtn" class="btn btn-secondary mx-2">
                                    <i class="fas fa-redo me-1"></i><span data-translate="reset">@Context.Session.GetTranslation("reset")</span>
                                </button>
                                <button id="exportExcelBtn" class="btn btn-success">
                                    <i class="fas fa-file-excel me-1"></i><span data-translate="export">@Context.Session.GetTranslation("export")</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- ตารางข้อมูล -->
            <div class="table-responsive">
                <table id="employeeTable" class="table table-striped table-bordered display" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th data-translate="employee_id">@Context.Session.GetTranslation("employee_id")</th>
                            <th data-translate="employee_name">@Context.Session.GetTranslation("employee_name")</th>
                            <th data-translate="department">@Context.Session.GetTranslation("department")</th>
                            <th data-translate="date">@Context.Session.GetTranslation("date")</th>
                            <th data-translate="shift">@Context.Session.GetTranslation("shift")</th>
                            <th data-translate="check_in">@Context.Session.GetTranslation("check_in")</th>
                            <th data-translate="status">@Context.Session.GetTranslation("status")</th>
                            <th data-translate="total_break_time">@Context.Session.GetTranslation("total_break_time")</th>
                            <th data-translate="break_count">@Context.Session.GetTranslation("break_count")</th>
                            <th data-translate="longest_break">@Context.Session.GetTranslation("longest_break")</th>
                            <th data-translate="average_break">@Context.Session.GetTranslation("average_break")</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only" data-translate="loading">@Context.Session.GetTranslation("loading")</span>
    </div>
</div>

<style>
    /* สไตล์สำหรับ Child Row */
    .timeline {
        position: relative;
        margin: 0 0 30px 10px;
        padding: 0;
        list-style: none;
    }
    
    .timeline:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 20px;
        width: 3px;
        background: #e9ecef;
        border-radius: 2px;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 20px;
        display: flex;
    }
    
    .timeline-dot {
        position: absolute;
        left: 16px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        transform: translateX(-50%);
        z-index: 2;
    }
    
    .timeline-dot-in {
        background-color: #28a745;
        box-shadow: 0 0 0 4px rgba(40, 167, 69, 0.2);
    }
    
    .timeline-dot-out {
        background-color: #dc3545;
        box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.2);
    }
    
    .timeline-content {
        position: relative;
        margin-left: 40px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }
    
    .timeline-content:hover {
        background: #f0f0f0;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .timeline-info {
        flex-grow: 1;
    }
    
    .timeline-time {
        font-weight: bold;
        color: #495057;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
    }
    
    .break-badge {
        display: inline-block;
        font-size: 0.75rem;
        padding: 2px 8px;
        margin-left: 10px;
        border-radius: 12px;
    }
    
    .morning-break {
        background-color: #e3f2fd;
        color: #0d6efd;
    }
    
    .lunch-break {
        background-color: #fff3cd;
        color: #fd7e14;
    }
    
    .action-btn {
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        padding: 5px;
        transition: color 0.2s;
    }
    
    .action-btn:hover {
        color: #343a40;
    }
    
    .badge-shift {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    
    .badge-day {
        background-color: #e3f2fd;
        color: #0d6efd;
    }
    
    .badge-night {
        background-color: #f8d7da;
        color: #dc3545;
    }
    
    .badge-office {
        background-color: #d1e7dd;
        color: #198754;
    }
    
    .shift-day {
        border-left: 4px solid #0d6efd;
    }
    
    .shift-night {
        border-left: 4px solid #dc3545;
    }
    
    .shift-office {
        border-left: 4px solid #198754;
    }
    
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }
    
    /* สไตล์ใหม่สำหรับ Child Row ที่ปรับปรุง */
    .child-row-container {
        background-color: #f9f9f9;
        border-radius: 10px;
        padding: 20px;
        margin: 10px 0;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
    }
    
    .stats-card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    .timeline-actions-buttons {
        display: flex;
        gap: 5px;
    }
    
    .action-button {
        padding: 4px 8px;
        border-radius: 4px;
        border: none;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    
    .action-button.edit {
        background-color: #e3f2fd;
        color: #0d6efd;
    }
    
    .action-button.edit:hover {
        background-color: #cfe2ff;
    }
    
    .action-button.view {
        background-color: #f8f9fa;
        color: #6c757d;
    }
    
    .action-button.view:hover {
        background-color: #e9ecef;
    }
    
    .action-button.break {
        background-color: #d1e7dd;
        color: #198754;
    }
    
    .action-button.break:hover {
        background-color: #badbcc;
    }
    
    .break-info-card {
        background-color: #f0f8ff;
        border-left: 4px solid #0d6efd;
        border-radius: 5px;
        padding: 15px;
        margin-bottom: 20px;
    }
    
    .break-info-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        color: #0d6efd;
    }

    /* สไตล์สำหรับปุ่มเพิ่มลดวัน */
    .date-nav-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 38px;
        padding: 0;
        transition: all 0.2s;
    }

    .date-nav-btn:hover {
        background-color: #e9ecef;
    }

    .date-nav-btn:active {
        transform: scale(0.95);
    }
</style>
 

@section Scripts {
    <script>
        // เพิ่มตัวแปร JavaScript สำหรับเก็บค่าสิทธิ์การแก้ไข
        var canEdit = @(canEdit ? "true" : "false");  
        loadLanguageData('@ViewBag.ModuleId');

        
        $(document).ready(function () {
                 // ปุ่มเพิ่มลดวัน
            $('#prevDateBtn').on('click', function() {
                var currentDate = moment($('#selectedDate').val());
                var newDate = currentDate.subtract(1, 'days');
                $('#selectedDate').val(newDate.format('YYYY-MM-DD'));
                saveFilterSettings();
                table.ajax.reload();
            });

            $('#nextDateBtn').on('click', function() {
                var currentDate = moment($('#selectedDate').val());
                var newDate = currentDate.add(1, 'days');
                $('#selectedDate').val(newDate.format('YYYY-MM-DD'));
                saveFilterSettings();
                table.ajax.reload();
            });


            // ฟังก์ชันสำหรับบันทึกค่า filter ลงใน localStorage
            function saveFilterSettings() {
                var isDateRange = $('#dateRangeSwitch').is(':checked');
                var filterSettings = {
                    isDateRange: isDateRange,
                    selectedDate: $('#selectedDate').val(),
                    startDate: $('#startDate').val(),
                    endDate: $('#endDate').val(),
                    department: $('#departmentFilter').val(),
                    shift: $('#shiftFilter').val()
                };
                localStorage.setItem('attendanceFilterSettings', JSON.stringify(filterSettings));
            }
            
            // ฟังก์ชันสำหรับโหลดค่า filter จาก localStorage
            function loadFilterSettings() {
                var savedSettings = localStorage.getItem('attendanceFilterSettings');
                if (savedSettings) {
                    var settings = JSON.parse(savedSettings);
                    
                    // ตั้งค่าสวิตช์เลือกวันที่
                    $('#dateRangeSwitch').prop('checked', settings.isDateRange);
                    
                    if (settings.isDateRange) {
                        $('#singleDateContainer').hide();
                        $('#dateRangeContainer').show();
                        $('#startDate').val(settings.startDate);
                        $('#endDate').val(settings.endDate);
                    } else {
                        $('#singleDateContainer').show();
                        $('#dateRangeContainer').hide();
                        $('#selectedDate').val(settings.selectedDate);
                    }
                    
                    // ตั้งค่าแผนกและกะ
                    $('#departmentFilter').val(settings.department);
                    $('#shiftFilter').val(settings.shift);
                    
                    return true;
                }
                return false;
            }
            
            // พยายามโหลดค่า filter จาก localStorage
            var settingsLoaded = loadFilterSettings();
            
            // ถ้าไม่มีค่าที่บันทึกไว้ ให้ตั้งค่าเริ่มต้นเป็นวันปัจจุบัน
            if (!settingsLoaded) {
                $('#selectedDate').val(moment().format('YYYY-MM-DD'));
            }
            
            // เริ่มต้นตาราง DataTable
            var table = $('#employeeTable').DataTable({
                processing: true,
                serverSide: false,
                pageLength: -1, // แสดงแถวทั้งหมด
                paging: false,
                lengthMenu: [], // ซ่อนตัวเลือกจำนวนแถวต่อหน้า
                language: {
                    processing: '<div class="spinner-border text-primary" role="status"><span class="sr-only">' + translate("loading") + '</span></div>',
                    search: translate("search") + ':',
                    lengthMenu: translate("show") + ' _MENU_ ' + translate("entries"),
                    info: translate("showing") + ' _START_ ' + translate("to") + ' _END_ ' + translate("of") + ' _TOTAL_ ' + translate("entries"),
                    infoEmpty: translate("showing") + ' 0 ' + translate("to") + ' 0 ' + translate("of") + ' 0 ' + translate("entries"),
                    infoFiltered: '(' + translate("filtered_from") + ' _MAX_ ' + translate("total_entries") + ')',
                    emptyTable: translate("no_data"),
                    paginate: {
                        first: translate("first"),
                        previous: translate("previous"),
                        next: translate("next"),
                        last: translate("last")
                    }
                },
                ajax: {
                    url: '/Attendance/GetAllEmployeeBreakEvents',
                    type: 'GET',
                    data: function() {
                        var isDateRange = $('#dateRangeSwitch').is(':checked');
                        return {
                            date: isDateRange ? null : $('#selectedDate').val(),
                            startDate: isDateRange ? $('#startDate').val() : null,
                            endDate: isDateRange ? $('#endDate').val() : null,
                            department: $('#departmentFilter').val()
                        };
                    },
                    dataSrc: function(json) {
                        if (json.success && json.data) {
                            // กรองข้อมูลตามกะการทำงาน
                            var shiftFilter = $('#shiftFilter').val();
                            var filteredData = json.data;
                            
                            if (shiftFilter) {
                                filteredData = json.data.filter(function(item) {
                                    var shift = item.shift.toLowerCase();
                                    if (shiftFilter === 'day') {
                                        return shift.includes('d') || shift.includes('day');
                                    } else if (shiftFilter === 'night') {
                                        return shift.includes('n') || shift.includes('night');
                                    } else if (shiftFilter === 'office') {
                                        return shift.includes('of') || shift.includes('office');
                                    }
                                    return true;
                                });
                            }
                            
                            // คำนวณข้อมูลสถิติการพักใหม่สำหรับแต่ละรายการ
                            filteredData.forEach(function(item) {
                                if (item.events && item.events.length > 0) {
                                    // แยกการคำนวณตามกะการทำงาน
                                    var shift = item.shift || '';
                                    var isNightShift = shift.toLowerCase().includes('n') || shift.toLowerCase().includes('night');
                                    var isDayShift = shift.toLowerCase().includes('d') || shift.toLowerCase().includes('day');
                                    var isOfficeShift = shift.toLowerCase().includes('of') || shift.toLowerCase().includes('office');
                                    
                                    // กำหนดประเภทกะการทำงาน
                                    var shiftType = isNightShift ? 'night' : (isDayShift ? 'day' : 'office');
                                    
                                    // คำนวณสถิติการพักตามกะการทำงาน
                                    var stats = calculateBreakStats(item.events, shiftType);
                                    
                                    // อัพเดทข้อมูลสถิติการพัก
                                    item.breakStats = {
                                        totalBreakTime: stats.totalBreakTime,
                                        breakCount: stats.breakCount,
                                        longestBreak: stats.longestBreak,
                                        averageBreak: stats.averageBreak,
                                        scheduledBreaks: item.breakStats ? item.breakStats.scheduledBreaks : null,
                                        shiftType: shiftType
                                    };
                                    
                                    // กำหนดสถานะใหม่ตามข้อมูลการเข้า-ออกล่าสุด
                                    if (item.events.length > 0) {
                                        var lastEventIndex = item.events.length - 1;
                                        var isLastEventIn = lastEventIndex % 2 === 0; // เลขคู่ (รวม 0) = เข้า, เลขคี่ = ออก
                                        item.currentStatus = isLastEventIn ? 'IN' : 'OUT';
                                    }
                                }
                            });
                            
                            return filteredData;
                        }
                        return [];
                    },
                    error: function(xhr, error, thrown) {
                        console.error('เกิดข้อผิดพลาดในการโหลดข้อมูล:', error);
                        alert('เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + thrown);
                        $('#loadingOverlay').hide();
                    },
                    beforeSend: function() {
                        $('#loadingOverlay').show();
                    },
                    complete: function() {
                        $('#loadingOverlay').hide();
                    }
                },
                columns: [
                    {
                        className: 'dt-control text-center',
                        orderable: false,
                        data: null,
                        defaultContent: '',
                        render: function () {
                            return '<i class="fas fa-plus-circle text-primary"></i>';
                        }
                    },
                    { 
                        data: 'employeeId',
                        render: function(data) {
                            return data || 'ไม่ระบุ';
                        }
                    },
                    { 
                        data: 'employeeName',
                        render: function(data) {
                            return data || 'ไม่ระบุ';
                        }
                    },
                    { 
                        data: 'department',
                        render: function(data) {
                            return data || 'ไม่ระบุ';
                        }
                    },
                    { 
                        data: 'date',
                        render: function(data) {
                            return moment(data).format('DD/MM/YYYY');
                        }
                    },
                    { 
                        data: null,
                        render: function(data) {
                            var shift = data.shift || '';
                            var shiftName = data.shiftName || '';
                            var badgeClass = 'badge-office';
                            
                            if (shift.toLowerCase().includes('d') || shift.toLowerCase().includes('day')) {
                                badgeClass = 'badge-day';
                            } else if (shift.toLowerCase().includes('n') || shift.toLowerCase().includes('night')) {
                                badgeClass = 'badge-night';
                            }
                            
                            return '<span class="badge-shift ' + badgeClass + '">' + shift + '</span><br><small>' + shiftName + '</small>';
                        }
                    },
                    {
                        data: null,
                        width: '200px',
                        render: function(data, type, row) {
                            var checkIn = row.firstCheckIn ? moment(row.firstCheckIn).format('HH:mm:ss') : 'ไม่ระบุ';
                            var checkOut = row.lastCheckOut ? moment(row.lastCheckOut).format('HH:mm:ss') : 'ไม่ระบุ';
                            
                            // ถ้า checkout เหมือนกับ checkin ไม่ต้องแสดงเวลา checkout
                            if (checkIn === checkOut) {
                                checkOut = 'ไม่ระบุ';
                            }
                            
                            return '<div class="d-flex align-items-center justify-content-between p-2">' +
                                '<div class="text-center mr-3">' +
                                    '<i class="fas fa-sign-in-alt text-success mb-1"></i><br>' +
                                    '<span class="badge bg-light text-dark">' + checkIn + '</span>' +
                                '</div>' +
                                '<div class="text-muted px-2">|</div>' + 
                                '<div class="text-center ml-3">' +
                                    '<i class="fas fa-sign-out-alt text-danger mb-1"></i><br>' +
                                    '<span class="badge bg-light text-dark">' + checkOut + '</span>' +
                                '</div>' +
                            '</div>';
                        }
                    },
                    { 
                        data: 'currentStatus',
