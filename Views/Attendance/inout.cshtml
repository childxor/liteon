            // ฟังก์ชันสุ่มเวลาพัก
            function adjustBreakTime(breakStartTime, breakEndTime, id) {
                // แปลงเวลาเป็น moment object
                var startTime = moment(breakStartTime, 'HH:mm:ss');
                var endTime = moment(breakEndTime, 'HH:mm:ss');
                
                // คำนวณเวลาพักปัจจุบัน (นาที)
                var currentBreakDuration = endTime.diff(startTime, 'minutes');
                
                // สุ่มเวลาพักใหม่ระหว่าง 10-15 นาที
                var newBreakDuration = Math.floor(Math.random() * (15 - 10 + 1)) + 10;
                
                // คำนวณเวลาใหม่โดยปรับจากเวลาออก (breakStartTime)
                var newEndTime = moment(breakStartTime, 'HH:mm:ss').add(newBreakDuration, 'minutes');

                // แสดง Modal ยืนยัน
                Swal.fire({
                    title: translate("confirm_adjust_break"),
                    html: `
                        <div class="text-left">
                            <p>` + translate("exit_time") + `: ${breakStartTime}</p>
                            <p>` + translate("original_entry_time") + `: ${breakEndTime}</p>
                            <p>` + translate("original_break_time") + `: ${currentBreakDuration} ` + translate("minutes") + `</p>
                            <hr>
                            <p>` + translate("new_entry_time") + `: ${newEndTime.format('HH:mm:ss')}</p>
                            <p>` + translate("new_break_time") + `: ${newBreakDuration} ` + translate("minutes") + `</p>
                            <p class="text-info">` + translate("break_time_reduction") + `: ${currentBreakDuration - newBreakDuration} ` + translate("minutes") + `</p>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: translate("confirm"),
                    cancelButtonText: translate("cancel")
                }).then((result) => {
                    if (result.isConfirmed) {
                        // ส่งข้อมูลไปยัง server
                        $.ajax({
                            url: '/Attendance/AdjustBreakTime',
                            type: 'POST',
                            data: {
                                id: id,
                                adjustedTime: newEndTime.format('YYYY-MM-DD HH:mm:ss')
                            },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire(
                                        translate("success"),
                                        translate("break_time_adjusted"),
                                        'success'
                                    ).then(() => {
                                        // รีโหลดข้อมูล
                                        table.ajax.reload();
                                    });
                                } else {
                                    Swal.fire(
                                        translate("error"),
                                        response.message || translate("cannot_adjust_break"),
                                        'error'
                                    );
                                }
                            },
                            error: function() {
                                Swal.fire(
                                    translate("error"),
                                    translate("connection_error"),
                                    'error'
                                );
                            }
                        });
                    }
                });
            }

