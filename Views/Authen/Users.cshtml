@model IEnumerable<IPS_TH.Models.sys_user>
    @using IPS_TH.Models

    @{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
    }

    <div class="container-fluid">
        <!-- หัวข้อหลักของหน้า -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <h2 class="mb-0 text-primary">
                <i class="fas fa-users me-2"></i>จัดการผู้ใช้งาน
            </h2>
        </div>

        <!-- ส่วนตัวกรองข้อมูล -->
        <div class="card shadow-sm mb-4 border-0 rounded-3 overflow-hidden mt-4">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-filter me-2"></i>ค้นหาและกรองข้อมูล</h5>
            </div>
            <div class="card-body bg-light py-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="departmentFilter">แผนก:</label>
                        <select id="departmentFilter" class="form-select shadow-sm">
                            <option value="">-- เลือกทุกแผนก --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="positionFilter">ตำแหน่ง:</label>
                        <select id="positionFilter" class="form-select shadow-sm">
                            <option value="">-- เลือกทุกตำแหน่ง --</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12 text-end">
                        <button class="btn btn-outline-primary me-2">
                            <i class="fas fa-sync-alt me-2"></i>ล้างตัวกรอง
                        </button>
                        <button class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>ค้นหา
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ส่วนแสดงตารางข้อมูล -->
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-table me-2"></i>รายการผู้ใช้งานทั้งหมด</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2">
                            <i class="fas fa-file-excel me-1"></i> ส่งออกเป็น Excel
                        </button>
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-file-pdf me-1"></i> ส่งออกเป็น PDF
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="userTable" class="table table-striped table-hover border-0 mb-0">
                        <!-- ตารางข้อมูลจะถูกสร้างโดย DataTable -->
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- หน้าต่างแก้ไขข้อมูลผู้ใช้ -->
    <div class="modal fade" id="editUserModal" role="dialog" aria-labelledby="editUserModalLabel">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="editUserModalLabel">
                        <i class="fas fa-user-edit me-2"></i>แก้ไขข้อมูลผู้ใช้งาน
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="editUserForm" class="row g-3">
                        <input type="hidden" id="editUserId" name="id">

                        <!-- ข้อมูลส่วนตัว -->
                        <div class="col-12 mb-2">
                            <h6 class="fw-bold text-primary border-bottom pb-2">ข้อมูลส่วนตัว</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold" for="editFirstName">ชื่อ:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" class="form-control" id="editFirstName" placeholder="กรอกชื่อ">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" for="editLastName">นามสกุล:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" class="form-control" id="editLastName" placeholder="กรอกนามสกุล">
                            </div>
                        </div>

                        <!-- ข้อมูลการเข้าสู่ระบบ -->
                        <div class="col-12 mt-4 mb-2">
                            <h6 class="fw-bold text-primary border-bottom pb-2">ข้อมูลการเข้าสู่ระบบ</h6>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold" for="editUsername">ชื่อผู้ใช้:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                                <input type="text" class="form-control" id="editUsername" placeholder="กรอกชื่อผู้ใช้">
                            </div>
                        </div>

                        <!-- ข้อมูลการติดต่อ -->
                        <div class="col-12 mt-4 mb-2">
                            <h6 class="fw-bold text-primary border-bottom pb-2">ข้อมูลการติดต่อ</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold" for="editEmail">อีเมล:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" class="form-control" id="editEmail" placeholder="กรอกอีเมล">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" for="editPhoneNumber">เบอร์โทร:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input type="text" class="form-control" id="editPhoneNumber" placeholder="กรอกเบอร์โทร">
                            </div>
                        </div>

                        <!-- สิทธิ์และการเข้าถึง -->
                        <div class="col-12 mt-4 mb-2">
                            <h6 class="fw-bold text-primary border-bottom pb-2">สิทธิ์และการเข้าถึง</h6>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold" for="editRoles">บทบาทผู้ใช้งาน:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                                <select id="editRoles" class="form-select select2" multiple required>
                                    <option value="">เลือกบทบาท</option>
                                    @foreach (var role in ViewBag.Roles ?? Enumerable.Empty<IPS_TH.Models.sys_role>())
                                        {
                                        <option value="@role.Id">@role.RoleName</option>
                                        }
                                </select>
                            </div>
                            <small class="text-muted">สามารถเลือกได้หลายบทบาท</small>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="form-check form-switch">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input me-2" type="checkbox" id="editIsActive" role="switch"
                                        style="width: 3em; height: 1.5em;">
                                    <label class="form-check-label fw-bold"
                                        for="editIsActive">เปิดใช้งานบัญชีผู้ใช้</label>
                                </div>
                                <small class="text-muted ms-5">ผู้ใช้ที่ถูกปิดการใช้งานจะไม่สามารถเข้าสู่ระบบได้</small>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>ยกเลิก
                    </button>
                    <button type="button" class="btn btn-primary" id="saveUserChanges">
                        <i class="fas fa-save me-2"></i>บันทึกข้อมูล
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        $(document).ready(function() {
            // ตั้งค่าตาราง DataTable
            var table = $('#userTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetUsers", "Authen")',
                    type: 'GET',
                    dataSrc: function(response) {
                        // เรียงข้อมูลตามเวลาเข้าระบบล่าสุด
                        return response.data.sort(function(a, b) {
                            // ถ้าไม่มีค่า lastLogin ให้จัดไว้ท้ายสุด
                            if (!a.lastLogin) return 1;
                            if (!b.lastLogin) return -1;
                            // เรียงจากใหม่ไปเก่า
                            return new Date(b.lastLogin) - new Date(a.lastLogin);
                        });
                    }
                },
                paging: true,
                pageLength: -1,
                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, "ทั้งหมด"]
                ],
                order: [
                    [5, 'asc']
                ],
                ordering: true,
                columns: [
                    {
                        data: 'firstName',
                        title: 'ชื่อ'
                    },
                    {
                        data: 'lastName',
                        title: 'นามสกุล'
                    },
                    {
                        data: 'username',
                        title: 'ชื่อผู้ใช้'
                    },
                    {
                        data: 'email',
                        title: 'อีเมล'
                    },
                    {
                        data: 'lastLogin',
                        title: 'เข้าระบบล่าสุด',
                        render: function(data) {
                            if (!data)
                            return '<span class="badge bg-secondary">ไม่เคยเข้าสู่ระบบ</span>';
                            const loginDate = moment(data);
                            const now = moment();
                            const diffDays = now.diff(loginDate, 'days');
                            const diffHours = now.diff(loginDate, 'hours');
                            let timeText = loginDate.format('DD/MM/YYYY HH:mm');
                            let badgeClass = 'bg-info';
                            if (diffHours < 1) {
                                timeText = loginDate.fromNow();
                                badgeClass = 'bg-success fw-bold';
                            } else if (diffHours < 24) {
                                timeText = loginDate.fromNow();
                                badgeClass = 'bg-success';
                            } else if (diffDays < 7) {
                                timeText = loginDate.fromNow();
                                badgeClass = 'bg-primary';
                            } else if (diffDays < 30) {
                                timeText = loginDate.format('D MMM') + ' (' + loginDate
                                .fromNow() + ')';
                                badgeClass = 'bg-warning';
                            } else {
                                timeText = loginDate.format('D MMM YYYY');
                                badgeClass = 'bg-secondary';
                            }
                            return `<span class="badge ${badgeClass}" data-bs-toggle="tooltip" title="${loginDate.format('DD/MM/YYYY HH:mm:ss')}">${timeText}</span>`;
                        },
                        orderSequence: ['desc', 'asc']
                    },
                    {
                        data: 'roles',
                        title: 'บทบาท',
                        render: function(data) {
                            if (!data || data.length === 0)
                            return '<span class="badge bg-secondary">ไม่มีบทบาท</span>';
                            // แยกบทบาทและแสดงเป็น badge
                            const roles = Array.isArray(data) ? data : [data];
                            return roles.map(role =>
                                `<span class="badge bg-info me-1">${role}</span>`
                            ).join(' ');
                        }
                    },
                    {
                        data: 'isActive',
                        title: 'สถานะ',
                        render: function(data) {
                            return data ?
                                '<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>เปิดใช้งาน</span>' :
                                '<span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>ปิดใช้งาน</span>';
                        }
                    },
                    {
                        data: null,
                        title: 'จัดการ',
                        className: 'text-center',
                        orderable: false,
                        render: function(data, type, row) {
                            return `
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-outline-primary edit-user" data-id="${row.id}" title="แก้ไขข้อมูล">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-user" data-id="${row.id}" title="ลบผู้ใช้">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                `;
                        }
                    }
                ],
                paging: false,
                info: false,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/th.json",
                    emptyTable: "ไม่พบข้อมูลผู้ใช้งานในระบบ",
                    zeroRecords: "ไม่พบข้อมูลที่ตรงกับเงื่อนไขการค้นหา"
                },
                responsive: true,
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                initComplete: function() {
                    $('#userTable_wrapper').addClass('p-3');
                    $('.dataTables_filter input').addClass('form-control shadow-sm').attr(
                        'placeholder', 'ค้นหาผู้ใช้...');
                    $('.dataTables_length select').addClass('form-select shadow-sm');
                    // เพิ่ม tooltip ให้กับ badge
                    setTimeout(function() {
                        $('[data-bs-toggle="tooltip"]').tooltip();
                    }, 500);
                }
            });
            // ตั้งค่า Select2 สำหรับเลือกบทบาท
            $('#editRoles').select2({
                dropdownParent: $('#editUserModal'),
                width: '100%',
                autoClose: false,
                allowClear: true,
                placeholder: 'เลือกบทบาทผู้ใช้งาน',
                closeOnSelect: false,
                multiple: true,
                theme: 'bootstrap-5'
            });
            // การแก้ไขข้อมูลผู้ใช้
            $('#userTable').on('click', '.edit-user', function() {
                var userId = $(this).data('id');
                // แสดงข้อความกำลังโหลด
                Swal.fire({
                    title: 'กำลังโหลดข้อมูล',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.get('@Url.Action("GetUserById", "Authen")/' + userId, function(data) {
                    // ปิดข้อความโหลด
                    Swal.close();
                    // กรอกข้อมูลลงในฟอร์ม
                    $('#editUserId').val(userId);
                    $('#editFirstName').val(data.firstName);
                    $('#editLastName').val(data.lastName);
                    $('#editUsername').val(data.username);
                    $('#editEmail').val(data.email);
                    $('#editPhoneNumber').val(data.phoneNumber);
                    // ล้างค่าเก่าและเซ็ตค่าใหม่
                    $('#editRoles').val(null).trigger('change');
                    if (data.roles && data.roles.length > 0) {
                        $('#editRoles').val(data.roles).trigger('change');
                    }
                    $('#editIsActive').prop('checked', data.isActive);
                    $('#editUserModal').modal('show');
                }).fail(function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลผู้ใช้ได้ กรุณาลองใหม่อีกครั้ง',
                        confirmButtonColor: '#0d6efd'
                    });
                });
            });
            // จัดการการปิด modal
            $('#editUserModal').on('hidden.bs.modal', function() {
                // ลบ backdrop และ class modal-open
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('padding-right', '');
            });
            // บันทึกการเปลี่ยนแปลง
            $('#saveUserChanges').click(function() {
                // ตรวจสอบข้อมูลก่อนส่ง
                if (!$('#editFirstName').val() || !$('#editLastName').val() || !$('#editUsername')
                .val()) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'ข้อมูลไม่ครบถ้วน',
                        text: 'กรุณากรอกข้อมูลที่จำเป็นให้ครบถ้วน (ชื่อ, นามสกุล, ชื่อผู้ใช้)',
                        confirmButtonColor: '#0d6efd'
                    });
                    return;
                }
                var userData = {
                    id: $('#editUserId').val(),
                    firstName: $('#editFirstName').val(),
                    lastName: $('#editLastName').val(),
                    username: $('#editUsername').val(),
                    email: $('#editEmail').val(),
                    phoneNumber: $('#editPhoneNumber').val(),
                    roles: $('#editRoles').val() ? $('#editRoles').val().join('|') : '',
                    isActive: $('#editIsActive').is(':checked')
                };
                // แสดงข้อความกำลังบันทึก
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                $.ajax({
                    url: '@Url.Action("UpdateUser", "Authen")',
                    type: 'POST',
                    data: userData,
                    success: function(response) {
                        if (response.success) {
                            // ปิด modal
                            var modal = bootstrap.Modal.getInstance(document.getElementById(
                                'editUserModal'));
                            modal.hide();
                            // ลบ backdrop
                            $('.modal-backdrop').remove();
                            $('body').removeClass('modal-open').css('padding-right', '');
                            // รีโหลดตาราง
                            table.ajax.reload();
                            // แสดงข้อความสำเร็จ
                            Swal.fire({
                                icon: 'success',
                                title: 'บันทึกข้อมูลสำเร็จ',
                                text: 'ข้อมูลผู้ใช้ถูกบันทึกเรียบร้อยแล้ว',
                                confirmButtonColor: '#0d6efd'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: response.message ||
                                    'ไม่สามารถบันทึกข้อมูลได้ กรุณาลองใหม่อีกครั้ง',
                                confirmButtonColor: '#0d6efd'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้ กรุณาลองใหม่อีกครั้ง',
                            confirmButtonColor: '#0d6efd'
                        });
                    }
                });
            });
            // ลบผู้ใช้
            $('#userTable').on('click', '.delete-user', function() {
                var userId = $(this).data('id');
                Swal.fire({
                    title: 'ยืนยันการลบผู้ใช้',
                    text: "คุณต้องการลบผู้ใช้นี้ใช่หรือไม่? การกระทำนี้ไม่สามารถย้อนกลับได้",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'ใช่, ลบผู้ใช้นี้',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // แสดงข้อความกำลังลบ
                        Swal.fire({
                            title: 'กำลังลบข้อมูล',
                            text: 'กรุณารอสักครู่...',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        $.ajax({
                            url: '@Url.Action("DeleteUser", "Authen")/' + userId,
                            type: 'POST',
                            success: function(response) {
                                if (response.success) {
                                    table.ajax.reload();
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'ลบผู้ใช้สำเร็จ',
                                        text: 'ลบข้อมูลผู้ใช้เรียบร้อยแล้ว',
                                        confirmButtonColor: '#0d6efd'
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'เกิดข้อผิดพลาด',
                                        text: response.message ||
                                            'ไม่สามารถลบผู้ใช้ได้ กรุณาลองใหม่อีกครั้ง',
                                        confirmButtonColor: '#0d6efd'
                                    });
                                }
                            },
                            error: function() {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้ กรุณาลองใหม่อีกครั้ง',
                                    confirmButtonColor: '#0d6efd'
                                });
                            }
                        });
                    }
                });
            });
            // รีเฟรชข้อมูล
            $('.card-header .btn-outline-primary').click(function() {
                // แสดงข้อความกำลังโหลด
                Swal.fire({
                    title: 'กำลังรีเฟรชข้อมูล',
                    text: 'กรุณารอสักครู่...',
                    allowOutsideClick: false,
                    timer: 1000,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                table.ajax.reload();
            });
        });
