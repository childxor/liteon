            // ฟังก์ชันบันทึกค่าตัวกรองลง localStorage
            function saveFiltersToLocalStorage() {
                const filters = {
                    status: $('#filter-storage').data('status') || 'active',
                    door: $('#filter-storage').data('door') || '',
                    department: $('#filter-storage').data('department') || '',
                    shift: $('#filter-storage').data('shift') || '',
                    fingerprint: $('#filter-storage').data('fingerprint') || '',
                    hasProductionLine: $('#filter-storage').data('hasProductionLine') || false
                };
                localStorage.setItem('employeeFilters', JSON.stringify(filters));
            }
            // ฟังก์ชันโหลดค่าตัวกรองจาก localStorage
            function loadFiltersFromLocalStorage() {
                const storedFilters = localStorage.getItem('employeeFilters');
                return storedFilters ? JSON.parse(storedFilters) : {
                    status: 'active',
                    door: '',
                    department: '',
                    shift: '',
                    fingerprint: '',
                    hasProductionLine: false
                };
            }
            // อัพเดท UI แสดงตัวกรองที่ใช้อยู่
            function updateFilterBadges() {
                const filters = {
                    status: $('#filter-storage').data('status') || 'active',
                    door: $('#filter-storage').data('door') || '',
                    department: $('#filter-storage').data('department') || '',
                    shift: $('#filter-storage').data('shift') || '',
                    fingerprint: $('#filter-storage').data('fingerprint') || '',
                    hasProductionLine: $('#filter-storage').data('hasProductionLine') || false
                };
                $('#current-filters').empty();
                let hasFilter = false;
                if (filters.shift) {
                    hasFilter = true;
                    let shiftName = findName(shiftLookup, filters.shift);
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-clock me-1"></i>กะ: ${shiftName}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="shift"></button>
                    </span>`);
                }
                if (filters.door) {
                    hasFilter = true;
                    let doorName = doorLookup[filters.door] || filters.door;
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-door-open me-1"></i>ประตู: ${doorName}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="door"></button>
                    </span>`);
                }
                if (filters.department) {
                    hasFilter = true;
                    let deptName = findName(deptLookup, filters.department);
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-building me-1"></i>แผนก: ${deptName}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="department"></button>
                    </span>`);
                }
                if (filters.fingerprint) {
                    hasFilter = true;
                    let fingerprintLabel = filters.fingerprint === 'has' ? 'มีลายนิ้วมือ' : 'ไม่มีลายนิ้วมือ';
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-fingerprint me-1"></i>ลายนิ้วมือ: ${fingerprintLabel}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="fingerprint"></button>
                    </span>`);
                }
                if (filters.status && filters.status !== 'active') {
                    hasFilter = true;
                    let statusLabel = filters.status === 'resigned' ? 'ลาออกแล้ว' : filters.status;
                    $('#current-filters').append(`<span class="badge bg-danger rounded-pill">
                        <i class="fas fa-toggle-on me-1"></i>สถานะ: ${statusLabel}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="status"></button>
                    </span>`);
                }
                if (filters.hasProductionLine) {
                    hasFilter = true;
                    $('#current-filters').append(`<span class="badge bg-success rounded-pill">
                        <i class="fas fa-industry me-1"></i>มีไลน์ผลิต
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="hasProductionLine"></button>
                    </span>`);
                }
                if (hasFilter) {
                    $('#current-filters').append(`<span class="badge bg-warning rounded-pill clear-all-filters" style="cursor: pointer;">
                        <i class="fas fa-times-circle me-1"></i>ล้างตัวกรองทั้งหมด
                    </span>`);
                } else {
                    $('#current-filters').append(`<span class="badge bg-secondary rounded-pill">
                        <i class="fas fa-info-circle me-1"></i>ไม่มีตัวกรอง
                    </span>`);
                }
                // เพิ่ม event listener สำหรับปุ่มลบตัวกรอง
                $('.btn-close[data-filter]').on('click', function() {
                    const filterType = $(this).data('filter');
                    $('#filter-storage').data(filterType, '');
                    // ถ้าเป็นสถานะ ให้กลับไปเป็น active
                    if (filterType === 'status') {
                        $('#filter-storage').data('status', 'active');
                    }
                    // ถ้าเป็น hasProductionLine ให้รีเซ็ตเป็น false
                    if (filterType === 'hasProductionLine') {
                        $('#filter-storage').data('hasProductionLine', false);
                    }
                    // ถ้าเป็น department และไม่ใช่ admin ให้รีเซ็ตกลับไปยังแผนกผู้ใช้
                    if (filterType === 'department' && !userPermissions.isAdmin) {
                        $('#filter-storage').data('department', userPermissions.currentUserDepartment || '');
                    }
                    saveFiltersToLocalStorage();
                    $('#employeeTable').DataTable().ajax.reload();
                    updateFilterBadges();
                });
                // ล้างตัวกรองทั้งหมด
                $('.clear-all-filters').on('click', function() {
                    $('#filter-storage').data('department', '');
                    $('#filter-storage').data('shift', '');
                    $('#filter-storage').data('door', '');
                    $('#filter-storage').data('status', 'active');
                    $('#filter-storage').data('fingerprint', '');
                    $('#filter-storage').data('hasProductionLine', false);
                    saveFiltersToLocalStorage();
                    $('#employeeTable').DataTable().ajax.reload();
                    updateFilterBadges();
                });


            }
        </script>
        }
