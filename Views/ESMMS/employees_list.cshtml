                              + '      <span class="badge bg-primary rounded-pill">'+ list.length +' รายการ</span>'
                              + '    </div>'
                              + '    <div class="card-body p-2">'
                              + '      <div class="table-responsive">'
                              + '        <table class="table table-sm table-striped align-middle mb-0">'
                              + '          <thead class="table-light">'
                              + '            <tr>'
                              + '              <th class="text-nowrap"><i class="far fa-calendar-check me-1 text-primary"></i>วันที่กำหนด</th>'
                              + '              <th class="text-nowrap"><i class="fas fa-file-alt me-1 text-primary"></i>ชุดสอบ</th>'
                              + '              <th class="text-nowrap"><i class="fas fa-book me-1 text-primary"></i>คอร์ส</th>'
                              + '              <th class="text-nowrap text-center"><i class="fas fa-star me-1 text-warning"></i>คะแนน</th>'
                              + '              <th class="text-nowrap"><i class="fas fa-industry me-1 text-primary"></i>ไลน์ผลิต</th>'
                              + '              <th class="text-nowrap"><i class="far fa-calendar-times me-1 text-danger"></i>หมดอายุ</th>'
                              + '            </tr>'
                              + '          </thead>'
                              + '          <tbody>';

                            list.forEach(function(x){
                                var assigned = x.assigned_at ? moment(x.assigned_at).format('DD/MM/YYYY HH:mm') : '-';
                                var expire = x.expire_at ? moment(x.expire_at).format('DD/MM/YYYY') : '-';
                                var course = x.course_code ? (x.course_code + (x.course_name ? (' - ' + x.course_name) : '')) : (x.course_name || '-');
                                var score = (x.score != null) ? x.score : '-';

                                // ไทย/简中: คำนวณสถานะหมดอายุด้วย badge
                                var expBadge = '';
                                if (x.expire_at) {
                                    try {
                                        var now = new Date();
                                        var dExp = new Date(x.expire_at);
                                        var days = Math.floor((dExp - now) / 86400000);
                                        if (days < 0) expBadge = '<span class="badge bg-danger ms-1">หมดอายุ</span>';
                                        else if (days <= 30) expBadge = '<span class="badge bg-warning text-dark ms-1">ใกล้หมดอายุ</span>';
                                        else expBadge = '<span class="badge bg-success ms-1">ปกติ</span>';
                                    } catch(e) { /* no-op */ }
                                }

                                // ไทย/简中: สี badge คะแนนอย่างง่าย
                                var scoreClass = 'bg-secondary';
                                if (typeof x.score === 'number') {
                                    if (x.score >= 8) scoreClass = 'bg-success';
                                    else if (x.score >= 5) scoreClass = 'bg-warning text-dark';
                                    else scoreClass = 'bg-danger';
                                }
                                var scoreHtml = '<span class="badge '+scoreClass+'">'+ score +'</span>';

                                // ไทย/简中: map ไลน์ผลิตจาก dict ถ้ามี
                                var pd = x.pd_line || '-';
                                try { if (window.pdlineDict && window.pdlineDict[pd]) pd = window.pdlineDict[pd]; } catch(e){}

                                // สร้างลิงก์สำหรับดาวน์โหลดไฟล์ Excel
                                var examTitleHtml = '-';
                                if (x.exam_title) {
                                    examTitleHtml = '<a href="#" class="download-excel-link text-primary fw-medium" ' +
                                        'data-exam-title="' + x.exam_title + '" ' +
                                        'data-person-id="' + row.personID + '" ' +
                                        'data-course-id="' + (x.course_id || '') + '" ' +
                                        'title="คลิกเพื่อดาวน์โหลดไฟล์ Excel">' +
                                        '<i class="fas fa-file-excel me-1 text-success"></i>' + x.exam_title +
                                        '</a>';
                                }

                                html += ''
                                  + '<tr>'
                                  + '  <td class="text-nowrap">'+ assigned +'</td>'
                                  + '  <td class="text-nowrap">'+ examTitleHtml +'</td>'
                                  + '  <td>'+ course +'</td>'
                                  + '  <td class="text-center">'+ scoreHtml +'</td>'
                                  + '  <td class="text-nowrap">'+ pd +'</td>'
                                  + '  <td class="text-nowrap">'+ expire + (expBadge ? (' ' + expBadge) : '') +'</td>'
                                  + '</tr>';
                            });

                            html += ''
                              + '          </tbody>'
                              + '        </table>'
                              + '      </div>'
                              + '    </div>'
                              + '  </div>'
                              + '</div>';

                            row.child(html).show();
                            
                            // เพิ่ม event handler สำหรับลิงก์ดาวน์โหลดไฟล์ Excel
                            $('.download-excel-link').off('click').on('click', function(e) {
                                e.preventDefault();
                                var examTitle = $(this).data('exam-title');
                                var personId = $(this).data('person-id');
                                var courseId = $(this).data('course-id');
                                
                                // เรียกใช้ฟังก์ชันดาวน์โหลดไฟล์ Excel
                                downloadExamExcel(examTitle, personId, courseId);
                            });
                         })
                         .fail(function(){
                            row.child('<div class="p-3 text-danger">โหลดประวัติการสอบไม่สำเร็จ</div>').show();
                         });
                    }
                });
            });
            // ฟังก์ชันดาวน์โหลดไฟล์ Excel สำหรับชุดสอบ
            function downloadExamExcel(examTitle, personId, courseId) {
                if (!examTitle) {
                    showErrorToast('ไม่พบชื่อชุดสอบ');
                    return;
                }
                
                // แสดง loading
                Swal.fire({
                    title: 'กำลังดาวน์โหลดไฟล์...',
                    html: '<div class="spinner-border text-primary" role="status"></div><br><small>กรุณารอสักครู่</small>',
                    showConfirmButton: false,
                    allowOutsideClick: false
                });
                
                // สร้าง URL สำหรับดาวน์โหลดไฟล์ Excel
                var downloadUrl = appBasePath + 'Employee/DownloadExamExcel?examTitle=' + encodeURIComponent(examTitle) + 
                    '&personId=' + encodeURIComponent(personId) + 
                    '&courseId=' + encodeURIComponent(courseId || '');
                
                // สร้างลิงก์ชั่วคราวเพื่อดาวน์โหลด
                var link = document.createElement('a');
                link.href = downloadUrl;
                link.download = examTitle + '_' + personId + '.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                // ปิด loading
                Swal.close();
                showSuccessToast('เริ่มดาวน์โหลดไฟล์: ' + examTitle);
            }

            // กำหนดตัวแปรสิทธิ์สำหรับใช้ใน JavaScript
            var userPermissions = {
                canAdd: @Json.Serialize(canAdd),
                canEdit: @Json.Serialize(canEdit),
                canDelete: @Json.Serialize(canDelete),
                canView: @Json.Serialize(canView),
                isAdmin: @Json.Serialize(isAdmin),

                currentUserDepartment: '@ViewData["CurrentUserDepartment"]'
            };

            // ฟังก์ชันกรองสถานะฝึกอบรมหลังจากข้อมูลโหลดเสร็จ
            function applyTrainingStatusFilter() {
                var statusFilter = $('#statusFilter').val();
                var table = $('#employeeTable').DataTable();
                
                // ถ้าไม่มี filter ให้แสดงข้อมูลทั้งหมด
                if (!statusFilter) {
                    // โหลดข้อมูลทั้งหมดใหม่
                    table.ajax.reload(function() {
                        updateTrainingDashboard();
                    });
                    return;
                }
                
                // กรองข้อมูลตามสถานะฝึกอบรม
                var allData = table.rows().data().toArray();
                var filteredData = allData.filter(function(row) {
                    var trainingStatus = row.__trainingStatus;
                    if (!trainingStatus) return statusFilter === 'red'; // ไม่มีข้อมูล = หมดอายุ
                    return trainingStatus.status === statusFilter;
                });
                
                // อัพเดทตาราง
                table.clear();
                table.rows.add(filteredData);
                table.draw();
                
                // อัพเดท dashboard
                updateTrainingDashboard();
            }
 
            // ฟังก์ชันอัพเดท dashboard สรุปสถานะฝึกอบรม
            function updateTrainingDashboard() {
                var table = $('#employeeTable').DataTable();
                // นับจากทุกแถว ไม่ใช่เฉพาะหน้าปัจจุบัน
                var data = table.rows().data().toArray();
                
                var counts = {
                    normal: 0,
                    expiring: 0,
                    processing: 0,
                    expired: 0
                };
                
                data.forEach(function(row) {
                    var status = row.__trainingStatus;
                    if (status) {
                        switch(status.status) {
                            case 'green':
                                counts.normal++;
                                break;
                            case 'yellow':
                                counts.expiring++;
                                break;
                            case 'blue':
                                counts.processing++;
                                break;
                            case 'red':
                            default:
                                counts.expired++;
                                break;
                        }
                    } else {
                        counts.expired++;
                    }
                });
                
                // อัพเดทตัวเลขใน dashboard
                $('#normalCount').text(counts.normal);
                $('#expiringCount').text(counts.expiring);
                $('#processingCount').text(counts.processing);
                $('#expiredCount').text(counts.expired);
            }

            // ฟังก์ชันกรองข้อมูลด้วย DataTable (เรียก API ครั้งเดียว)
            function applyFilters() {
                var departmentFilter = $('#departmentFilter').val();
                var workStatusFilter = $('#workStatusFilter').val();
                var pdlineFilter = $('#pdlineFilter').val();
                var hasProductionLineFilter = $('#hasProductionLineFilter').is(':checked');

                if (Array.isArray(departmentFilter)) departmentFilter = departmentFilter.join(',');
                if (Array.isArray(pdlineFilter)) pdlineFilter = pdlineFilter.join(',');

                $('#filter-storage').data('department', departmentFilter);
                $('#filter-storage').data('status', workStatusFilter);
                $('#filter-storage').data('pdline', pdlineFilter || '');
                $('#filter-storage').data('hasProductionLine', hasProductionLineFilter);

                Swal.fire({
                    title: 'กำลังกรองข้อมูล...',
                    html: '<div class="spinner-border text-primary" role="status"></div><br><small>กรุณารอสักครู่</small>',
                    showConfirmButton: false,
                    allowOutsideClick: false
                });

                var table = $('#employeeTable').DataTable();
                table.ajax.reload(function(){
                    Swal.close();
                    updateTrainingDashboard();
                    showSuccessToast('กรองข้อมูลสำเร็จ');
                }, false);
            }

            // ฟังก์ชันล้างตัวกรอง
            function clearFilters() {
                $('#departmentFilter').val(null).trigger('change');
                $('#statusFilter').val('');
                $('#workStatusFilter').val('');
                $('#pdlineFilter').val(null).trigger('change');
                $('#hasProductionLineFilter').prop('checked', false);
                updateDeptCount();

                $('#filter-storage').data('department', '');
                $('#filter-storage').data('status', '');
                $('#filter-storage').data('pdline', '');
                $('#filter-storage').data('hasProductionLine', false);

                Swal.fire({
                    title: 'กำลังโหลดข้อมูลทั้งหมด...',
                    html: '<div class="spinner-border text-primary" role="status"></div><br><small>กรุณารอสักครู่</small>',
                    showConfirmButton: false,
                    allowOutsideClick: false 
                });

                var table = $('#employeeTable').DataTable();
                table.ajax.reload(function(){
                    Swal.close();
                    updateTrainingDashboard();
                    showSuccessToast('โหลดข้อมูลทั้งหมดสำเร็จ');
                }, false);
            }

            // Event handlers สำหรับ filter
            $('#applyFilter').on('click', function() {
                applyFilters();
            });

            $('#clearFilter').on('click', function() {
                clearFilters();
            });

            // Enter key สำหรับกรองข้อมูล
            $('#departmentFilter, #statusFilter, #workStatusFilter').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    applyFilters();
                }
            });

            // ฟังก์ชันอัพเดทจำนวนแผนกที่เลือก
            function updateDeptCount() {
                var selectedCount = $('#departmentFilter').val() ? $('#departmentFilter').val().length : 0;
                var selectedDepts = $('#departmentFilter').val() || [];
                
                $('#deptCount').text(selectedCount + ' แผนก');
                
                if (selectedCount === 0) {
                    $('#deptCount').removeClass('filter-count-badge').addClass('badge bg-secondary');
                } else {
                    $('#deptCount').removeClass('badge bg-secondary').addClass('filter-count-badge');
                }
                
                // อัพเดทการแสดงผลตัวกรองที่เลือกไว้
                updateCurrentFilters();
            }
            
            // ฟังก์ชันอัพเดทการแสดงผลตัวกรองปัจจุบัน
            function updateCurrentFilters() {
                var selectedDepts = $('#departmentFilter').val() || [];
                var selectedStatus = $('#statusFilter').val();
                var selectedWorkStatus = $('#workStatusFilter').val();
                var selectedPdlines = $('#pdlineFilter').val() || [];
                var hasProductionLine = $('#hasProductionLineFilter').is(':checked');
                
                $('#current-filters').empty();
                
                // แสดงแผนกที่เลือก
                if (selectedDepts.length > 0) {
                    selectedDepts.forEach(function(dept) {
                        $('#current-filters').append(
                            '<span class="badge bg-primary rounded-pill me-1 mb-1">' +
                                '<i class="fas fa-building me-1"></i>' + dept +
                                '<button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="dept" data-value="' + dept + '"></button>' +
                            '</span>'
                        );
                    });
                }
                
                // แสดงสถานะฝึกอบรม
                if (selectedStatus) {
                    var statusLabels = {
                        'green': 'ปกติ',
                        'yellow': 'ใกล้หมดอายุ',
                        'blue': 'กำลังดำเนินการ',
                        'red': 'หมดอายุ'
                    };
                    $('#current-filters').append(
                        '<span class="badge bg-warning rounded-pill me-1 mb-1">' +
                            '<i class="fas fa-certificate me-1"></i>สถานะ: ' + (statusLabels[selectedStatus] || selectedStatus) +
                            '<button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="status"></button>' +
                        '</span>'
                    );
                }
                
                // แสดงสถานะการทำงาน
                if (selectedWorkStatus && selectedWorkStatus !== 'active') {
                    var workStatusLabels = {
                        'inactive': 'ไม่ใช้งาน',
                        'resigned': 'ลาออกแล้ว'
                    };
                    $('#current-filters').append(
                        '<span class="badge bg-danger rounded-pill me-1 mb-1">' +
                            '<i class="fas fa-user-times me-1"></i>สถานะ: ' + (workStatusLabels[selectedWorkStatus] || selectedWorkStatus) +
                            '<button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="workStatus"></button>' +
                        '</span>'
                    );
                }
                
                // แสดงไลน์ผลิตที่เลือก
                if (selectedPdlines.length > 0) {
                    selectedPdlines.forEach(function(pdline) {
                        $('#current-filters').append(
                            '<span class="badge bg-success rounded-pill me-1 mb-1">' +
                                '<i class="fas fa-industry me-1"></i>' + pdline +
                                '<button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="pdline" data-value="' + pdline + '"></button>' +
                            '</span>'
                        );
                    });
                }
                
                // แสดงตัวกรองไลน์ผลิต
                if (hasProductionLine) {
                    $('#current-filters').append(
                        '<span class="badge bg-info rounded-pill me-1 mb-1">' +
                            '<i class="fas fa-filter me-1"></i>มีไลน์ผลิตเท่านั้น' +
                            '<button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="hasProductionLine"></button>' +
                        '</span>'
                    );
                }
                
                // เพิ่มปุ่มล้างตัวกรองทั้งหมด
                if (selectedDepts.length > 0 || selectedStatus || (selectedWorkStatus && selectedWorkStatus !== 'active') || selectedPdlines.length > 0 || hasProductionLine) {
                    $('#current-filters').append(
                        '<span class="badge bg-dark rounded-pill me-1 mb-1 clear-all-filters" style="cursor: pointer;">' +
                            '<i class="fas fa-times-circle me-1"></i>ล้างทั้งหมด' +
                        '</span>'
                    );
                }
                
                // เพิ่ม event listener สำหรับปุ่มลบตัวกรอง
                $('.btn-close[data-filter]').on('click', function() {
                    var filterType = $(this).data('filter');
                    var filterValue = $(this).data('value');
                    
                    switch(filterType) {
                        case 'dept':
                            var currentDepts = $('#departmentFilter').val() || [];
                            var newDepts = currentDepts.filter(function(dept) { return dept !== filterValue; });
                            $('#departmentFilter').val(newDepts).trigger('change');
                            break;
                        case 'status':
                            $('#statusFilter').val('').trigger('change');
                            break;
                        case 'workStatus':
                            $('#workStatusFilter').val('active').trigger('change');
                            break;
                        case 'pdline':
                            var currentPdlines = $('#pdlineFilter').val() || [];
                            var newPdlines = currentPdlines.filter(function(pdline) { return pdline !== filterValue; });
                            $('#pdlineFilter').val(newPdlines).trigger('change');
                            break;
                        case 'hasProductionLine':
                            $('#hasProductionLineFilter').prop('checked', false).trigger('change');
                            break;
                    }
                });
                
                // เพิ่ม event listener สำหรับปุ่มล้างทั้งหมด
                $('.clear-all-filters').on('click', function() {
                    $('#departmentFilter').val(null).trigger('change');
                    $('#statusFilter').val('');
                    $('#workStatusFilter').val('active');
                    $('#pdlineFilter').val(null).trigger('change');
                    $('#hasProductionLineFilter').prop('checked', false);
                });
            }

            // ปุ่มเลือก/ยกเลิกเลือกแผนกทั้งหมด
            $('#selectAllDept').on('click', function() {
                var allValues = $('#departmentFilter option').map(function() {
                    return $(this).val();
                }).get();
                $('#departmentFilter').val(allValues).trigger('change');
                updateDeptCount();
            });

            $('#clearAllDept').on('click', function() {
                $('#departmentFilter').val(null).trigger('change');
                updateDeptCount();
            });

            // ปุ่มเลือก/ยกเลิกเลือกไลน์ผลิตทั้งหมด
            $('#selectAllPdline').on('click', function() {
                var allValues = $('#pdlineFilter option').map(function() {
                    return $(this).val();
                }).get();
                $('#pdlineFilter').val(allValues).trigger('change');
                updatePdlineCount();
            });

            $('#clearAllPdline').on('click', function() {
                $('#pdlineFilter').val(null).trigger('change');
                updatePdlineCount();
            });

            // อัพเดทจำนวนเมื่อมีการเปลี่ยนแปลง (เพิ่ม debounce เพื่อประสิทธิภาพ)
            var deptChangeTimeout;
            $('#departmentFilter').on('change', function() {
                clearTimeout(deptChangeTimeout);
                deptChangeTimeout = setTimeout(function() {
                    updateDeptCount();
                }, 100);
            });
            
            var pdlineChangeTimeout;
            $('#pdlineFilter').on('change', function() {
                clearTimeout(pdlineChangeTimeout);
                pdlineChangeTimeout = setTimeout(function() {
                    updatePdlineCount();
                }, 100);
            });
            
            // เพิ่มฟีเจอร์ keyboard navigation
            $('#departmentFilter').on('select2:open', function() {
                setTimeout(function() {
                    $('.select2-search__field').focus();
                }, 100);
            });
            
            $('#pdlineFilter').on('select2:open', function() {
                setTimeout(function() {
                    $('.select2-search__field').focus();
                }, 100);
            });
            
            // เพิ่มฟีเจอร์ auto-complete สำหรับการค้นหา
            $('#departmentFilter').on('select2:select', function(e) {
                var data = e.params.data;
                console.log('Selected department:', data.text);
                
                // เพิ่มเอฟเฟกต์ visual feedback
                $(this).addClass('select2-container--loading');
                setTimeout(function() {
                    $('#departmentFilter').removeClass('select2-container--loading');
                }, 300);
            });
            
            $('#pdlineFilter').on('select2:select', function(e) {
                var data = e.params.data;
                console.log('Selected production line:', data.text);
                
                // เพิ่มเอฟเฟกต์ visual feedback
                $(this).addClass('select2-container--loading');
                setTimeout(function() {
                    $('#pdlineFilter').removeClass('select2-container--loading');
                }, 300);
            });
            
            // กรองสถานะฝึกอบรมเมื่อมีการเปลี่ยนแปลง
            $('#statusFilter').on('change', function() {
                applyTrainingStatusFilter();
            });

            // อัพเดทจำนวนเมื่อโหลดหน้า
            updateDeptCount();
            updatePdlineCount();
            
            // ฟังก์ชันอัพเดทจำนวนไลน์ผลิตที่เลือก
            function updatePdlineCount() {
                var selectedCount = $('#pdlineFilter').val() ? $('#pdlineFilter').val().length : 0;
                var selectedPdlines = $('#pdlineFilter').val() || [];
                
                $('#pdlineCount').text(selectedCount + ' ไลน์ผลิต');
                
                if (selectedCount === 0) {
                    $('#pdlineCount').removeClass('filter-count-badge').addClass('badge bg-secondary');
                } else {
                    $('#pdlineCount').removeClass('badge bg-secondary').addClass('filter-count-badge bg-success');
                }
                
                // อัพเดทการแสดงผลตัวกรองที่เลือกไว้
                updateCurrentFilters();
            }
            
            // ฟังก์ชันตั้งค่า Select2
            function setupSelect2() {
                console.log('Setting up Select2...');
                console.log('Department options count:', $('#departmentFilter option').length);
                
                // ตั้งค่า Select2 สำหรับแผนก
                if (!$('#departmentFilter').hasClass('select2-hidden-accessible')) {
                    $('#departmentFilter').select2({
                        placeholder: 'เลือกแผนก...',
                        allowClear: true,
                        width: '100%',
                        closeOnSelect: false,
                        theme: 'bootstrap-5',
                        language: {
                            noResults: function() {
                                return '<div class="text-center py-3"><i class="fas fa-search me-2"></i>ไม่พบข้อมูลที่ค้นหา</div>';
