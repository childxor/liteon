            // ฟังก์ชันเพื่อโหลดข้อมูลประวัติการเปลี่ยนกะ
            function loadEmployeeHistory(personId) {
                return $.ajax({
                    url: appBasePath + 'Employee/GetEmployeeHistory',
                    type: 'GET',
                    data: {
                        personId: personId
                    },
                    success: function(response) {
                        let historyHtml = '';
                        let content = ''; // เพิ่มการประกาศตัวแปร content ที่จะใช้ในฟังก์ชัน
                        if (response.success && response.data.length > 0) {
                            // เก็บข้อมูลกะทั้งหมดไว้ในตัวแปร global
                            window.employeeShifts = response.data;
                            // เรียงข้อมูลตามวันที่จากเก่าสุดไปล่าสุด เพื่อแสดงแบบไทม์ไลน์
                            const sortedData = [...response.data].sort((a, b) => new Date(a.date) -
                                new Date(b.date));
                            const today = new Date();
                            today.setHours(0, 0, 0, 0);
                            // หากะปัจจุบัน (วันที่น้อยกว่าหรือเท่ากับวันนี้ และเป็นวันที่มากที่สุด)
                            const currentShift = response.data.reduce((current, item) => {
                                const itemDate = new Date(item.date);
                                itemDate.setHours(0, 0, 0, 0);
                                if (itemDate <= today && (!current || new Date(current.date) <
                                        itemDate)) {
                                    return item;
                                }
                                return current;
                            }, null);
                            // สร้าง HTML สำหรับส่วนหัวของประวัติการเปลี่ยนกะ
                            content = '<div class="card shadow-sm mb-3">' +
                                '<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">' +
                                '<div class="d-flex align-items-center">' +
                                '<i class="fas fa-history me-2 text-primary"></i>' +
                                '<span>ประวัติการเปลี่ยนกะ</span>';
                            if (currentShift) {
                                content += '<span class="badge bg-success ms-2">กะปัจจุบัน: ' + (
                                    currentShift.shiftMent || '-') + '</span>';
                            }
                            content += '</div>' +
                                '<button type="button" class="btn btn-sm btn-primary add-shift-btn" data-person-id="' +
                                personId + '">' +
                                '<i class="fas fa-plus-circle me-1"></i>เพิ่มกะ' +
                                '</button>' +
                                '</div>' +
                                '<div class="card-body p-2">' +
                                '<div class="timeline-shift">';
                            // สร้าง Timeline
                            sortedData.forEach(function(item) {
                                const itemDate = new Date(item.date);
                                itemDate.setHours(0, 0, 0, 0);
                                // เช็คว่าเป็นกะปัจจุบันหรือไม่
                                const isCurrentShift = currentShift && currentShift.id === item.id;
                                // กำหนดสถานะตามวันที่
                                let statusClass = '';
                                let statusText = '';
                                if (itemDate < today) {
                                    statusClass = 'bg-secondary';
                                    statusText = 'อดีต';
                                } else if (itemDate.getTime() === today.getTime()) {
                                    statusClass = 'bg-success';
                                    statusText = 'วันนี้';
                                } else {
                                    statusClass = 'bg-info';
                                    statusText = 'อนาคต';
                                }
                                const dateStr = item.date ? new Date(item.date).toLocaleDateString(
                                    'th-TH', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric'
                                    }) : '-';
                                const itemClass = isCurrentShift ? 'current' : '';
                                const iconClass = isCurrentShift ? 'text-success' :
                                    'text-secondary';
                                const dateStr2 = item.date && item.date.split('T') ? item.date
                                    .split('T')[0] : '';
                                content += '<div class="timeline-item ' + itemClass + '">' +
                                    '<div class="shift-card ' + itemClass + '">' +
                                    '<div class="shift-header">' +
                                    '<div class="shift-date">' +
                                    '<i class="fas fa-calendar-day me-1 ' + iconClass + '"></i> ' +
                                    dateStr +
                                    '<span class="badge ' + statusClass + ' ms-1 badge-sm">' +
                                    statusText + '</span>' +
                                    '</div>' +
                                    '<div class="shift-actions">' +
                                    '<button type="button" class="btn btn-shift-action btn-outline-warning edit-shift-btn" ' +
                                    'data-id="' + item.id + '" ' +
                                    'data-shift="' + (item.shiftMent || '') + '" ' +
                                    'data-date="' + dateStr2 + '" ' +
                                    'data-name="' + (item.name || '') + '" ' +
                                    'data-cardnumber="' + (item.cardNumber || '') + '" ' +
                                    'data-deptid="' + (item.deptID || '') + '" ' +
                                    'data-personid="' + (item.personId || '') + '" ' +
                                    'data-deptname="' + (item.deptName || '') + '" ' +
                                    'data-deptcode="' + (item.deptCode || item.deptID || '') +
                                    '" ' +
                                    'data-remark="' + (item.remark || '') + '" ' +
                                    'data-timein="' + (item.timeIn || '') + '" ' +
                                    'data-timeout="' + (item.timeOut || '') + '" ' +
                                    'data-shiftment="' + (item.shiftMent || '') + '" ' +
                                    'data-shiftname="' + (item.shiftName || '') + '" ' +
                                    'data-shiftgroup="' + (item.shiftGroup || '') + '" ' +
                                    'data-shiftstart="' + (item.shiftStart || '') + '" ' +
                                    'data-shiftend="' + (item.shiftEnd || '') + '" ' +
                                    'data-hascarddata="' + (item.hasCardData ? 'true' : 'false') +
                                    '" ' +
                                    'data-hasfingerprintdata="' + (item.hasFingerprintData ?
                                        'true' : 'false') + '">' +
                                    '<i class="fas fa-edit"></i>' +
                                    '</button>' +
                                    '<button type="button" class="btn btn-shift-action btn-outline-danger delete-shift-btn" ' +
                                    'data-id="' + item.id + '" ' +
                                    'data-personid="' + (item.personId || '') + '" ' +
                                    'data-name="' + (item.name || '') + '" ' +
                                    'data-shiftment="' + (item.shiftMent || '') + '" ' +
                                    'data-date="' + dateStr2 + '">' +
                                    '<i class="fas fa-trash-alt"></i>' +
                                    '</button>' +
                                    '</div>' +
                                    '</div>' +
                                    '<div class="shift-body">' +
                                    '<div class="shift-info">' +
                                    '<span class="badge bg-primary shift-badge">' + (item
                                        .shiftMent || '-') + '</span>' +
                                    '<span class="text-muted small">แผนก: ' + (item.deptName ||
                                        '-') + '</span>';
                                // แสดงหมายเหตุถ้ามี
                                if (item.remark) {
                                    content +=
                                        '<div class="small mt-1"><i class="fas fa-comment-alt text-muted me-1"></i>' +
                                        item.remark + '</div>';
                                }
                                content += '</div>' +
                                    '</div>' +
                                    '</div>' +
                                    '</div>';
                            });
                            content += '</div></div></div>';
                            historyHtml = content; // ใช้ content ที่สร้างไว้กับ historyHtml
                        } else {
                            // เคลียร์ข้อมูลกะเดิม
                            window.employeeShifts = [];
                            historyHtml = '<div class="card shadow-sm mb-3">' +
                                '<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">' +
                                '<div>' +
                                '<i class="fas fa-history me-2 text-primary"></i>' +
                                '<span>ประวัติการเปลี่ยนกะ</span>' +
                                '</div>' +
                                '<button type="button" class="btn btn-sm btn-primary add-shift-btn" data-person-id="' +
                                personId + '">' +
                                '<i class="fas fa-plus-circle me-1"></i>เพิ่มกะ' +
                                '</button>' +
                                '</div>' +
                                '<div class="card-body">' +
                                '<div class="text-center text-muted py-2">' +
                                '<i class="fas fa-info-circle me-1"></i> ไม่พบประวัติการเปลี่ยนกะ' +
                                '</div>' +
                                '</div>' +
                                '</div>';
                        }
                        return historyHtml;
                    },
                    error: function(error) {
                        console.error("Error loading employee history:", error);
                        return '<div class="alert alert-danger">เกิดข้อผิดพลาดในการโหลดข้อมูล</div>';
                    }
                });
            }
            // เพิ่มกะการทำงาน
            $('body').on('click', '.add-shift-btn', function() {
                let personId = $(this).data('person-id');
                resetShiftForm();
                // ดึงข้อมูลพนักงานจากตาราง
                let row = $('#employeeTable').DataTable().row($(this).closest('tr').prev()).data();
                console.log(row);
                if (!row) {
                    // กรณีคลิกจาก child row
                    let parentRow = $(this).closest('.child').parent().prev();
                    row = $('#employeeTable').DataTable().row(parentRow).data();
                }
                if (row) {
                    // กำหนดค่าข้อมูลจากแถวของตาราง
                    $('#shiftPersonId').val(personId);
                    $('#shiftCardNo').val(row.cardNumber || '');
                    $('#shiftPersonNameDisplay').text(row.name || '');
                    $('#shiftCardNoDisplay').text('');
                    $('#shiftDeptDisplay').text(row.department || '');
                    $('#shiftDeptID').val(row.deptID || '');
                    $('#shiftDeptIDDisplay').val(row.deptID || '');
                    $('#shiftDeptCode').val(row.deptID || '');
                    // ตั้งค่า select แผนกให้ตรงกับข้อมูลพนักงาน
                    let deptName = row.deptName || row.department || '';
                    $('#shiftDeptName').val(deptName);
                    // เก็บข้อมูลสถานะ SQL944 ไว้ใน data attribute
                    $('#shiftModal').data('hasCardData', row.hasCardData);
                } else {
                    // กรณีไม่สามารถดึงข้อมูลจากตารางได้
                    $.ajax({
                        url: appBasePath + 'Employee/GetEmployeeBasicInfo',
                        type: 'GET',
                        data: {
                            personId: personId
                        },
                        async: false,
                        success: function(response) {
                            if (response.success) {
                                $('#shiftPersonId').val(personId);
                                $('#shiftCardNo').val(response.data.cardNumber || '');
                                $('#shiftPersonNameDisplay').text(response.data.name || '');
                                $('#shiftCardNoDisplay').text(response.data.cardNumber || '');
                                $('#shiftDeptDisplay').text(response.data.deptName || '');
                                $('#shiftDeptID').val(response.data.deptID || '');
                                $('#shiftDeptIDDisplay').val(response.data.deptID || '');
                                $('#shiftDeptCode').val(response.data.deptCode || response.data
                                    .deptID || '');
                                $('#shiftDeptName').val(response.data.deptName || '');
                                // เก็บข้อมูลสถานะ SQL944 ไว้ใน data attribute
                                $('#shiftModal').data('hasCardData', response.data.hasCardData);
