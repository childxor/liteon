            // เมื่อเลือกแผนก อัพเดทรหัสแผนก 
            $('#deptName').on('change', function() {
                $('#deptID').val($(this).val());
            });
            // แสดงรายละเอียดพนักงาน
            $('body').on('click', '.toggle-child-row', function() {
                let tr = $(this).closest('tr');
                let row = $('#employeeTable').DataTable().row(tr);
                if (row.child.isShown()) {
                    // ปิดรายละเอียด
                    row.child.hide();
                    $(this).find('i').removeClass('fa-minus').addClass('fa-plus');
                    $(this).removeClass('shown');
                    tr.removeClass('shown-row');
                } else {
                    // เปิดรายละเอียด
                    let personId = $(this).data('id');
                    // แสดง Loading
                    row.child(
                        '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div><div class="mt-2">กำลังโหลดข้อมูล...</div></div>'
                    ).show();
                    $(this).find('i').removeClass('fa-plus').addClass('fa-minus');
                    $(this).addClass('shown');
                    tr.addClass('shown-row');
                    // ดึงข้อมูลประวัติพนักงาน
                    $.ajax({
                        url: appBasePath + 'Employee/GetEmployeeHistory',
                        type: 'GET',
                        data: { 
                            personId: personId
                        },
                        success: function(response) {
                            let historyHtml = '';
                            let content = ''; // เพิ่มการประกาศตัวแปร content ที่จะใช้ในฟังก์ชัน
                            if (response.success && response.data.length > 0) {
                                // เก็บข้อมูลกะทั้งหมดไว้ในตัวแปร global
                                window.employeeShifts = response.data;
                                // เรียงข้อมูลตามวันที่จากเก่าสุดไปล่าสุด เพื่อแสดงแบบไทม์ไลน์
                                const sortedData = [...response.data].sort((a, b) => new Date(a
                                        .date) -
                                    new Date(b.date));
                                const today = new Date();
                                today.setHours(0, 0, 0, 0);
                                // หากะปัจจุบัน (วันที่น้อยกว่าหรือเท่ากับวันนี้ และเป็นวันที่มากที่สุด)
                                const currentShift = response.data.reduce((current, item) => {
                                    const itemDate = new Date(item.date);
                                    itemDate.setHours(0, 0, 0, 0);
                                    if (itemDate <= today && (!current || new Date(current
                                                .date) <
                                            itemDate)) {
                                        return item;
                                    }
                                    return current;
                                }, null);
                                // สร้าง HTML สำหรับส่วนหัวของประวัติการเปลี่ยนกะ
                                content = '<div class="card shadow-sm mb-3">' +
                                    '<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">' +
                                    '<div class="d-flex align-items-center">' +
                                    '<i class="fas fa-history me-2 text-primary"></i>' +
                                    '<span>ประวัติการเปลี่ยนกะ</span>';
                                if (currentShift) {
                                    content += '<span class="badge bg-success ms-2">กะปัจจุบัน: ' +
                                        (
                                            currentShift.shiftMent || '-') + '</span>';
                                }
                                content += '</div>' +
                                    '<button type="button" class="btn btn-sm btn-primary add-shift-btn" data-person-id="' +
                                    personId + '">' +
                                    '<i class="fas fa-plus-circle me-1"></i>เพิ่มกะ' +
                                    '</button>' +
                                    '</div>' +
                                    '<div class="card-body p-2">' +
                                    '<div class="timeline-shift">';
                                // สร้าง Timeline
                                sortedData.forEach(function(item) {
                                    const cardNumber = item.cardNumber;
                                    const itemDate = new Date(item.date);
                                    itemDate.setHours(0, 0, 0, 0);
                                    // เช็คว่าเป็นกะปัจจุบันหรือไม่
                                    const isCurrentShift = currentShift && currentShift
                                        .id === item.id;
                                    // กำหนดสถานะตามวันที่
                                    let statusClass = '';
                                    let statusText = '';
                                    if (itemDate < today) {
                                        statusClass = 'bg-secondary';
                                        statusText = 'อดีต';
                                    } else if (itemDate.getTime() === today.getTime()) {
                                        statusClass = 'bg-success';
                                        statusText = 'วันนี้';
                                    } else {
                                        statusClass = 'bg-info';
                                        statusText = 'อนาคต';
                                    }
                                    const dateStr = item.date ? new Date(item.date)
                                        .toLocaleDateString(
                                            'th-TH', {
                                                year: 'numeric',
                                                month: 'short',
                                                day: 'numeric'
                                            }) : '-';
                                    const itemClass = isCurrentShift ? 'current' : '';
                                    const iconClass = isCurrentShift ? 'text-success' :
                                        'text-secondary';
                                    const dateStr2 = item.date && item.date.split('T') ?
                                        item.date
                                        .split('T')[0] : '';
                                    // เก็บข้อมูลกะในแบบ data-* เพื่อใช้ในการแก้ไข
                                    content += '<div class="timeline-item ' + itemClass +
                                        '">' +
                                        '<div class="shift-card ' + itemClass + '">' +
                                        '<div class="shift-header">' +
                                        '<div class="shift-date">' +
                                        '<i class="fas fa-calendar-day me-1 ' + iconClass +
                                        '"></i> ' +
                                        dateStr +
                                        '<span class="badge ' + statusClass +
                                        ' ms-1 badge-sm">' +
                                        statusText + '</span>' +
                                        (item.shouldChange ? ' <span class="badge bg-danger ms-2"><i class="fas fa-exclamation-triangle me-1"></i>ควรเปลี่ยน</span>' : '') +
                                        '</div>' +
                                        '<div class="shift-actions">' +
                                        '<button type="button" class="btn btn-shift-action btn-outline-warning edit-shift-btn" ' +
                                        'data-id="' + item.id + '" ' +
                                        'data-shift="' + (item.shiftMent || '') + '" ' +
                                        'data-date="' + dateStr2 + '" ' +
                                        'data-name="' + (item.name || '') + '" ' +
                                        'data-cardnumber="' + (item.cardNumber || '') +
                                        '" ' +
                                        'data-deptid="' + (item.deptID || '') + '" ' +
                                        'data-personid="' + (personId) + '" ' +
                                        'data-deptname="' + (item.deptName || '') + '" ' +
                                        'data-deptcode="' + (item.deptCode || item.deptID ||
                                            '') + '" ' +
                                        'data-remark="' + (item.remark || '') + '" ' +
                                        'data-timein="' + (item.timeIn || '') + '" ' +
                                        'data-timeout="' + (item.timeOut || '') + '" ' +
                                        'data-shiftment="' + (item.shiftMent || '') + '" ' +
                                        'data-shiftname="' + (item.shiftName || '') + '" ' +
                                        'data-shiftgroup="' + (item.shiftGroup || '') +
                                        '" ' +
                                        'data-shiftstart="' + (item.shiftStart || '') +
                                        '" ' +
                                        'data-shiftend="' + (item.shiftEnd || '') + '" ' +
                                        'data-hascarddata="' + (item.hasCardData ? 'true' :
                                            'false') + '" ' +
                                        'data-hasfingerprintdata="' + (item
                                            .hasFingerprintData ? 'true' : 'false') + '">' +
                                        '<i class="fas fa-edit"></i>' +
                                        '</button>' +
                                        '<button type="button" class="btn btn-shift-action btn-outline-danger delete-shift-btn" ' +
                                        'data-id="' + item.id + '" ' +
                                        'data-personid="' + (item.personId || '') + '" ' +
                                        'data-name="' + (item.name || '') + '" ' +
                                        'data-shiftment="' + (item.shiftMent || '') + '" ' +
                                        'data-date="' + dateStr2 + '">' +
                                        '<i class="fas fa-trash-alt"></i>' +
                                        '</button>' +
                                        '</div>' +
                                        '</div>' +
                                        '<div class="shift-body">' +
                                        '<div class="shift-info">' +
                                        '<span class="badge bg-primary shift-badge">' + (item.shiftMent || '-') + '</span>' +
                                        (item.shouldChange && item.hrShift ? '<span class="ms-2 badge bg-warning text-dark">HR: ' + item.hrShift + '</span>' : '') +
                                        '<span class="text-muted small">แผนก: ' + ((item.TWorkArea && item.TWorkArea.trim() !== '' ? item.TWorkArea : (item.deptName || '-'))) + '</span>';
                                    // แสดงหมายเหตุถ้ามี
                                    if (item.remark) {
                                        content +=
                                            '<div class="small mt-1"><i class="fas fa-comment-alt text-muted me-1"></i>' +
                                            item.remark + '</div>';
                                    }
                                    if (item.shouldChange && (item.changeReasonDesc || item.changeReasonCode)) {
                                        content += '<div class="small mt-1 text-danger"><i class="fas fa-info-circle me-1"></i>' +
                                            (item.changeReasonDesc || ('เหตุผล: ' + item.changeReasonCode)) + '</div>';
                                    }
                                    content += '</div>' +
                                        '</div>' +
                                        '</div>' +
                                        '</div>';
                                });
                                content += '</div></div></div>';
                                historyHtml = content; // ใช้ content ที่สร้างไว้กับ historyHtml
                            } else {
                                // เคลียร์ข้อมูลกะเดิม
                                window.employeeShifts = [];
                                historyHtml = '<div class="card shadow-sm mb-3">' +
                                    '<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">' +
                                    '<div>' +
                                    '<i class="fas fa-history me-2 text-primary"></i>' +
                                    '<span>ประวัติการเปลี่ยนกะ</span>' +
                                    '</div>' +
                                    '<button type="button" class="btn btn-sm btn-primary add-shift-btn" data-person-id="' +
                                    personId + '">' +
                                    '<i class="fas fa-plus-circle me-1"></i>เพิ่มกะ' +
                                    '</button>' +
                                    '</div>' +
                                    '<div class="card-body">' +
                                    '<div class="text-center text-muted py-2">' +
                                    '<i class="fas fa-info-circle me-1"></i> ไม่พบประวัติการเปลี่ยนกะ' +
                                    '</div>' +
                                    '</div>' +
                                    '</div>';
                            }
                            // อัปเดต child row
                            row.child(historyHtml).show();
                        },
                        error: function(error) {
                            console.error("Error fetching employee history:", error);
                            row.child(
                                '<div class="p-3 text-danger"><i class="fas fa-exclamation-triangle me-2"></i>เกิดข้อผิดพลาดในการโหลดข้อมูล</div>'
                            ).show();
                        }
                    });
                }
            });
            // ฟังก์ชันรีโหลดข้อมูลเมื่อมีการอัปเดท
            function refreshOpenedChildRow() {
                // หา child row ที่เปิดอยู่
                let openedRow = $('.toggle-child-row.shown');
                if (openedRow.length > 0) {
                    // จำลองการคลิกเพื่อปิด
                    openedRow.click();
                    // จำลองการคลิกเพื่อเปิดใหม่
                    setTimeout(function() {
                        openedRow.click();
                    }, 100);
                }
            }
            // ฟังก์ชันสำหรับแสดงโมดอลเพิ่มกะการทำงาน
            function showAddShiftModal(personId) {
                // เริ่มต้นค่าฟอร์ม
                $('#shiftModalTitle').text('เพิ่มกะการทำงาน');
                $('#shiftForm')[0].reset();
                $('#shiftId').val('');
                $('#personId').val(personId);
                $('#shiftDate').val(moment().format('YYYY-MM-DD'));
                $('#actionType').val('add');
                // แสดงโมดอล
                $('#shiftModal').modal('show');
            }
            // ฟังก์ชันสำหรับแสดงโมดอลแก้ไขกะการทำงาน
            function showEditShiftModal(id, personId, shift, date, timeIn, timeOut, cardNumber) {
                // กำหนดค่าให้ฟอร์ม
                $('#shiftModalTitle').text('แก้ไขกะการทำงาน');
                $('#shiftId').val(id);
                $('#personId').val(personId);
                $('#shift').val(shift);
                $('#shiftDate').val(date);
                $('#timeIn').val(timeIn);
                $('#timeOut').val(timeOut);
                $('#actionType').val('edit');
                $('#shiftCardNo').val(cardNumber || '');
                $('#shiftCardNoDisplay').text(cardNumber || '');
                // แสดงโมดอล
                $('#shiftModal').modal('show');
            }
            // ลบกะการทำงาน
            $('body').on('click', '.delete-shift-btn', function() {
                let id = $(this).data('id');
                confirmDeleteShift(id);
            });
            // ฟังก์ชันสำหรับยืนยันการลบกะการทำงาน
            function confirmDeleteShift(id) {
                Swal.fire({
                    title: 'ยืนยันการลบ',
                    text: 'คุณต้องการลบประวัติกะการทำงานนี้ใช่หรือไม่?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ยืนยัน',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#dc3545',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        deleteShift(id);
                    }
                });
            }
            // ฟังก์ชันสำหรับลบกะการทำงาน
            function deleteShift(id) {
                $.ajax({
                    url: appBasePath + 'Employee/DeleteShiftHistory',
                    type: 'POST',
                    data: {
                        id: id
                    },
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader("RequestVerificationToken",
                            $('input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    success: function(response) {
                        if (response.success) {
                            showSuccessToast(response.message);
                            // รีโหลดข้อมูล child row ที่กำลังแสดงอยู่
                            refreshOpenedChildRow();
                        } else {
                            showErrorToast(response.message);
                        }
                    },
                    error: function() {
                        showErrorToast('เกิดข้อผิดพลาดในการลบข้อมูล');
                    }
                });
            }
            // เมื่อกดปุ่มบันทึกในโมดอลกะการทำงาน
            $('#saveShiftButton').on('click', function() {
                if (!$('#shiftForm')[0].checkValidity()) {
                    $('#shiftForm')[0].classList.add('was-validated');
                    return;
                }
                let data = {
                    Id: $('#shiftId').val() ? parseInt($('#shiftId').val()) : 0,
                    PersonId: $('#personId').val(),
                    ShiftMent: $('#shift').val(),
                    Date: $('#shiftDate').val(),
                    TimeIn: $('#timeIn').val() ? $('#shiftDate').val() + 'T' + $('#timeIn').val() : null,
                    TimeOut: $('#timeOut').val() ? $('#shiftDate').val() + 'T' + $('#timeOut').val() : null
                };
                $.ajax({
                    url: appBasePath + 'Employee/SaveShiftChange',
                    type: 'POST',
                    contentType: 'application/json',
