                // สร้าง Sheet สำหรับแต่ละแผนก
                Object.keys(departments).forEach(function(deptName) {
                    // กำหนดชื่อชีต (ตัดความยาวไม่เกิน 31 ตัวอักษรตามข้อจำกัด Excel)
                    var sheetName = deptName.length > 31 ? deptName.substring(0, 31) : deptName;

                    // สร้างข้อมูลชีต โดยให้คอลัมน์ Department เท่ากับชื่อชีต
                    var deptData = createDepartmentSheetWithDoors(departments[deptName], sheetName);
