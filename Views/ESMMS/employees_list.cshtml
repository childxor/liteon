                    } catch (e) { console.warn('SheetJS style not fully supported in this build:', e); }
                    XLSX.utils.book_append_sheet(wb, overviewWs, 'Door Access Overview');

                                    // แยกข้อมูลตามแผนก
                var departments = {};
                data.forEach(function(row) {
