            // ===== สถานะฝึกอบรมจาก ESMMS =====
			function loadTrainingStatuses() {
				var dt = $('#employeeTable').DataTable();
				var data = dt.rows({ page: 'current' }).data().toArray();
				if (!data || data.length === 0) return;

				// ถ้าข้อมูลสถานะมาพร้อมจากเซิร์ฟเวอร์แล้ว ให้ redraw และกรองทันทีโดยไม่เรียก API
				var hasTraining = data.some(function (r) { return r && r.__trainingStatus; });
				if (hasTraining) {
					var statusFilter0 = $('#statusFilter').val();
					if (statusFilter0) {
						setTimeout(function(){ applyTrainingStatusFilter(); }, 100);
					}
					dt.rows({ page: 'current' }).invalidate('data').draw(false);
					return;
				}

				// สร้างรายการรหัส และแบ่งเป็นล็อตเพื่อหลีกเลี่ยง URL ยาวเกิน (414)
				var ids = [];
				data.forEach(function (r) {
					var pid = r && r.personID;
					if (pid) ids.push(String(pid).trim());
				});
				if (!ids.length) return;

				var chunkSize = 150;
				var chunks = [];
				for (var i = 0; i < ids.length; i += chunkSize) {
					chunks.push(ids.slice(i, i + chunkSize));
				}

				var requests = chunks.map(function (chunk) {
					return $.get('@Url.Action("GetTrainingStatusForEmployees","Exam")', { personIds: chunk.join(',') })
						.then(function (res) {
							return Array.isArray(res) ? res : (res && res.data ? res.data : []);
						});
				});

				Promise.all(requests).then(function (lists) {
					var merged = [];
					lists.forEach(function (list) { merged = merged.concat(list); });
					var map = {};
					merged.forEach(function (x) { map[String(x.emp_no || '').trim()] = x; });

					// ใช้ cache pdline ถ้ามี ไม่งั้นใช้ข้อมูลว่าง
					var useDict = (window.pdlineDict && Object.keys(window.pdlineDict).length > 0) ? window.pdlineDict : {};
					var applyAndDraw = function(dict){
						dict = dict || {};
						dt.rows({ page: 'current' }).every(function () {
							var row = this.data();
							var key = String(row.personID || '').trim();
							var st = map[key] || null;
							if (st) {
								var pdId = (st.pd_line||'').toString();
								st.pdline_name = dict[pdId] || (pdId || null);
							}
							row.__trainingStatus = st;
							this.data(row, false);
						});
						dt.rows({ page: 'current' }).invalidate('data').draw(false);

						var statusFilter = $('#statusFilter').val();
						if (statusFilter) {
							setTimeout(function(){ applyTrainingStatusFilter(); }, 100);
						}
					};

					applyAndDraw(useDict);
				});
			}

			// รองรับการเรียกแบบเดิม: gettrainingstatus() -> ใช้ loadTrainingStatuses()
			function gettrainingstatus() {
				try {
					var dt = $('#employeeTable').DataTable();
					var rows = dt.rows({ page: 'current' }).data().toArray();
					var hasTraining = rows && rows.some(function(r){ return r && r.__trainingStatus; });
					if (hasTraining) {
						var statusFilter = $('#statusFilter').val();
						if (statusFilter) {
							setTimeout(function(){ applyTrainingStatusFilter(); }, 100);
						}
						// อัปเดตตารางเผื่อ renderer ใช้ __trainingStatus
						dt.rows({ page: 'current' }).invalidate('data').draw(false);
						return;
					}
					// ถ้าไม่มีข้อมูลในแถว ให้ดึงจาก API
					loadTrainingStatuses();
				} catch (e) { /* no-op */ }
			}

