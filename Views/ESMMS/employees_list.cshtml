                            var addr = XLSX.utils.encode_cell({ r: r, c: c });
                            ws[addr] = ws[addr] || { t: 's', v: v };
                            if (typeof v !== 'undefined') ws[addr].v = v;
                            ws[addr].s = Object.assign({
