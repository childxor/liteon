                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_c")</label>
                            <input name="choice_c" id="edit_c_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_c_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_c" accept="image/*"
