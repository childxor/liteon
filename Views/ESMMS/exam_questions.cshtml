@using IPS_TH.Models.ESMMS
@model IEnumerable<esmms_question>

@{
    ViewData["Title"] = "จัดการข้อสอบรายคอร์ส";
    var selected = ViewBag.SelectedCourse as string ?? string.Empty;
}

<div class="container-fluid py-3 mt-4">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0">ข้อสอบตามคอร์ส</h5>
                <form method="get" asp-action="Index" asp-controller="ExamQuestion" class="d-flex align-items-center">
                    <select name="course_code" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                        <option value="">-- เลือกคอร์ส --</option>
                        @foreach (var c in (IEnumerable<dynamic>)ViewBag.Courses)
                        {
                            <option value="@c.course_code"
                                selected="@(selected == (string)c.course_code ? "selected" : null)">@c.course_code
                                @c.description_en</option>
                        }
                    </select>
                    <noscript><button class="btn btn-sm btn-secondary" type="submit">เลือก</button></noscript>
                </form>
            </div>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg"></i> เพิ่มข้อสอบ
            </button>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="questionTable" class="table table-hover table-striped table-sm align-middle mb-0"></table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">เพิ่มข้อสอบ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateQuestion" asp-controller="ExamQuestion" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-2"> 
                        <div class="col-12">
                            <label class="form-label">คอร์ส (course_code)</label>
                            <input name="course_code" class="form-control form-control-sm" maxlength="20" readonly
                                value="@selected" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">คำถาม</label>
                            <textarea name="question_text" class="form-control form-control-sm" rows="3"
                                maxlength="1000" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รูปภาพประกอบ (ไม่บังคับ)</label>
                            <input type="file" name="image" accept="image/*" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก A</label>
                            <input name="choice_a" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก B</label>
                            <input name="choice_b" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก C</label>
                            <input name="choice_c" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก D</label>
                            <input name="choice_d" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">คำตอบที่ถูกต้อง</label>
                            <select name="correct_choice" class="form-select form-select-sm">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">คะแนน</label>
                            <input type="number" name="score" class="form-control form-control-sm" min="1" value="1" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" value="true" name="is_active" checked />
                                <input type="hidden" name="is_active" value="false" />
                                <label class="form-check-label">เปิดใช้งาน</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary">บันทึก</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModalQ" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">แก้ไขข้อสอบ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editFormQ" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit_id_q" />
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">คอร์ส (course_code)</label>
                            <input name="course_code" id="edit_course_code_q" class="form-control form-control-sm"
                                maxlength="20" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">คำถาม</label>
                            <textarea name="question_text" id="edit_question_text_q"
                                class="form-control form-control-sm" rows="3" maxlength="1000" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รูปภาพปัจจุบัน</label>
                            <div id="edit_image_preview" class="border rounded p-2 text-center">
                                <span class="text-muted">ไม่มีรูป</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">เลือกรูปใหม่ (ถ้ามี)</label>
                            <input type="file" name="image" id="edit_image_q" accept="image/*"
                                class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก A</label>
                            <input name="choice_a" id="edit_a_q" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก B</label>
                            <input name="choice_b" id="edit_b_q" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก C</label>
                            <input name="choice_c" id="edit_c_q" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก D</label>
                            <input name="choice_d" id="edit_d_q" class="form-control form-control-sm" maxlength="500" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">คำตอบที่ถูกต้อง</label>
                            <select name="correct_choice" id="edit_correct_q" class="form-select form-select-sm">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">คะแนน</label>
                            <input type="number" name="score" id="edit_score_q" class="form-control form-control-sm"
                                min="1" value="1" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" value="true" name="is_active"
                                    id="edit_active_q">
                                <label class="form-check-label" for="edit_active_q">เปิดใช้งาน</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary">บันทึก</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            try {
                const APP_BASE = '@Url.Content("~/")';
                var table = $('#questionTable').DataTable({
                    language: { url: '/js/datatables/i18n/th.json' },
                    responsive: true,
                    autoWidth: false,
                    processing: true,
                    serverSide: false,
                    ordering: false,
                    ajax: {
                        url: '@Url.Action("GetQuestions", "ExamQuestion", new { course_code = ViewBag.SelectedCourse })',
                        dataSrc: 'data'
                    },
                    columns: [
                        { data: null, title: '#', orderable: false, render: (d, t, r, m) => m.row + 1 },
                        { data: 'course_code', title: 'คอร์ส' },
                        { data: 'question_text', title: 'คำถาม' },
                        { data: 'image_path', title: 'รูปภาพ', className: 'text-center', render: function (v) {
                            if (!v) return '-';
                            var src = v.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + v) : (APP_BASE + v);
                            return '<img src="' + src + '" style="max-height:60px;" />';
                        } },
                        { data: 'choice_a', title: 'A' },
                        { data: 'choice_b', title: 'B' },
                        { data: 'choice_c', title: 'C' },
                        { data: 'choice_d', title: 'D' },
                        { data: 'correct_choice', title: 'คำตอบ' },
                        { data: 'score', title: 'คะแนน', className: 'text-center' },
                        { data: 'is_active', title: 'สถานะ', className: 'text-center', render: v => v ? '<span class="badge text-bg-success">ใช้งาน</span>' : '<span class="badge text-bg-secondary">ปิด</span>' },
                        {
                            data: null, title: 'Action', orderable: false, className: 'text-end', render: function (d, t, row) {
                                var editBtn = '<button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit"'
                                    + ' data-id="' + row.id + '"'
                                    + ' data-course_code="' + (row.course_code || '') + '"'
                                    + ' data-question="' + (row.question_text || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-image="' + (row.image_path || '') + '"'
                                    + ' data-a="' + (row.choice_a || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-b="' + (row.choice_b || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-c="' + (row.choice_c || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-d="' + (row.choice_d || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-correct="' + (row.correct_choice || 'A') + '"'
                                    + ' data-score="' + (row.score || 1) + '"'
                                    + ' data-active="' + (row.is_active ? 'true' : 'false') + '">แก้ไข</button>';
                                var delBtn = '<button type="button" class="btn btn-outline-danger btn-sm btn-delete" data-id="' + row.id + '">ลบ</button>';
                                return editBtn + delBtn;
                            }
                        }
                    ],
                    pageLength: 10,
                    info: false,
                    lengthChange: false,
                    paging: false,
                    searching: false
                });

                // เปิด modal เพื่อแก้ไข (เติมค่าจาก data-*)
                $(document).on('click', '.btn-edit', function () {
                    const b = $(this);
                    $('#edit_id_q').val(b.data('id'));
                    $('#edit_course_code_q').val(b.data('course_code'));
                    $('#edit_question_text_q').val(b.data('question'));
                    $('#edit_a_q').val(b.data('a'));
                    $('#edit_b_q').val(b.data('b'));
                    $('#edit_c_q').val(b.data('c'));
                    $('#edit_d_q').val(b.data('d'));
                    $('#edit_correct_q').val(b.data('correct'));
                    $('#edit_score_q').val(b.data('score'));
                    $('#edit_active_q').prop('checked', (b.data('active') === true || b.data('active') === 'true'));
                    const img = b.data('image');
                    if (img) {
                        const src = (typeof img === 'string' && img.startsWith('/')) ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + (img || ''));
                        $('#edit_image_preview').html('<img src="' + src + '" style="max-height:100px;" />');
                    } else {
                        $('#edit_image_preview').html('<span class="text-muted">ไม่มีรูป</span>');
                    }
                    new bootstrap.Modal(document.getElementById('editModalQ')).show();
                });

                // ส่งแก้ไขแบบ AJAX (รองรับรูป)
                $('#editFormQ').on('submit', function (e) {
                    e.preventDefault();
                    const form = document.getElementById('editFormQ');
                    const fd = new FormData(form);
                    $.ajax({
                        url: '@Url.Action("EditAjax", "ExamQuestion")',
                        type: 'POST',
                        data: fd,
                        processData: false,
                        contentType: false
                    }).done(function () {
                        $('#editModalQ').modal('hide');
                        Swal.fire({ icon: 'success', title: 'บันทึกแล้ว', timer: 1000, showConfirmButton: false });
                        table.ajax.reload(null, false);
                    }).fail(function (xhr) {
                        Swal.fire({ icon: 'error', title: 'บันทึกไม่สำเร็จ', text: xhr.responseText || xhr.statusText });
                    });
                });

                // ลบด้วย SweetAlert2 + AJAX (ยืนยันครั้งเดียว)
                $(document).on('click', '.btn-delete', function () {
                    const id = $(this).data('id');
                    Swal.fire({
                        title: 'ยืนยันการลบ?',
                        text: 'ข้อมูลจะถูกลบออกจากระบบ',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'ลบ',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("DeleteAjax", "ExamQuestion")',
                                method: 'POST',
                                data: { id }
                            }).done(function () {
                                Swal.fire({ icon: 'success', title: 'ลบแล้ว', timer: 1000, showConfirmButton: false });
                                table.ajax.reload(null, false);
                            }).fail(function (xhr) {
                                Swal.fire({ icon: 'error', title: 'ลบไม่สำเร็จ', text: xhr.responseText || xhr.statusText });
                            });
                        }
                    });
                });
            } catch (e) {
                console.warn('DataTable init failed:', e);
            }
        });
    </script>
}
