                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_d")</label>
                            <input name="choice_d" id="edit_d_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_d_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_d" accept="image/*"
                                    class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก E</label>
                            <input name="choice_e" id="edit_e_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_e_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_e" accept="image/*"
                                    class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก F</label>
                            <input name="choice_f" id="edit_f_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_f_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_f" accept="image/*"
                                    class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก G</label>
                            <input name="choice_g" id="edit_g_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_g_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_g" accept="image/*"
                                    class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก H</label>
                            <input name="choice_h" id="edit_h_q" class="form-control form-control-sm" maxlength="500" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <div id="prev_h_q" class="flex-grow-1 small text-muted">ไม่มีรูป</div>
                                <input type="file" name="image_h" accept="image/*"
                                    class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">คำตอบที่ถูกต้อง</label>
                            <textarea name="correct_answer" id="edit_correct_q" class="form-control form-control-sm"
                                rows="2" maxlength="500" placeholder="กรอกคำตอบที่ถูกต้อง" required></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label">คะแนน</label>
                            <input type="number" name="score" id="edit_score_q" class="form-control form-control-sm"
                                min="1" value="1" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" value="true" name="is_active"
                                    id="edit_active_q">
                                <label class="form-check-label" for="edit_active_q">เปิดใช้งาน</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary">บันทึก</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            try {
                const APP_BASE = '@Url.Content("~/")';
                var table = $('#questionTable').DataTable({
                    language: { url: '/js/datatables/i18n/th.json' },
                    responsive: true,
                    autoWidth: false,
                    processing: true,
                    serverSide: false,
                    ordering: false,
                    ajax: {
                        url: '@Url.Action("GetQuestions", "ExamQuestion", new { course_code = ViewBag.SelectedCourse })',
                        dataSrc: 'data'
                    },
                    columns: [
                        { data: null, title: '#', orderable: false, render: (d, t, r, m) => m.row + 1 },
                        { data: 'course_code', title: 'คอร์ส' },
                        { data: 'question_text', title: 'คำถาม' },
                        {
                            data: 'image_path', title: 'รูปภาพ', className: 'text-center', render: function (v) {
                                if (!v) return '-';
                                var src = v.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + v) : (APP_BASE + v);
                                return '<img src="' + src + '" style="max-height:60px;" />';
                            }
                        },
                        {
                            data: null, title: 'A', render: function (d, t, row) {
                                var txt = row.choice_a || '';
                                var img = row.choice_a_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'B', render: function (d, t, row) {
                                var txt = row.choice_b || '';
                                var img = row.choice_b_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'C', render: function (d, t, row) {
                                var txt = row.choice_c || '';
                                var img = row.choice_c_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'D', render: function (d, t, row) {
                                var txt = row.choice_d || '';
                                var img = row.choice_d_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'E', render: function (d, t, row) {
                                var txt = row.choice_e || '';
                                var img = row.choice_e_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'F', render: function (d, t, row) {
                                var txt = row.choice_f || '';
                                var img = row.choice_f_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'G', render: function (d, t, row) {
                                var txt = row.choice_g || '';
                                var img = row.choice_g_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: null, title: 'H', render: function (d, t, row) {
                                var txt = row.choice_h || '';
                                var img = row.choice_h_image_path || '';
                                var esc = function (s) { return $('<div>').text(s || '').html(); };
                                var html = txt ? esc(txt) : (img ? '(รูปภาพ)' : '-');
                                if (img) {
                                    var src = img.startsWith('/') ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + img);
                                    html += '<div><img src="' + src + '" style="max-height:60px;" /></div>';
                                }
                                return html;
                            }
                        },
                        { data: 'correct_answer', title: 'คำตอบ' },
                        { data: 'score', title: 'คะแนน', className: 'text-center' },
                        { data: 'is_active', title: 'สถานะ', className: 'text-center', render: v => v ? '<span class="badge text-bg-success">ใช้งาน</span>' : '<span class="badge text-bg-secondary">ปิด</span>' },
                        {
                            data: null, title: 'Action', orderable: false, className: 'text-end', render: function (d, t, row) {
                                var editBtn = '<button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit"'
                                    + ' data-id="' + row.id + '"'
                                    + ' data-course_code="' + (row.course_code || '') + '"'
                                    + ' data-question="' + (row.question_text || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-image="' + (row.image_path || '') + '"'
                                    + ' data-a="' + (row.choice_a || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-b="' + (row.choice_b || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-c="' + (row.choice_c || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-d="' + (row.choice_d || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-e="' + (row.choice_e || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-f="' + (row.choice_f || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-g="' + (row.choice_g || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-h="' + (row.choice_h || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-img-a="' + (row.choice_a_image_path || '') + '"'
                                    + ' data-img-b="' + (row.choice_b_image_path || '') + '"'
                                    + ' data-img-c="' + (row.choice_c_image_path || '') + '"'
                                    + ' data-img-d="' + (row.choice_d_image_path || '') + '"'
                                    + ' data-img-e="' + (row.choice_e_image_path || '') + '"'
                                    + ' data-img-f="' + (row.choice_f_image_path || '') + '"'
                                    + ' data-img-g="' + (row.choice_g_image_path || '') + '"'
                                    + ' data-img-h="' + (row.choice_h_image_path || '') + '"'
                                    + ' data-correct="' + (row.correct_answer || '').replace(/"/g, '&quot;') + '"'
                                    + ' data-score="' + (row.score || 1) + '"'
                                    + ' data-active="' + (row.is_active ? 'true' : 'false') + '">แก้ไข</button>';
                                var delBtn = '<button type="button" class="btn btn-outline-danger btn-sm btn-delete" data-id="' + row.id + '">ลบ</button>';
                                return editBtn + delBtn;
                            }
                        }
                    ],
                    pageLength: 10,
                    info: false,
                    lengthChange: false,
                    paging: false,
                    searching: false
                });

                // เปิด modal เพื่อแก้ไข (เติมค่าจาก data-*)
                $(document).on('click', '.btn-edit', function () {
                    const b = $(this);
                    $('#edit_id_q').val(b.data('id'));
                    $('#edit_course_code_q').val(b.data('course_code'));
                    $('#edit_question_text_q').val(b.data('question'));
                    $('#edit_a_q').val(b.data('a'));
                    $('#edit_b_q').val(b.data('b'));
                    $('#edit_c_q').val(b.data('c'));
                    $('#edit_d_q').val(b.data('d'));
                    $('#edit_e_q').val(b.data('e'));
                    $('#edit_f_q').val(b.data('f'));
                    $('#edit_g_q').val(b.data('g'));
                    $('#edit_h_q').val(b.data('h'));
                    $('#edit_correct_q').val(b.data('correct'));
                    $('#edit_score_q').val(b.data('score'));
                    $('#edit_active_q').prop('checked', (b.data('active') === true || b.data('active') === 'true'));
                    const img = b.data('image');
                    if (img) {
                        const src = (typeof img === 'string' && img.startsWith('/')) ? (APP_BASE.replace(/\/$/, '') + img) : (APP_BASE + (img || ''));
                        $('#edit_image_preview').html('<img src="' + src + '" style="max-height:100px;" />');
                    } else {
                        $('#edit_image_preview').html('<span class="text-muted">ไม่มีรูป</span>');
                    }

                    function setPrev(id, path) {
                        if (!path) { $(id).html('<span class="text-muted">ไม่มีรูป</span>'); return; }
                        var src = (typeof path === 'string' && path.startsWith('/')) ? (APP_BASE.replace(/\/$/, '') + path) : (APP_BASE + path);
                        $(id).html('<img src="' + src + '" style="max-height:70px;" />');
                    }
                    setPrev('#prev_a_q', b.data('img-a'));
                    setPrev('#prev_b_q', b.data('img-b'));
                    setPrev('#prev_c_q', b.data('img-c'));
                    setPrev('#prev_d_q', b.data('img-d'));
                    setPrev('#prev_e_q', b.data('img-e'));
                    setPrev('#prev_f_q', b.data('img-f'));
                    setPrev('#prev_g_q', b.data('img-g'));
                    setPrev('#prev_h_q', b.data('img-h'));
                    new bootstrap.Modal(document.getElementById('editModalQ')).show();
                });

                // ส่งแก้ไขแบบ AJAX (รองรับรูป)
                $('#editFormQ').on('submit', function (e) {
                    e.preventDefault();
                    const form = document.getElementById('editFormQ');
                    const fd = new FormData(form);
                    $.ajax({
                        url: '@Url.Action("EditAjax", "ExamQuestion")',
                        type: 'POST',
                        data: fd,
                        processData: false,
                        contentType: false
                    }).done(function () {
                        $('#editModalQ').modal('hide');
                        Swal.fire({ icon: 'success', title: 'บันทึกแล้ว', timer: 1000, showConfirmButton: false });
                        table.ajax.reload(null, false);
                    }).fail(function (xhr) {
                        Swal.fire({ icon: 'error', title: 'บันทึกไม่สำเร็จ', text: xhr.responseText || xhr.statusText });
                    });
                });

                // ลบด้วย SweetAlert2 + AJAX (ยืนยันครั้งเดียว)
                $(document).on('click', '.btn-delete', function () {
                    const id = $(this).data('id');
                    Swal.fire({
                        title: 'ยืนยันการลบ?',
                        text: 'ข้อมูลจะถูกลบออกจากระบบ',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'ลบ',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("DeleteAjax", "ExamQuestion")',
                                method: 'POST',
                                data: { id }
                            }).done(function () {
                                Swal.fire({ icon: 'success', title: 'ลบแล้ว', timer: 1000, showConfirmButton: false });
                                table.ajax.reload(null, false);
                            }).fail(function (xhr) {
                                Swal.fire({ icon: 'error', title: 'ลบไม่สำเร็จ', text: xhr.responseText || xhr.statusText });
                            });
                        }
                    });
                });
            } catch (e) {
                console.warn('DataTable init failed:', e);
            }
        });
    </script>
}
