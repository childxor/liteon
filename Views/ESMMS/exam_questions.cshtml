@using IPS_TH.Models.ESMMS
@using IPS_TH.Extensions
@model IEnumerable<esmms_question>

@{
    ViewData["Title"] = Context.Session.GetTranslation("exam_questions_management_title");
    var selected = ViewBag.SelectedCourse as string ?? string.Empty;
}

<div class="container-fluid py-3 mt-4">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0">@Context.Session.GetTranslation("exam_by_course")</h5>
                <form method="get" asp-action="Index" asp-controller="ExamQuestion" class="d-flex align-items-center">
                    <select name="course_code" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                        <option value="">-- @Context.Session.GetTranslation("select_course") --</option>
                        @foreach (var c in (IEnumerable<dynamic>)ViewBag.Courses)
                        {
                            <option value="@c.course_code"
                                selected="@(selected == (string)c.course_code ? "selected" : null)">@c.course_code
                                @c.description_en</option>
                        }
                    </select>
                    <noscript><button class="btn btn-sm btn-secondary"
                            type="submit">@Context.Session.GetTranslation("select")</button></noscript>
                </form>
            </div>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg"></i> @Context.Session.GetTranslation("add_question")
            </button>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="questionTable" class="table table-hover table-striped table-sm align-middle mb-0"></table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">@Context.Session.GetTranslation("add_question")</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateQuestion" asp-controller="ExamQuestion" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">@Context.Session.GetTranslation("course_code")</label>
                            <input name="course_code" class="form-control form-control-sm" maxlength="20" readonly
                                value="@selected" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Context.Session.GetTranslation("question")</label>
                            <textarea name="question_text" class="form-control form-control-sm" rows="3"
                                maxlength="1000" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รูปภาพประกอบ (ไม่บังคับ)</label>
                            <input type="file" name="image" accept="image/*" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_a")</label>
                            <input name="choice_a" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_a" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_b")</label>
                            <input name="choice_b" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_b" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_c")</label>
                            <input name="choice_c" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_c" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@Context.Session.GetTranslation("option_d")</label>
                            <input name="choice_d" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_d" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก E</label>
                            <input name="choice_e" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_e" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก F</label>
                            <input name="choice_f" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_f" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก G</label>
                            <input name="choice_g" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_g" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ตัวเลือก H</label>
                            <input name="choice_h" class="form-control form-control-sm" maxlength="500" />
                            <input type="file" name="image_h" accept="image/*"
                                class="form-control form-control-sm mt-1" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">คำตอบที่ถูกต้อง</label>
                            <textarea name="correct_answer" class="form-control form-control-sm" rows="2"
                                maxlength="500" placeholder="กรอกคำตอบที่ถูกต้อง" required></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label">คะแนน</label>
                            <input type="number" name="score" class="form-control form-control-sm" min="1" value="1" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" value="true" name="is_active" checked />
                                <input type="hidden" name="is_active" value="false" />
                                <label class="form-check-label">เปิดใช้งาน</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary">บันทึก</button>
                </div>
            </form>
        </div>
    </div>
</div>

