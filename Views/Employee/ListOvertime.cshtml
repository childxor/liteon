@model IEnumerable<dynamic>
@using IPS_TH.Models.Employee
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "รายการทำงานล่วงเวลา";
    
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false;
    bool canView = permissions?["CanView"] ?? false;
}

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row my-4">
        <div class="col">
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h2 class="text-primary mb-0"> 
                    <i class="fas fa-clock me-2"></i>รายการทำงานล่วงเวลา
                </h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success d-flex align-items-center shadow-sm" onclick="showStatistics()">
                        <i class="fas fa-chart-bar me-2"></i>สถิติ
                    </button>
                    <button class="btn btn-outline-info d-flex align-items-center shadow-sm" onclick="exportToExcel()">
                        <i class="fas fa-file-excel me-2"></i>ส่งออก Excel
                    </button>
                    @if (canAdd)
                    {
                        <button class="btn btn-primary d-flex align-items-center shadow-sm" onclick="openAddModal()">
                            <i class="fas fa-plus me-2"></i>เพิ่มรายการ OT
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 summary-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-md bg-primary-subtle rounded">
                                <i class="fas fa-clock fa-lg text-primary"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="card-subtitle mb-1 text-muted">จำนวน OT ทั้งหมด</h6>
                            <div>
                                <h4 class="card-title mb-0 fw-bold" id="totalOT">-</h4>
                                <small class="text-muted" id="totalHours">- ชั่วโมง</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 summary-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-md bg-success-subtle rounded">
                                <i class="fas fa-check-circle fa-lg text-success"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="card-subtitle mb-1 text-muted">อนุมัติแล้ว</h6>
                            <div>
                                <h4 class="card-title mb-0 fw-bold" id="approvedOT">-</h4>
                                <small class="text-muted" id="approvedHours">- ชั่วโมง</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 summary-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-md bg-warning-subtle rounded">
                                <i class="fas fa-hourglass-half fa-lg text-warning"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="card-subtitle mb-1 text-muted">รออนุมัติ</h6>
                            <h4 class="card-title mb-0 fw-bold" id="pendingOT">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 summary-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-md bg-danger-subtle rounded">
                                <i class="fas fa-times-circle fa-lg text-danger"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="card-subtitle mb-1 text-muted">ไม่อนุมัติ</h6>
                            <h4 class="card-title mb-0 fw-bold" id="rejectedOT">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="row mb-4">
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-search me-2"></i>ค้นหาและกรองข้อมูล
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Row 1: Basic filters -->
                        <div class="col-md-3">
                            <div class="form-floating">
                                <select class="form-select" id="yearFilter">
                                    @{
                                        int currentYear = DateTime.Now.Year;
                                        for (int year = currentYear; year >= currentYear - 2; year--)
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    }
                                </select>
                                <label for="yearFilter"><i class="fas fa-calendar-alt me-1"></i>ปี</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <select class="form-select" id="monthFilter">
                                    <option value="">ทั้งหมด</option>
                                    <option value="1">มกราคม</option>
                                    <option value="2">กุมภาพันธ์</option>
                                    <option value="3">มีนาคม</option>
                                    <option value="4">เมษายน</option>
                                    <option value="5">พฤษภาคม</option>
                                    <option value="6">มิถุนายน</option>
                                    <option value="7">กรกฎาคม</option>
                                    <option value="8">สิงหาคม</option>
                                    <option value="9">กันยายน</option>
                                    <option value="10">ตุลาคม</option>
                                    <option value="11">พฤศจิกายน</option>
                                    <option value="12">ธันวาคม</option>
                                </select>
                                <label for="monthFilter"><i class="fas fa-calendar me-1"></i>เดือน</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <select class="form-select" id="statusFilter">
                                    <option value="">ทั้งหมด</option>
                                    <option value="Pending">รออนุมัติ</option>
                                    <option value="Approved">อนุมัติแล้ว</option>
                                    <option value="Rejected">ไม่อนุมัติ</option>
                                </select>
                                <label for="statusFilter"><i class="fas fa-check-circle me-1"></i>สถานะ</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid h-100">
                                <button class="btn btn-outline-secondary" onclick="clearFilter()" title="ล้างตัวกรอง">
                                    <i class="fas fa-eraser me-2"></i>ล้างตัวกรอง
                                </button>
                            </div>
                        </div>

                        @if (canEdit)
                        {
                            <!-- Row 2: Employee filters (only for editors) -->
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="empNoFilter" placeholder="รหัสพนักงาน">
                                    <label for="empNoFilter"><i class="fas fa-user me-1"></i>รหัสพนักงาน</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="empNameFilter" placeholder="ชื่อพนักงาน">
                                    <label for="empNameFilter"><i class="fas fa-id-card me-1"></i>ชื่อพนักงาน</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="jgCodeFilter" placeholder="ระดับ JG">
                                    <label for="jgCodeFilter"><i class="fas fa-star me-1"></i>ระดับ JG</label>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <!-- Quick Filter Buttons -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-warning btn-sm" onclick="quickFilter('Pending')">
                                    <i class="fas fa-hourglass-half me-1"></i>รออนุมัติ
                                </button>
                                <button class="btn btn-outline-success btn-sm" onclick="quickFilter('Approved')">
                                    <i class="fas fa-check me-1"></i>อนุมัติแล้ว
                                </button>
                                <button class="btn btn-outline-danger btn-sm" onclick="quickFilter('Rejected')">
                                    <i class="fas fa-times me-1"></i>ไม่อนุมัติ
                                </button>
                                <button class="btn btn-outline-primary btn-sm" onclick="quickFilter('today')">
                                    <i class="fas fa-calendar-day me-1"></i>วันนี้
                                </button>
                                <button class="btn btn-outline-info btn-sm" onclick="quickFilter('thisweek')">
                                    <i class="fas fa-calendar-week me-1"></i>สัปดาห์นี้
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="quickFilter('thismonth')">
                                    <i class="fas fa-calendar-alt me-1"></i>เดือนนี้
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="m-0 font-weight-bold text-primary">รายการทำงานล่วงเวลา</h6>
                        <small class="text-muted" id="searchResults">กำลังโหลดข้อมูล...</small>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="autoRefresh">
                            <label class="form-check-label" for="autoRefresh">รีเฟรชอัตโนมัติ</label>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" onclick="refreshData()">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="overtimeTable" style="width: 100%;">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> เลขที่ OT</th>
                                    <th><i class="fas fa-user"></i> รหัสพนักงาน</th>
                                    <th><i class="fas fa-id-card"></i> ชื่อ-นามสกุล</th>
                                    <th><i class="fas fa-star"></i> ระดับ JG</th>
                                    <th><i class="fas fa-calendar"></i> วันที่ทำงาน</th>
                                    <th><i class="fas fa-clock"></i> เวลาเริ่ม-สิ้นสุด</th>
                                    <th><i class="fas fa-hourglass-half"></i> ชั่วโมง OT</th>
                                    <th><i class="fas fa-building"></i> แผนก</th>
                                    <th><i class="fas fa-comment"></i> หมายเหตุ</th>
                                    <th><i class="fas fa-check-circle"></i> สถานะ</th>
                                    @if (canEdit || canDelete)
                                    {
                                    <th><i class="fas fa-cogs"></i> จัดการ</th>
                                    }
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for OT Details -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">รายละเอียด OT</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailModalBody">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Statistics -->
<div class="modal fade" id="statisticsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">สถิติการทำงานล่วงเวลา</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <select class="form-select" id="statsYear">
                            @{
                                for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 2; year--)
                                {
                                    <option value="@year">@year</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select class="form-select" id="statsMonth">
                            <option value="">ทั้งปี</option>
                            <option value="1">มกราคม</option>
                            <option value="2">กุมภาพันธ์</option>
                            <option value="3">มีนาคม</option>
                            <option value="4">เมษายน</option>
                            <option value="5">พฤษภาคม</option>
                            <option value="6">มิถุนายน</option>
                            <option value="7">กรกฎาคม</option>
                            <option value="8">สิงหาคม</option>
                            <option value="9">กันยายน</option>
                            <option value="10">ตุลาคม</option>
                            <option value="11">พฤศจิกายน</option>
                            <option value="12">ธันวาคม</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <canvas id="statisticsChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script>
        var table;
        var refreshInterval;
        var statisticsChart;

        $(document).ready(function() {
            // ตั้งค่าเริ่มต้นให้เป็นเดือนปัจจุบัน
            var currentDate = new Date();
            $('#yearFilter').val(currentDate.getFullYear());
            $('#monthFilter').val(currentDate.getMonth() + 1);
            
            // Initialize DataTable
            initializeDataTable();

            // Event listeners with debounce for text inputs
            $('#yearFilter, #monthFilter, #statusFilter').on('change', function() {
                applyFilter();
            });

            // Debounced search for text inputs
            let searchTimeout;
            $('#empNoFilter, #empNameFilter, #jgCodeFilter').on('keyup', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    applyFilter();
                }, 800); // รอ 800ms หลังจากพิมพ์หยุด
            });

            // Immediate search on Enter
            $('#empNoFilter, #empNameFilter, #jgCodeFilter').on('keypress', function(e) {
                if (e.which === 13) {
                    clearTimeout(searchTimeout);
                    applyFilter();
                }
            });

            // Auto refresh toggle
            $('#autoRefresh').change(function() {
                if (this.checked) {
                    refreshInterval = setInterval(function() {
                        table.ajax.reload(null, false);
                    }, 30000); // 30 seconds
                } else {
                    clearInterval(refreshInterval);
                }
            });

            // Statistics modal event
            $('#statsYear, #statsMonth').change(function() {
                loadStatistics();
            });
        });

        function initializeDataTable() {
            table = $('#overtimeTable').DataTable({
                "processing": true,
                "serverSide": false,
                "ajax": {
                    "url": "@Url.Action("GetOvertimeList", "ListOvertime")",
                    "type": "POST",
                    "data": function(d) {
                        @if (canEdit)
                        {
                            <text>d.empNo = $('#empNoFilter').val();
                            d.empName = $('#empNameFilter').val();
                            d.jgCode = $('#jgCodeFilter').val();</text>
                        }
                        else
                        {
                            <text>d.empNo = null;
                            d.empName = null;
                            d.jgCode = null;</text>
                        }
                        d.year = $('#yearFilter').val();
                        d.month = $('#monthFilter').val();
                        d.status = $('#statusFilter').val();
                    },
                    "datatype": "json",
                    "dataSrc": function(response) {
                        if (response.summary) {
                            updateSummaryCards(response.summary);
                        }
                        return response.data || [];
                    }
                },
                "columns": [
                    { 
                        "data": "OTReqNo",
                        "render": function(data, type, row) {
                            return `<span class="badge bg-info text-truncate" style="max-width: 100px;" title="${data}">${data}</span>`;
                        }
                    },
                    { 
                        "data": "EmpNo",
                        "render": function(data, type, row) {
                            return `<span class="fw-bold">${data}</span>`;
                        }
                    },
                    { 
                        "data": "FullName",
                        "render": function(data, type, row) {
                            return data ? `<span class="text-primary">${data.trim()}</span>` : '<span class="text-muted">-</span>';
                        }
                    },
                    { 
                        "data": "JGCode",
                        "render": function(data, type, row) {
                            return data ? `<span class="badge bg-primary">${data}</span>` : '<span class="text-muted">-</span>';
                        }
                    },
                    { 
                        "data": "WrkDate",
                        "render": function(data) {
                            return moment(data).format('DD/MM/YYYY');
                        }
                    },
                    { 
                        "data": null,
                        "render": function(data) {
                            const start = moment(data.DteTmeStr).format('HH:mm');
                            const end = moment(data.DteTmeEnd).format('HH:mm');
                            return `<span class="text-nowrap">${start} - ${end}</span>`;
                        }
                    },
                    { 
                        "data": "TotalOTHrs",
                        "render": function(data) {
                            return `<span class="badge bg-secondary">${(parseFloat(data) || 0).toFixed(2)} ชม.</span>`;
                        }
                    },
                    {
                        "data": "SecCode",
                        "render": function(data) {
                            return data || '-';
                        }
                    },
                    {
                        "data": "Remark",
                        "render": function(data) {
                            if (!data) return '-';
                            return data.length > 30 ? 
                                `<span title="${data}">${data.substring(0, 30)}...</span>` : 
                                data;
                        }
                    },
                    { 
                        "data": "ApprStatus",
                        "render": function(data) {
                            let badgeClass = 'bg-secondary';
                            let statusText = data;
                            switch(data) {
                                case 'Approved':
                                    badgeClass = 'bg-success';
                                    statusText = 'อนุมัติแล้ว';
                                    break;
                                case 'Pending':
                                    badgeClass = 'bg-warning text-dark';
                                    statusText = 'รออนุมัติ';
                                    break;
                                case 'Rejected':
                                    badgeClass = 'bg-danger';
                                    statusText = 'ไม่อนุมัติ';
                                    break;
                            }
                            return `<span class="badge ${badgeClass}">${statusText}</span>`;
                        }
                    },
                    @if (canEdit || canDelete)
                    {
                        <text>
                    {
                        "data": null,
                        "render": function(data, type, row) {
                            let buttons = '';
                            
                            // View button
                            buttons += `<button class="btn btn-info btn-sm me-1" onclick="viewDetails('${row.OTReqNo}', ${row.OTSeqNo})" title="ดูรายละเอียด">
                                <i class="fas fa-eye"></i>
                            </button>`;
                            
                            // Edit status buttons (only for pending)
                            @if (canEdit)
                            {
                                <text>
                            if (row.ApprStatus === 'Pending') {
                                buttons += `<button class="btn btn-success btn-sm me-1" onclick="updateStatus('${row.OTReqNo}', ${row.OTSeqNo}, 'Approved')" title="อนุมัติ">
                                    <i class="fas fa-check"></i>
                                </button>`;
                                buttons += `<button class="btn btn-warning btn-sm me-1" onclick="updateStatus('${row.OTReqNo}', ${row.OTSeqNo}, 'Rejected')" title="ไม่อนุมัติ">
                                    <i class="fas fa-times"></i>
                                </button>`;
                            }
                                </text>
                            }
                            
                            // Delete button (only for pending)
                            @if (canDelete)
                            {
                                <text>
                            if (row.ApprStatus === 'Pending') {
                                buttons += `<button class="btn btn-danger btn-sm" onclick="deleteOvertime('${row.OTReqNo}', ${row.OTSeqNo})" title="ลบ">
                                    <i class="fas fa-trash"></i>
                                </button>`;
                            }
                                </text>
                            }
                            
                            return `<div class="btn-group" role="group">${buttons}</div>`;
                        }
                    }
                        </text>
                    }
                ],
                "order": [[2, 'desc']],
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
                "language": {
                    "processing": "กำลังประมวลผล...",
                    "search": "ค้นหา:",
                    "lengthMenu": "แสดง _MENU_ รายการ",
                    "info": "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                    "infoEmpty": "แสดง 0 ถึง 0 จาก 0 รายการ",
                    "zeroRecords": "ไม่พบข้อมูล",
                    "paginate": {
                        "first": "หน้าแรก",
                        "last": "หน้าสุดท้าย",
                        "next": "ถัดไป",
                        "previous": "ก่อนหน้า"
                    }
                },
                "responsive": true,
                "scrollX": true
            });
        }

                 function updateSummaryCards(summary) {
             $('#totalOT').text(summary.total || 0);
             $('#approvedOT').text(summary.approved || 0);
             $('#pendingOT').text(summary.pending || 0);
             $('#rejectedOT').text(summary.rejected || 0);
             $('#totalHours').text((summary.totalHours || 0).toFixed(2) + ' ชั่วโมง');
             $('#approvedHours').text((summary.approvedHours || 0).toFixed(2) + ' ชั่วโมง');
             
             // แสดงผลการค้นหา
             const currentFilters = getActiveFilters();
             const filterText = currentFilters.length > 0 ? ` (กรองด้วย: ${currentFilters.join(', ')})` : '';
             $('#searchResults').text(`พบ ${summary.total || 0} รายการ${filterText}`);
         }

         function getActiveFilters() {
             const filters = [];
             
             const year = $('#yearFilter').val();
             const month = $('#monthFilter').val();
             const status = $('#statusFilter').val();
             const empNo = $('#empNoFilter').val();
             const empName = $('#empNameFilter').val();
             const jgCode = $('#jgCodeFilter').val();
             
             if (year) filters.push(`ปี ${year}`);
             if (month) {
                 const monthNames = ['', 'ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                 filters.push(`เดือน ${monthNames[parseInt(month)]}`);
             }
             if (status) {
                 const statusNames = { 'Pending': 'รออนุมัติ', 'Approved': 'อนุมัติแล้ว', 'Rejected': 'ไม่อนุมัติ' };
                 filters.push(`สถานะ ${statusNames[status]}`);
             }
             if (empNo) filters.push(`รหัส ${empNo}`);
             if (empName) filters.push(`ชื่อ ${empName}`);
             if (jgCode) filters.push(`JG ${jgCode}`);
             
             return filters;
         }

        function openAddModal() {
            // เปิด tab ใหม่สำหรับเพิ่ม OT
            window.open('http://icm942/BPM/Menu/Index?menuid=1&itemid=1&src=Inbox&random=16263920252620&isphone=false', '_blank');
        }

        function viewDetails(otReqNo, otSeqNo) {
            $.get(`@Url.Action("GetOvertimeById", "ListOvertime")?otReqNo=${otReqNo}&otSeqNo=${otSeqNo}`, function(data) {
                const modalBody = `
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary">ข้อมูลทั่วไป</h6>
                            <table class="table table-sm">
                                <tr><td><strong>เลขที่ OT:</strong></td><td>${data.OTReqNo}</td></tr>
                                <tr><td><strong>รหัสพนักงาน:</strong></td><td>${data.EmpNo}</td></tr>
                                <tr><td><strong>ชื่อ-นามสกุล:</strong></td><td class="text-primary">${data.FullName ? data.FullName.trim() : '-'}</td></tr>
                                <tr><td><strong>ระดับ JG:</strong></td><td><span class="badge bg-primary">${data.JGCode || '-'}</span></td></tr>
                                <tr><td><strong>วันที่ทำงาน:</strong></td><td>${moment(data.WrkDate).format('DD/MM/YYYY')}</td></tr>
                                <tr><td><strong>แผนก:</strong></td><td>${data.SecCode || '-'}</td></tr>
                                <tr><td><strong>กะงาน:</strong></td><td>${data.ShiftCode || '-'}</td></tr>
                                <tr><td><strong>ตำแหน่ง:</strong></td><td>${data.TitleCode || '-'}</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary">เวลาและชั่วโมงงาน</h6>
                            <table class="table table-sm">
                                <tr><td><strong>เวลาเริ่ม:</strong></td><td>${moment(data.DteTmeStr).format('HH:mm')}</td></tr>
                                <tr><td><strong>เวลาสิ้นสุด:</strong></td><td>${moment(data.DteTmeEnd).format('HH:mm')}</td></tr>
                                <tr><td><strong>ชั่วโมง OT:</strong></td><td>${data.TotalOTHrs} ชม.</td></tr>
                                <tr><td><strong>สถานะ:</strong></td><td>
                                    <span class="badge ${data.ApprStatus === 'Approved' ? 'bg-success' : data.ApprStatus === 'Pending' ? 'bg-warning text-dark' : 'bg-danger'}">
                                        ${data.ApprStatus === 'Approved' ? 'อนุมัติแล้ว' : data.ApprStatus === 'Pending' ? 'รออนุมัติ' : 'ไม่อนุมัติ'}
                                    </span>
                                </td></tr>
                                ${data.ApprDate ? `<tr><td><strong>วันที่อนุมัติ:</strong></td><td>${moment(data.ApprDate).format('DD/MM/YYYY HH:mm')}</td></tr>` : ''}
                            </table>
                        </div>
                    </div>
                    ${data.Remark ? `<div class="row mt-3"><div class="col-12"><h6 class="text-primary">หมายเหตุ</h6><p class="border p-2 rounded">${data.Remark}</p></div></div>` : ''}
                `;
                
                $('#detailModalBody').html(modalBody);
                new bootstrap.Modal(document.getElementById('detailModal')).show();
            }).fail(function() {
                Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถโหลดข้อมูลได้', 'error');
            });
        }

        function updateStatus(otReqNo, otSeqNo, status) {
            Swal.fire({
                title: `ยืนยัน${status === 'Approved' ? 'อนุมัติ' : 'ไม่อนุมัติ'}?`,
                text: `คุณต้องการ${status === 'Approved' ? 'อนุมัติ' : 'ไม่อนุมัติ'}รายการ OT นี้หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                input: status === 'Rejected' ? 'textarea' : null,
                inputPlaceholder: status === 'Rejected' ? 'เหตุผลในการไม่อนุมัติ (ไม่บังคับ)' : null
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("UpdateOvertimeStatus", "ListOvertime")', {
                        otReqNo: otReqNo,
                        otSeqNo: otSeqNo,
                        status: status,
                        remark: result.value || null
                    }).done(function(response) {
                        if (response.success) {
                            Swal.fire('สำเร็จ', response.message, 'success');
                            table.ajax.reload();
                        } else {
                            Swal.fire('เกิดข้อผิดพลาด', response.message, 'error');
                        }
                    }).fail(function() {
                        Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถอัพเดทสถานะได้', 'error');
                    });
                }
            });
        }

        function deleteOvertime(otReqNo, otSeqNo) {
            Swal.fire({
                title: 'ยืนยันการลบ?',
                text: 'คุณต้องการลบรายการ OT นี้หรือไม่? (ลบได้เฉพาะรายการที่ยังไม่ได้อนุมัติ)',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#d33'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteOvertime", "ListOvertime")', {
                        otReqNo: otReqNo,
                        otSeqNo: otSeqNo
                    }).done(function(response) {
                        if (response.success) {
                            Swal.fire('สำเร็จ', response.message, 'success');
                            table.ajax.reload();
                        } else {
                            Swal.fire('เกิดข้อผิดพลาด', response.message, 'error');
                        }
                    }).fail(function() {
                        Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถลบข้อมูลได้', 'error');
                    });
                }
            });
        }

                 function applyFilter() {
             // แสดงสถานะกำลังค้นหา
             $('#overtimeTable').addClass('searching');
             
             table.ajax.reload(function() {
                 // ซ่อนสถานะกำลังค้นหาเมื่อเสร็จ
                 $('#overtimeTable').removeClass('searching');
             });
         }

         function quickFilter(type) {
             switch(type) {
                 case 'Pending':
                 case 'Approved':
                 case 'Rejected':
                     $('#statusFilter').val(type);
                     break;
                 case 'today':
                     const today = new Date();
                     $('#yearFilter').val(today.getFullYear());
                     $('#monthFilter').val(today.getMonth() + 1);
                     break;
                 case 'thisweek':
                     const thisWeek = new Date();
                     $('#yearFilter').val(thisWeek.getFullYear());
                     $('#monthFilter').val(thisWeek.getMonth() + 1);
                     break;
                 case 'thismonth':
                     const thisMonth = new Date();
                     $('#yearFilter').val(thisMonth.getFullYear());
                     $('#monthFilter').val(thisMonth.getMonth() + 1);
                     break;
             }
             applyFilter();
             
             // แสดงการแจ้งเตือนแบบสั้น
             showQuickToast(`กรองข้อมูล: ${getFilterDisplayName(type)}`);
         }

         function getFilterDisplayName(type) {
             const names = {
                 'Pending': 'รออนุมัติ',
                 'Approved': 'อนุมัติแล้ว', 
                 'Rejected': 'ไม่อนุมัติ',
                 'today': 'วันนี้',
                 'thisweek': 'สัปดาห์นี้',
                 'thismonth': 'เดือนนี้'
             };
             return names[type] || type;
         }

         function showQuickToast(message) {
             Swal.fire({
                 toast: true,
                 position: 'top-end',
                 icon: 'info',
                 title: message,
                 showConfirmButton: false,
                 timer: 1500,
                 timerProgressBar: true
             });
         }

                 function clearFilter() {
             $('#yearFilter').val(new Date().getFullYear());
             $('#monthFilter').val(new Date().getMonth() + 1);
             $('#statusFilter').val('');
             $('#empNoFilter').val('');
             $('#empNameFilter').val('');
             $('#jgCodeFilter').val('');
             table.ajax.reload();
         }

        function refreshData() {
            table.ajax.reload();
            Swal.fire({
                title: 'รีเฟรชข้อมูล',
                text: 'ข้อมูลได้รับการอัพเดทแล้ว',
                icon: 'success',
                timer: 1500,
                showConfirmButton: false
            });
        }

                 function exportToExcel() {
             var empNoValue = '';
             var empNameValue = '';
             var jgCodeValue = '';
             @if (canEdit)
             {
                 <text>empNoValue = $('#empNoFilter').val() || '';
                 empNameValue = $('#empNameFilter').val() || '';
                 jgCodeValue = $('#jgCodeFilter').val() || '';</text>
             }
             
             const params = new URLSearchParams({
                 empNo: empNoValue,
                 empName: empNameValue,
                 jgCode: jgCodeValue,
                 year: $('#yearFilter').val() || '',
                 month: $('#monthFilter').val() || '',
                 status: $('#statusFilter').val() || ''
             });

             window.open('@Url.Action("ExportToExcel", "ListOvertime")?' + params.toString(), '_blank');
         }

        function showStatistics() {
            $('#statisticsModal').modal('show');
            loadStatistics();
        }

        function loadStatistics() {
            const year = $('#statsYear').val();
            const month = $('#statsMonth').val() || null;

            $.get('@Url.Action("GetOvertimeStatistics", "ListOvertime")', {
                year: year,
                month: month
            }).done(function(response) {
                if (response.success) {
                    updateStatisticsChart(response.data, month ? 'day' : 'month');
                }
            });
        }

        function updateStatisticsChart(data, type) {
            const ctx = document.getElementById('statisticsChart').getContext('2d');
            
            if (statisticsChart) {
                statisticsChart.destroy();
            }

            const labels = data.map(item => {
                if (type === 'day') {
                    return `วันที่ ${item.Day}`;
                } else {
                    const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                    return monthNames[item.Month - 1];
                }
            });

            statisticsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'จำนวน OT',
                        data: data.map(item => item.Count),
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        yAxisID: 'y'
                    }, {
                        label: 'ชั่วโมง OT',
                        data: data.map(item => item.TotalHours),
                        backgroundColor: 'rgba(255, 99, 132, 0.6)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1,
                        type: 'line',
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    scales: {
                        x: {
                            display: true,
                            title: {
                                display: true,
                                text: type === 'day' ? 'วัน' : 'เดือน'
                            }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'จำนวน OT'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'ชั่วโมง OT'
                            },
                            grid: {
                                drawOnChartArea: false,
                            },
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: `สถิติการทำงานล่วงเวลา ${type === 'day' ? 'รายวัน' : 'รายเดือน'}`
                        }
                    }
                }
            });
        }
    </script>
}

