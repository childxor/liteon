@model IEnumerable<dynamic>
@using IPS_TH.Models.Employee
@using Newtonsoft.Json;

@{
    ViewData["Title"] = "จัดการกะการทำงาน";
    var shifts = ViewBag.Shifts as List<dynamic> ?? new List<dynamic>();
    
    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
    bool canAdd = permissions?["CanAdd"] ?? false;
    bool canEdit = permissions?["CanEdit"] ?? false;
    bool canDelete = permissions?["CanDelete"] ?? false;
    bool canView = permissions?["CanView"] ?? false;
}

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row my-4">
        <div class="col">
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h2 class="text-primary mb-0">
                    <i class="fas fa-clock me-2"></i>จัดการกะการทำงาน
                </h2>
                @if (canAdd)
                {
                    <button class="btn btn-primary d-flex align-items-center shadow-sm" onclick="openAddModal()">
                        <i class="fas fa-plus me-2"></i>เพิ่มกะการทำงาน
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary">รายการกะการทำงาน</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive rounded">
                        <table class="table table-striped table-hover" id="shiftTable" style="width: 100%;">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center"><i class="fas fa-sort-numeric-down"></i> ลำดับ</th>
                                    <th><i class="fas fa-hashtag"></i> รหัสกะ</th>
                                    <th><i class="fas fa-file-alt"></i> ชื่อกะ</th>
                                    <th><i class="fas fa-layer-group"></i> กลุ่มกะ</th>
                                    <th><i class="fas fa-hourglass-start"></i> เวลาเริ่ม</th>
                                    <th><i class="fas fa-hourglass-end"></i> เวลาสิ้นสุด</th>
                                    <th><i class="fas fa-cogs"></i> จัดการ</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal สำหรับเพิ่ม/แก้ไขกะ -->
<div class="modal fade" id="shiftModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-clock me-2"></i><span id="modalTitleText">จัดการกะการทำงาน</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="shiftForm" class="needs-validation" novalidate>
                    <input type="hidden" id="shiftId" />
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="shiftCode" required>
                                <label>รหัสกะ<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณากรอกรหัสกะ</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="shiftName" required>
                                <label>ชื่อกะ<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณากรอกชื่อกะ</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="shiftGroup" required>
                                <label>กลุ่มกะ<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณากรอกกลุ่มกะ</div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="time" class="form-control" id="startTime" required>
                                <label>เวลาเริ่ม<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณาเลือกเวลาเริ่ม</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="time" class="form-control" id="endTime" required>
                                <label>เวลาสิ้นสุด<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณาเลือกเวลาสิ้นสุด</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="sort" required>
                                <label>ลำดับ<span class="text-danger">*</span></label>
                                <div class="invalid-feedback">กรุณากรอกลำดับ</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-primary shadow-sm" onclick="saveShift()">
                    <i class="fas fa-save me-2"></i>บันทึก
                </button>
                <button type="button" class="btn btn-light border shadow-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>ยกเลิก
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ประกาศตัวแปร appBasePath
        var appBasePath = '@Url.Content("~/")';
        
        var table;

        $(document).ready(function() {
            table = $('#shiftTable').DataTable({
                "ajax": {
                    "url": appBasePath + "Employee/GetShifts",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { 
                        "data": "sort",
                        "title": "<i class='fas fa-sort-numeric-down'></i> ลำดับ",
                        "width": "5%",
                        "className": "text-center",
                        "orderable": false
                    },
                    { 
                        "data": "shift_code",
                        "title": "<i class='fas fa-hashtag'></i> รหัสกะ",
                        "width": "10%",
                        "orderable": false
                    },
                    { 
                        "data": "shift_name",
                        "title": "<i class='fas fa-file-alt'></i> ชื่อกะ",
                        "width": "25%",
                        "orderable": false
                    },
                    { 
                        "data": "shift_group",
                        "title": "<i class='fas fa-layer-group'></i> กลุ่มกะ",
                        "width": "20%",
                        "orderable": false
                    },
                    { 
                        "data": "start_time",
                        "title": "<i class='fas fa-hourglass-start'></i> เวลาเริ่ม",
                        "width": "15%",
                        "className": "text-center",
                        "render": function(data) {
                            if (!data) return '-';
                            return data.substring(0, 5);
                        },
                        "orderable": false
                    },
                    { 
                        "data": "end_time",
                        "title": "<i class='fas fa-hourglass-end'></i> เวลาสิ้นสุด",
                        "width": "15%",
                        "className": "text-center",
                        "render": function(data) {
                            if (!data) return '-';
                            return data.substring(0, 5);
                        },
                        "orderable": false
                    },
                    {
                        "data": null,
                        "title": "<i class='fas fa-cogs'></i> จัดการ",
                        "width": "10%",
                        "orderable": false,
                        "className": "text-center",
                        "render": function(data, type, row) {
                            var buttons = '<div class="btn-group" role="group">';
                            @if (canEdit)
                            {
                                <text>
                                buttons += `<button class="btn btn-warning btn-sm" onclick="openChildRow(${row.id}, this)" data-bs-toggle="tooltip" title="แก้ไข">
                                    <i class="fas fa-edit"></i>
                                </button>`;
                                </text>
                            }
                            @if (canDelete)
                            {
                                <text>
                                buttons += `<button class="btn btn-danger btn-sm" onclick="deleteShift(${row.id})" data-bs-toggle="tooltip" title="ลบ">
                                    <i class="fas fa-trash"></i>
                                </button>`;
                                </text>
                            }
                            buttons += '</div>';
                            return buttons;
                        }
                    }
                ],
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
                "drawCallback": function() {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                }
            });
        });

        function openChildRow(id, button) {
            var tr = $(button).closest('tr');
            var row = table.row(tr);
            
            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            } else {
                $.get(appBasePath + 'Employee/GetShiftById/' + id, function(data) {
                    var childContent = `
                        <div class="card shadow-sm border-0 my-3">
                            <div class="card-header bg-light py-3">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fas fa-edit me-2"></i>แก้ไขข้อมูลกะการทำงาน
                                </h6>
                            </div>
                            <div class="card-body">
                                <form id="childShiftForm${data.id}" class="needs-validation" novalidate>
                                    <div class="row g-3">
                                        <!-- ข้อมูลพื้นฐาน -->
                                        <div class="col-12">
                                            <h6 class="mb-3 text-primary"><i class="fas fa-info-circle me-2"></i>ข้อมูลพื้นฐาน</h6>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="childShiftCode${data.id}" 
                                                    value="${data.shift_code}" required>
                                                <label>รหัสกะ<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณากรอกรหัสกะ</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="childShiftName${data.id}" 
                                                    value="${data.shift_name}" required>
                                                <label>ชื่อกะ<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณากรอกชื่อกะ</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="childShiftGroup${data.id}" 
                                                    value="${data.shift_group}" required>
                                                <label>กลุ่มกะ<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณากรอกกลุ่มกะ</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="number" class="form-control" id="childSort${data.id}" 
                                                    value="${data.sort}" required>
                                                <label>ลำดับ<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณากรอกลำดับ</div>
                                            </div>
                                        </div>

                                        <!-- เวลาทำงาน -->
                                        <div class="col-12">
                                            <h6 class="mb-3 text-primary"><i class="fas fa-clock me-2"></i>เวลาทำงาน</h6>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childStartTime${data.id}" 
                                                    value="${data.start_time ? data.start_time.substring(0, 5) : ''}" required>
                                                <label>เวลาเริ่มงาน<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณาเลือกเวลาเริ่มงาน</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childEndTime${data.id}" 
                                                    value="${data.end_time ? data.end_time.substring(0, 5) : ''}" required>
                                                <label>เวลาเลิกงาน<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณาเลือกเวลาเลิกงาน</div>
                                            </div>
                                        </div>

                                        <!-- เวลาพักที่ 1 -->
                                        <div class="col-12">
                                            <h6 class="mb-3 text-primary"><i class="fas fa-coffee me-2"></i>เวลาพักที่ 1</h6>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childBreakStart${data.id}" 
                                                    value="${data.break_start_time ? data.break_start_time.substring(0, 5) : ''}">
                                                <label>เวลาเริ่มพัก</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childBreakEnd${data.id}" 
                                                    value="${data.break_end_time ? data.break_end_time.substring(0, 5) : ''}">
                                                <label>เวลาสิ้นสุดพัก</label>
                                            </div>
                                        </div>

                                        <!-- เวลาพักที่ 2 -->
                                        <div class="col-12 d-flex align-items-center justify-content-between">
                                            <h6 class="mb-3 text-primary"><i class="fas fa-coffee me-2"></i>เวลาพักที่ 2</h6>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="childIsBreak2${data.id}"
                                                    ${data.is_break2 ? 'checked' : ''} onchange="toggleBreak2Fields(${data.id})">
                                                <label class="form-check-label" for="childIsBreak2${data.id}">เปิดใช้งานพักที่ 2</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 break2-field${data.id}" ${!data.is_break2 ? 'style="display:none;"' : ''}>
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childBreak2Start${data.id}" 
                                                    value="${data.break2_start_time ? data.break2_start_time.substring(0, 5) : ''}">
                                                <label>เวลาเริ่มพักที่ 2</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 break2-field${data.id}" ${!data.is_break2 ? 'style="display:none;"' : ''}>
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childBreak2End${data.id}" 
                                                    value="${data.break2_end_time ? data.break2_end_time.substring(0, 5) : ''}">
                                                <label>เวลาสิ้นสุดพักที่ 2</label>
                                            </div>
                                        </div>

                                        <!-- เวลา OT -->
                                        <div class="col-12">
                                            <h6 class="mb-3 text-primary"><i class="fas fa-business-time me-2"></i>เวลา OT</h6>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childOTStart${data.id}" 
                                                    value="${data.ot_start_time ? data.ot_start_time.substring(0, 5) : ''}">
                                                <label>เวลาเริ่ม OT</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="time" class="form-control" id="childOTEnd${data.id}" 
                                                    value="${data.ot_end_time ? data.ot_end_time.substring(0, 5) : ''}">
                                                <label>เวลาสิ้นสุด OT</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <button type="button" class="btn btn-primary shadow-sm" onclick="saveChildShift(${data.id})">
                                            <i class="fas fa-save me-2"></i>บันทึก
                                        </button>
                                        <button type="button" class="btn btn-light border shadow-sm" onclick="closeChildRow(this)">
                                            <i class="fas fa-times me-2"></i>ยกเลิก
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    `;
                    row.child(childContent).show();
                    tr.addClass('shown');
                });
            }
        }

        function closeChildRow(button) {
            var tr = $(button).closest('tr').prev();
            var row = table.row(tr);
            row.child.hide();
            tr.removeClass('shown');
        }

        function toggleBreak2Fields(id) {
            const isChecked = $(`#childIsBreak2${id}`).is(':checked');
            $(`.break2-field${id}`).toggle(isChecked);
        }

        function saveChildShift(id) {
            var form = document.getElementById(`childShiftForm${id}`);
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');
                return;
            }

            var data = {
                Id: id,
                shift_code: $(`#childShiftCode${id}`).val(),
                shift_name: $(`#childShiftName${id}`).val(),
                shift_group: $(`#childShiftGroup${id}`).val(),
                start_time: $(`#childStartTime${id}`).val(),
                end_time: $(`#childEndTime${id}`).val(),
                sort: $(`#childSort${id}`).val(),
                break_start_time: $(`#childBreakStart${id}`).val() || null,
                break_end_time: $(`#childBreakEnd${id}`).val() || null,
                is_break2: $(`#childIsBreak2${id}`).is(':checked'),
                break2_start_time: $(`#childBreak2Start${id}`).val() || null,
                break2_end_time: $(`#childBreak2End${id}`).val() || null,
                ot_start_time: $(`#childOTStart${id}`).val() || null,
                ot_end_time: $(`#childOTEnd${id}`).val() || null
            };

            $.ajax({
                url: appBasePath + 'Employee/SaveShift',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            table.ajax.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message
                        });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถบันทึกข้อมูลได้ กรุณาลองใหม่อีกครั้ง'
                    });
                }
            });
        }

        function openAddModal() {
            $('#modalTitleText').text('เพิ่มกะการทำงาน');
            $('#shiftForm')[0].reset();
            $('#shiftId').val('');
            $('#shiftModal').modal('show');
        }

        function openEditModal(id) {
            $('#modalTitleText').text('แก้ไขกะการทำงาน');
            $.get(appBasePath + 'Employee/GetShiftById/' + id, function(data) {
                $('#shiftId').val(data.id);
                $('#shiftCode').val(data.shift_code);
                $('#shiftName').val(data.shift_name);
                $('#shiftGroup').val(data.shift_group);
                $('#startTime').val(moment(data.start_time).format('HH:mm'));
                $('#endTime').val(moment(data.end_time).format('HH:mm'));
                $('#sort').val(data.sort);
                $('#shiftModal').modal('show');
            });
        }

        function saveShift() {
            var form = document.getElementById('shiftForm');
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');
                return;
            }

            var data = {
                Id: $('#shiftId').val(),
                shift_code: $('#shiftCode').val(),
                shift_name: $('#shiftName').val(),
                shift_group: $('#shiftGroup').val(),
                start_time: $('#startTime').val(),
                end_time: $('#endTime').val(),
                sort: $('#sort').val()
            };

            $.ajax({
                url: appBasePath + 'Employee/SaveShift',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            $('#shiftModal').modal('hide');
                            $('#shiftTable').DataTable().ajax.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message
                        });
                    }
                }
            });
        }

        function deleteShift(id) {
            Swal.fire({
                title: 'ยืนยันการลบ?', 
                text: "คุณต้องการลบกะการทำงานนี้ใช่หรือไม่?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'ใช่, ลบ',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: appBasePath + 'Employee/DeleteShift/' + id,
                        type: 'POST',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    $('#shiftTable').DataTable().ajax.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message
                                });
                            }
                        }
                    });
                }
            });
        }
    </script>
}

<style>
    .table > :not(caption) > * > * {
        padding: 0.75rem;
    }
    
    .table tbody tr:hover {
        background-color: rgba(0,0,0,.075);
    }
    
    .btn-group .btn {
        padding: 0.375rem 0.75rem;
    }
    
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #0d6efd;
    }
    
    .modal-header {
        border-radius: 0.375rem 0.375rem 0 0;
    }
    
    .card {
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
</style>