                                        `<span class="badge ${row.existsInCES941 ? 'bg-primary' : 'bg-danger'}" data-bs-toggle="tooltip" title="${row.existsInCES941 ? 'มีข้อมูลใน CES941' : 'ไม่มีข้อมูลใน CES941'}"><i class="fas ${row.existsInCES941 ? 'fa-check' : 'fa-times'}"></i></span>
                                            <span class="badge ${row.existsInSQL944 ? 'bg-info' : 'bg-warning'}" data-bs-toggle="tooltip" title="${row.existsInSQL944 ? 'มีข้อมูลใน SQL944' : 'ไม่มีข้อมูลใน SQL944'}"><i class="fas ${row.existsInSQL944 ? 'fa-check' : 'fa-times'}"></i></span>`;
