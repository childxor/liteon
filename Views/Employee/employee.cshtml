            // ===== สถานะฝึกอบรมจาก ESMMS =====
            function loadTrainingStatuses() {
                var dt = $('#employeeTable').DataTable();
                var data = dt.rows({ page: 'current' }).data().toArray();
                if (!data || data.length === 0) return;
                var ids = [];
                data.forEach(function (r) {
                    var pid = r && r.personID;
                    if (pid) ids.push(String(pid).trim());
                });
                if (!ids.length) return;
                $.get('@Url.Action("GetTrainingStatusForEmployees","Exam")', { personIds: ids.join(',') })
                    .done(function (res) {
                        var list = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                        var map = {};
                        list.forEach(function (x) { map[String(x.emp_no || '').trim()] = x; });
                        // ใช้ cache pdline ถ้ามี ไม่งั้นดึงครั้งเดียวแล้ว cache
                        var useDict = (window.pdlineDict && Object.keys(window.pdlineDict).length > 0) ? window.pdlineDict : null;
                        var applyAndDraw = function(dict){
                            dict = dict || {};
                            dt.rows({ page: 'current' }).every(function () {
                                var row = this.data();
                                var key = String(row.personID || '').trim();
                                var st = map[key] || null;
                                if (st) {
                                    var pdId = (st.pd_line||'').toString();
                                    st.pdline_name = dict[pdId] || (pdId || null);
                                }
                                row.__trainingStatus = st;
                                this.data(row, false);
                            });
                            dt.rows({ page: 'current' }).invalidate('data').draw(false);
                        };
                        if (useDict) {
                            applyAndDraw(useDict);
                        } else {
                            $.get('@Url.Action("GetPdlines","OracleStations")')
                                .done(function(pdlines){
                                    var dict = {};
                                    if (Array.isArray(pdlines)) {
                                        pdlines.forEach(function(it){ dict[String(it.Id||it.id)] = it.Name||it.name; });
                                    }
                                    window.pdlineDict = dict;
                                    applyAndDraw(dict);
                                })
                                .fail(function(){ applyAndDraw({}); });
                        }
                    });
            }

