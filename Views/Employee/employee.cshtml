                    let shiftName = $('.filter-shift option[value="' + filters.shift + '"]').text() || filters.shift;
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-clock me-1"></i>กะ: ${shiftName}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="shift"></button>
                    </span>`);
                }
                if (filters.door) {
                    hasFilter = true;
                    let doorName = $('.filter-door option[value="' + filters.door + '"]').text() || filters.door;
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-door-open me-1"></i>ประตู: ${doorName}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="door"></button>
                    </span>`);
                }
                if (filters.fingerprint) {
                    hasFilter = true;
                    let fingerprintLabel = filters.fingerprint === 'has' ? 'มีลายนิ้วมือ' : 'ไม่มีลายนิ้วมือ';
                    $('#current-filters').append(`<span class="badge bg-info rounded-pill">
                        <i class="fas fa-fingerprint me-1"></i>ลายนิ้วมือ: ${fingerprintLabel}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="fingerprint"></button>
                    </span>`);
                }
                if (filters.status && filters.status !== 'active') {
                    hasFilter = true;
                    let statusLabel = filters.status === 'resigned' ? 'ลาออกแล้ว' : filters.status;
                    $('#current-filters').append(`<span class="badge bg-danger rounded-pill">
                        <i class="fas fa-toggle-on me-1"></i>สถานะ: ${statusLabel}
                        <button class="btn-close btn-close-white ms-2 p-0" style="font-size: 0.5rem;" data-filter="status"></button>
                    </span>`);
                }
                if (hasFilter) {
                    $('#current-filters').append(`<span class="badge bg-warning rounded-pill clear-all-filters" style="cursor: pointer;">
                        <i class="fas fa-times-circle me-1"></i>ล้างตัวกรองทั้งหมด
                    </span>`);
                } else {
                    $('#current-filters').append(`<span class="badge bg-secondary rounded-pill">
                        <i class="fas fa-info-circle me-1"></i>ไม่มีตัวกรอง
                    </span>`);
                }
                // เพิ่ม event listener สำหรับปุ่มลบตัวกรอง
                $('.btn-close[data-filter]').on('click', function() {
                    const filterType = $(this).data('filter');
                    $('#filter-storage').data(filterType, '');
                    // ถ้าเป็นสถานะ ให้กลับไปเป็น active
                    if (filterType === 'status') {
                        $('#filter-storage').data('status', 'active');
                    }
                    saveFiltersToLocalStorage();
                    $('#employeeTable').DataTable().ajax.reload();
                    updateFilterBadges();
                });
                // ล้างตัวกรองทั้งหมด
                $('.clear-all-filters').on('click', function() {
                    $('#filter-storage').data('department', '');
                    $('#filter-storage').data('shift', '');
                    $('#filter-storage').data('door', '');
                    $('#filter-storage').data('status', 'active');
                    $('#filter-storage').data('fingerprint', '');
                    saveFiltersToLocalStorage();
                    $('#employeeTable').DataTable().ajax.reload();
                    updateFilterBadges();
                });
            }
        </script>
        }

