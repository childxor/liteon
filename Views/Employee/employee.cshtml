                                            </div>
                                            <div class="card-body">
                                                    <ul class="list-group list-group-flush">
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">รหัสพนักงาน:</span>
                                                        <span class="fw-medium">${employee.personID || '-'}</span>
                                                    </li>
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">เลขบัตร:</span>
                                                        <span class="fw-medium">${employee.cardNumber || '-'}</span>
                                                    </li>
                                                        <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                            <span class="text-muted">ระดับ JG:</span>
                                                            <span class="badge bg-secondary">${employee.jobGrade || '-'}</span>
                                                        </li>
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">กะการทำงาน:</span>
                                                        <span class="fw-medium">${employee.shift || employee.shiftMent || '-'}</span>
                                                    </li>
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">แผนก:</span>
                                                        <span class="fw-medium">${employee.deptName || employee.department || '-'} (${employee.deptID || '-'})</span>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                                // แสดงข้อมูลในรูปแบบ Modal ด้วย SweetAlert2
                                Swal.fire({
                                    title: 'ข้อมูลพนักงาน',
                                    html: modalContent,
                                    width: '800px',
                                    showCloseButton: true,
                                    showConfirmButton: false,
                                    customClass: {
                                        container: 'employee-detail-modal'
                                    }
                                });
                            } else {
