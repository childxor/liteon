@model IEnumerable<dynamic>
    @using IPS_TH.Models.Employee
    @using Newtonsoft.Json;

    @{
    ViewBag.Title = "จัดการข้อมูลพนักงาน";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var departments = ViewBag.Departments;
    var shifts = ViewBag.Shifts;

    var permissions = ViewData["Permissions"] as Dictionary<string, bool>;
        bool canAdd = permissions?["CanAdd"] ?? false;
        bool canEdit = permissions?["CanEdit"] ?? false;
        bool canDelete = permissions?["CanDelete"] ?? false;
        bool canView = permissions?["CanView"] ?? false;
        }
 
        <div class="container-fluid">
            <!-- div สำหรับเก็บค่า filter -->
            <div id="filter-storage" data-status="active" data-door="" data-department="" data-shift=""
                style="display:none;"></div>

            <div class="container-fluid px-4">
                <!-- Header Section -->
                <div class="row my-4">
                    <div class="col">
                        <div class="card shadow-lg border-0 bg-gradient-primary text-white">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="display-icon bg-white bg-opacity-25 rounded-circle p-3 me-4">
                                    <i class="fas fa-users fa-2x text-white"></i>
                                </div>
                                <div>
                                    <h2 class="mb-0 fw-bold">รายชื่อพนักงาน</h2>
                                    <p class="mb-0 text-white-50">จัดการข้อมูลพนักงานและสิทธิ์การเข้าถึง</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons Section -->
                <div class="row mb-4">
                    <div class="col">
                        <div class="card shadow-sm border-0 rounded-3">
                            <div class="card-body p-0">
                                <div class="bg-light p-3 rounded-top border-bottom">
                                    <h5 class="mb-0"><i class="fas fa-tools me-2 text-primary"></i>การจัดการ</h5>
                                </div>
                                <div class="p-3">
                                    <div class="d-flex gap-3 flex-wrap">
                                        <button type="button"
                                            class="btn btn-danger btn-hover-translate rounded-pill shadow-sm"
                                            id="removeResignedAccessButton">
                                            <i class="fas fa-door-closed me-2"></i>ลบสิทธิ์ประตูพนักงานลาออก
                                        </button>
                                        <button type="button"
                                            class="btn btn-primary btn-hover-translate rounded-pill shadow-sm"
                                            id="checkAndAddBasicAccessButton">
                                            <i class="fas fa-check-circle me-2"></i>ตรวจสอบและเพิ่มสิทธิ์พื้นฐาน
                                        </button>
                                        <button type="button"
                                            class="btn btn-danger btn-hover-translate rounded-pill shadow-sm"
                                            id="removeEmployeeButton">
                                            <i class="fas fa-trash me-2"></i>ลบข้อมูลพนักงานลาออก
                                        </button>
                                        <button type="button"
                                            class="btn btn-info text-white btn-hover-translate rounded-pill shadow-sm"
                                            id="filterButton">
                                            <i class="fas fa-filter me-2"></i>กรองข้อมูล
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="row">
                    <div class="col">
                        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                            <div
                                class="card-header bg-gradient-light py-3 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-table me-2 text-primary"></i>ข้อมูลพนักงาน</h5>
                                <div class="d-flex align-items-center gap-2">
                                    <div id="current-filters" class="d-flex flex-wrap gap-2 me-2"></div>
                                    <button class="btn btn-sm btn-success rounded-pill add-employee"><i
                                            class="fas fa-user-plus me-2"></i>เพิ่มพนักงาน</button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover table-modern" id="employeeTable"
                                        style="width:100%"></table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Employee Modal -->
            <div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow-lg">
                        <form id="employeeForm" method="post" class="needs-validation" novalidate>
                            <div class="modal-header bg-gradient-primary text-white">
                                <h5 class="modal-title" id="employeeModalLabel">
                                    <i class="fas fa-user-plus me-2"></i>เพิ่มข้อมูลพนักงาน
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <div class="row g-3">
                                        <!-- ส่วนหัวของฟอร์ม -->
                                        <div class="col-12 mb-3">
                                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                                <i class="fas fa-info-circle fa-lg me-3"></i>
                                                <div>
                                                    กรุณากรอกข้อมูลให้ครบถ้วน ช่องที่มีเครื่องหมาย <span
                                                        class="text-danger">*</span> เป็นข้อมูลที่จำเป็นต้องกรอก
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Row 1 -->
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="cardNo" id="cardNo"
                                                    required pattern="\d{1,8}" title="กรุณากรอกตัวเลขไม่เกิน 8 ตัว">
                                                <label for="cardNo">
                                                    <i class="fas fa-id-card me-1"></i>รหัสพนักงาน<span
                                                        class="text-danger">*</span>
                                                </label>
                                                <div class="invalid-feedback">กรุณากรอกรหัสพนักงาน</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="cardNumber"
                                                    id="cardNumber">
                                                <label for="cardNumber">
                                                    <i class="fas fa-credit-card me-1"></i>เลขหลังบัตรพนักงาน<span
                                                        class="text-danger">*</span>
                                                </label>
                                                <div class="invalid-feedback">กรุณากรอกเลขบัตร</div>
                                            </div>
                                        </div>

                                        <!-- Row 2 -->
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control bg-light" name="personIDc"
                                                    id="personIDc" readonly>
                                                <label for="personIDc">บัตรพนักงาน</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control bg-light" name="personIDfp"
                                                    id="personIDfp" readonly>
                                                <label for="personIDfp">รหัสลายนิ้วมือ</label>
                                            </div>
                                        </div>

                                        <!-- Row 3 -->
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" name="name" id="name" required>
                                                <label for="name">ชื่อ-นามสกุล<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณากรอกชื่อ-นามสกุล</div>
                                            </div>
                                        </div>

                                        <!-- Row 4 -->
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <select class="form-select" name="deptName" id="deptName" required>
                                                    <option value="">เลือกแผนก</option>
                                                    <option value="4070">Liteon Thailand IPS</option>
                                                    <option value="S6211">MFG</option>
                                                    <option value="S6212">QRA</option>
                                                    <option value="S6213">CSC</option>
                                                    <option value="S6214">OFFICE</option>
                                                    <option value="S6215">WH</option>
                                                    <option value="S6216">IE</option>
                                                    <option value="S6217">PMC</option>
                                                    <option value="S6218">รปภ.</option>
                                                    <option value="S6219">CH</option>
                                                    <option value="S6220">แม่บ้าน</option>
                                                    <option value="S6221">ME</option>
                                                    <option value="S6224">ITS</option>
                                                    <option value="S6225">PE</option>
                                                    <option value="S6226">BOI</option>
                                                    <option value="S6227">PC</option>
                                                </select>
                                                <label for="deptName">แผนก<span class="text-danger">*</span></label>
                                                <div class="invalid-feedback">กรุณาเลือกแผนก</div>
                                            </div>
                                        </div>

                                        <!-- Row 5 -->
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <input type="text" class="form-control bg-light" name="deptID"
                                                    id="deptID" readonly>
                                                <label for="deptID">รหัสแผนก</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary btn-hover-translate rounded-pill"
                                    data-bs-dismiss="modal">
                                    <i class="fas fa-times me-2"></i>ยกเลิก
                                </button>
                                <button type="button" class="btn btn-primary btn-hover-translate rounded-pill"
                                    id="saveButton">
                                    <i class="fas fa-save me-2"></i>บันทึก
                                </button>
                            </div>
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>
            </div>

            <!-- Door Access Modal -->
            <div class="modal fade" id="accessDoorModal" tabindex="-1" aria-labelledby="accessDoorModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header bg-gradient-primary text-white">
                            <h5 class="modal-title" id="accessDoorModalLabel">
                                <i class="fas fa-door-open me-2"></i>สิทธิ์ประตู: <span id="employeeName"></span>
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-0">
                            <!-- ข้อมูลพนักงาน -->
                            <div class="bg-light p-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-lg bg-primary text-white rounded-circle p-3 me-3">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" id="employeeName"></h6>
                                            <div class="d-flex gap-3">
                                                <span class="badge bg-primary rounded-pill"><i
                                                        class="fas fa-id-card me-1"></i><span
                                                        id="employeeID"></span></span>
                                                <span class="badge bg-secondary rounded-pill"><i
                                                        class="fas fa-building me-1"></i><span
                                                        id="employeeDept"></span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ข้อมูลสิทธิ์ประตู -->
                            <div class="p-3">
                                <div class="alert alert-info d-flex p-2 mb-3">
                                    <div class="me-auto">
                                        <small><i class="fas fa-info-circle me-1"></i> สถานะสิทธิ์ประตู:</small>
                                    </div>
                                    <div class="d-flex gap-3">
                                        <small><span class="badge bg-success"><i
                                                    class="fas fa-check-circle me-1"></i>มีสิทธิ์</span></small>
                                        <small><span class="badge bg-danger"><i
                                                    class="fas fa-times-circle me-1"></i>ไม่มีสิทธิ์</span></small>
                                    </div>
                                </div>
                                <div class="table-responsive bg-white rounded-3 border shadow-sm">
                                    <table id="doorAccessTable" class="table table-striped table-hover table-sm mb-0"
                                        style="width:100%">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th style="width: 50%;"><i
                                                        class="fas fa-door-open me-1 text-primary"></i> ประตู</th>
                                                <th style="width: 25%;" class="text-center"><i
                                                        class="fas fa-id-card me-1 text-primary"></i> บัตร</th>
                                                <th style="width: 25%;" class="text-center"><i
                                                        class="fas fa-fingerprint me-1 text-primary"></i> ลายนิ้วมือ
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="doorAccessTableBody">
                                            <!-- ข้อมูลจะถูกเพิ่มโดย JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <div class="btn-group shadow-sm" role="group">
                                <button type="button" class="btn btn-primary btn-hover-translate" id="addAllAccess">
                                    <i class="fas fa-door-open me-1"></i>เพิ่มสิทธิ์ทั้งหมด
                                </button>
                                <button type="button" class="btn btn-success btn-hover-translate" id="addSpecificDoors">
                                    <i class="fas fa-building me-1"></i>เพิ่มเฉพาะประตูพื้นฐาน
                                </button>
                                <button type="button" class="btn btn-danger btn-hover-translate" id="removeAllAccess">
                                    <i class="fas fa-times-circle me-1"></i>ลบสิทธิ์ทั้งหมด
                                </button>
                            </div>
                            <button type="button" class="btn btn-secondary btn-hover-translate rounded-pill"
                                data-bs-dismiss="modal">
                                <i class="fas fa-times me-1"></i>ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- New row template for filter -->
            <script type="text/template" id="filterRowTemplate">
                <tr id="filter-row" class="bg-light">
                    <td colspan="13">
                        <div class="card shadow-sm border-0 rounded-3 my-3 fade-in">
                            <div class="card-header bg-gradient-light py-3">
                                <h5 class="mb-0"><i class="fas fa-filter me-2 text-primary"></i>ตัวกรองข้อมูล</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select class="form-select filter-department">
                                                <option value="">ทั้งหมด</option>
                                                <option value="4070">Liteon Thailand IPS</option>
                                                <option value="S6211">MFG</option>
                                                <option value="S6212">QRA</option>
                                                <option value="S6213">CSC</option>
                                                <option value="S6214">OFFICE</option>
                                                <option value="S6215">WH</option>
                                                <option value="S6216">IE</option>
                                                <option value="S6217">PMC</option>
                                                <option value="S6218">รปภ.</option>
                                                <option value="S6219">CH</option>
                                                <option value="S6220">แม่บ้าน</option>
                                                <option value="S6221">ME</option>
                                                <option value="S6224">ITS</option>
                                                <option value="S6225">PE</option>
                                                <option value="S6226">BOI</option>
                                                <option value="S6227">PC</option>
                                            </select>
                                            <label><i class="fas fa-building me-1"></i>แผนก</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select class="form-select filter-shift">
                                                <option value="">ทั้งหมด</option>
                                                <option value="D01N01">กะเช้า (รายวัน) (D01N01)</option>
                                                <option value="DT1NT1">กะเช้า (รายเดือน) (DT1NT1)</option>
                                                <option value="OFFICE">กะออฟฟิศ (ไม่เข้ากะ) (OFFICE)</option>
                                                <option value="DAYSHF">กะเช้า (รายวัน) (DAYSHF)</option>
                                                <option value="DAYTCH">กะเช้า (รายเดือน) (DAYTCH)</option>
                                                <option value="N01D01">กะดึก (รายวัน) (N01D01)</option>
                                                <option value="NT1DT1">กะดึก (รายเดือน) (NT1DT1)</option>
                                                <option value="OFFICE2">กะออฟฟิศ (ไม่เข้ากะ) (OFFICE2)</option>
                                            </select>
                                            <label><i class="fas fa-clock me-1"></i>กะการทำงาน</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select class="form-select filter-status">
                                                <option value="">ทั้งหมด</option>
                                                <option value="active" selected>ยังไม่ลาออก</option>
                                                <option value="resigned">ลาออก</option>
                                                <option value="incomplete">ข้อมูลไม่ครบถ้วน</option>
                                                <option value="ces941only">มีเฉพาะใน CES941</option>
                                                <option value="sql944only">มีเฉพาะใน SQL944</option>
                                            </select>
                                            <label><i class="fas fa-toggle-on me-1"></i>สถานะ</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select class="form-select filter-door">
                                                <option value="">ทั้งหมด</option>
                                                <option value="0001601">Build1 - Chemical room</option>
                                                <option value="0001801">Build1 - Comsumables room</option>
                                                <option value="0001101">Build1 - DCC room</option>
                                                <option value="0001201">Build1 - DQE room</option>
                                                <option value="0000101">Build1 - HR Attendance 01</option>
                                                <option value="0000201">Build1 - HR Attendance 02</option>
                                                <option value="0000301">Build1 - HR Attendance 03</option>
                                                <option value="0000401">Build1 - HR Attendance 04</option>
                                                <option value="0000501">Build1 - HR Attendance 05</option>
                                                <option value="0000601">Build1 - HR Attendance 06</option>
                                                <option value="0000701">Build1 - HR Attendance 07</option>
                                                <option value="0000801">Build1 - HR Attendance 08</option>
                                                <option value="0000901">Build1 - HR Attendance 09</option>
                                                <option value="0001301">Build1 - IQC room</option>
                                                <option value="0001701">Build1 - Jig room</option>
                                                <option value="0001001">Build1 - MIS server room</option>
                                                <option value="0002001">Build1 - Store electonic</option>
                                                <option value="0001401">Build1 - Store Finish goods 01</option>
                                                <option value="0001501">Build1 - Store Finish goods 02</option>
                                                <option value="0001901">Build1 - Store raw material</option>
                                            </select>
                                            <label><i class="fas fa-door-open me-1"></i>ประตู</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select class="form-select filter-fingerprint">
                                                <option value="">ทั้งหมด</option>
                                                <option value="has">มีลายนิ้วมือ</option>
                                                <option value="none">ไม่มีลายนิ้วมือ</option>
                                            </select>
                                            <label><i class="fas fa-fingerprint me-1"></i>ลายนิ้วมือ</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-4">
                                    <button type="button" class="btn btn-outline-secondary rounded-pill reset-filter">
                                        <i class="fas fa-undo me-2"></i>รีเซ็ต
                                    </button>
                                    <button type="button" class="btn btn-primary rounded-pill apply-filter">
                                        <i class="fas fa-check me-2"></i>ตกลง
                                    </button>
                                    <button type="button" class="btn btn-danger rounded-pill close-filter">
                                        <i class="fas fa-times me-2"></i>ปิด
                                    </button>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </script>
        </div>

        @section Scripts {
        <script>
            $(document).ready(function() {
                // ตั้งค่า filter เริ่มต้นจาก localStorage หรือค่าเริ่มต้นปกติ
                const storedFilters = loadFiltersFromLocalStorage();
                $('#filter-storage').data('status', storedFilters.status || 'active');
                $('#filter-storage').data('door', storedFilters.door || '');
                $('#filter-storage').data('department', storedFilters.department || '');
                $('#filter-storage').data('shift', storedFilters.shift || '');
                $('#filter-storage').data('fingerprint', storedFilters.fingerprint || '');
                // เริ่มต้น DataTables
                var table = $('#employeeTable').DataTable({
                    processing: false,
                    serverSide: false,
                    paging: true,
                    lengthChange: true,
                    orderable: true,
                    ordering: false,
                    searching: true,
                    pageLength: 50,
                    lengthMenu: [50, 100, 200, 500],
                    info: true,
                    ajax: {
                        url: '@Url.Action("GetEmployeesData", "Employee")',
                        type: 'GET',
                        data: function(d) {
                            d.status = $('#filter-storage').data('status');
                            d.door = $('#filter-storage').data('door');
                            d.department = $('#filter-storage').data('department');
                            d.shift = $('#filter-storage').data('shift');
                            d.fingerprint = $('#filter-storage').data('fingerprint');
                        }
                    }, 
                    columns: [{
                            data: 'personID',
                            title: '<i class="fas fa-plus"></i>',
                            orderable: false,
                            className: 'text-center',
                            render: function(data) {
                                return '<button class="btn btn-xs btn-icon btn-rounded btn-outline-primary toggle-child-row" data-id="' +
                                    data +
                                    '" data-bs-toggle="tooltip" title="ดูข้อมูลเพิ่มเติม">' +
                                    '<i class="fas fa-plus"></i></button>';
                            }
                        },
                        {
                            data: 'cardNumber',
                            title: '<i class="fas fa-id-card me-1"></i> เลขบัตร',
                            render: function(data, type, row) {
                                var html = '<div><span class="badge bg-light text-dark">' +
                                    data + '</span>';
                                html += '<div class="mt-1">';
                                if (row.hasCardData) {
                                    html +=
                                        '<span class="badge bg-success ms-1" data-bs-toggle="tooltip" title="มีข้อมูลบัตรใน SQL944"><i class="fas fa-id-card"></i></span>';
                                }
                                if (row.hasFingerprintData) {
                                    html +=
