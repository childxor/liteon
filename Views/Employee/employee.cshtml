                                    showErrorToast(response.message ||
                                        'เกิดข้อผิดพลาดในการดำเนินการ');
                                }
                            },
                            error: function() {
                                showErrorToast('เกิดข้อผิดพลาดในการดำเนินการ');
                            }
                        });
                    }
                });
            });

