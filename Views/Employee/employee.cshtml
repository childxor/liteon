                    ],
                    initComplete: function() {
                        // เพิ่ม tooltip ให้กับปุ่มต่างๆ
                        $('[data-bs-toggle="tooltip"]').tooltip({ html: true });
                        // ลบโค้ดการสร้าง dropdown filter ที่หัวตาราง
                        // โค้ดส่วนนี้ถูกลบออกไปแล้ว
                        // หมายเหตุ: ให้ไปโหลดสถานะฝึกอบรมใน xhr.dt เพื่อป้องกันเรียกซ้ำ
                    },
                    drawCallback: function() {
                        $('[data-bs-toggle="tooltip"]').tooltip({ html: true });
                    }
                });
                // อัพเดท UI แสดงตัวกรองที่ใช้อยู่
                updateFilterBadges();
                // โหลดสถานะเมื่อมีการวาดตาราง (เช่น เปลี่ยนหน้า/ค้นหา/เรียง)
                var lastTrainingStatusKey = '';
                table.on('draw.dt', function(){
                    var dt = $('#employeeTable').DataTable();
                    var data = dt.rows({ page: 'current' }).data().toArray();
                    if (!data || data.length === 0) return;
                    var ids = [];
                    data.forEach(function(r){ if (r && r.personID) ids.push(String(r.personID).trim()); });
                    var key = ids.join(',');
                    if (key && key !== lastTrainingStatusKey) {
                        lastTrainingStatusKey = key;
                        loadTrainingStatuses();
                    }
                });
            });
            // กำหนดตัวแปรสิทธิ์สำหรับใช้ใน JavaScript
            var userPermissions = {
                canAdd: @Json.Serialize(canAdd),
                canEdit: @Json.Serialize(canEdit),
                canDelete: @Json.Serialize(canDelete),
                canView: @Json.Serialize(canView),
                isAdmin: @Json.Serialize(isAdmin),

                currentUserDepartment: '@ViewData["CurrentUserDepartment"]'
            };

            // จัดการกับส่วน Filter
            $('#filterButton').on('click', function() {
                // เช็คว่ามี filter row อยู่แล้วหรือไม่
                if ($('#filter-row').length) {
                    $('#filter-row').remove();
                } else {
                    // เพิ่ม row ใหม่สำหรับฟิลเตอร์เป็น row แรกของตาราง
                    let filterContent = $('#filterRowTemplate').html();
                    $('#employeeTable').find('tbody').prepend(filterContent);
                    // กำหนดค่าที่เลือกไว้ก่อนหน้า
                    let storedDepartment = $('#filter-storage').data('department');
                    if (storedDepartment && storedDepartment !== '') {
                        $('.filter-department').val(storedDepartment);
                    }
                    // ถ้าไม่ใช่ admin ล็อกแผนกเป็นของผู้ใช้และ disable การเปลี่ยนค่า
                    if (!userPermissions.isAdmin) {
                        const userDept = userPermissions.currentUserDepartment;
                        if (userDept && userDept !== '') {
                            $('.filter-department').val(userDept);
                        }
                        $('.filter-department').prop('disabled', true);
                    }
                    $('.filter-shift').val($('#filter-storage').data('shift') || '');
                    $('.filter-status').val($('#filter-storage').data('status') || 'active');
                    $('.filter-door').val($('#filter-storage').data('door') || '');
                    // จัดการปุ่มรีเซ็ต
                    $('.reset-filter').on('click', function() {
                        $('.filter-shift, .filter-door, .filter-fingerprint').val('');
                        $('.filter-status').val('active');
                        
                        // ตรวจสอบสิทธิ์การเข้าถึงแผนก
                        if (!userPermissions.isAdmin) {
                            // ถ้าไม่ใช่ admin ให้ตั้งค่าแผนกเป็นแผนกของผู้ใช้
                            $('.filter-department').val(userPermissions.currentUserDepartment);
                        }
                    });
                    // จัดการปุ่มตกลง
                    $('.apply-filter').on('click', function() {
                        let department = $('.filter-department').val();
                        let shift = $('.filter-shift').val();
                        let status = $('.filter-status').val();
                        let door = $('.filter-door').val();
                        let fingerprint = $('.filter-fingerprint').val();
                        // เก็บค่าที่เลือก
                        $('#filter-storage').data('department', department);
                        $('#filter-storage').data('shift', shift);
                        $('#filter-storage').data('status', status);
                        $('#filter-storage').data('door', door);
                        $('#filter-storage').data('fingerprint', fingerprint);
                        // บันทึกลง localStorage
                        saveFiltersToLocalStorage();
                        // รีโหลดตาราง
                        $('#employeeTable').DataTable().ajax.reload();
                        // อัพเดท UI แสดงตัวกรอง
                        updateFilterBadges();
                        // ปิด filter row
                        $('#filter-row').remove();
                    });
                    // จัดการปุ่มปิด
                    $('.close-filter').on('click', function() {
                        $('#filter-row').remove();
                    });
                }
            });
            // จัดการโมดัลเพิ่ม/แก้ไขพนักงาน
            $('#employeeModal').on('shown.bs.modal', function() {
                $(this).find('input:first').focus();
            });
            // เมื่อกดปุ่มเพิ่มพนักงาน
            $('body').on('click', '.add-employee', function() {
                resetEmployeeForm();
                $('#employeeModalLabel').html('<i class="fas fa-user-plus me-2"></i>เพิ่มข้อมูลพนักงาน');
                
                // ตรวจสอบสิทธิ์การเพิ่มพนักงาน
                if (!userPermissions.canAdd) {
                    showErrorToast('ไม่มีสิทธิ์ในการเพิ่มข้อมูลพนักงาน');
                    return;
                }
                
                // ถ้าไม่ใช่ admin ให้เลือกแผนกของผู้ใช้โดยอัตโนมัติ
                if (!userPermissions.isAdmin) {
                    $('#deptName').val(userPermissions.currentUserDepartment);
                    $('#deptName').trigger('change');
                }
                
                $('#employeeModal').modal('show');
            });
            // เมื่อกดปุ่มแก้ไขพนักงาน
            $('body').on('click', '.edit-employee', function() {
                let personId = $(this).data('person-id'); 
                resetEmployeeForm();
                // แสดง Loading
                Swal.fire({
                    title: 'กำลังโหลดข้อมูล',
                    html: '<div class="spinner-border text-primary" role="status"></div>',
                    showConfirmButton: false,
                    allowOutsideClick: false
                });
                // ดึงข้อมูลพนักงาน
                $.ajax({
                    url: appBasePath + 'Employee/GetEmployeeById',
                    type: 'GET',
                    data: {
                        personID: personId
                    },
                    success: function(response) {
                        Swal.close(); // ปิด loading
                        if (response && response.success) {
                            let data = response.data;
                            $('#employeeModalLabel').html(
                                '<i class="fas fa-user-edit me-2"></i>แก้ไขข้อมูล : ' + data
                                .emp_person[0].name);
                            // กรณีที่มีโครงสร้างข้อมูลแบบใหม่ (มี emp_person array)
                            if (data.emp_person && Array.isArray(data.emp_person) && data.emp_person
                                .length > 0) {
                                // แยกข้อมูลแต่ละประเภท
                                let personData = null;
                                let cardData = null;
                                let fingerprintData = null;
                                // หาข้อมูลบัตรและลายนิ้วมือโดยดูจาก personID ที่ลงท้ายด้วย -1 (บัตร) และ -2 (ลายนิ้วมือ)
                                data.emp_person.forEach(function(item) {
                                    if (item.personID.endsWith('-1')) {
                                        cardData = item;
                                    } else if (item.personID.endsWith('-2')) {
                                        fingerprintData = item;
                                    } else {
                                        personData = item;
                                    }
                                });
                                // ถ้าไม่มีข้อมูลหลัก ใช้ข้อมูลบัตรเป็นหลัก
                                if (!personData && cardData) {
                                    personData = cardData;
                                } else if (!personData && fingerprintData) {
                                    personData = fingerprintData;
                                } else if (!personData && data.emp_person.length > 0) {
                                    personData = data.emp_person[0];
                                }
                                if (personData) {
                                    // ใส่ข้อมูลพื้นฐานลงในฟอร์ม
                                    $('#cardNo').val(personData.personID ? personData.personID
                                        .split('-')[0] : '');
                                    $('#cardNumber').val(personData.cardNumber || '');
                                    $('#name').val(personData.name || '');
                                    $('#shift').val(personData.shiftMent || '');
                                    $('#deptName').val(personData.deptID || '');
                                    $('#deptID').val(personData.deptID || '');
                                    // ข้อมูลเพิ่มเติมสำหรับบัตรและลายนิ้วมือ
                                    if (cardData) {
                                        $('#personIDc').val(cardData.personID || '');
                                    }
                                    if (fingerprintData) {
                                        $('#personIDfp').val(fingerprintData.personID || '');
                                    }
                                    // แสดงโมดัล
                                    $('#employeeModal').modal('show');
                                } else {
                                    showErrorToast('ไม่พบข้อมูลพนักงาน');
                                }
                            } else {
                                showErrorToast('ไม่พบข้อมูลพนักงาน');
                            }
                        } else {
                            showErrorToast(response.message || 'ไม่พบข้อมูลพนักงาน');
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.close(); // ปิด loading
                        showErrorToast('เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error);
                    }
                });
            });
            // ล้างฟอร์ม
            function resetEmployeeForm() { 
                $('#employeeForm')[0].reset();
                $('#employeeForm').removeClass('was-validated');
            }
            // บันทึกข้อมูลพนักงาน
            $('#saveButton').on('click', function() {
                let form = $('#employeeForm')[0];
                if (form.checkValidity()) {
                    // ตรวจสอบว่าเป็นการเพิ่มหรือแก้ไข
                    let isNewEmployee = !$('#employeeModalLabel').html().includes('แก้ไข');
                    let url = isNewEmployee ? appBasePath + 'Employee/AddEmployee' : appBasePath + 'Employee/UpdateEmployee';
                    $.ajax({
                        url: url,
                        type: 'POST',
                        data: {
                            personID: $('#cardNo').val(),
                            cardNumber: $('#cardNumber').val(),
                            name: $('#name').val(),
                            deptID: $('#deptID').val(),
                            deptName: $('#deptName option:selected').text()
                        },
                        beforeSend: function(xhr) {
                            xhr.setRequestHeader("RequestVerificationToken",
                                $('input:hidden[name="__RequestVerificationToken"]').val());
                        },
                        success: function(response) {
                            if (response.success) {
                                $('#employeeModal').modal('hide');
                                showSuccessToast(response.message || 'บันทึกข้อมูลสำเร็จ');
                                $('#employeeTable').DataTable().ajax.reload();
                            } else {
                                showErrorToast(response.message ||
                                    'เกิดข้อผิดพลาดในการบันทึกข้อมูล');
                            }
                        },
                        error: function() {
                            showErrorToast('เกิดข้อผิดพลาดในการบันทึกข้อมูล');
                        }
                    });
                } else {
                    form.classList.add('was-validated');
                }
            });
            
            // ลบพนักงาน (รองรับ 2 ขั้นตอน)
            $('body').on('click', '.delete-employee', function() {
                let personId = $(this).data('person-id');
                let buttonElement = $(this);
                
                // ตรวจสอบว่าเป็นการลบถาวรหรือไม่
                let isPermanentDelete = buttonElement.hasClass('btn-danger');
                
                let title, text, confirmText, warningLevel;
                
                if (isPermanentDelete) {
                    // การลบถาวร
                    title = 'ยืนยันการลบถาวร';
                    text = 'คุณต้องการลบข้อมูลพนักงานนี้ถาวรใช่หรือไม่? การกระทำนี้ไม่สามารถยกเลิกได้!';
                    confirmText = 'ลบถาวร';
                    warningLevel = 'error';
                } else {
                    // การทำเครื่องหมายเพื่อลบ
                    title = 'ยืนยันการทำเครื่องหมายเพื่อลบ';
                    text = 'คุณต้องการทำเครื่องหมายข้อมูลพนักงานนี้เพื่อลบใช่หรือไม่? สามารถคืนสถานะได้ภายหลัง';
                    confirmText = 'ทำเครื่องหมาย';
                    warningLevel = 'warning';
                }
                
                Swal.fire({
                    title: title,
                    text: text,
                    icon: warningLevel,
                    showCancelButton: true,
                    confirmButtonText: confirmText,
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#dc3545',
                    reverseButtons: true
                }).then((result) => {
