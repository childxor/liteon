            // ฟังก์ชันแสดงโมดัลสิทธิ์ประตู
            function showAccessModal(personId, isAdmin) {
                // แสดง Loading
                Swal.fire({
                    title: 'กำลังโหลดข้อมูล',
                    html: '<div class="spinner-border text-primary" role="status"></div>',
                    showConfirmButton: false,
                    allowOutsideClick: false
                });
                // ดึงข้อมูลสิทธิ์ประตู
                $.ajax({
                    url: appBasePath + 'Employee/GetAccess',
                    type: 'POST',
                    data: {
                        personId: personId
                    },
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader("RequestVerificationToken",
                            $('input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    success: function(response) {
                        // ปิด loading dialog
                        Swal.close();
                        if (response.success) {
                            // กำหนดข้อมูลพนักงาน
                            $('#employeeName').text(response.employeeName || personId);
                            $('#employeeID').text(personId);
                            $('#employeeDept').text(response.deptName || 'ไม่ระบุแผนก');
                            $('#addAllAccess, #addSpecificDoors, #removeAllAccess').data(
                                'person-id', personId);
                            // เก็บข้อมูลประตูไว้ใช้ภายหลัง
                            $('#doorAccessTable').data('doors', response.data);
                            // สร้างตาราง
                            let tableHtml = '';
                            $.each(response.data, function(index, door) {
                                // กำหนดสถานะสิทธิ์
                                let cardAccessHtml = getAccessHtml(door.hasCardAccess,
                                    'card', personId, door.doorID, isAdmin);
                                let fingerAccessHtml = getAccessHtml(door
                                    .hasFingerprintAccess, 'finger', personId, door
                                    .doorID, isAdmin);
                                // สร้างแถวข้อมูล
                                tableHtml += '<tr>';
                                tableHtml += '<td>' + door.doorName +
                                    '<div class="small text-muted">' + door.doorID +
                                    '</div></td>';
                                tableHtml += '<td class="text-center">' + cardAccessHtml +
                                    '</td>';
                                tableHtml += '<td class="text-center">' + fingerAccessHtml +
                                    '</td>';
                                tableHtml += '</tr>';
                            });
                            // เพิ่มข้อมูลลงในตาราง
                            $('#doorAccessTableBody').html(tableHtml);
                            
                            // จัดการการแสดงปุ่มควบคุมตามสิทธิ์
                            if (isAdmin) {
                                $('#accessControlButtons').show();
                                $('#viewOnlyMessage').addClass('d-none');
                                // เพิ่ม event listener สำหรับการเปลี่ยนสถานะสิทธิ์
                                setupAccessToggleEvents();
                            } else {
                                $('#accessControlButtons').hide();
                                $('#viewOnlyMessage').removeClass('d-none');
                            }
                            
                            // แสดงโมดัล
                            $('#accessDoorModal').modal('show');
                        } else {
                            // แสดงข้อความผิดพลาด
                            showErrorToast(response.error || 'ไม่สามารถโหลดข้อมูลสิทธิ์ประตูได้');
                        }
                    },
                    error: function(xhr, status, error) {
                        // ปิด loading dialog
                        Swal.close();
                        showErrorToast('เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error);
                    }
                });
            }
            // ฟังก์ชันสร้าง HTML สำหรับแสดงสถานะสิทธิ์
            function getAccessHtml(hasAccess, accessType, personId, doorId, isAdmin) {
                let checked = hasAccess ? 'checked' : '';
                let suffix = accessType === 'card' ? '-1' : '-2';
                let fullPersonId = personId + suffix;
                let disabled = isAdmin ? '' : 'disabled';
                return '<div class="form-check form-switch d-flex justify-content-center">' +
                    '<input class="form-check-input toggle-access" type="checkbox" ' + checked + ' ' + disabled + ' ' +
                    'data-person-id="' + fullPersonId + '" ' +
                    'data-door-id="' + doorId + '" ' +
                    'data-access-type="' + accessType + '">' +
                    '</div>';
            }
            // ฟังก์ชันเพิ่ม event listener สำหรับการเปลี่ยนสถานะสิทธิ์
            function setupAccessToggleEvents() {
                $('.toggle-access').on('change', function() {
                    let personId = $(this).data('person-id');
                    let doorId = $(this).data('door-id');
                    let accessType = $(this).data('access-type');
                    let state = $(this).prop('checked') ? 1 : 0;
                    let dnfp = accessType === 'finger' ? 1 : 0;
                    // เตรียมข้อมูล weekTimeID
                    let weekTimeID = null;
                    // ใช้ weekTimeID จากข้อมูลประตู (ถ้ามี)
                    $.each($('#doorAccessTable').data('doors'), function(index, door) {
                        if (door.doorID === doorId) {
                            weekTimeID = door.weekTimeID;
                            return false; // ออกจาก loop
                        }
                    });
                    // อัพเดทสถานะสิทธิ์
                    updateDoorAccess(personId, doorId, state, weekTimeID, dnfp);
                });
            }
            // อัพเดทสิทธิ์การเข้าประตู
            function updateDoorAccess(personId, doorId, state, weekTimeID, dnfp) {
                $.ajax({
                    url: appBasePath + 'Employee/UpdateAccess',
                    type: 'POST',
                    data: {
                        personId: personId,
                        doorId: doorId,
                        state: state,
                        weekTimeID: weekTimeID,
                        dnfp: dnfp
                    },
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader("RequestVerificationToken",
                            $('input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    success: function(response) {
                        if (response.status === 'success') {
                            // ไม่ต้องแสดงข้อความเมื่อสำเร็จ
                        } else {
                            // แสดงข้อความผิดพลาดที่เหมาะสม
                            let errorMessage = response.message || 'ไม่สามารถอัพเดทสิทธิ์ได้';
                            if (errorMessage.includes('ไม่มีสิทธิ์')) {
                                showErrorToast('คุณไม่มีสิทธิ์ในการแก้ไขสิทธิ์ประตู กรุณาติดต่อผู้ดูแลระบบ');
                            } else {
                                showErrorToast(errorMessage);
                            }
                            // ย้อนกลับสถานะของสวิตช์
                            let checkbox = $('[data-person-id="' + personId + '"][data-door-id="' + doorId +
                                '"]');
                            checkbox.prop('checked', !checkbox.prop('checked'));
                        }
                    },
                    error: function(xhr, status, error) {
                        // ตรวจสอบข้อผิดพลาดจาก server
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            let errorMessage = xhr.responseJSON.message;
                            if (errorMessage.includes('ไม่มีสิทธิ์')) {
                                showErrorToast('คุณไม่มีสิทธิ์ในการแก้ไขสิทธิ์ประตู กรุณาติดต่อผู้ดูแลระบบ');
                            } else {
                                showErrorToast('เกิดข้อผิดพลาดในการอัพเดทสิทธิ์: ' + errorMessage);
                            }
                        } else {
                            showErrorToast('เกิดข้อผิดพลาดในการอัพเดทสิทธิ์');
                        }
                        // ย้อนกลับสถานะของสวิตช์
                        let checkbox = $('[data-person-id="' + personId + '"][data-door-id="' + doorId +
                            '"]');
                        checkbox.prop('checked', !checkbox.prop('checked'));
                    }
                });
            }
