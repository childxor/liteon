                                                    </li>
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">อัพเดทล่าสุด:</span>
                                                        <span class="fw-medium">${fingerprintData.modifyTime ? new Date(fingerprintData.modifyTime).toLocaleString('th-TH') : '-'}</span>
                                                    </li>
                                                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                                                        <span class="text-muted">สถานะการใช้งาน:</span>
                                                        <span class="badge ${fingerprintData.isActive === 1 ? 'bg-success' : 'bg-warning'}">${fingerprintData.isActive === 1 ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}</span>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>`;
                                        }
                                        modalContent += `
                                        </div>
                                    </div>
                                </div>`;
                                    }
                                    // แสดงข้อมูลในรูปแบบ Modal ด้วย SweetAlert2
                                    Swal.fire({
                                        title: 'ข้อมูลพนักงาน',
                                        html: modalContent,
                                        width: '800px',
                                        showCloseButton: true,
                                        showConfirmButton: false,
                                        customClass: {
                                            container: 'employee-detail-modal'
                                        }
