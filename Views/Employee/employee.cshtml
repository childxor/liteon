            // ฟังก์ชันดึงข้อมูลสิทธิ์ประตูของพนักงานแต่ละคน
            function getEmployeeDoorAccess(personId) {
                return new Promise(function(resolve, reject) {
                    $.ajax({
                        url: appBasePath + 'Employee/GetAccess',
                        type: 'POST',
                        data: {
                            personId: personId
                        },
                        beforeSend: function(xhr) {
                            xhr.setRequestHeader("RequestVerificationToken",
                                $('input:hidden[name="__RequestVerificationToken"]').val());
                        },
                        success: function(response) {
                            if (response.success && response.data) {
                                // สร้างรายการประตูทั้งหมดจากการเรียกครั้งแรก
                                if (!window.allDoors) {
                                    window.allDoors = (response.data || []).map(function(d) {
                                        return { doorID: d.doorID, doorName: d.doorName };
                                    });
                                }

                                // เก็บข้อมูลสิทธิ์ประตูแบบรายการชื่อ และแบบ Matrix ตาม doorID
                                var doorList = [];
                                var accessById = {};
                                response.data.forEach(function(door) {
                                    var hasAccess = !!(door.hasCardAccess || door.hasFingerprintAccess);
                                    if (hasAccess) {
                                        doorList.push(door.doorName + ' (' + door.doorID + ')');
                                    }
                                    accessById[door.doorID] = hasAccess;
                                });

                                // เก็บข้อมูลใน global variable
                                if (!window.employeeAccessData) { window.employeeAccessData = {}; }
                                if (!window.employeeDoorAccessById) { window.employeeDoorAccessById = {}; }

                                window.employeeAccessData[personId] = doorList;
                                window.employeeDoorAccessById[personId] = accessById;
                            }
                            resolve();
                        },
                        error: function(xhr, status, error) {
                            console.warn('ไม่สามารถดึงข้อมูลสิทธิ์ประตูสำหรับ ' + personId + ': ' + error);
                            // ถ้าไม่สามารถดึงข้อมูลได้ ให้เก็บเป็น array ว่าง
                            if (!window.employeeAccessData) {
                                window.employeeAccessData = {};
                            }
                            window.employeeAccessData[personId] = [];
                            resolve(); // ยังคง resolve เพื่อให้ process ต่อไป
                        }
                    });
                });
            }

            // ฟังก์ชันสร้าง Sheet สรุปภาพรวม
            function createSummarySheet(data) {
                var summaryData = [];
                var headers = [
                    'Employees by Department Summary',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    '',
                    ''
                ];
                summaryData.push(headers);

                // สถิติตามแผนก (TH/简中 注释) Department statistics
                var deptStats = {};
                data.forEach(function(row) {
                    var deptName = (row.WorkArea || row.department || 'Unknown');
                    if (!deptStats[deptName]) {
                        deptStats[deptName] = {
                            total: 0,
                            active: 0,
                            resigned: 0,
                            hasAccess: 0,
                            hasFingerprint: 0
                        };
                    }
                    deptStats[deptName].total++;
                    
                    if (row.resignDate) {
                        deptStats[deptName].resigned++;
                    } else {
                        deptStats[deptName].active++;
                    }
                    
                    if (row.accessCount > 0) {
                        deptStats[deptName].hasAccess++;
                    }
                    
                    if (row.hasFingerprint) {
                        deptStats[deptName].hasFingerprint++;
                    }
                });

                // เพิ่มข้อมูลสถิติ (TH/简中 注释) Add statistics header
                summaryData.push(['Department', 'Total', 'Active', 'Resigned', 'Has Door Access', 'Has Fingerprint']);
                Object.keys(deptStats).forEach(function(deptName) {
                    var stats = deptStats[deptName];
                    summaryData.push([
                        deptName,
                        stats.total,
                        stats.active,
                        stats.resigned,
                        stats.hasAccess,
                        stats.hasFingerprint
                    ]);
                });

                // สรุปรวม
                var totalEmployees = data.length;
                var totalActive = data.filter(row => !row.resignDate).length;
                var totalResigned = data.filter(row => row.resignDate).length;
                var totalWithAccess = data.filter(row => row.accessCount > 0).length;
                var totalWithFingerprint = data.filter(row => row.hasFingerprint).length;

                summaryData.push(['']);
                summaryData.push(['Totals', totalEmployees, totalActive, totalResigned, totalWithAccess, totalWithFingerprint]);

                return summaryData;
            }
            // ฟังก์ชันสร้าง Sheet สรุปภาพรวมสิทธิ์ประตู (Door Access Overview)
            function createDoorAccessOverviewSheet(data) {
                var sheet = [];

                // หัวเรื่องใหญ่ของชีต
                sheet.push(['Door Access Overview']);

                // รายชื่อห้อง/ประตู ก่อนและหลังปรับชื่อ (เพื่อแสดงบนหัวตาราง)
                var beforeNames = [
                    'Chemical room',
                    'DCC room',
                    'Comsumables room',
                    'Jig room',
                    'MIS server room',
                    'DQE room',
                    'IQC room',
                    'Store raw material',
                    'Store electonic',
                    'Store Finish goods 01',
                    'Store Finish goods 02',
                    'HR Attendance 01',
                    'HR Attendance 02'
                ];

                var afterNames = [
                    'Chemical room',
                    'MRO room',
                    'shoes change',
                    'Jig room',
                    'MIS server room',
                    'DQE room',
                    'IQC room',
                    'Store raw material',
                    'Store electonic',
                    'Store Finish goods 01',
                    'Store Finish goods 02',
                    'HR Attendance 01',
                    'HR Attendance 02'
                ];

                var owners = [
                    'MFG',
                    'MFG',
                    'MFG',
                    'ME',
                    'IT',
                    'QRA',
                    'QRA',
                    'SCM',
                    'SCM',
                    'SCM',
                    'SCM',
                    'MD-IDL',
                    'MD-IDL&DL'
                ];

                // สร้าง mapping ของชื่อห้อง (หลังปรับ) ไปยัง alias ที่อาจพบในระบบ
                var aliasMap = {
                    'Chemical room': ['chemical room'],
                    'MRO room': ['mro room', 'dcc room'],
                    'shoes change': ['shoes change', 'shoe change', 'comsumables room', 'consumables room'],
                    'Jig room': ['jig room'],
                    'MIS server room': ['mis server room'],
                    'DQE room': ['dqe room'],
                    'IQC room': ['iqc room'],
                    'Store raw material': ['store raw material'],
                    'Store electonic': ['store electonic', 'store electronic', 'store electronics'],
                    'Store Finish goods 01': ['store finish goods 01', 'store finish goods1', 'store finish goods01'],
                    'Store Finish goods 02': ['store finish goods 02', 'store finish goods2', 'store finish goods02'],
                    'HR Attendance 01': ['hr attendance 01', 'hr attendance1', 'hr attendance01', 'hr attendance 1'],
                    'HR Attendance 02': ['hr attendance 02', 'hr attendance2', 'hr attendance02', 'hr attendance 2']
                };

                function normalize(text) {
                    return (text || '').toString().toLowerCase().replace(/\s+/g, ' ').trim();
                }

                // แถวหัวเรื่อง Before / After
                sheet.push(['', '', '', 'Before'].concat(beforeNames)); // row 2 (1-based)
                sheet.push(['', '', '', 'After'].concat(afterNames));   // row 3

                // แถวหัวคอลัมน์จริง (ไม่ใส่ชื่อประตูซ้ำในบรรทัดนี้)
                sheet.push(['Department', 'Employee ID', 'Card Number', 'Full Name'].concat(new Array(afterNames.length).fill(''))); // row 4

                // แถวเจ้าของคอลัมน์ (Owner) 
                sheet.push(['', '', '', 'Owner'].concat(owners));

                // เตรียมรายการประตูทั้งหมดแบบ normalize ไว้ล่วงหน้า
                var normalizedAllDoors = (window.allDoors || []).map(function(d) {
                    return { doorID: d.doorID, nameNorm: normalize(d.doorName) };
                });

                // สร้างข้อมูลพนักงานแบบสรุปสิทธิ์ประตู (อ้างอิงสิทธิ์จริงจาก Employee/GetAccess)
                data.forEach(function(row) {
                    var accessById = (window.employeeDoorAccessById && window.employeeDoorAccessById[row.personID]) || {};

                    var flags = afterNames.map(function(targetName) {
                        var aliases = (aliasMap[targetName] || [targetName]).map(normalize);

                        // หา doorID ที่ชื่อใดชื่อหนึ่งใน alias ตรง/ใกล้เคียงกับชื่อประตูจริง
                        var matchedIds = [];
                        normalizedAllDoors.forEach(function(nd) {
                            var isMatch = aliases.some(function(a) {
                                return nd.nameNorm === a || nd.nameNorm.indexOf(a) !== -1 || a.indexOf(nd.nameNorm) !== -1;
                            });
                            if (isMatch) { matchedIds.push(nd.doorID); }
                        });

                        if (matchedIds.length === 0) { return ''; }
                        var hasAny = matchedIds.some(function(id) { return !!accessById[id]; });
                        return hasAny ? 'V' : '';
                    });

                    var deptDisplay = (row.WorkArea || row.department || 'ไม่ระบุแผนก');
                    sheet.push([
                        deptDisplay,
                        (row.personID || ''),
                        (row.cardNumber || ''),
                        (row.name || '')
                    ].concat(flags));
                });

                return sheet;
            }

            // ฟังก์ชันสร้าง Sheet สำหรับแต่ละแผนก (แบบแยกประตูเป็นแถว)
            function createDepartmentSheetWithDoors(data, deptName) {
                var deptData = [];
                var headers = [
                    'Employee ID',
                    'Card Number',
                    'Full Name',
                    'Department',
                    'Door Access Count',
                    'Door Code',
                    'Door Name',
                    'Access Level',
                    'Access Start Date',
                    'Access End Date',
                    'Approved By',
                    'Remarks'
                ];

                deptData.push(headers);

                // แปลงข้อมูลแต่ละแถว
                data.forEach(function(row) {
                    // ดึงรายการประตูที่เข้าถึงได้จากข้อมูลที่ดึงมาแล้ว
                    var doorList = [];
                    if (window.employeeAccessData && window.employeeAccessData[row.personID]) {
                        doorList = window.employeeAccessData[row.personID];
                    }
                    
                    // กำหนดระดับสิทธิ์การเข้าถึง (TH/简中 注释) Determine access level
                    var accessLevel = 'Anytime'; // default
                    if (row.shiftMent) {
                        if (row.shiftMent.includes('DAY')) {
                            accessLevel = 'Day shift only';
                        } else if (row.shiftMent.includes('N01')) {
                            accessLevel = 'Night shift only';
                        } else if (row.shiftMent.includes('OFFICE')) {
                            accessLevel = 'Office hours only'; 
                        }
                    }
                    
                    // กำหนดวันที่เริ่มต้นสิทธิ์
                    var accessStartDate = row.startDate ? 
                        moment(row.startDate).format('DD/MM/YYYY') : 'ไม่ระบุ';
                    
                    // กำหนดวันที่สิ้นสุดสิทธิ์
                    var accessEndDate = row.resignDate ? 
                        moment(row.resignDate).format('DD/MM/YYYY') : 'ไม่มีกำหนด';
                    
                    // กำหนดผู้อนุมัติสิทธิ์
                    var approver = 'Supervisor'; // ค่าเริ่มต้น
                    
                    // หมายเหตุเพิ่มเติม
                    var notes = '';
                    if (row.noteStatus) {
                        notes = row.noteStatus;
                    } else if (row.resignDate) {
                        notes = 'ลาออกแล้ว - ต้องลบสิทธิ์ประตู';
                    } else if (!row.hasCardData && !row.hasFingerprintData) {
                        notes = 'ข้อมูลไม่ครบถ้วน - ต้องเพิ่มข้อมูลใน SQL944';
                    }

                    if (doorList.length === 0) {
                        // ถ้าไม่มีสิทธิ์ประตู ให้แสดงแถวเดียว
                        var rowData = [
                            row.personID || '',
                            row.cardNumber || '',
                            row.name || '',
                            (deptName || ''),
                            row.accessCount || 0,
                            '-',
                            'ไม่มีสิทธิ์',
                            accessLevel,
                            accessStartDate,
                            accessEndDate,
                            approver,
                            notes
                        ];
                        deptData.push(rowData);
                    } else {
                        // ถ้ามีสิทธิ์ประตู ให้แสดงแต่ละประตูเป็นแถวแยกกัน
                        doorList.forEach(function(doorInfo, index) {
                            // แยกรหัสประตูและชื่อประตู
                            var doorMatch = doorInfo.match(/^(.+?)\s*\(([^)]+)\)$/);
                            var doorName = doorMatch ? doorMatch[1].trim() : doorInfo;
                            var doorID = doorMatch ? doorMatch[2].trim() : doorInfo;
                            
                            var rowData = [
                                row.personID || '',
                                row.cardNumber || '',
                                row.name || '',
                                (deptName || ''),
                                row.accessCount || 0,
                                doorID,
                                doorName,
                                accessLevel,
                                accessStartDate,
                                accessEndDate,
                                approver,
                                notes
                            ];
                            deptData.push(rowData);
                        });
                    }
                });

                return deptData;
            }
