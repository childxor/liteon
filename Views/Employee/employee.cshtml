                                    'data-hasfingerprintdata="' + (item.hasFingerprintData ?
                                        'true' : 'false') + '">' +
                                    '<i class="fas fa-edit"></i>' +
                                    '</button>' +
                                    '<button type="button" class="btn btn-shift-action btn-outline-danger delete-shift-btn" ' +
                                    'data-id="' + item.id + '" ' +
                                    'data-personid="' + (item.personId || '') + '" ' +
                                    'data-name="' + (item.name || '') + '" ' +
                                    'data-shiftment="' + (item.shiftMent || '') + '" ' +
                                    'data-date="' + dateStr2 + '">' +
                                    '<i class="fas fa-trash-alt"></i>' +
                                    '</button>' +
                                    '</div>' +
                                    '</div>' +
                                    '<div class="shift-body">' +
                                    '<div class="shift-info">' +
                                    '<span class="badge bg-primary shift-badge">' + (item
                                        .shiftMent || '-') + '</span>' +
                                    '<span class="text-muted small">แผนก: ' + (item.deptName ||
                                        '-') + '</span>';
                                // แสดงหมายเหตุถ้ามี
                                if (item.remark) {
                                    content +=
                                        '<div class="small mt-1"><i class="fas fa-comment-alt text-muted me-1"></i>' +
                                        item.remark + '</div>';
                                }
                                content += '</div>' +
                                    '</div>' +
                                    '</div>' +
                                    '</div>';
                            });
                            content += '</div></div></div>';
                            historyHtml = content; // ใช้ content ที่สร้างไว้กับ historyHtml
                        } else {
                            // เคลียร์ข้อมูลกะเดิม
                            window.employeeShifts = [];
                            historyHtml = '<div class="card shadow-sm mb-3">' +
                                '<div class="card-header bg-light d-flex justify-content-between align-items-center py-2">' +
                                '<div>' +
                                '<i class="fas fa-history me-2 text-primary"></i>' +
                                '<span>ประวัติการเปลี่ยนกะ</span>' +
                                '</div>' +
                                '<button type="button" class="btn btn-sm btn-primary add-shift-btn" data-person-id="' +
                                personId + '">' +
                                '<i class="fas fa-plus-circle me-1"></i>เพิ่มกะ' +
                                '</button>' +
                                '</div>' +
                                '<div class="card-body">' +
                                '<div class="text-center text-muted py-2">' +
                                '<i class="fas fa-info-circle me-1"></i> ไม่พบประวัติการเปลี่ยนกะ' +
                                '</div>' +
                                '</div>' +
                                '</div>';
                        }
                        return historyHtml;
                    },
                    error: function(error) {
                        console.error("Error loading employee history:", error);
                        return '<div class="alert alert-danger">เกิดข้อผิดพลาดในการโหลดข้อมูล</div>';
                    }
                });
