                let form = $('#shiftForm')[0];
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    showErrorToast('กรุณากรอกข้อมูลให้ครบถ้วนและถูกต้อง');
                    return;
                }
                
                // สร้างข้อมูลสำหรับส่งไปยัง API
                let formData = {
                    Id: $('#shiftId').val() ? parseInt($('#shiftId').val()) : 0,
                    PersonId: $('#shiftPersonId').val(),
                    name: $('#shiftPersonNameDisplay').text(),
                    deptID: $('#shiftDeptID').val(),
                    deptName: $('#shiftDeptName').val(),
                    deptCode: $('#shiftDeptCode').val(),
                    ShiftMent: $('#shiftName').val(),
                    Date: $('#shiftDate').val()
                };
                
                // Debug: แสดงข้อมูลที่จะส่งไป
                console.log('FormData:', formData);
                console.log('Mode:', formData.Id === 0 ? 'Create' : 'Edit');
                
                // ตรวจสอบข้อมูลที่จำเป็นอีกครั้ง
                if (!formData.PersonId || !formData.ShiftMent || !formData.Date || !formData.deptID) {
                    showErrorToast('กรุณากรอกข้อมูลให้ครบถ้วน');
                    console.log('Missing data:', {
                        PersonId: formData.PersonId,
                        ShiftMent: formData.ShiftMent,
                        Date: formData.Date,
                        deptID: formData.deptID
                    });
                    return;
                }
                
                // แสดง loading
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล',
                    html: '<div class="spinner-border text-primary" role="status"></div>',
                    showConfirmButton: false,
                    allowOutsideClick: false
                });
                
                // เช็คว่าเป็นการสร้างใหม่ (Id = 0) หรือแก้ไข (Id > 0)
                if (formData.Id === 0) {
                    // กรณีสร้างใหม่ - เช็คว่าต้องเพิ่มข้อมูล SQL944 หรือไม่
                    let hasCardData = $('#shiftModal').data('hasCardData');
                    let cardNumber = $('#shiftCardNo').val();
                    
                    if (!hasCardData && cardNumber) {
                        // เพิ่มข้อมูล SQL944 ก่อน
                        $.ajax({
                            url: '/Employee/CreateCardData',
                            type: 'POST',
                            data: {
                                personId: formData.PersonId,
                                cardNumber: cardNumber,
                                personName: formatName(formData.name),
                                deptID: formData.deptID,
                                deptName: formData.deptName,
                                shift: formData.ShiftMent,
                                date: formData.Date
                            },
                            beforeSend: function(xhr) {
                                xhr.setRequestHeader("RequestVerificationToken", $(
                                    'input:hidden[name="__RequestVerificationToken"]').val());
                            },
                            success: function(response) {
                                if (response.success) {
                                    // เพิ่มข้อมูล SQL944 สำเร็จ แล้วบันทึกข้อมูลกะ
                                    saveShiftData(formData);
                                } else {
                                    Swal.close();
                                    showErrorToast(response.message || 'ไม่สามารถเพิ่มข้อมูล SQL944 ได้');
                                }
                            },
                            error: function() {
                                Swal.close();
                                showErrorToast('เกิดข้อผิดพลาดในการเพิ่มข้อมูล SQL944');
                            }
                        });
                    } else {
                        // มีข้อมูลใน SQL944 แล้ว หรือไม่มีเลขบัตร ให้บันทึกข้อมูลกะเลย
                        saveShiftData(formData);
                    }
                } else {
                    // กรณีแก้ไข - บันทึกข้อมูลกะเลย ไม่ต้องเช็ค SQL944
                    saveShiftData(formData);
                }
            });
            
            // ฟังก์ชันสำหรับบันทึกข้อมูลกะ
            function saveShiftData(formData) {
                $.ajax({
                    url: '/Employee/SaveShiftHistory',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader("RequestVerificationToken", $(
                            'input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    success: function(response) {
                        Swal.close();
                        if (response.success) {
                            $('#shiftModal').modal('hide');
                            showSuccessToast(response.message || 'บันทึกข้อมูลสำเร็จ');
                            refreshOpenedChildRow();
                            // อัพเดทตารางหลัก
                            $('#employeeTable').DataTable().ajax.reload();
                        } else {
                            showErrorToast(response.message || 'ไม่สามารถบันทึกข้อมูลได้');
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.close();
                        console.error('Error:', error);
                        showErrorToast('เกิดข้อผิดพลาดในการบันทึกข้อมูล: ' + error);
                    }
                });
            }
            // รีเซ็ตฟอร์ม
            function resetShiftForm() {
                $('#shiftId').val(0);
                $('#shiftForm')[0].reset();
                $('#shiftForm').removeClass('was-validated');
                $('#shiftPersonNameDisplay').text('-');
                $('#shiftCardNoDisplay').text('-');
                $('#shiftDeptDisplay').text('-');
                $('#shiftDeptIDDisplay').val('');
                $('#shiftDeptID').val('');
                $('#shiftDeptCode').val('');
                $('#shiftStartTimeDisplay').text('-');
                $('#shiftEndTimeDisplay').text('-');
                // ล้างข้อมูล data attribute
                $('#shiftModal').removeData('hasCardData');
            }

            // ฟังก์ชันจัดรูปแบบชื่อ
            function formatName(fullName) {
                // ลบคำนำหน้าชื่อ
                let name = fullName.replace(/^(Mr\.|Mrs\.|Miss|Ms\.|Dr\.|Prof\.)\s+/i, '');
                // แยกชื่อและนามสกุล
                let nameParts = name.split(' ');
                if (nameParts.length >= 2) {
                    // เอาเฉพาะตัวอักษรแรกของนามสกุล
                    let lastName = nameParts[nameParts.length - 1];
                    let lastNameInitial = lastName.charAt(0);
                    // รวมชื่อและตัวอักษรแรกของนามสกุล
                    return nameParts[0] + ' ' + lastNameInitial + '.';
                }
                return name;
            }
