        function setupLanguageHandling() {
            function updateLanguageText() {
                const currentLang = '@Context.Session.GetCurrentLanguage()';
                const langTexts = {
                    'th': '@Context.Session.GetTranslation("thai_language")',
                    'en': '@Context.Session.GetTranslation("english_language")',
                    'zh': '@Context.Session.GetTranslation("chinese_language")'
                };
                $('#currentLanguage').text(langTexts[currentLang] || '@Context.Session.GetTranslation("language")');
            }
            updateLanguageText();
            $('.language-select').on('click', function (e) {
                e.preventDefault();
                const lang = $(this).data('lang');
                $('#currentLanguage').html('<i class="fas fa-spinner fa-spin"></i>');
                $.ajax({
                    url: appBasePath + 'Home/ChangeLanguage',
                    type: 'POST',
                    data: {
                        lang: lang
                    },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            showError('@Context.Session.GetTranslation("cannot_change_language")');
                        }
                    },
                    error: function () {
                        showError('@Context.Session.GetTranslation("cannot_connect_server")');
                    }
                });
            });
        }

        function showError(message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: '@Context.Session.GetTranslation("error_occurred")',
                    text: message,
                    confirmButtonText: '@Context.Session.GetTranslation("ok")'
                });
            } else {
                alert(message);
            }
        }
        
        // Add raindrops animation
        function createRaindrops() {
            const container = document.getElementById('raindrops');
            const count = 50;
            for (let i = 0; i < count; i++) {
                const raindrop = document.createElement('div');
                raindrop.className = 'raindrop';
                raindrop.style.left = `${Math.random() * 100}%`;
                raindrop.style.animationDelay = `${Math.random() * 1}s`;
                raindrop.style.opacity = Math.random() * 0.5;
                container.appendChild(raindrop);
            }
        }



        // ฟังก์ชันสำหรับควบคุมการซ่อน/ขยายส่วนรายละเอียด
        function setupToggleDetails() {
            // ปุ่มซ่อน/ขยายรายละเอียดตู้เก็บของ
            $('#btnToggleCabinetDetails').on('click', function() {
                const $detailsSection = $('#cabinetDetailsSection');
                const $btn = $(this);
                
                if ($detailsSection.is(':visible')) {
                    $detailsSection.slideUp(300);
                    $btn.html('<i class="fas fa-chevron-down me-1"></i>แสดงรายละเอียด');
                    $btn.removeClass('btn-primary active').addClass('btn-outline-primary');
                } else {
                    $detailsSection.slideDown(300);
                    $btn.html('<i class="fas fa-chevron-up me-1"></i>ซ่อนรายละเอียด');
                    $btn.removeClass('btn-outline-primary').addClass('btn-primary active');
                }
            });

            // ปุ่มซ่อน/ขยายรายละเอียดคอมพิวเตอร์
            $('#btnToggleComputerDetails').on('click', function() {
                const $detailsSection = $('#computerDetailsSection');
                const $btn = $(this);
                
                if ($detailsSection.is(':visible')) {
                    $detailsSection.slideUp(300);
                    $btn.html('<i class="fas fa-chevron-down me-1"></i>แสดงรายละเอียด');
                    $btn.removeClass('btn-info active').addClass('btn-outline-info');
                } else {
                    $detailsSection.slideDown(300);
                    $btn.html('<i class="fas fa-chevron-up me-1"></i>ซ่อนรายละเอียด');
                    $btn.removeClass('btn-outline-info').addClass('btn-info active');
                }
            });
        }
