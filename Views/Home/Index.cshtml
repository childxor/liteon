            if (!departmentStats || !departmentStats.length) return;
            const ctx = document.getElementById('departmentChart').getContext('2d');
            const topDepts = departmentStats.slice(0, 5);
            try {
                if (window.departmentChart && window.departmentChart.destroy) window.departmentChart.destroy();
                else if (Chart.getChart('departmentChart')) Chart.getChart('departmentChart').destroy();
