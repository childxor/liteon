<!-- Add Raindrops -->
<div id="raindrops"></div>

@section Scripts {
    <script>
        // ประกาศตัวแปร appBasePath
        var appBasePath = '@Url.Content("~/")';

        // กำหนดการตั้งค่าภาษาสำหรับ Chart.js
        const currentLanguage = '@Context.Session.GetCurrentLanguage()';

        // ตั้งค่าชื่อเดือนและวันตามภาษา
        const monthNames = {
            'th': ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'],
            'en': ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            'zh': ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
        };

        const fullMonthNames = {
            'th': ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'],
            'en': ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
            'zh': ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月']
        };

        // ตั้งค่า Chart.js defaults
        if (typeof Chart !== 'undefined') {
            Chart.defaults.font.family = 'Segoe UI, Tahoma, Geneva, Verdana, sans-serif';
            Chart.defaults.color = '#374151';
            Chart.defaults.borderColor = '#e5e7eb';

            // กำหนดรูปแบบการแสดงผลพื้นฐานสำหรับทุกกราฟ
            Chart.defaults.plugins.legend.labels.usePointStyle = true;
            Chart.defaults.plugins.legend.labels.padding = 20;
            Chart.defaults.plugins.tooltip.cornerRadius = 8;
            Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 0, 0, 0.8)';
            Chart.defaults.plugins.tooltip.titleColor = '#ffffff';
            Chart.defaults.plugins.tooltip.bodyColor = '#ffffff';
            Chart.defaults.plugins.tooltip.borderColor = '#4a90e2';
            Chart.defaults.plugins.tooltip.borderWidth = 1;

            // ตั้งค่าสำหรับ responsive
            Chart.defaults.maintainAspectRatio = false;
            Chart.defaults.responsive = true;
        }

        // ฟังก์ชันแปลงชื่อเดือนเป็นภาษาท้องถิ่น
        function getLocalizedMonth(monthStr) {
            const months = monthNames[currentLanguage] || monthNames['th'];

            // ถ้าเป็นรูปแบบ "MMM yyyy" เช่น "Jan 2024"
            if (monthStr && monthStr.includes(' ')) {
                const parts = monthStr.split(' ');
                const month = parts[0];
                const year = parts[1];

                // หาตำแหน่งเดือนจากภาษาอังกฤษ
                const englishMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                const monthIndex = englishMonths.findIndex(m => m === month);

                if (monthIndex !== -1) {
                    const localizedMonth = months[monthIndex];
                    return currentLanguage === 'th' ? `${localizedMonth} ${parseInt(year) + 543}` : `${localizedMonth} ${year}`;
                }
            }

            // ถ้าเป็นแค่ชื่อเดือน
            const englishMonths = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            const shortEnglishMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            let monthIndex = englishMonths.findIndex(m => monthStr.includes(m));
            if (monthIndex === -1) {
                monthIndex = shortEnglishMonths.findIndex(m => monthStr.includes(m));
            }

            if (monthIndex !== -1) {
                return months[monthIndex];
            }

            return monthStr; // ถ้าไม่พบให้คืนค่าเดิม
        }

        // ฟังก์ชันแปลงชื่อแผนกเป็นภาษาท้องถิ่น (ถ้าจำเป็น)
        function getLocalizedDepartment(deptName) {
            // สามารถเพิ่มการแปลชื่อแผนกที่นี่ได้หากต้องการ
            if (!deptName || deptName.length > 15) {
                return deptName ? deptName.substring(0, 12) + '...' : deptName;
            }
            return deptName;
        }

        $(document).ready(function () {
            // Clear existing charts
            clearCharts();
            // Set module ID
            $('body').attr('data-module-id', '@ViewBag.ModuleId');
            // Load employee statistics
            loadEmployeeStats();
            // Load leave statistics
            loadLeaveStats();
            // Load cabinet statistics
            loadCabinetStats();
            // Load computer statistics
            loadComputerStats();
            // Load access error statistics
            loadAccessErrorStats();
            // Language handling
            setupLanguageHandling();
            // Add raindrops animation 
            createRaindrops();
            // Setup toggle details functionality
            setupToggleDetails();
            
            // ตรวจสอบและรอให้ DataTable library โหลดเสร็จ
            if (typeof $.fn.DataTable === 'undefined') {
                // ถ้า DataTable ยังไม่โหลด ให้รอ
                const checkDataTable = setInterval(function() {
                    if (typeof $.fn.DataTable !== 'undefined') {
                        clearInterval(checkDataTable);
                        // เริ่มต้น DataTable หลังจาก library โหลดเสร็จ
                        setTimeout(initializePhoneDataTable, 100);
                    }
                }, 100);
            } else {
                // ถ้า DataTable โหลดแล้ว ให้เริ่มต้นทันที
                setTimeout(initializePhoneDataTable, 100);
            }

            // รีเฟรชสถิติตู้ทุก ๆ 30 วินาที
            setInterval(loadCabinetStats, 30000);
            // รีเฟรชสถิติคอมพิวเตอร์ทุก ๆ 30 วินาที
            setInterval(loadComputerStats, 30000);
            // รีเฟรชสถานะผิดพลาดทุก ๆ 60 วินาที
            setInterval(loadAccessErrorStats, 60000);
            // Setup refresh button
            $('#btnRefreshErrors').on('click', function() {
                $(this).find('i').addClass('fa-spin');
                loadAccessErrorStats();
                setTimeout(() => {
                    $(this).find('i').removeClass('fa-spin');
                }, 1000);
            });

            // Setup test connection button
            $('#btnTestConnection').on('click', function() {
                $(this).find('i').addClass('fa-spin');
                testSQL944Connection();
                setTimeout(() => {
                    $(this).find('i').removeClass('fa-spin');
                }, 1000);
            });

            // ฟิลเตอร์/ค้นหา และเปลี่ยนหน้า
            $('#errorSearch').on('input', function(){
                window._accessErrorPage = 1;
                displayAccessErrorStats(applyAccessErrorFilters()); 
            });
            $('#doorFilter, #eventFilter').on('change', function(){
                window._accessErrorPage = 1;
                displayAccessErrorStats(applyAccessErrorFilters());
            });
            $('#btnPrevPage').on('click', function(){
                if (window._accessErrorPage > 1) {
                    window._accessErrorPage--;
                    displayAccessErrorStats(applyAccessErrorFilters());
                }
            });
            $('#btnNextPage').on('click', function(){
                if (window._accessErrorPage < (window._accessErrorTotalPages || 1)) {
                    window._accessErrorPage++;
                    displayAccessErrorStats(applyAccessErrorFilters());
                }
            });
        });


        // ฟังก์ชันเริ่มต้น DataTable สำหรับตารางเบอร์โทรศัพท์
        function initializePhoneDataTable() {
            // ตรวจสอบว่า DataTable library โหลดแล้ว
            if (typeof $.fn.DataTable === 'undefined') {
                console.warn('DataTable library ยังไม่โหลด');
                return;
            }
            
            // ตรวจสอบว่า element phoneTable มีอยู่
            if ($('#phoneTable').length === 0) {
                console.warn('ไม่พบ element phoneTable');
                return;
            }
            
            // ตรวจสอบว่า DataTable ถูกเริ่มต้นแล้วหรือไม่
            if ($.fn.DataTable.isDataTable('#phoneTable')) {
                console.log('DataTable ถูกเริ่มต้นแล้ว');
                window.phoneDataTable = $('#phoneTable').DataTable();
                return;
            }
            
            // เริ่มต้น DataTable พร้อมข้อมูลเริ่มต้น
            try {
                window.phoneDataTable = $('#phoneTable').DataTable({
                    data: [],
                    columns: [
                        { title: '#', width: '60px' },
                        { title: 'CardNumber' },
                        { title: 'ชื่อ' },
                        { title: 'แผนก' },
                        { title: 'เบอร์โทรศัพท์' },
                        { title: 'การจัดการ', width: '160px', orderable: false, searchable: false }
                    ],
                    language: {
                        url: '/js/datatables/i18n/th.json',
                        search: "ค้นหา:",
                        lengthMenu: "แสดง _MENU_ รายการต่อหน้า",
                        info: "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                        infoEmpty: "แสดง 0 ถึง 0 จาก 0 รายการ",
                        infoFiltered: "(กรองจาก _MAX_ รายการทั้งหมด)",
                        paginate: {
                            first: "หน้าแรก",
                            previous: "ก่อนหน้า",
                            next: "ถัดไป",
                            last: "หน้าสุดท้าย"
                        },
                        emptyTable: "ไม่มีข้อมูลในตาราง",
                        zeroRecords: "ไม่พบข้อมูลที่ค้นหา"
                    },
                    responsive: {
                        details: {
                            display: $.fn.dataTable.Responsive.display.modal({
                                header: function(row) {
                                    var data = row.data();
                                    return '<h5 class="modal-title">รายละเอียด: ' + data[2] + '</h5>';
                                }
                            }),
                            renderer: $.fn.dataTable.Responsive.renderer.tableAll({
                                tableClass: 'table table-sm table-bordered'
                            })
                        }
                    },
                    autoWidth: false,
                    dom: '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                         '<"row"<"col-md-12"tr>>' +
                         '<"row mt-3"<"col-md-5"i><"col-md-7"p>>',
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
                    pageLength: 10,
                    order: [[0, 'asc']],
                    columnDefs: [
                        {
                            targets: [0], // คอลัมน์ #
                            className: 'text-center'
                        },
                        {
                            targets: [5], // คอลัมน์การจัดการ
                            className: 'text-center'
                        }
                    ]
                });
                
                console.log('DataTable สำหรับตารางเบอร์โทรศัพท์เริ่มต้นสำเร็จ');
            } catch (error) {
                console.error('เกิดข้อผิดพลาดในการเริ่มต้น DataTable:', error);
            }
        }

        function clearCharts() {
            try {
                // ทำความสะอาด Charts
                if (window.departmentChart && window.departmentChart.destroy) window.departmentChart.destroy();
                if (window.monthlyChart && window.monthlyChart.destroy) window.monthlyChart.destroy();
                if (window.leaveByMonthChart && window.leaveByMonthChart.destroy) window.leaveByMonthChart.destroy();
                if (window.leaveTypeChart && window.leaveTypeChart.destroy) window.leaveTypeChart.destroy();
                if (window.leaveDaysByMonthChart && window.leaveDaysByMonthChart.destroy) window.leaveDaysByMonthChart.destroy();
                if (window.leaveByDepartmentChart && window.leaveByDepartmentChart.destroy) window.leaveByDepartmentChart.destroy();
                if (window.averageLeaveDurationChart && window.averageLeaveDurationChart.destroy) window.averageLeaveDurationChart.destroy();
                if (window.workdayHolidayLeaveChart && window.workdayHolidayLeaveChart.destroy) window.workdayHolidayLeaveChart.destroy();
                if (typeof Chart !== 'undefined' && Chart.getChart) {
                    ['departmentChart', 'monthlyChart', 'leaveByMonthChart', 'leaveTypeChart', 'leaveDaysByMonthChart',
                        'leaveByDepartmentChart', 'averageLeaveDurationChart', 'workdayHolidayLeaveChart'
                    ].forEach(id => {
                        const chart = Chart.getChart(id);
                        if (chart) chart.destroy();
                    });
                }
                
                // ทำความสะอาด DataTable
            } catch (e) {
                console.warn('Chart cleanup warning:', e);
            }
        }

        function loadEmployeeStats() {
            $.ajax({
                url: appBasePath + 'Home/GetEmployeeStats',
                type: 'GET',
                success: function (data) {
                    if (data.success) {
                        updateBasicStats(data);
                        displayRecentResignedEmployees(data.recentResignedEmployees); 
                        displayDepartmentChart(data.departmentStats);
                        displayMonthlyChart(data.monthlyStats);
                        displayStartTodayEmployees(data.startTodayEmployees);
                    }
                },
                error: function () {
                    console.error('Failed to load employee statistics');
                }
            });
        }

        function loadLeaveStats() {
            $.ajax({
                url: appBasePath + 'Leave/GetLeaveStats',
                type: 'GET',
                success: function (data) {
