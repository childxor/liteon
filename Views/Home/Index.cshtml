@{
    ViewData["Title"] = "Welcome to LITEON";
    var username = ViewBag.Username;
    var moduleId = ViewBag.ModuleId;
}

@using IPS_TH.Extensions

<!-- Required Libraries -->
<!-- Font Awesome, jQuery, และ Chart.js ถูกโหลดใน Layout แล้ว -->

<style>
    /* CSS สำหรับปุ่มซ่อน/ขยายรายละเอียด */
    #btnToggleCabinetDetails,
    #btnToggleComputerDetails {
        transition: all 0.3s ease;
        border-radius: 20px;
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        font-weight: 500;
    }

    #btnToggleCabinetDetails:hover,
    #btnToggleComputerDetails:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    #btnToggleCabinetDetails:active,
    #btnToggleComputerDetails:active {
        transform: translateY(0);
    }

    /* Animation สำหรับการซ่อน/ขยาย */
    #cabinetDetailsSection,
    #computerDetailsSection {
        transition: all 0.3s ease-in-out;
    }

    /* ปรับแต่งการ์ดในส่วนรายละเอียด */
    #cabinetDetailsSection .card,
    #computerDetailsSection .card {
        transition: all 0.3s ease;
    }

    #cabinetDetailsSection .card:hover,
    #computerDetailsSection .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
    }

    /* ปรับแต่ง section header */
    .section-header {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
        border-radius: 15px;
        padding: 1rem 1.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* ปรับแต่งปุ่มให้ดูทันสมัย */
    .btn-outline-primary {
        border-color: #3b82f6;
        color: #3b82f6;
    }

    .btn-outline-primary:hover {
        background-color: #3b82f6;
        border-color: #3b82f6;
        color: white;
    }

    .btn-outline-info {
        border-color: #06b6d4;
        color: #06b6d4;
    }

    .btn-outline-info:hover {
        background-color: #06b6d4;
        border-color: #06b6d4;
        color: white;
    }

    /* Animation สำหรับ icon ในปุ่ม */
    #btnToggleCabinetDetails i,
    #btnToggleComputerDetails i {
        transition: transform 0.3s ease;
    }

    #btnToggleCabinetDetails.active i,
    #btnToggleComputerDetails.active i {
        transform: rotate(180deg);
    }
</style>

<!-- Main Container -->
<div class="bg-rainy-gradient min-vh-100">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="text-center text-dark mb-5">
            <img src="~/image/logo-text.png" alt="LITEON" class="img-fluid mb-3" style="max-width: 200px;">
            <h1 class="display-4 fw-bold mb-3 text-rainy-dark">
                <span data-translate="welcome_to">@Context.Session.GetTranslation("welcome_to")</span> LITEON IPS,
                @username! 👋
            </h1>
            <p class="lead text-rainy-muted" data-translate="innovating_future">
                @Context.Session.GetTranslation("innovating_future")
            </p>
        </div>

        <!-- Employee Statistics Section -->
        <div class="stats-section mb-4">
            <div class="section-header mb-3">
                <div class="d-flex align-items-center">
                    <div class="section-icon me-3">
                        <i class="fas fa-users fa-2x text-rainy-primary"></i>
                    </div>
                    <div>
                        <h4 class="section-title mb-1">สรุปข้อมูลพนักงาน</h4>
                        <p class="section-subtitle mb-0">Employee Statistics Overview</p>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fas fa-users fa-lg text-rainy-primary me-2"></i>
                                <span class="badge bg-rainy-primary rounded-pill small">ทั้งหมด</span>
                            </div>
                            <h4 class="fw-bold text-rainy-dark mb-1" id="totalEmployees">0</h4>
                            <p class="card-text text-rainy-muted small mb-0">พนักงานทั้งหมด</p>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-rainy-primary" style="width: 100%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fas fa-user-check fa-lg text-rainy-success me-2"></i>
                                <span class="badge bg-rainy-success rounded-pill small" id="activePercent">0%</span>
                            </div>
                            <h4 class="fw-bold text-rainy-dark mb-1" id="activeEmployees">0</h4>
                            <p class="card-text text-rainy-muted small mb-0">พนักงานปัจจุบัน</p>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-rainy-success" id="activeProgress" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fas fa-user-plus fa-lg text-rainy-warning me-2"></i>
                                <span class="badge bg-rainy-warning rounded-pill small" id="newPercent">0%</span>
                            </div>
                            <h4 class="fw-bold text-rainy-dark mb-1" id="newEmployees">0</h4>
                            <p class="card-text text-rainy-muted small mb-0">พนักงานใหม่เดือนนี้</p>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-rainy-warning" id="newProgress" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fas fa-user-minus fa-lg text-rainy-danger me-2"></i>
                                <span class="badge bg-rainy-danger rounded-pill small" id="resignedPercent">0%</span>
                            </div>
                            <h4 class="fw-bold text-rainy-dark mb-1" id="resignedEmployees">0</h4>
                            <p class="card-text text-rainy-muted small mb-0">ลาออกเดือนนี้</p>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar bg-rainy-danger" id="resignedProgress" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Phone List Section (SQL944) -->
        <div class="stats-section mb-4" id="phoneListSection" style="display: none;">
            <div class="section-header mb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="section-icon me-3">
                            <i class="fas fa-phone fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h4 class="section-title mb-1">รายชื่อที่มีเบอร์โทรศัพท์</h4>
                            <p class="section-subtitle mb-0">เบอร์โทรศัพท์ที่มีอยู่ในระบบเป็นเบอร์โต๊ะทำงาน</p>
                        </div>
                    </div>
                    <span class="badge bg-primary"><i class="fas fa-phone me-1"></i><span id="phoneCount">0 รายการ</span></span>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="border rounded p-3 mb-3 bg-light">
                        <div class="row g-2 align-items-end"> 
                            <div class="col-md-4">
                                <label class="form-label mb-1"><i class="fas fa-id-badge me-1 text-secondary"></i>ค้นหา/เพิ่มเบอร์ (PersonID)</label>
                                <input type="text" class="form-control" id="inputFindPersonId" placeholder="เช่น 10129029">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label mb-1"><i class="fas fa-phone me-1 text-secondary"></i>เบอร์โทรศัพท์โต๊ะทำงาน</label>
                                <input type="text" class="form-control" id="inputPhoneValue" placeholder="เช่น 344" disabled>
                            </div>
                            <div class="col-md-5">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-primary" id="btnFindPerson"><i class="fas fa-user-search me-1"></i>ค้นหา</button>
                                    <button type="button" class="btn btn-primary" id="btnSavePhone" disabled><i class="fas fa-save me-1"></i>บันทึกเบอร์</button>
                                    <button type="button" class="btn btn-outline-secondary" id="btnClearForm"><i class="fas fa-undo me-1"></i>ล้างฟอร์ม</button>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3" id="personResult" style="display:none;">
                            <div class="alert alert-info mb-0 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div><i class="fas fa-user me-1 text-secondary"></i><strong>ชื่อ:</strong> <span id="resultName">-</span> <span class="text-muted">(<span id="resultPersonId">-</span>)</span></div>
                                        <div class="small text-muted"><i class="fas fa-building me-1"></i><strong>แผนก:</strong> <span id="resultDept">-</span> | <i class="fas fa-id-card me-1"></i><strong>Card:</strong> <span id="resultCard">-</span></div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnOpenEditModal" style="display:none;"><i class="fas fa-pen me-1"></i>แก้ไขในหน้าต่าง</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <div id="phoneTableLoading" class="text-center py-4" style="display: none;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลด...</span>
                            </div>
                            <p class="mt-2 text-muted">กำลังโหลดข้อมูลเบอร์โทรศัพท์...</p>
                        </div>
                        <div id="phoneTableError" class="text-center py-4" style="display: none;">
                            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-2"></i>
                            <p class="text-muted">เกิดข้อผิดพลาดในการโหลดข้อมูล</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="loadPhoneList()">
                                <i class="fas fa-redo me-1"></i>ลองใหม่
                            </button>
                        </div>
                        <table class="table table-sm table-striped align-middle datatable" id="phoneTable" style="width: 100%">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;"><i class="fas fa-hashtag me-1 text-secondary"></i>#</th>
                                    <th><i class="fas fa-id-card me-1 text-secondary"></i>CardNumber</th>
                                    <th><i class="fas fa-user me-1 text-secondary"></i>ชื่อ</th>
                                    <th><i class="fas fa-building me-1 text-secondary"></i>แผนก</th>
                                    <th><i class="fas fa-phone me-1 text-secondary"></i>เบอร์โทรศัพท์</th>
                                    <th style="width: 160px;"><i class="fas fa-sliders-h me-1 text-secondary"></i>การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody id="phoneTableBody">
                                <!-- ข้อมูลจะถูกโหลดผ่าน DataTable -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (function(){
                function renderPhoneTable(list){
                    // ตรวจสอบว่า DataTable ถูกสร้างแล้วหรือไม่
                    if (!window.phoneDataTable || !window.phoneDataTable.clear) {
                        console.warn('DataTable ยังไม่เริ่มต้น');
                        return;
                    }
                    
                    if(!list || list.length === 0){
                        // ล้างข้อมูลใน DataTable
                        window.phoneDataTable.clear().draw();
                        document.getElementById('phoneCount').textContent = '0 รายการ';
                        return;
                    }
                    
                    // สร้างข้อมูลสำหรับ DataTable
                    const tableData = list.map((x, idx) => [
                        (idx + 1).toString(),
                        (x.cardNumber || '-'),
                        (x.name || '-'),
                        (x.deptName || '-'),
                        (x.phone || '-'),
                        `<div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary btn-edit-phone" data-person="${x.personID || ''}" data-name="${x.name || ''}" data-dept="${x.deptName || ''}" data-phone="${x.phone || ''}">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-clear-phone" data-person="${x.personID || ''}" data-name="${x.name || ''}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>`
                    ]);
                    
                    try {
                        // อัปเดตข้อมูลใน DataTable
                        window.phoneDataTable.clear().rows.add(tableData).draw();
                        
                        // อัปเดตจำนวนรายการ
                        document.getElementById('phoneCount').textContent = (list.length || 0) + ' รายการ';
                    } catch (error) {
                        console.error('เกิดข้อผิดพลาดในการอัปเดต DataTable:', error);
                        // ลองเริ่มต้น DataTable ใหม่
                        if (window.phoneDataTable && window.phoneDataTable.destroy) {
                            window.phoneDataTable.destroy();
                            window.phoneDataTable = null;
                        }
                        initializePhoneDataTable();
                        // ลองอัปเดตข้อมูลอีกครั้ง
                        setTimeout(() => {
                            if (window.phoneDataTable && window.phoneDataTable.clear) {
                                window.phoneDataTable.clear().rows.add(tableData).draw();
                                document.getElementById('phoneCount').textContent = (list.length || 0) + ' รายการ';
                            }
                        }, 100);
                    }
                }

                function loadPhoneList(){
                    const section = document.getElementById('phoneListSection');
                    const loadingEl = document.getElementById('phoneTableLoading');
                    const errorEl = document.getElementById('phoneTableError');
                    const tableEl = document.getElementById('phoneTable');
                    
                    // แสดง section ก่อน
                    if(section) section.style.display = '';
                    
                    // แสดง loading state
                    if(loadingEl) loadingEl.style.display = '';
                    if(errorEl) errorEl.style.display = 'none';
                    if(tableEl) tableEl.style.display = 'none';
                    
                    // ตรวจสอบว่า DataTable เริ่มต้นแล้วหรือไม่
                    if (!window.phoneDataTable || !window.phoneDataTable.clear) {
                        console.warn('DataTable ยังไม่เริ่มต้น กำลังรอ...');
                        // รอให้ DataTable เริ่มต้นแล้วค่อยโหลดข้อมูล
                        setTimeout(loadPhoneList, 500);
                        return;
                    }
                    
                    fetch((window.appBasePath || '') + 'Home/GetPhoneList')
                        .then(r => r.json())
                        .then(res => {
                            // ซ่อน loading state
                            if(loadingEl) loadingEl.style.display = 'none';
                            if(tableEl) tableEl.style.display = '';
                            
                            if(res && res.success){
                                renderPhoneTable(res.data || []);
                            } else {
                                renderPhoneTable([]);
                            }
                        })
                        .catch((error) => {
                            console.error('เกิดข้อผิดพลาดในการโหลดข้อมูลเบอร์โทรศัพท์:', error);
                            
                            // ซ่อน loading state และแสดง error state
                            if(loadingEl) loadingEl.style.display = 'none';
                            if(errorEl) errorEl.style.display = '';
                            if(tableEl) tableEl.style.display = 'none';
                        });
                }

                document.addEventListener('DOMContentLoaded', function(){
                    // โหลดข้อมูลครั้งแรก และแคชไว้
                    const originalRender = renderPhoneTable;
                    window.renderPhoneTable = function(list){
                        window._phoneCache = Array.isArray(list) ? list : [];
                        originalRender(window._phoneCache);
                    };
                    loadPhoneList();

                    // ค้นหา/เพิ่มเบอร์ ด้วย PersonID (ถ้าไม่พบจะลองเติม -2 ฝั่งเซิร์ฟเวอร์)
                    const btnFind = document.getElementById('btnFindPerson');
                    const btnSave = document.getElementById('btnSavePhone');
                    const btnClear = document.getElementById('btnClearForm');
                    const inputPid = document.getElementById('inputFindPersonId');
                    const inputPhone = document.getElementById('inputPhoneValue');
                    const personResult = document.getElementById('personResult');
                    const resultName = document.getElementById('resultName');
                    const resultPersonId = document.getElementById('resultPersonId');
                    const resultDept = document.getElementById('resultDept');
                    const resultCard = document.getElementById('resultCard');
                    const btnOpenEditModal = document.getElementById('btnOpenEditModal');

                    function resetForm(){
                        inputPid.value = '';
                        inputPhone.value = '';
                        inputPhone.disabled = true;
                        btnSave.disabled = true;
                        personResult.style.display = 'none';
                        btnOpenEditModal.style.display = 'none';
                    }
                    if(btnClear){ btnClear.addEventListener('click', resetForm); }

                    if(btnFind){
                        btnFind.addEventListener('click', function(){
                            const pid = (inputPid.value || '').trim();
                            if(!pid){
                                Swal.fire({ icon: 'warning', title: 'กรุณาระบุ PersonID', timer: 1500, showConfirmButton: false });
                                return;
                            }
                            fetch((window.appBasePath || '') + 'Home/FindPersonForPhone?personId=' + encodeURIComponent(pid))
                                .then(r => r.json())
                                .then(res => {
                                    if(res && res.success){
                                        const d = res.data || {};
                                        resultName.textContent = d.name || '-';
                                        resultPersonId.textContent = d.personID || pid;
                                        resultDept.textContent = d.deptName || '-';
                                        resultCard.textContent = d.cardNumber || '-';
                                        inputPhone.value = d.phone || '';
                                        inputPhone.disabled = false;
                                        btnSave.disabled = false;
                                        personResult.style.display = '';
                                        btnOpenEditModal.style.display = '';
                                        btnOpenEditModal.onclick = function(){
                                            openEditModal(d.personID || pid, d.name || '-', d.deptName || '-', d.phone || '');
                                        };
                                    } else {
                                        Swal.fire({ icon: 'warning', title: 'ไม่พบชื่อ', timer: 1500, showConfirmButton: false });
                                        resetForm();
                                    }
                                })
                                .catch(() => { Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาดในการค้นหา', timer: 1800, showConfirmButton: false }); });
                        });
                    }

                    if(btnSave){
                        btnSave.addEventListener('click', function(){
                            const pidShown = resultPersonId.textContent || (inputPid.value || '').trim();
                            const phoneVal = inputPhone.value || '';
                            if(!pidShown){ Swal.fire({ icon: 'warning', title: 'ไม่พบ PersonID', timer: 1500, showConfirmButton: false }); return; }
                            fetch((window.appBasePath || '') + 'Home/UpdatePhone', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ personId: pidShown, phone: phoneVal })
                            })
                            .then(r => r.json())
                            .then(res => {
                                if(res && res.success){
                                    loadPhoneList();
                                    Swal.fire({ icon: 'success', title: 'บันทึกสำเร็จ', timer: 1500, showConfirmButton: false });
                                } else {
                                    Swal.fire({ icon: 'error', title: res?.message || 'บันทึกไม่สำเร็จ', timer: 1800, showConfirmButton: false });
                                }
                            })
                            .catch(() => Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาดในการบันทึก', timer: 1800, showConfirmButton: false }));
                        });
                    }

                    // Modal แก้ไข และยืนยันลบ
                    const editModalEl = document.getElementById('editPhoneModal');
                    const editModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;
                    const editPid = document.getElementById('editPersonId');
                    const editName = document.getElementById('editName');
                    const editDept = document.getElementById('editDept');
                    const editPhone = document.getElementById('editPhone');
                    const btnEditSave = document.getElementById('btnEditSave');

                    window.openEditModal = function(personId, name, dept, phone){
                        if(!editModal) return;
                        editPid.value = personId || '';
                        editName.textContent = name || '-';
                        editDept.textContent = dept || '-';
                        editPhone.value = phone || '';
                        editModal.show();
                    }

                    if(btnEditSave){
                        btnEditSave.addEventListener('click', function(){
                            const pid = editPid.value || '';
                            const phoneVal = editPhone.value || '';
                            fetch((window.appBasePath || '') + 'Home/UpdatePhone', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ personId: pid, phone: phoneVal })
                            })
                            .then(r => r.json())
                            .then(res => {
                                if(res && res.success){
                                    editModal.hide();
                                    loadPhoneList();
                                    Swal.fire({ icon: 'success', title: 'บันทึกสำเร็จ', timer: 1500, showConfirmButton: false });
                                } else {
                                    Swal.fire({ icon: 'error', title: res?.message || 'บันทึกไม่สำเร็จ', timer: 1800, showConfirmButton: false });
                                }
                            })
                            .catch(() => Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาดในการบันทึก', timer: 1800, showConfirmButton: false }));
                        });
                    }

                    const clearModalEl = document.getElementById('confirmClearModal');
                    const clearModal = clearModalEl ? new bootstrap.Modal(clearModalEl) : null;
                    const clearPid = document.getElementById('clearPersonId');
                    const clearName = document.getElementById('clearName');
                    const btnClearConfirm = document.getElementById('btnClearConfirm');

                    function openClearModal(personId, name){
                        if(!clearModal) return;
                        clearPid.value = personId || '';
                        clearName.textContent = name || '-';
                        clearModal.show();
                    }

                    if(btnClearConfirm){
                        btnClearConfirm.addEventListener('click', function(){
                            const pid = clearPid.value || '';
                            fetch((window.appBasePath || '') + 'Home/ClearPhone', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ personId: pid })
                            })
                            .then(r => r.json())
                            .then(res => {
                                if(res && res.success){
                                    clearModal.hide();
                                    loadPhoneList();
                                    Swal.fire({ icon: 'success', title: 'ลบสำเร็จ', timer: 1500, showConfirmButton: false });
                                } else {
                                    Swal.fire({ icon: 'error', title: res?.message || 'ลบไม่สำเร็จ', timer: 1800, showConfirmButton: false });
                                }
                            })
                            .catch(() => Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาดในการลบ', timer: 1800, showConfirmButton: false }));
                        });
                    }

                    // ปุ่มแก้ไข/ลบ ในตาราง (Event Delegation สำหรับ DataTable)
                    $(document).on('click', '#phoneTable .btn-edit-phone', function(e){
                        e.preventDefault();
                        const pid = $(this).data('person') || '';
                        const name = $(this).data('name') || '';
                        const dept = $(this).data('dept') || '';
                        const phone = $(this).data('phone') || '';
                        openEditModal(pid, name, dept, phone);
                    });
                    
                    $(document).on('click', '#phoneTable .btn-clear-phone', function(e){
                        e.preventDefault();
                        const pid = $(this).data('person') || '';
                        const name = $(this).data('name') || '';
                        openClearModal(pid, name);
                    });
                });
            })();
        </script>

