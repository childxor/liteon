        // สร้างตัวเลือกกรองจากข้อมูลล่าสุด
        function buildFilterOptions(data) {
            const doors = [...new Set(data.map(x => (x.doorName || x.deviceName || '').toString()).filter(Boolean))].sort();
            const events = [...new Set(data.map(x => (x.eventName || x.eventCode || '').toString()).filter(Boolean))].sort();

            const $door = $('#doorFilter');
            const $event = $('#eventFilter');
            $door.find('option:not(:first)').remove();
            $event.find('option:not(:first)').remove();
            doors.forEach(d => $door.append(`<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`));
            events.forEach(e => $event.append(`<option value="${escapeHtml(e)}">${escapeHtml(e)}</option>`));
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // นำ filter มาใช้กับ cache และแบ่งหน้า
        function applyAccessErrorFilters() {
            const query = ($('#errorSearch').val() || '').toString().toLowerCase();
            const door = ($('#doorFilter').val() || '').toString();
            const evt = ($('#eventFilter').val() || '').toString();
            const source = Array.isArray(window._accessErrorCache) ? window._accessErrorCache : [];

            let filtered = source.filter(item => {
                const text = [
                    item.eventCard,
                    item.personNameFromCard || item.personName,
                    item.personDeptName || item.deptName,
                    item.doorName || item.deviceName,
                    item.eventName || item.eventCode
                ].map(v => (v || '').toString().toLowerCase()).join(' ');

                const doorMatch = !door || (item.doorName || item.deviceName || '') === door;
                const eventMatch = !evt || (item.eventName || item.eventCode || '') === evt;
                const textMatch = !query || text.includes(query);
                return doorMatch && eventMatch && textMatch;
            });

            // Pagination
            const pageSize = 10;
            const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
            window._accessErrorTotalPages = totalPages;
            if (!window._accessErrorPage || window._accessErrorPage < 1) window._accessErrorPage = 1;
            if (window._accessErrorPage > totalPages) window._accessErrorPage = totalPages;
            const start = (window._accessErrorPage - 1) * pageSize;
            const pageData = filtered.slice(start, start + pageSize);
            $('#pageInfo').text(`${window._accessErrorPage}/${totalPages}`);
            return pageData;
        }

