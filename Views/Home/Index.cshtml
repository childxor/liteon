    function setupLanguageHandling() {
        function updateLanguageText() {
            const currentLang = '@Context.Session.GetCurrentLanguage()';
            const langTexts = {
                'th': '@Context.Session.GetTranslation("thai_language")',
                'en': '@Context.Session.GetTranslation("english_language")',
                'zh': '@Context.Session.GetTranslation("chinese_language")'
            };
            $('#currentLanguage').text(langTexts[currentLang] || '@Context.Session.GetTranslation("language")');
        }
        updateLanguageText();
        $('.language-select').on('click', function(e) {
            e.preventDefault();
            const lang = $(this).data('lang');
            $('#currentLanguage').html('<i class="fas fa-spinner fa-spin"></i>');
            $.ajax({
                url: '@Url.Action("ChangeLanguage", "Home")',
                type: 'POST',
                data: {
                    lang: lang
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        showError('@Context.Session.GetTranslation("cannot_change_language")');
                    }
                },
                error: function() {
                    showError('@Context.Session.GetTranslation("cannot_connect_server")');
                }
            });
        });
    }

    function showError(message) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'error',
                title: '@Context.Session.GetTranslation("error_occurred")',
                text: message,
                confirmButtonText: '@Context.Session.GetTranslation("ok")'
            });
        } else {
            alert(message);
        }
    }
    // Add raindrops animation
    function createRaindrops() {
        const container = document.getElementById('raindrops');
        const count = 50;
        for (let i = 0; i < count; i++) {
            const raindrop = document.createElement('div');
            raindrop.className = 'raindrop';
            raindrop.style.left = `${Math.random() * 100}%`;
            raindrop.style.animationDelay = `${Math.random() * 1}s`;
            raindrop.style.opacity = Math.random() * 0.5;
            container.appendChild(raindrop);
        }
    }

    function loadFeedbackList() {
        $.get('@Url.Action("GetFeedbackList", "Home")', function(res) {
            if (res.success) {
                let html = '';
                res.data.forEach(fb => {
                    const isLiked = res.likes.some(like => 
                        like.feedbackid === fb.id && 
                        like.username === '@ViewBag.username' && 
                        like.status === 'like'
                    );
                    
                    html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="card-title mb-1">${fb.isanonymous ? '@Context.Session.GetTranslation("anonymous")' : (fb.username || '')}</h6>
                                        <small class="text-rainy-muted">${fb.department || ''}</small>
                                    </div>
                                    <span class="badge bg-rainy-primary">${fb.type}</span>
                                </div>
                                <p class="card-text">${fb.content}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="btn-group">
                                        <button class="btn btn-sm ${isLiked ? 'btn-rainy-primary active' : 'btn-outline-rainy-primary'} btn-like" data-id="${fb.id}">
                                            <i class="fas fa-thumbs-up me-1"></i> ${fb.likecount}
                                        </button>
                                        <button class="btn btn-sm btn-outline-rainy-secondary btn-comment" data-id="${fb.id}">
                                            <i class="fas fa-comment me-1"></i> ${fb.commentcount}
                                        </button>
                                    </div>
                                    <small class="text-rainy-muted">${fb.createdat ? fb.createdat.split('T')[0] : ''}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    `;
                });
                $('#feedbackList').html(html);
            }
        });
    }

    // เพิ่ม function สำหรับโหลดข้อมูลวันหยุด
    function loadUpcomingHolidays() {
        $.get('@Url.Action("GetUpcomingHolidays", "Home")', function(res) {
            if (res.success) {
                const container = $('#upcomingHolidays');
                if (res.holidays && res.holidays.length > 0) {
                    let html = '';
                    res.holidays.forEach(holiday => {
                        const daysUntil = holiday.daysUntil;
                        const badgeClass = daysUntil <= 7 ? 'bg-rainy-danger' : 
                                         daysUntil <= 14 ? 'bg-rainy-warning' : 
                                         'bg-rainy-primary';
                        
                        html += `
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0">${holiday.holidayName}</h6>
                                        <span class="badge ${badgeClass}">
                                            ${daysUntil === 0 ? '@Context.Session.GetTranslation("today")' : 
                                              daysUntil === 1 ? '@Context.Session.GetTranslation("tomorrow")' : 
                                              `${daysUntil} @Context.Session.GetTranslation("days")`}
                                        </span>
                                    </div>
                                    <p class="card-text text-rainy-muted mb-2">
                                        <i class="fas fa-calendar me-2"></i>
                                        ${holiday.holidayDate}
                                    </p>
                                    <p class="card-text small text-rainy-muted">
                                        <i class="fas fa-info-circle me-2"></i>
                                        ${holiday.description || '@Context.Session.GetTranslation("annual_holiday")'}
                                    </p>
                                </div>
                            </div>
                        </div>
                        `;
                    });
                    container.html(html);
                } else {
                    container.html(`
                        <div class="col-12 text-center text-rainy-muted">
                            <i class="fas fa-calendar-times me-2"></i>
                            @Context.Session.GetTranslation("no_upcoming_holidays")
                        </div>
                    `);
                }
            }
        });
    }
</script>
