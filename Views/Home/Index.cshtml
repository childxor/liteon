@{
ViewData["Title"] = "Welcome to LITEON";
var username = ViewBag.Username;
var moduleId = ViewBag.ModuleId;
}

@using IPS_TH.Extensions 

<!-- Required Libraries -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Main Container -->
<div class="bg-rainy-gradient min-vh-100">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="text-center text-dark mb-5">
            <img src="/image/logo-text.png" alt="LITEON" class="img-fluid mb-3" style="max-width: 200px;">
            <h1 class="display-4 fw-bold mb-3 text-rainy-dark">
                <span data-translate="welcome_to">@Context.Session.GetTranslation("welcome_to")</span> LITEON IPS,
                @username! 👋
            </h1>
            <p class="lead text-rainy-muted" data-translate="innovating_future">
                @Context.Session.GetTranslation("innovating_future")
            </p>
        </div>

        <!-- Stats Cards Row -->
        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-2x mb-3 text-rainy-primary"></i>
                        <h3 class="display-6 fw-bold text-rainy-dark" id="totalEmployees">0</h3>
                        <p class="card-text text-rainy-muted" data-translate="total_employees">
                            @Context.Session.GetTranslation("total_employees")</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-check fa-2x mb-3 text-rainy-success"></i>
                        <h3 class="display-6 fw-bold text-rainy-dark" id="activeEmployees">0</h3>
                        <p class="card-text text-rainy-muted" data-translate="current_employees">
                            @Context.Session.GetTranslation("current_employees")</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-plus fa-2x mb-3 text-rainy-warning"></i>
                        <h3 class="display-6 fw-bold text-rainy-dark" id="newEmployees">0</h3>
                        <p class="card-text text-rainy-muted" data-translate="new_employees_month">
                            @Context.Session.GetTranslation("new_employees_month")</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-minus fa-2x mb-3 text-rainy-danger"></i>
                        <h3 class="display-6 fw-bold text-rainy-dark" id="resignedEmployees">0</h3>
                        <p class="card-text text-rainy-muted" data-translate="resigned_employees_month">
                            @Context.Session.GetTranslation("resigned_employees_month")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cabinet Stats Cards Row -->
        <div class="mb-5" id="cabinetStatsContainer" style="display: none;">
            <!-- แถวที่ 1: สถิติตู้ -->
            <div class="row g-3 mb-3">
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-archive fa-2x mb-3 text-rainy-primary"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="totalCabinets">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="total_cabinets">@Context.Session.GetTranslation("total_cabinets")</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-check-circle fa-2x mb-3 text-rainy-success"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="availableCabinets">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="available_cabinets">@Context.Session.GetTranslation("available_cabinets")</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-user-check fa-2x mb-3 text-primary"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="occupiedCabinets">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="occupied_cabinets">@Context.Session.GetTranslation("occupied_cabinets")</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3 text-rainy-warning"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="damagedCabinets">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="damaged_cabinets">@Context.Session.GetTranslation("damaged_cabinets")</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- แถวที่ 2: สถิติพิเศษ -->
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100 border-warning">
                        <div class="card-body text-center">
                            <i class="fas fa-user-times fa-2x mb-3 text-rainy-danger"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="resignedOwnedCabinets">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="cabinets_to_return">@Context.Session.GetTranslation("cabinets_to_return")<br/><small class="text-warning" data-translate="owner_resigned">(@Context.Session.GetTranslation("owner_resigned"))</small></p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100 border-info">
                        <div class="card-body text-center">
                            <i class="fas fa-user-plus fa-2x mb-3 text-rainy-primary"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="employeesWithoutCabinet">0</h3>
                            <p class="card-text text-rainy-muted small" data-translate="employees_without_cabinet">@Context.Session.GetTranslation("employees_without_cabinet")<br/><small class="text-info" data-translate="still_working">(@Context.Session.GetTranslation("still_working"))</small></p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-percentage fa-2x mb-3 text-rainy-secondary"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="utilizationRate">0%</h3>
                            <p class="card-text text-rainy-muted small" data-translate="utilization_rate">@Context.Session.GetTranslation("utilization_rate")</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="card shadow-rainy border-0 h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-users-cog fa-2x mb-3 text-rainy-primary"></i>
                            <h3 class="display-6 fw-bold text-rainy-dark" id="cabinetCoverage">0%</h3>
                            <p class="card-text text-rainy-muted small" data-translate="coverage_rate">@Context.Session.GetTranslation("coverage_rate")<br/><small class="text-muted" data-translate="employees_with_cabinets">(@Context.Session.GetTranslation("employees_with_cabinets"))</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Holidays Section -->
        <div class="row mt-4 mb-4">
            <div class="col-12">
                <div class="card shadow-rainy border-0">
                    <div class="card-header bg-rainy-light border-bottom">
                        <h5 class="card-title mb-0 text-rainy-dark" data-translate="upcoming_holidays">
                            <i class="fas fa-calendar-alt me-2 text-rainy-warning"></i>
                            @Context.Session.GetTranslation("upcoming_holidays") 
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="upcomingHolidays" class="row g-3">
                            <div class="col-12 text-center text-rainy-muted">
                                <i class="fas fa-spinner fa-spin me-2"></i> <span data-translate="loading_data">@Context.Session.GetTranslation("loading_data")</span>...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feedback Board Section -->
        <div class="row mb-5">
            <!-- กระดานความคิดเห็น -->
            <div class="col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div
                        class="card-header bg-rainy-light border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 text-rainy-dark" data-translate="feedback_board">
                            <i class="fas fa-comments me-2 text-rainy-primary"></i>
                            @Context.Session.GetTranslation("feedback_board")
                        </h5>
                        <button type="button" class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#feedbackModal"
                            style="background: linear-gradient(45deg, #4a90e2, #5cb3ff); color: white; border: none; box-shadow: 0 2px 4px rgba(74, 144, 226, 0.2);"
                            data-translate="add_feedback">
                            <i class="fas fa-plus me-1"></i> @Context.Session.GetTranslation("add_feedback")
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-4" id="feedbackList"></div>
                    </div>
                </div>
            </div>

            <!-- ข่าวประกาศ -->
            <div class="col-md-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div
                        class="card-header bg-rainy-light border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 text-rainy-dark" data-translate="announcement">
                            <i class="fas fa-bullhorn me-2 text-rainy-warning"></i>
                            @Context.Session.GetTranslation("announcement")
                        </h5>
                        @if (ViewBag.IsAdmin == "true")
                        {
                            <button type="button" class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#announcementModal" 
                                style="background: linear-gradient(45deg, #f59e0b, #fbbf24); color: white; border: none; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.2);"
                                data-translate="add_announcement">
                                <i class="fas fa-plus me-1"></i> @Context.Session.GetTranslation("add_announcement")
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row g-4" id="announcementList">
                            <!-- ตัวอย่างข่าวประกาศ -->
                            <div class="col-12 d-none">
                                <div class="card border-0 shadow-sm mb-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="card-title mb-1" data-translate="annual_holiday_announcement">@Context.Session.GetTranslation("annual_holiday_announcement")</h6>
                                                <small class="text-rainy-muted" data-translate="hr_department">@Context.Session.GetTranslation("hr_department")</small>
                                            </div>
                                            <span class="badge bg-rainy-warning" data-translate="important">@Context.Session.GetTranslation("important")</span>
                                        </div>
                                        <p class="card-text" data-translate="holiday_announcement_content">@Context.Session.GetTranslation("holiday_announcement_content")</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <small class="text-rainy-muted">15 มี.ค. 2567</small>
                                            <button class="btn btn-sm btn-outline-rainy-warning">
                                                <i class="fas fa-eye me-1"></i> <span data-translate="read_more">@Context.Session.GetTranslation("read_more")</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feedback Modal -->
        <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-rainy-light">
                        <h5 class="modal-title" id="feedbackModalLabel">
                            <i class="fas fa-comment-dots me-2 text-rainy-primary"></i>
                            <span data-translate="add_new_feedback">@Context.Session.GetTranslation("add_new_feedback")</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="feedbackForm">
                            <div class="mb-3">
                                <label for="feedbackType" class="form-label" data-translate="feedback_type">@Context.Session.GetTranslation("feedback_type")</label>
                                <select class="form-select" id="feedbackType" required>
                                    <option value="" data-translate="select_feedback_type">@Context.Session.GetTranslation("select_feedback_type")</option>
                                    <option value="feature">Feature Request</option>
                                    <option value="bug">Bug Report</option>
                                    <option value="improvement">Improvement</option>
                                    <option value="other" data-translate="other">@Context.Session.GetTranslation("other")</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="feedbackTitle" class="form-label" data-translate="title">@Context.Session.GetTranslation("title")</label>
                                <input type="text" class="form-control" id="feedbackTitle" required>
                            </div>
                            <div class="mb-3">
                                <label for="feedbackContent" class="form-label" data-translate="details">@Context.Session.GetTranslation("details")</label>
                                <textarea class="form-control" id="feedbackContent" rows="4" required></textarea>
                            </div>
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="anonymousFeedback">
                                    <label class="form-check-label" for="anonymousFeedback" data-translate="send_anonymous_feedback">
                                        @Context.Session.GetTranslation("send_anonymous_feedback")
                                    </label>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-rainy-secondary" data-bs-dismiss="modal" data-translate="cancel">@Context.Session.GetTranslation("cancel")</button>
                        <button type="button" class="btn btn-rainy-primary" id="submitFeedback">
                            <i class="fas fa-paper-plane me-1"></i> <span data-translate="send_feedback">@Context.Session.GetTranslation("send_feedback")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Announcement Modal -->
        <div class="modal fade" id="announcementModal" tabindex="-1" aria-labelledby="announcementModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-rainy-light">
                        <h5 class="modal-title" id="announcementModalLabel">
                            <i class="fas fa-bullhorn me-2 text-rainy-warning"></i>
                            <span data-translate="add_new_announcement">@Context.Session.GetTranslation("add_new_announcement")</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="announcementForm">
                            <div class="mb-3">
                                <label for="announcementTitle" class="form-label" data-translate="announcement_title">@Context.Session.GetTranslation("announcement_title")</label>
                                <input type="text" class="form-control" id="announcementTitle" required>
                            </div>
                            <div class="mb-3">
                                <label for="announcementContent" class="form-label" data-translate="details">@Context.Session.GetTranslation("details")</label>
                                <textarea class="form-control" id="announcementContent" rows="4" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="announcementDepartment" class="form-label" data-translate="announcing_department">@Context.Session.GetTranslation("announcing_department")</label>
                                <select class="form-select" id="announcementDepartment" required>
                                    <option value="" data-translate="select_department">@Context.Session.GetTranslation("select_department")</option>
                                    <option value="hr" data-translate="hr_department">@Context.Session.GetTranslation("hr_department")</option>
                                    <option value="it" data-translate="it_department">@Context.Session.GetTranslation("it_department")</option>
                                    <option value="admin" data-translate="admin_department">@Context.Session.GetTranslation("admin_department")</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="announcementPriority" class="form-label" data-translate="importance">@Context.Session.GetTranslation("importance")</label>
                                <select class="form-select" id="announcementPriority" required>
                                    <option value="normal" data-translate="normal">@Context.Session.GetTranslation("normal")</option>
                                    <option value="important" data-translate="important">@Context.Session.GetTranslation("important")</option>
                                    <option value="urgent" data-translate="urgent">@Context.Session.GetTranslation("urgent")</option>
                                </select>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-rainy-secondary" data-bs-dismiss="modal" data-translate="cancel">@Context.Session.GetTranslation("cancel")</button>
                        <button type="button" class="btn btn-rainy-warning" id="submitAnnouncement">
                            <i class="fas fa-paper-plane me-1"></i> <span data-translate="announce">@Context.Session.GetTranslation("announce")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-5">
            <div class="col-xl-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-header bg-rainy-light border-bottom">
                        <h5 class="card-title mb-0 text-rainy-dark">
                            <i class="fas fa-chart-bar me-2 text-rainy-primary"></i>
                            <span
                                data-translate="department_stats">@Context.Session.GetTranslation("department_stats")</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px;">
                            <canvas id="departmentChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card shadow-rainy border-0 h-100">
                    <div class="card-header bg-rainy-light border-bottom">
                        <h5 class="card-title mb-0 text-rainy-dark">
                            <i class="fas fa-chart-line me-2 text-rainy-primary"></i>
                            <span
                                data-translate="monthly_in_out_stats">@Context.Session.GetTranslation("monthly_in_out_stats")</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px;">
                            <canvas id="monthlyChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leave Statistics Section -->
        <div class="row g-4 mb-5">
            <div class="col-12">
                <div class="card shadow-rainy border-0">
                    <div class="card-header bg-rainy-light border-bottom">
                        <h5 class="card-title mb-0 text-rainy-dark">
                            <i class="fas fa-calendar-alt me-2 text-rainy-primary"></i>
                            <span data-translate="leave_statistics">@Context.Session.GetTranslation("leave_statistics")</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <!-- กราฟแสดงจำนวนการลาต่อเดือน -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-chart-line me-1"></i>
                                            <span data-translate="leave_count_per_month">@Context.Session.GetTranslation("leave_count_per_month")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="leaveByMonthChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- กราฟแสดงประเภทการลาที่ใช้บ่อย -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-chart-pie me-1"></i>
                                            <span data-translate="popular_leave_types">@Context.Session.GetTranslation("popular_leave_types")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="leaveTypeChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- กราฟแสดงจำนวนวันลาต่อเดือน -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            <span data-translate="leave_days_per_month">@Context.Session.GetTranslation("leave_days_per_month")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="leaveDaysByMonthChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- กราฟแสดงสัดส่วนการลาแยกตามแผนก -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-building me-1"></i>
                                            <span data-translate="leave_ratio_by_department">@Context.Session.GetTranslation("leave_ratio_by_department")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="leaveByDepartmentChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- กราฟแสดงระยะเวลาการลาเฉลี่ยต่อครั้ง -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-hourglass-half me-1"></i>
                                            <span data-translate="average_leave_duration">@Context.Session.GetTranslation("average_leave_duration")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="averageLeaveDurationChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- กราฟแสดงการลาในช่วงวันหยุด/วันทำงาน -->
                            <div class="col-xl-6">
                                <div class="card border-0 shadow-rainy h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title text-rainy-primary mb-2 small">
                                            <i class="fas fa-calendar-check me-1"></i>
                                            <span data-translate="leave_workday_holiday">@Context.Session.GetTranslation("leave_workday_holiday")</span>
                                        </h6>
                                        <div style="height: 200px; position: relative;">
                                            <canvas id="workdayHolidayLeaveChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Start Today Employees Section (Dynamic) -->
        <div id="startTodayEmployeesSection" style="display: none;">
            <!-- Content will be populated by JavaScript -->
        </div>

        <!-- Recent Resigned Employees Section -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-rainy border-0">
                    <div class="card-header bg-rainy-light border-bottom">
                        <h5 class="card-title mb-0 text-rainy-dark">
                            <i class="fas fa-user-times me-2 text-rainy-danger"></i>
                            <span data-translate="recent_resigned_employees">@Context.Session.GetTranslation("recent_resigned_employees")</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="recentResignedEmployees" class="row g-3">
                            <div class="col-12 text-center text-rainy-muted">
                                <span data-translate="no_resigned_employees">@Context.Session.GetTranslation("no_resigned_employees")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rainy Theme Styles -->
<style>
    :root {
        --rainy-primary: #4a90e2;
        --rainy-secondary: #6c757d;
        --rainy-success: #28a745;
        --rainy-warning: #ffc107;
        --rainy-danger: #dc3545;
        --rainy-dark: #2c3e50;
        --rainy-muted: #6c757d;
        --rainy-light: #f8f9fa;
    }

    .bg-rainy-gradient {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
    }

    .bg-rainy-gradient::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="1" fill="%234a90e2" opacity="0.3"/></svg>') repeat;
        opacity: 0.1;
        pointer-events: none;
    }

    .text-rainy-dark {
        color: var(--rainy-dark) !important;
    }

    .text-rainy-muted {
        color: var(--rainy-muted) !important;
    }

    .text-rainy-primary {
        color: var(--rainy-primary) !important;
    }

    .text-rainy-success {
        color: var(--rainy-success) !important;
    }

    .text-rainy-warning {
        color: var(--rainy-warning) !important;
    }

    .text-rainy-danger {
        color: var(--rainy-danger) !important;
    }

    .card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(74, 144, 226, 0.1) !important;
    }

    .shadow-rainy {
        box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1) !important;
    }

    .card-header {
        background-color: rgba(255, 255, 255, 0.8) !important;
        border-bottom: 1px solid rgba(74, 144, 226, 0.1) !important;
    }

    .today-badge {
        background-color: var(--rainy-danger);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Raindrop Animation */
    @@keyframes raindrop {
        0% {
            transform: translateY(-100%);
            opacity: 0;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            transform: translateY(100vh);
            opacity: 0;
        }
    }

    .raindrop {
        position: absolute;
        width: 2px;
        height: 20px;
        background: linear-gradient(transparent, var(--rainy-primary));
        border-radius: 50%;
        animation: raindrop 1s linear infinite;
    }

    /* Animation for Cabinet stats cards */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #cabinetStatsContainer .card {
        animation: fadeInUp 0.6s ease-out;
    }

    /* Animation สำหรับแถวที่ 1 */
    #cabinetStatsContainer .row:nth-child(1) .col-lg-3:nth-child(1) .card { animation-delay: 0.1s; }
    #cabinetStatsContainer .row:nth-child(1) .col-lg-3:nth-child(2) .card { animation-delay: 0.2s; }
    #cabinetStatsContainer .row:nth-child(1) .col-lg-3:nth-child(3) .card { animation-delay: 0.3s; }
    #cabinetStatsContainer .row:nth-child(1) .col-lg-3:nth-child(4) .card { animation-delay: 0.4s; }
    
    /* Animation สำหรับแถวที่ 2 */
    #cabinetStatsContainer .row:nth-child(3) .col-lg-3:nth-child(1) .card { animation-delay: 0.5s; }
    #cabinetStatsContainer .row:nth-child(3) .col-lg-3:nth-child(2) .card { animation-delay: 0.6s; }
    #cabinetStatsContainer .row:nth-child(3) .col-lg-3:nth-child(3) .card { animation-delay: 0.7s; }
    #cabinetStatsContainer .row:nth-child(3) .col-lg-3:nth-child(4) .card { animation-delay: 0.8s; }

    /* เอฟเฟกต์กะพริบสำหรับตู้ต้องคืน */
    @@keyframes pulse-warning {
        0% { box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1); }
        50% { box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4); }
        100% { box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1); }
    }

    .cabinet-alert {
        animation: pulse-warning 2s infinite;
    }

    .cabinet-alert .card-body i {
        animation: pulse 1.5s infinite;
    }
</style>

<!-- Add Raindrops -->
<div id="raindrops"></div>

@section Scripts {
<script>
    // กำหนดการตั้งค่าภาษาสำหรับ Chart.js
    const currentLanguage = '@Context.Session.GetCurrentLanguage()';
    
    // ตั้งค่าชื่อเดือนและวันตามภาษา
    const monthNames = {
        'th': ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'],
        'en': ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
        'zh': ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
    };

    const fullMonthNames = {
        'th': ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'],
        'en': ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
        'zh': ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月']
    };

    // ตั้งค่า Chart.js defaults
    if (typeof Chart !== 'undefined') {
        Chart.defaults.font.family = 'Segoe UI, Tahoma, Geneva, Verdana, sans-serif';
        Chart.defaults.color = '#374151';
        Chart.defaults.borderColor = '#e5e7eb';
        
        // กำหนดรูปแบบการแสดงผลพื้นฐานสำหรับทุกกราฟ
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.legend.labels.padding = 20;
        Chart.defaults.plugins.tooltip.cornerRadius = 8;
        Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 0, 0, 0.8)';
        Chart.defaults.plugins.tooltip.titleColor = '#ffffff';
        Chart.defaults.plugins.tooltip.bodyColor = '#ffffff';
        Chart.defaults.plugins.tooltip.borderColor = '#4a90e2';
        Chart.defaults.plugins.tooltip.borderWidth = 1;
        
        // ตั้งค่าสำหรับ responsive
        Chart.defaults.maintainAspectRatio = false;
        Chart.defaults.responsive = true;
    }

    // ฟังก์ชันแปลงชื่อเดือนเป็นภาษาท้องถิ่น
    function getLocalizedMonth(monthStr) {
        const months = monthNames[currentLanguage] || monthNames['th'];
        
        // ถ้าเป็นรูปแบบ "MMM yyyy" เช่น "Jan 2024"
        if (monthStr && monthStr.includes(' ')) {
            const parts = monthStr.split(' ');
            const month = parts[0];
            const year = parts[1];
            
            // หาตำแหน่งเดือนจากภาษาอังกฤษ
            const englishMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            const monthIndex = englishMonths.findIndex(m => m === month);
            
            if (monthIndex !== -1) {
                const localizedMonth = months[monthIndex];
                return currentLanguage === 'th' ? `${localizedMonth} ${parseInt(year) + 543}` : `${localizedMonth} ${year}`;
            }
        }
        
        // ถ้าเป็นแค่ชื่อเดือน
        const englishMonths = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        const shortEnglishMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        
        let monthIndex = englishMonths.findIndex(m => monthStr.includes(m));
        if (monthIndex === -1) {
            monthIndex = shortEnglishMonths.findIndex(m => monthStr.includes(m));
        }
        
        if (monthIndex !== -1) {
            return months[monthIndex];
        }
        
        return monthStr; // ถ้าไม่พบให้คืนค่าเดิม
    }

    // ฟังก์ชันแปลงชื่อแผนกเป็นภาษาท้องถิ่น (ถ้าจำเป็น)
    function getLocalizedDepartment(deptName) {
        // สามารถเพิ่มการแปลชื่อแผนกที่นี่ได้หากต้องการ
        if (!deptName || deptName.length > 15) {
            return deptName ? deptName.substring(0, 12) + '...' : deptName;
        }
        return deptName;
    }

    $(document).ready(function() {
        // Clear existing charts
        clearCharts();
        // Set module ID
        $('body').attr('data-module-id', '@ViewBag.ModuleId');
        // Load employee statistics
        loadEmployeeStats();
        // Load leave statistics
        loadLeaveStats();
        // Load cabinet statistics
        loadCabinetStats();
        // Language handling
        setupLanguageHandling();
        // Add raindrops animation 
        createRaindrops();
        loadFeedbackList();
        // Load upcoming holidays
        loadUpcomingHolidays();
        
        // รีเฟรชสถิติตู้ทุก ๆ 30 วินาที
        setInterval(loadCabinetStats, 30000);
        // ส่งความคิดเห็นใหม่
        $('#submitFeedback').on('click', function() {
            const data = {
                username: '@ViewBag.username', // ดึงชื่อพนักงานจาก session
                department: 'แผนก', // ดึงจาก session จริง
                type: $('#feedbackType').val(),
                title: $('#feedbackTitle').val(),
                content: $('#feedbackContent').val(),
                isanonymous: $('#anonymousFeedback').is(':checked')
            };
            $.ajax({
                url: '@Url.Action("AddFeedback", "Home")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        $('#feedbackModal').modal('hide');
                        loadFeedbackList();
                    }
                }
            });
        });
        // Like/Dislike
        $(document).on('click', '.btn-like', function() {
            const feedbackid = $(this).data('id');
            const $btn = $(this);
            const currentStatus = $btn.hasClass('active') ? 'unlike' : 'like';
            
            $.post('@Url.Action("LikeFeedback", "Home")', {
                feedbackid,
                username: '@ViewBag.username',
                status: currentStatus
            }, function(res) {
                if (res.success) {
                    loadFeedbackList();
                }
            });
        });
        // เพิ่ม Dislike และ Comment ตาม pattern เดียวกัน
    });

    function clearCharts() {
        try {
            if (window.departmentChart && window.departmentChart.destroy) window.departmentChart.destroy();
            if (window.monthlyChart && window.monthlyChart.destroy) window.monthlyChart.destroy();
            if (window.leaveByMonthChart && window.leaveByMonthChart.destroy) window.leaveByMonthChart.destroy();
            if (window.leaveTypeChart && window.leaveTypeChart.destroy) window.leaveTypeChart.destroy();
            if (window.leaveDaysByMonthChart && window.leaveDaysByMonthChart.destroy) window.leaveDaysByMonthChart.destroy();
            if (window.leaveByDepartmentChart && window.leaveByDepartmentChart.destroy) window.leaveByDepartmentChart.destroy();
            if (window.averageLeaveDurationChart && window.averageLeaveDurationChart.destroy) window.averageLeaveDurationChart.destroy();
            if (window.workdayHolidayLeaveChart && window.workdayHolidayLeaveChart.destroy) window.workdayHolidayLeaveChart.destroy();
            if (typeof Chart !== 'undefined' && Chart.getChart) {
                ['departmentChart', 'monthlyChart', 'leaveByMonthChart', 'leaveTypeChart', 'leaveDaysByMonthChart',
                    'leaveByDepartmentChart', 'averageLeaveDurationChart', 'workdayHolidayLeaveChart'
                ].forEach(id => {
                    const chart = Chart.getChart(id);
                    if (chart) chart.destroy();
                });
            }
        } catch (e) {
            console.warn('Chart cleanup warning:', e);
        }
    }

    function loadEmployeeStats() {
        $.ajax({
            url: '@Url.Action("GetEmployeeStats", "Home")',
            type: 'GET',
            success: function(data) {
                if (data.success) {
                    updateBasicStats(data);
                    displayRecentResignedEmployees(data.recentResignedEmployees);
                    displayDepartmentChart(data.departmentStats);
                    displayMonthlyChart(data.monthlyStats);
                    displayStartTodayEmployees(data.startTodayEmployees);
                }
            },
            error: function() {
                console.error('Failed to load employee statistics');
            }
        });
    }

    function loadLeaveStats() {
        $.ajax({
            url: '@Url.Action("GetLeaveStats", "Leave")',
            type: 'GET',
            success: function(data) {
                if (data.success) {
                    console.log('Leave Stats Data:', data);
                    displayLeaveByMonthChart(data.leaveByMonth);
                    displayLeaveTypeChart(data.leaveTypes);
                    displayLeaveDaysByMonthChart(data.leaveDaysByMonth);
                    displayLeaveByDepartmentChart(data.leaveByDepartment);
                    displayAverageLeaveDurationChart(data.averageLeaveDuration);
                    displayWorkdayHolidayLeaveChart(data.workdayHolidayLeave);
                } else {
                    console.error('Failed to load leave statistics:', data.message);
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading leave statistics:', error);
            }
        });
    }

    function loadCabinetStats() {
        $.ajax({
            url: '@Url.Action("GetCabinetStats", "Cabinet")',
            type: 'GET',
            success: function(data) {
                try {
                    // ตรวจสอบว่าข้อมูลถูกต้อง
                    if (data && typeof data === 'object') {
                                                // อัปเดตข้อมูลในการ์ด
                        $('#totalCabinets').text(data.TotalCabinets || 0);
                        $('#availableCabinets').text(data.AvailableCabinets || 0);
                        $('#occupiedCabinets').text(data.OccupiedCabinets || 0);
                        $('#damagedCabinets').text(data.DamagedCabinets || 0);
                        $('#resignedOwnedCabinets').text(data.ResignedOwnedCabinets || 0);
                        $('#employeesWithoutCabinet').text(data.EmployeesWithoutCabinet || 0);
                        
                        // คำนวณอัตราการใช้งาน
                        const totalCabinets = data.TotalCabinets || 0;
                        const occupiedCabinets = data.OccupiedCabinets || 0;
                        const utilizationRate = totalCabinets > 0 ? 
                            Math.round((occupiedCabinets / totalCabinets) * 100) : 0;
                        $('#utilizationRate').text(utilizationRate + '%');
                        
                        // คำนวณความครอบคลุม (พนักงานที่มีตู้)
                        const employeesWithoutCabinet = data.EmployeesWithoutCabinet || 0;
                        const uniqueOccupiedOwners = data.OccupiedCabinets || 0; // จำนวนพนักงานที่มีตู้
                        const totalActiveEmployees = employeesWithoutCabinet + uniqueOccupiedOwners;
                        const cabinetCoverage = totalActiveEmployees > 0 ? 
                            Math.round((uniqueOccupiedOwners / totalActiveEmployees) * 100) : 0;
                        $('#cabinetCoverage').text(cabinetCoverage + '%');
                        
                        // เปลี่ยนสีการ์ดตู้ต้องคืนตามจำนวน
                        const resignedCard = $('#resignedOwnedCabinets').closest('.card');
                        const resignedCount = data.ResignedOwnedCabinets || 0;
                        
                        resignedCard.removeClass('border-warning border-danger cabinet-alert');
                        if (resignedCount > 0) {
                            resignedCard.addClass(resignedCount > 5 ? 'border-danger' : 'border-warning');
                            resignedCard.addClass('cabinet-alert');
                        }
                        
                        // แสดงส่วน Cabinet Stats Cards
                        $('#cabinetStatsContainer').fadeIn(800);
                    } else {
                        console.error('Invalid data received:', data);
                        showDefaultCabinetStats();
                    }
                } catch (err) {
                    console.error('Error processing cabinet stats:', err);
                    showDefaultCabinetStats();
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading cabinet stats:', {xhr, status, error});
                showDefaultCabinetStats();
            }
        });
    }

    function showDefaultCabinetStats() {
        // แสดงค่าเริ่มต้นเมื่อเกิดข้อผิดพลาด
        $('#totalCabinets').text('0');
        $('#availableCabinets').text('0');
        $('#occupiedCabinets').text('0');
        $('#damagedCabinets').text('0');
        $('#resignedOwnedCabinets').text('0');
        $('#employeesWithoutCabinet').text('0');
        $('#utilizationRate').text('0%');
        $('#cabinetCoverage').text('0%');
        
        const resignedCard = $('#resignedOwnedCabinets').closest('.card');
        resignedCard.removeClass('border-warning border-danger cabinet-alert');
        
        // แสดงส่วน Cabinet Stats Cards แม้จะเกิดข้อผิดพลาด
        $('#cabinetStatsContainer').fadeIn(800);
    }

    function updateBasicStats(data) {
        $('#totalEmployees').text(data.totalEmployees || 0);
        $('#activeEmployees').text(data.activeEmployees || 0);
        $('#newEmployees').text(data.newEmployees || 0);
        $('#resignedEmployees').text(data.resignedEmployees || 0);
    }

    function displayRecentResignedEmployees(employees) {
        const container = $('#recentResignedEmployees');
        container.empty();
        if (employees && employees.length > 0) {
            employees.forEach(emp => {
                const todayBadge = emp.daysAgo === 0 ?
                    `<span class="today-badge ms-2" data-translate="today">@Context.Session.GetTranslation("today")!</span>` :
                    '';
                const card = $(`
                    <div class="col-lg-4 col-md-6">
                        <div class="card border border-rainy-danger border-opacity-25 h-100">
                            <div class="card-body">
                                <h6 class="card-title text-rainy-dark">${emp.name}${todayBadge}</h6>
                                <p class="card-text small mb-1 text-rainy-muted">
                                    <i class="fas fa-building me-2 text-rainy-primary"></i>
                                    <span data-translate="department">@Context.Session.GetTranslation("department")</span>: ${emp.department}
                                </p>
                                <p class="card-text small mb-1 text-rainy-muted">
                                    <i class="fas fa-calendar-check me-2 text-rainy-success"></i>
                                    <span data-translate="start_date">@Context.Session.GetTranslation("start_date")</span>: ${emp.startDate}
                                </p>
                                <p class="card-text small mb-1 text-rainy-muted">
                                    <i class="fas fa-calendar-times me-2 text-rainy-danger"></i>
                                    <span data-translate="resign_date">@Context.Session.GetTranslation("resign_date")</span>: ${emp.resignDate}
                                </p>
                                <p class="card-text small mb-1 text-rainy-muted">
                                    <i class="fas fa-business-time me-2 text-rainy-warning"></i>
                                    <span data-translate="work_period">@Context.Session.GetTranslation("work_period")</span>: ${emp.workPeriod}
                                </p>
                                <p class="card-text small text-rainy-muted">
                                    <i class="fas fa-hourglass-end me-2 text-rainy-secondary"></i>
                                    ${emp.daysAgo === 0 ? 
                                        `<span class="fw-bold text-rainy-danger" data-translate="today">@Context.Session.GetTranslation("today")</span>` :
                                        `${emp.daysAgo} <span data-translate="days_ago">@Context.Session.GetTranslation("days_ago")</span>`
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                `);
                container.append(card);
            });
        } else {
            container.html(`
                <div class="col-12 text-center text-rainy-muted">
                    <span data-translate="no_resigned_employees">@Context.Session.GetTranslation("no_resigned_employees")</span>
                </div>
            `);
        }
    }

    function displayStartTodayEmployees(employees) {
        if (!employees || !employees.length) return;
        const section = $(`
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-rainy border-0">
                        <div class="card-header bg-rainy-light border-bottom">
                            <h5 class="card-title mb-0 text-rainy-dark">
                                <i class="fas fa-user-plus me-2 text-rainy-success"></i>
                                <span data-translate="start_today_employees">@Context.Session.GetTranslation("start_today_employees")</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3" id="startTodayEmployeesList"></div>
                        </div>
                    </div>
                </div>
            </div>
        `);
        $('#startTodayEmployeesSection').replaceWith(section).attr('id', 'startTodayEmployeesSection');
        const container = $('#startTodayEmployeesList');
        employees.forEach(emp => {
            const card = $(`
                <div class="col-lg-4 col-md-6">
                    <div class="card border border-rainy-success border-opacity-25 h-100">
                        <div class="card-body">
                            <h6 class="card-title text-rainy-dark">
                                ${emp.name}
                                <span class="today-badge ms-2" data-translate="first_day">@Context.Session.GetTranslation("first_day")!</span>
                            </h6>
                            <p class="card-text small text-rainy-muted">
                                <i class="fas fa-building me-2 text-rainy-primary"></i>
                                <span data-translate="department">@Context.Session.GetTranslation("department")</span>: ${emp.department}
