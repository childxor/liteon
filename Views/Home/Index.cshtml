</div>

<!-- Rainy Theme Styles -->
<style>
    :root {
        --rainy-primary: #4a90e2;
        --rainy-secondary: #6c757d;
        --rainy-success: #28a745;
        --rainy-warning: #ffc107;
        --rainy-danger: #dc3545;
        --rainy-dark: #2c3e50;
        --rainy-muted: #6c757d;
        --rainy-light: #f8f9fa;
    }

    .bg-rainy-gradient {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
    }

    .bg-rainy-gradient::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="1" fill="%234a90e2" opacity="0.3"/></svg>') repeat;
        opacity: 0.1;
        pointer-events: none;
    }

    .text-rainy-dark {
        color: var(--rainy-dark) !important;
    }

    .text-rainy-muted {
        color: var(--rainy-muted) !important;
    }

    .text-rainy-primary {
        color: var(--rainy-primary) !important;
    }

    .text-rainy-success {
        color: var(--rainy-success) !important;
    }

    .text-rainy-warning {
        color: var(--rainy-warning) !important;
    }

    .text-rainy-danger {
        color: var(--rainy-danger) !important;
    }

    .border-purple {
        border-color: #6f42c1 !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(74, 144, 226, 0.1) !important;
    }

    .shadow-rainy {
        box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1) !important;
    }

    .card-header {
        background-color: rgba(255, 255, 255, 0.8) !important;
        border-bottom: 1px solid rgba(74, 144, 226, 0.1) !important;
    }

    .today-badge {
        background-color: var(--rainy-danger);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Raindrop Animation */
    @@keyframes raindrop {
        0% {
            transform: translateY(-100%);
            opacity: 0;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            transform: translateY(100vh);
            opacity: 0;
        }
    }

    .raindrop {
        position: absolute;
        width: 2px;
        height: 20px;
        background: linear-gradient(transparent, var(--rainy-primary));
        border-radius: 50%;
        animation: raindrop 1s linear infinite;
    }

    /* Animation for Cabinet stats cards */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #cabinetComputerStatsContainer .card {
        animation: fadeInUp 0.6s ease-out;
    }

    /* Animation สำหรับตู้เก็บของ - แถวที่ 1 */
    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(2) .col-6:nth-child(1) .card {
        animation-delay: 0.1s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(2) .col-6:nth-child(2) .card {
        animation-delay: 0.2s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(2) .col-6:nth-child(3) .card {
        animation-delay: 0.3s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(2) .col-6:nth-child(4) .card {
        animation-delay: 0.4s;
    }

    /* Animation สำหรับตู้เก็บของ - แถวที่ 2 */
    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(4) .col-6:nth-child(1) .card {
        animation-delay: 0.5s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(4) .col-6:nth-child(2) .card {
        animation-delay: 0.6s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(4) .col-6:nth-child(3) .card {
        animation-delay: 0.7s;
    }

    #cabinetComputerStatsContainer .col-lg-6:first-child .row:nth-child(4) .col-6:nth-child(4) .card {
        animation-delay: 0.8s;
    }

    /* เอฟเฟกต์กะพริบสำหรับตู้ต้องคืน */
    @@keyframes pulse-warning {
        0% {
            box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1);
        }

        50% {
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

        100% {
            box-shadow: 0 4px 6px rgba(74, 144, 226, 0.1);
        }
    }

    .cabinet-alert {
        animation: pulse-warning 2s infinite;
    }

    .cabinet-alert .card-body i {
        animation: pulse 1.5s infinite;
    }

    /* CSS สำหรับ Stats Cards ที่ปรับปรุงแล้ว */
    .card .badge {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.35rem 0.6rem;
        border-radius: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card .progress {
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: 0.25rem;
        overflow: hidden;
    }

    .card .progress-bar {
        transition: width 0.8s ease-in-out;
        border-radius: 0.25rem;
    }

    /* Hover effects สำหรับ cards */
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
        transition: all 0.3s ease;
    }

    .card:hover .progress-bar {
        animation: progressPulse 1s ease-in-out;
    }

    @@keyframes progressPulse {
        0% { opacity: 1; }
        50% { opacity: 0.7; }
        100% { opacity: 1; }
    }

    /* สีสำหรับ badge ตามประเภท */
    .badge.bg-rainy-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%) !important;
        color: white !important;
    }

    .badge.bg-rainy-success {
        background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%) !important;
        color: white !important;
    }

    .badge.bg-rainy-warning {
        background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%) !important;
        color: #000 !important;
    }

    .badge.bg-rainy-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
        color: white !important;
    }

    .badge.bg-rainy-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #545b62 100%) !important;
        color: white !important;
    }

    .badge.bg-rainy-info {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%) !important;
        color: white !important;
    }

    .badge.bg-purple {
        background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%) !important;
        color: white !important;
    }

    /* สีสำหรับ progress bar */
    .progress-bar.bg-rainy-primary {
        background: linear-gradient(90deg, #007bff 0%, #0056b3 100%) !important;
    }

    .progress-bar.bg-rainy-success {
        background: linear-gradient(90deg, #28a745 0%, #1e7e34 100%) !important;
    }

    .progress-bar.bg-rainy-warning {
        background: linear-gradient(90deg, #ffc107 0%, #e0a800 100%) !important;
    }

    .progress-bar.bg-rainy-danger {
        background: linear-gradient(90deg, #dc3545 0%, #c82333 100%) !important;
    }

    .progress-bar.bg-rainy-secondary {
        background: linear-gradient(90deg, #6c757d 0%, #545b62 100%) !important;
    }

    .progress-bar.bg-rainy-info {
        background: linear-gradient(90deg, #17a2b8 0%, #138496 100%) !important;
    }

    .progress-bar.bg-purple {
        background: linear-gradient(90deg, #6f42c1 0%, #5a32a3 100%) !important;
    }

    /* Animation สำหรับการโหลดข้อมูล */
    .card.loading .progress-bar {
        animation: loadingProgress 2s ease-in-out infinite;
    }

    @@keyframes loadingProgress {
        0% { width: 0%; }
        50% { width: 70%; }
        100% { width: 100%; }
    }

    /* CSS สำหรับ Section Header */
    .stats-section {
        background: rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid rgba(74, 144, 226, 0.1);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 20px rgba(74, 144, 226, 0.08);
    }

    .section-header {
        border-bottom: 2px solid rgba(74, 144, 226, 0.1);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .section-icon {
        background: linear-gradient(135deg, rgba(74, 144, 226, 0.1) 0%, rgba(74, 144, 226, 0.2) 100%);
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 60px;
        min-height: 60px;
    }

    .section-title {
        color: var(--rainy-dark);
        font-weight: 700;
        font-size: 1.5rem;
        margin: 0;
        line-height: 1.2;
    }

    .section-subtitle {
        color: var(--rainy-muted);
        font-size: 0.9rem;
        font-weight: 500;
        margin: 0;
        opacity: 0.8;
    }

    /* Hover effect สำหรับ section */
    .stats-section:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(74, 144, 226, 0.12);
        transition: all 0.3s ease;
    }

    .stats-section:hover .section-icon {
        background: linear-gradient(135deg, rgba(74, 144, 226, 0.15) 0%, rgba(74, 144, 226, 0.25) 100%);
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    /* Animation สำหรับ section header */
    .section-header {
        animation: slideInDown 0.6s ease-out;
    }

    @@keyframes slideInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
