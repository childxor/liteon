        function loadCabinetStats() {
            $.ajax({
                url: appBasePath + 'Cabinet/GetCabinetStats',
                type: 'GET',
                success: function (data) {
                    try {
                        // ตรวจสอบว่าข้อมูลถูกต้อง
                        if (data && typeof data === 'object') {
                            const total = data.TotalCabinets || 0;
                            const available = data.AvailableCabinets || 0;
                            const occupied = data.OccupiedCabinets || 0;
                            const damaged = data.DamagedCabinets || 0;
                            const resigned = data.ResignedOwnedCabinets || 0;
                            const withoutCabinet = data.EmployeesWithoutCabinet || 0;

                            // อัปเดตข้อมูลในการ์ด
                            $('#totalCabinets').text(total);
                            $('#availableCabinets').text(available);
                            $('#occupiedCabinets').text(occupied);
                            $('#damagedCabinets').text(damaged);
                            $('#resignedOwnedCabinets').text(resigned);
                            $('#employeesWithoutCabinet').text(withoutCabinet);

                            // คำนวณและอัปเดตเปอร์เซ็นต์
                            if (total > 0) {
                                const availablePercent = Math.round((available / total) * 100);
                                const occupiedPercent = Math.round((occupied / total) * 100);
                                const damagedPercent = Math.round((damaged / total) * 100);
                                const resignedPercent = Math.round((resigned / total) * 100);

                                $('#availablePercent').text(availablePercent + '%');
                                $('#occupiedPercent').text(occupiedPercent + '%');
                                $('#damagedPercent').text(damagedPercent + '%');
                                $('#resignedPercent').text(resignedPercent + '%');

                                // อัปเดต progress bar
                                $('#availableProgress').css('width', availablePercent + '%');
                                $('#occupiedProgress').css('width', occupiedPercent + '%');
                                $('#damagedProgress').css('width', damagedPercent + '%');
                                $('#resignedProgress').css('width', resignedPercent + '%');
                            } else {
                                $('#availablePercent').text('0%');
                                $('#occupiedPercent').text('0%');
                                $('#damagedPercent').text('0%');
                                $('#resignedPercent').text('0%');
                                $('#availableProgress').css('width', '0%');
                                $('#occupiedProgress').css('width', '0%');
                                $('#damagedProgress').css('width', '0%');
                                $('#resignedProgress').css('width', '0%');
                            }

                            // คำนวณอัตราการใช้งาน
                            const utilizationRate = total > 0 ? Math.round((occupied / total) * 100) : 0;
                            $('#utilizationRate').text(utilizationRate + '%');
                            $('#utilizationProgress').css('width', utilizationRate + '%');

                            // คำนวณความครอบคลุม (พนักงานที่มีตู้)
                            const totalActiveEmployees = withoutCabinet + occupied;
                            const cabinetCoverage = totalActiveEmployees > 0 ? Math.round((occupied / totalActiveEmployees) * 100) : 0;
                            $('#cabinetCoverage').text(cabinetCoverage + '%');
                            $('#coverageProgress').css('width', cabinetCoverage + '%');

                            // คำนวณเปอร์เซ็นต์พนักงานไม่มีตู้
                            const withoutCabinetPercent = totalActiveEmployees > 0 ? Math.round((withoutCabinet / totalActiveEmployees) * 100) : 0;
                            $('#withoutCabinetProgress').css('width', withoutCabinetPercent + '%');

                            // เปลี่ยนสีการ์ดตู้ต้องคืนตามจำนวน
                            const resignedCard = $('#resignedOwnedCabinets').closest('.card');
                            resignedCard.removeClass('border-warning border-danger cabinet-alert');
                            if (resigned > 0) {
                                resignedCard.addClass(resigned > 5 ? 'border-danger' : 'border-warning');
                                resignedCard.addClass('cabinet-alert');
                            }

                            // แสดงส่วน Cabinet & Computer Stats Cards
                            $('#cabinetComputerStatsContainer').fadeIn(800);
                        } else {
                            console.error('Invalid data received:', data);
                            showDefaultCabinetStats();
                        }
                    } catch (err) {
                        console.error('Error processing cabinet stats:', err);
                        showDefaultCabinetStats();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading cabinet stats:', { xhr, status, error });
                    showDefaultCabinetStats();
                }
            });
        }

