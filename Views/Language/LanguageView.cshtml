@model IEnumerable<IPS_TH.Models.sys_language>
@{
    ViewData["Title"] = "จัดการตัวแปรภาษา";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">จัดการตัวแปรภาษา</h5>
            <button type="button" class="btn btn-primary" onclick="openModal()">
                <i class="fas fa-plus"></i> เพิ่มข้อมูล
            </button>
        </div>
    </div>
    <div class="card-body">
        <table id="languageTable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
            <thead class="thead-dark">
                <tr>
                    <th>Keyword</th>
                    <th>ไทย</th>
                    <th>English</th>
                    <th>日本語</th>
                    <th>中文</th>
                    <th>แก้ไขล่าสุด</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="languageModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">เพิ่มข้อมูลภาษา</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="languageForm">
                    <input type="hidden" id="Id" />
                    <div class="form-group">
                        <label for="Keyword">Keyword</label>
                        <input type="text" class="form-control" id="Keyword" required>
                    </div>
                    <div class="form-group">
                        <label for="Th">ภาษาไทย</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="Th" required>
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" onclick="autoTranslate(document.getElementById('Th'))">
                                    <i class="fas fa-language"></i> แปลภาษา
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="En">ภาษาอังกฤษ</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="En" required>
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" onclick="autoTranslate(document.getElementById('En'))">
                                    <i class="fas fa-language"></i> แปลภาษา
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Jp">ภาษาญี่ปุ่น</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="Jp" required>
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" onclick="autoTranslate(document.getElementById('Jp'))">
                                    <i class="fas fa-language"></i> แปลภาษา
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Cn">ภาษาจีน</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="Cn" required>
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" onclick="autoTranslate(document.getElementById('Cn'))">
                                    <i class="fas fa-language"></i> แปลภาษา
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">บันทึก</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/locale/th.min.js"></script>

    <script>
        let table;
        $(document).ready(function () {
            moment.locale('th');
            initializeDataTable();
        });

        function initializeDataTable() {
            table = $('#languageTable').DataTable({
                data: @Html.Raw(Json.Serialize(Model)),
                columns: [
                    { data: 'keyword' },
                    { data: 'th' },
                    { data: 'en' },
                    { data: 'jp' },
                    { data: 'cn' },
                    { 
                        data: 'updatedDate',
                        render: function(data) {
                            return moment(data).format('DD/MM/YYYY HH:mm');
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-warning btn-sm" onclick="editData(${row.id})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteData(${row.id})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Thai.json'
                }
            });
        }

        function openModal(id = null) {
            $('#languageForm')[0].reset();
            $('#Id').val('');
            $('#modalTitle').text(id ? 'แก้ไขข้อมูลภาษา' : 'เพิ่มข้อมูลภาษา');
            $('#languageModal').modal('show');
        }

        function saveData() {
            const data = {
                Id: $('#Id').val() || 0,
                Keyword: $('#Keyword').val(),
                Th: $('#Th').val() || '',
                En: $('#En').val() || '',
                Jp: $('#Jp').val() || '',
                Cn: $('#Cn').val() || '',
                CreatedBy: 'System',
                UpdatedBy: 'System'
            };

            if (!data.Keyword) {
                Swal.fire({
                    icon: 'error',
                    title: 'ผิดพลาด',
                    text: 'กรุณาระบุ Keyword'
                });
                return;
            }

            const url = data.Id > 0 ? '/Language/Update' : '/Language/Create';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.status) {
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: response.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'ผิดพลาด',
                            text: response.message
                        });
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการบันทึกข้อมูล: ' + error
                    });
                }
            });
        }

        function editData(id) {
            const data = table.rows().data().toArray().find(x => x.id === id);
            $('#Id').val(data.id);
            $('#Keyword').val(data.keyword);
            $('#Th').val(data.th);
            $('#En').val(data.en);
            $('#Jp').val(data.jp);
            $('#Cn').val(data.cn);
            openModal(id);
        }

        function deleteData(id) {
            Swal.fire({
                title: 'ยืนยันการลบ',
                text: "คุณต้องการลบข้อมูลนี้ใช่หรือไม่?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Language/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.status) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'สำเร็จ',
                                    text: response.message,
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'ผิดพลาด',
                                    text: response.message
                                });
                            }
                        }
                    });
                }
            });
        }

        function autoTranslate(sourceField) {
            const sourceText = $(sourceField).val();
            let sourceLang = '';
            
            // กำหนดภาษาต้นทาง
            switch(sourceField.id) {
                case 'Th': sourceLang = 'th'; break;
                case 'En': sourceLang = 'en'; break;
                case 'Jp': sourceLang = 'jp'; break;
                case 'Cn': sourceLang = 'cn'; break;
            }
            
            if (!sourceText || !sourceLang) return;

            // แสดง loading
            Swal.fire({
                title: 'กำลังแปลภาษา...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '/Language/TranslateText',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    text: sourceText,
                    sourceLang: sourceLang
                }),
                success: function (response) {
                    if (response.status) {
                        // นำผลลัพธ์การแปลไปใส่ในช่อง input
                        if (response.data.th) $('#Th').val(response.data.th);
                        if (response.data.en) $('#En').val(response.data.en);
                        if (response.data.jp) $('#Jp').val(response.data.jp);
                        if (response.data.cn) $('#Cn').val(response.data.cn);
                        Swal.close();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'ผิดพลาด',
                            text: response.message
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการแปลภาษา'
                    });
                }
            });
        }
    </script>
} 