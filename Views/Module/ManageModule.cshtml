@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@model IEnumerable<IPS_TH.Models.sys_module>

@{
    ViewData["Title"] = "จัดการโมดูล";
}

<!-- เพิ่ม Bootstrap Icons CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">จัดการโมดูล</h5>
                    <button type="button" class="btn btn-light" id="addNewModuleButton">
                        <i class="bi bi-plus-lg"></i> เพิ่มโมดูลหลัก
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="loadingSpinner" class="text-center d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลด...</span>
                            </div>
                        </div>
                        <table class="table table-hover" id="moduleTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px"></th>
                                    <th class="text-center" style="width: 80px">ลำดับ</th>
                                    <th>ชื่อโมดูล</th>
                                    <th>รายละเอียด</th>
                                    <th class="text-center" style="width: 100px">ไอคอน</th>
                                    <th class="text-center" style="width: 100px">สถานะ</th>
                                    <th class="text-center" style="width: 150px">จัดการ</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let mainModuleTable;

        $(document).ready(function () {
            initializeMainModuleTable();
            handleEditModule();
            handleToggleMainModuleStatus();
            handleAddModule();
        });

        function showLoading() {
            $('#loadingSpinner').removeClass('d-none');
        }

        function hideLoading() {
            $('#loadingSpinner').addClass('d-none');
        }

        function formatSubModuleTable(d) {
            if (!d.subModules || d.subModules.length === 0) {
                return '<div class="p-3 text-center">ไม่มีโมดูลย่อย</div>';
            }

            let table = `
                <div class="p-3">
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-primary btn-sm add-sub-module" data-parent-id="${d.Id}" data-parent-name="${d.Name}">
                            <i class="bi bi-plus-lg"></i> เพิ่มโมดูลย่อย
                        </button>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 80px">ลำดับ</th>
                                <th>ชื่อโมดูลย่อย</th>
                                <th>รายละเอียด</th>
                                <th>Controller</th>
                                <th>Action</th>
                                <th class="text-center" style="width: 100px">ไอคอน</th>
                                <th class="text-center" style="width: 100px">สถานะ</th>
                                <th class="text-center" style="width: 100px">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            d.subModules.forEach(subModule => {
                table += `
                    <tr>
                        <td class="text-center">${subModule.Order}</td>
                        <td>${subModule.Name}</td>
                        <td>${subModule.Description || ''}</td>
                        <td>${subModule.Controller || ''}</td>
                        <td>${subModule.Action || ''}</td>
                        <td class="text-center">
                            ${subModule.Icon ? `<i class="${subModule.Icon}"></i>` : ''}
                        </td>
                        <td class="text-center">
                            <div class="form-check form-switch d-flex justify-content-center">
                                <input class="form-check-input toggle-sub-status" 
                                    type="checkbox" id="subSwitch${subModule.Id}" 
                                    ${subModule.IsActive ? 'checked' : ''} 
                                    data-id="${subModule.Id}">
                                <label class="form-check-label" for="subSwitch${subModule.Id}"></label>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                <button type="button" class="btn btn-warning btn-sm rounded-circle edit-sub-module" data-id="${subModule.Id}" title="แก้ไข">
                                    <i class="bi bi-pencil fs-6"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-sm rounded-circle delete-sub-module" data-id="${subModule.Id}" title="ลบ">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            table += `
                        </tbody>
                    </table>
                </div>
            `;

            return table;
        }

        function initializeMainModuleTable() {
            try {
                showLoading();
                mainModuleTable = $('#moduleTable').DataTable({
                    processing: true,
                    serverSide: false,
                    searching: true,
                    paging: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    pageLength: 10,
                    language: {
                        processing: "กำลังโหลดข้อมูล...",
                        search: "ค้นหา:",
                        lengthMenu: "แสดง _MENU_ รายการ",
                        info: "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                        infoEmpty: "แสดง 0 ถึง 0 จาก 0 รายการ",
                        infoFiltered: "(กรองจากทั้งหมด _MAX_ รายการ)",
                        emptyTable: "ไม่พบข้อมูล",
                        zeroRecords: "ไม่พบข้อมูลที่ค้นหา",
                        paginate: {
                            first: "หน้าแรก",
                            last: "หน้าสุดท้าย",
                            next: "ถัดไป",
                            previous: "ก่อนหน้า"
                        }
                    },
                    ajax: {
                        url: '@Url.Action("GetModules", "Module")',
                        type: 'GET',
                        dataSrc: '',
                        beforeSend: function() {
                            showLoading();
                        },
                        complete: function() {
                            hideLoading();
                        }
                    },
                    columns: [
                        {
                            className: 'dt-control',
                            orderable: false,
                            data: null,
                            defaultContent: '<i class="bi bi-plus-circle"></i>'
                        },
                        {
                            data: 'Order',
                            className: 'text-center align-middle'
                        },
                        {
                            data: 'Name',
                            className: 'align-middle'
                        },
                        {
                            data: 'Description',
                            className: 'align-middle'
                        },
                        {
                            data: 'Icon',
                            className: 'text-center align-middle',
                            render: function(data) {
                                return data ? `<i class="${data}"></i>` : '';
                            }
                        },
                        {
                            data: 'IsActive',
                            className: 'text-center align-middle',
                            render: function(data, type, row) {
                                return `
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input toggle-status" 
                                            type="checkbox" id="customSwitch${row.Id}" ${data ? 'checked' : ''} 
                                            data-id="${row.Id}">
                                        <label class="form-check-label" for="customSwitch${row.Id}"></label>
                                    </div>
                                `;
                            }
                        },
                        {
                            data: null,
                            className: 'text-center align-middle',
                            orderable: false,
                            render: function(data, type, row) {
                                return `
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-warning btn-sm edit-module" 
                                            data-id="${row.Id}" title="แก้ไข">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm delete-module" 
                                            data-id="${row.Id}" title="ลบ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                `;
                            }
                        }
                    ],
                    order: [[1, 'asc']],
                    drawCallback: function() {
                        $('[data-toggle="tooltip"]').tooltip();
                    }
                });

                // เพิ่ม event handler สำหรับปุ่มขยาย/ย่อ
                $('#moduleTable tbody').on('click', 'td.dt-control', async function () {
                    const tr = $(this).closest('tr');
                    const row = mainModuleTable.row(tr);

                    if (row.child.isShown()) {
                        row.child.hide();
                        tr.removeClass('shown');
                    } else {
                        try {
                            showLoading();
                            const response = await $.get('@Url.Action("GetSubModules", "Module")', { 
                                parentId: row.data().Id 
                            });
                            row.data().subModules = response;
                            row.child(formatSubModuleTable(row.data())).show();
                            tr.addClass('shown');
                        } catch (error) {
                            console.error('Error loading submodules:', error);
                            Swal.fire({
                                title: 'เกิดข้อผิดพลาด!',
                                text: 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                                icon: 'error'
                            });
                        } finally {
                            hideLoading();
                        }
                    }
                });

            } catch (error) {
                console.error('Error initializing DataTable:', error);
                Swal.fire({
                    title: 'เกิดข้อผิดพลาด!',
                    text: 'ไม่สามารถโหลดตารางข้อมูลได้',
                    icon: 'error'
                });
            }
        }

        function handleEditModule() {
            $(document).on('click', '.edit-module', async function() {
                const id = $(this).data('id');
                
                try {
                    const response = await $.get('@Url.Action("GetModuleById", "Module")', { id: id });
                    
                    if (!response.success) {
                        throw new Error(response.message || 'ไม่สามารถโหลดข้อมูลโมดูลได้');
                    }

                    const module = response.data;
                    
                    const result = await Swal.fire({
                        title: 'แก้ไขโมดูล',
                        html: `
                            <form id="editModuleForm" class="text-start">
                                <div class="mb-3">
                                    <label class="form-label">ลำดับ</label>
                                    <input type="number" class="form-control" id="editModuleOrder" 
                                        value="${module.Order || ''}" min="1">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">ชื่อโมดูล</label>
                                    <input type="text" class="form-control" id="editModuleName" 
                                        value="${module.Name || ''}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">รายละเอียด</label>
                                    <textarea class="form-control" id="editModuleDescription" 
                                        rows="3">${module.Description || ''}</textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">ไอคอน</label>
                                    <select class="form-control" id="editModuleIcon">
                                        <option value="">เลือกไอคอน</option>
                                        ${generateIconOptions(module.Icon)}
                                    </select>
                                    <div class="icon-preview mt-2 text-center">
                                        <i class="${module.Icon || ''}" id="editIconPreview"></i>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" 
                                            id="editModuleStatus" ${module.IsActive ? 'checked' : ''}>
                                        <label class="form-check-label">เปิดใช้งาน</label>
                                    </div>
                                </div>
                            </form>
                        `,
                        showCancelButton: true,
                        confirmButtonText: 'บันทึก',
                        cancelButtonText: 'ยกเลิก',
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#dc3545',
                        focusConfirm: false,
                        allowOutsideClick: false,
                        didOpen: () => {
                            $('#editModuleIcon').on('change', function() {
                                const selectedIcon = $(this).val();
                                $('#editIconPreview').attr('class', selectedIcon || '');
                            });
                            $('#editModuleOrder').focus();
                        }
                    });

                    if (result.isConfirmed) {
                        const updatedData = {
                            Id: id,
                            Order: $('#editModuleOrder').val(),
                            Name: $('#editModuleName').val(),
                            Description: $('#editModuleDescription').val(),
                            Icon: $('#editModuleIcon').val(),
                            IsActive: $('#editModuleStatus').is(':checked')
                        };

                        const updateResponse = await $.ajax({
                            url: '@Url.Action("UpdateModule", "Module")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(updatedData)
                        });

                        if (updateResponse.success) {
                            await Swal.fire({
                                title: 'สำเร็จ!',
                                text: 'แก้ไขโมดูลเรียบร้อยแล้ว',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            mainModuleTable.ajax.reload();
                        } else {
                            throw new Error(updateResponse.message || 'ไม่สามารถแก้ไขโมดูลได้');
                        }
                    }
                } catch (error) {
                    Swal.fire({
                        title: 'เกิดข้อผิดพลาด!',
                        text: error.message,
                        icon: 'error'
                    });
                }
            });
        }

        function handleToggleMainModuleStatus() {
            $(document).on('change', '.toggle-status', function() {
                const id = $(this).data('id');
                const isActive = $(this).prop('checked');
                const $switch = $(this);

                Swal.fire({
                    title: 'ยืนยันการเปลี่ยนสถานะ',
                    text: `คุณต้องการ${isActive ? 'เปิด' : 'ปิด'}การใช้งานโมดูลนี้ใช่หรือไม่?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ยืนยัน',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("ToggleModuleStatus", "Module")',
                            type: 'POST',
                            data: { id: id, isActive: isActive },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: 'สำเร็จ!',
                                        text: `${isActive ? 'เปิด' : 'ปิด'}การใช้งานโมดูลเรียบร้อยแล้ว`,
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                    mainModuleTable.ajax.reload();
                                } else {
                                    $switch.prop('checked', !isActive);
                                    Swal.fire({
                                        title: 'เกิดข้อผิดพลาด!',
                                        text: response.message || 'ไม่สามารถเปลี่ยนสถานะได้',
                                        icon: 'error'
                                    });
                                }
                            },
                            error: function() {
                                $switch.prop('checked', !isActive);
                                Swal.fire({
                                    title: 'เกิดข้อผิดพลาด!',
                                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์',
                                    icon: 'error'
                                });
                            }
                        });
                    } else {
                        $switch.prop('checked', !isActive);
                    }
                });
            });
        }

        function handleAddModule() {
            $(document).on('click', '#addNewModuleButton', async function() {
                const result = await Swal.fire({
                    title: 'เพิ่มโมดูลใหม่',
                    html: `
                        <form id="addModuleForm" class="text-start">
                            <div class="mb-3">
                                <label class="form-label">ลำดับ</label>
                                <input type="number" class="form-control" id="addModuleOrder" min="1">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ชื่อโมดูล</label>
                                <input type="text" class="form-control" id="addModuleName">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">รายละเอียด</label>
                                <textarea class="form-control" id="addModuleDescription" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ไอคอน</label>
                                <select class="form-control" id="addModuleIcon">
                                    <option value="">เลือกไอคอน</option>
                                    ${generateIconOptions()}
                                </select>
                                <div class="icon-preview mt-2 text-center">
                                    <i class="" id="addIconPreview"></i>
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="addModuleStatus" checked>
                                    <label class="form-check-label">เปิดใช้งาน</label>
                                </div>
                            </div>
                        </form>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'บันทึก',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    focusConfirm: false,
                    allowOutsideClick: false,
                    didOpen: () => {
                        $('#addModuleIcon').on('change', function() {
                            const selectedIcon = $(this).val();
                            $('#addIconPreview').attr('class', selectedIcon || '');
                        });
                        $('#addModuleOrder').focus();
                    }
                });

                if (result.isConfirmed) {
                    const newData = {
                        Order: $('#addModuleOrder').val(),
                        Name: $('#addModuleName').val(),
                        Description: $('#addModuleDescription').val(),
                        Icon: $('#addModuleIcon').val(),
                        IsActive: $('#addModuleStatus').is(':checked')
                    };

                    try {
                        const response = await $.ajax({
                            url: '@Url.Action("AddModule", "Module")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(newData)
                        });

                        if (response.success) {
                            await Swal.fire({
                                title: 'สำเร็จ!',
                                text: 'เพิ่มโมดูลเรียบร้อยแล้ว',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            mainModuleTable.ajax.reload();
                        } else {
                            throw new Error(response.message || 'ไม่สามารถเพิ่มโมดูลได้');
                        }
                    } catch (error) {
                        Swal.fire({
                            title: 'เกิดข้อผิดพลาด!',
                            text: error.message,
                            icon: 'error'
                        });
                    }
                }
            });
        }

        function generateIconOptions(selectedIcon) {
            const iconCategories = {
                'ทั่วไป': [
                    'bi-house', 'bi-person', 'bi-people', 'bi-gear', 'bi-tools', 'bi-file', 
                    'bi-folder', 'bi-bar-chart', 'bi-calendar', 'bi-clock', 'bi-bell',
                    'bi-envelope', 'bi-star', 'bi-heart', 'bi-bookmark', 'bi-printer',
                    'bi-camera', 'bi-camera-video', 'bi-music-note', 'bi-search', 'bi-lock',
                    'bi-key', 'bi-gear', 'bi-tools', 'bi-database', 'bi-server',
                    'bi-pc-display', 'bi-laptop', 'bi-phone', 'bi-tablet', 'bi-telephone'
                ],
                'การเงิน': [
                    'bi-cash', 'bi-credit-card', 'bi-wallet', 'bi-coin', 'bi-piggy-bank',
                    'bi-graph-up', 'bi-pie-chart', 'bi-graph-up-arrow', 'bi-percent',
                    'bi-currency-dollar', 'bi-currency-yen', 'bi-currency-euro', 'bi-currency-pound',
                    'bi-cash-stack', 'bi-cash-coin', 'bi-cash'
                ],
                'การจัดการ': [
                    'bi-list-task', 'bi-clipboard', 'bi-clipboard-check', 'bi-clipboard-data',
                    'bi-calendar-check', 'bi-calendar-plus', 'bi-calendar-minus',
                    'bi-calendar', 'bi-calendar-day', 'bi-calendar-week',
                    'bi-calendar-x', 'bi-calendar-clock'
                ],
                'การสื่อสาร': [
                    'bi-chat', 'bi-chat-left', 'bi-chat-dots', 'bi-chat-right',
                    'bi-chat-square', 'bi-chat-square-text', 'bi-chat-square-quote',
                    'bi-chat-square-heart', 'bi-chat-square-dots', 'bi-chat-square-text',
                    'bi-chat-square-plus', 'bi-chat-square-minus', 'bi-chat-square-check',
                    'bi-chat-square-x', 'bi-chat-square-quote'
                ],
                'การตั้งค่า': [
                    'bi-gear', 'bi-sliders', 'bi-sliders2-vertical', 'bi-tools',
                    'bi-wrench', 'bi-screwdriver', 'bi-hammer', 'bi-rulers',
                    'bi-ruler', 'bi-ruler-combined', 'bi-ruler-horizontal', 'bi-ruler-vertical',
                    'bi-compass', 'bi-compass-fill', 'bi-geo-alt'
                ],
                'รายงาน': [
                    'bi-bar-chart', 'bi-graph-up', 'bi-pie-chart', 'bi-graph-up-arrow',
                    'bi-scatter-chart', 'bi-bubble-chart', 'bi-gantt-chart',
                    'bi-diagram-3', 'bi-radar', 'bi-tree',
                    'bi-waterfall-chart', 'bi-candlestick-chart', 'bi-box-plot',
                    'bi-bar-chart-line', 'bi-bar-chart-steps'
                ],
                'ความปลอดภัย': [
                    'bi-shield', 'bi-shield-virus', 'bi-shield-check',
                    'bi-shield-x', 'bi-shield-exclamation', 'bi-shield-heart',
                    'bi-shield-plus', 'bi-shield-minus', 'bi-shield-slash',
                    'bi-shield-fill-x', 'bi-shield-fill-check', 'bi-lock', 'bi-unlock',
                    'bi-key', 'bi-fingerprint'
                ],
                'การจัดการไฟล์': [
                    'bi-file', 'bi-file-text', 'bi-file-zip', 'bi-file-music',
                    'bi-file-code', 'bi-file-contract', 'bi-file-csv', 'bi-file-download',
                    'bi-file-excel', 'bi-file-export', 'bi-file-image', 'bi-file-import',
                    'bi-file-invoice', 'bi-file-invoice-dollar', 'bi-file-medical',
                    'bi-file-pdf', 'bi-file-powerpoint', 'bi-file-prescription',
                    'bi-file-signature', 'bi-file-upload', 'bi-file-video', 'bi-file-word'
                ],
                'การแจ้งเตือน': [
                    'bi-bell', 'bi-bell-slash', 'bi-bell-fill', 'bi-bell-school',
                    'bi-bell-ring', 'bi-bell-plus', 'bi-bell-minus', 'bi-bell-exclamation',
                    'bi-bell-check', 'bi-bell-x', 'bi-bell-concierge', 'bi-bell-hotel',
                    'bi-bell-desk', 'bi-bell-schedule', 'bi-bell-curfew'
                ],
                'การจัดการผู้ใช้': [
                    'bi-person', 'bi-person-plus', 'bi-person-minus', 'bi-person-edit',
                    'bi-person-x', 'bi-person-check', 'bi-person-clock', 'bi-person-gear',
                    'bi-person-gear', 'bi-person-shield', 'bi-person-lock', 'bi-person-unlock',
                    'bi-person-slash', 'bi-person-tag', 'bi-person-tie'
                ]
            };

            let options = '<option value="">เลือกไอคอน</option>';
            
            for (const [category, icons] of Object.entries(iconCategories)) {
                options += `<optgroup label="${category}">`;
                icons.forEach(icon => {
                    const fullIconClass = `bi ${icon}`;
                    const isSelected = fullIconClass === selectedIcon;
                    const displayName = icon.replace('bi-', '').replace(/-/g, ' ');
                    options += `<option value="${fullIconClass}" ${isSelected ? 'selected' : ''}>
                        ${displayName}
                    </option>`;
                });
                options += '</optgroup>';
            }

            return options;
        }

        // Event delegation สำหรับปุ่มแก้ไข/ลบโมดูลย่อยใน child row
        $(document).on('click', '.edit-sub-module', async function() {
            const id = $(this).data('id');
            try {
                const response = await $.get('@Url.Action("GetModuleById", "Module")', { id: id });
                if (!response.success) throw new Error(response.message || 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้');
                const module = response.data;
                const result = await Swal.fire({
                    title: 'แก้ไขโมดูลย่อย',
                    html: `
                        <form id="editSubModuleForm" class="text-start">
                            <div class="mb-3">
                                <label class="form-label">ลำดับ</label>
                                <input type="number" class="form-control" id="editSubModuleOrder" value="${module.Order || ''}" min="1">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ชื่อโมดูลย่อย</label>
                                <input type="text" class="form-control" id="editSubModuleName" value="${module.Name || ''}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">รายละเอียด</label>
                                <textarea class="form-control" id="editSubModuleDescription" rows="3">${module.Description || ''}</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Controller</label>
                                <input type="text" class="form-control" id="editSubModuleController" value="${module.Controller || ''}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Action</label>
                                <input type="text" class="form-control" id="editSubModuleAction" value="${module.Action || ''}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ไอคอน</label>
                                <select class="form-control" id="editSubModuleIcon">
                                    <option value="">เลือกไอคอน</option>
                                    ${generateIconOptions(module.Icon)}
                                </select>
                                <div class="icon-preview mt-2 text-center">
                                    <i class="${module.Icon || ''}" id="editSubIconPreview"></i>
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="editSubModuleStatus" ${module.IsActive ? 'checked' : ''}>
                                    <label class="form-check-label">เปิดใช้งาน</label>
                                </div>
                            </div>
                        </form>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'บันทึก',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    focusConfirm: false,
                    allowOutsideClick: false,
                    didOpen: () => {
                        $('#editSubModuleIcon').on('change', function() {
                            const selectedIcon = $(this).val();
                            $('#editSubIconPreview').attr('class', selectedIcon || '');
                        });
                        $('#editSubModuleOrder').focus();
                    }
                });
                if (result.isConfirmed) {
                    const updatedData = {
                        Id: id,
                        Order: $('#editSubModuleOrder').val(),
                        Name: $('#editSubModuleName').val(),
                        Description: $('#editSubModuleDescription').val(),
                        Controller: $('#editSubModuleController').val(),
                        Action: $('#editSubModuleAction').val(),
                        Icon: $('#editSubModuleIcon').val(),
                        IsActive: $('#editSubModuleStatus').is(':checked'),
                        ParentId: module.ParentId
                    };
                    const updateResponse = await $.ajax({
                        url: '@Url.Action("UpdateSubModule", "Module")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(updatedData)
                    });
                    if (updateResponse.success) {
                        await Swal.fire({
                            title: 'สำเร็จ!',
                            text: 'แก้ไขโมดูลย่อยเรียบร้อยแล้ว',
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        });
                        mainModuleTable.ajax.reload();
                    } else {
                        throw new Error(updateResponse.message || 'ไม่สามารถแก้ไขโมดูลย่อยได้');
                    }
                }
            } catch (error) {
                Swal.fire({
                    title: 'เกิดข้อผิดพลาด!',
                    text: error.message,
                    icon: 'error'
                });
            }
        });

        $(document).on('click', '.delete-sub-module', async function() {
            const id = $(this).data('id');
            const confirm = await Swal.fire({
