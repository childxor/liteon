@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@model IEnumerable<IPS_TH.Models.sys_module>

@{
    ViewData["Title"] = "จัดการโมดูล";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> จัดการโมดูล</h5>
                    <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addModuleModal">
                        <i class="bi bi-plus-lg"></i> เพิ่มโมดูลหลัก
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="loadingSpinner" class="text-center d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลด...</span>
                            </div>
                        </div>
                        <table class="table table-hover align-middle" id="moduleTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 30px" class="text-center"></th>
                                    <th style="width: 80px" class="text-center">ลำดับ</th>
                                    <th>ชื่อโมดูล</th>
                                    <th>รายละเอียด</th>
                                    <th style="width: 100px" class="text-center">ไอคอน</th>
                                    <th style="width: 100px" class="text-center">สถานะ</th>
                                    <th style="width: 150px" class="text-center">จัดการ</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่ม/แก้ไขโมดูลหลัก -->
<div class="modal fade" id="addModuleModal" tabindex="-1" aria-labelledby="addModuleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addModuleModalLabel">เพิ่มโมดูลหลัก</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="moduleForm">
                    <input type="hidden" id="moduleId" value="">
                    <div class="mb-3">
                        <label for="moduleOrder" class="form-label">ลำดับ <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="moduleOrder" min="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="moduleName" class="form-label">ชื่อโมดูล <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="moduleName" required>
                    </div>
                    <div class="mb-3">
                        <label for="moduleDescription" class="form-label">รายละเอียด</label>
                        <textarea class="form-control" id="moduleDescription" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="moduleIcon" class="form-label">ไอคอน</label>
                        <select class="form-select" id="moduleIcon">
                            <option value="">เลือกไอคอน</option>
                        </select>
                        <div class="mt-2 text-center">
                            <span class="fs-2" id="iconPreview"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="moduleStatus" checked>
                            <label class="form-check-label" for="moduleStatus">เปิดใช้งาน</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" id="saveModuleBtn">
                    <i class="bi bi-save"></i> บันทึก
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่ม/แก้ไขโมดูลย่อย -->
<div class="modal fade" id="addSubModuleModal" tabindex="-1" aria-labelledby="addSubModuleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSubModuleModalLabel">เพิ่มโมดูลย่อย</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="subModuleForm">
                    <input type="hidden" id="subModuleId" value="">
                    <input type="hidden" id="subModuleParentId" value="">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="subModuleOrder" class="form-label">ลำดับ <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="subModuleOrder" min="1" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="subModuleStatus" checked>
                                    <label class="form-check-label" for="subModuleStatus">เปิดใช้งาน</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="subModuleName" class="form-label">ชื่อโมดูลย่อย <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subModuleName" required>
                    </div>
                    <div class="mb-3">
                        <label for="subModuleDescription" class="form-label">รายละเอียด</label>
                        <textarea class="form-control" id="subModuleDescription" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="subModuleController" class="form-label">Controller</label>
                                <input type="text" class="form-control" id="subModuleController" placeholder="เช่น Home">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="subModuleAction" class="form-label">Action</label>
                                <input type="text" class="form-control" id="subModuleAction" placeholder="เช่น Index">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="subModuleIcon" class="form-label">ไอคอน</label>
                        <select class="form-select" id="subModuleIcon">
                            <option value="">เลือกไอคอน</option>
                        </select>
                        <div class="mt-2 text-center">
                            <span class="fs-2" id="subIconPreview"></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" id="saveSubModuleBtn">
                    <i class="bi bi-save"></i> บันทึก
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ประกาศตัวแปร appBasePath
        var appBasePath = '@Url.Content("~/")';
        
        let mainModuleTable;
        let isEditing = false;
        let currentParentId = null;

        $(document).ready(function () {
            initializeMainModuleTable();
            initializeIconOptions();
            bindEvents();
        });

        function showLoading() {
            $('#loadingSpinner').removeClass('d-none');
        }

        function hideLoading() {
            $('#loadingSpinner').addClass('d-none');
        }

        function showSuccess(message) {
            const toast = `
                <div class="toast show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 1055;">
                    <div class="toast-header bg-success text-white">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong class="me-auto">สำเร็จ</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `;
            $('body').append(toast);
            setTimeout(() => $('.toast').remove(), 3000);
        }

        function showError(message) {
            const toast = `
                <div class="toast show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 1055;">
                    <div class="toast-header bg-danger text-white">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong class="me-auto">ข้อผิดพลาด</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `;
            $('body').append(toast);
            setTimeout(() => $('.toast').remove(), 5000);
        }

        function initializeIconOptions() {
            const icons = [
                { category: 'ทั่วไป', items: ['bi-house', 'bi-person', 'bi-people', 'bi-gear', 'bi-tools', 'bi-file', 'bi-folder', 'bi-bar-chart', 'bi-calendar', 'bi-clock', 'bi-bell', 'bi-envelope', 'bi-star', 'bi-heart', 'bi-bookmark', 'bi-printer', 'bi-camera', 'bi-search', 'bi-lock', 'bi-key', 'bi-database', 'bi-server', 'bi-pc-display', 'bi-laptop', 'bi-phone', 'bi-tablet'] },
                { category: 'การเงิน', items: ['bi-cash', 'bi-credit-card', 'bi-wallet', 'bi-coin', 'bi-piggy-bank', 'bi-graph-up', 'bi-pie-chart', 'bi-percent', 'bi-cash-stack'] },
                { category: 'การจัดการ', items: ['bi-list-task', 'bi-clipboard', 'bi-clipboard-check', 'bi-clipboard-data', 'bi-calendar-check', 'bi-calendar-plus', 'bi-calendar-minus'] },
                { category: 'การสื่อสาร', items: ['bi-chat', 'bi-chat-left', 'bi-chat-dots', 'bi-chat-right', 'bi-chat-square', 'bi-chat-square-text'] },
                { category: 'การตั้งค่า', items: ['bi-gear', 'bi-sliders', 'bi-tools', 'bi-wrench', 'bi-screwdriver', 'bi-hammer', 'bi-rulers'] },
                { category: 'รายงาน', items: ['bi-bar-chart', 'bi-graph-up', 'bi-pie-chart', 'bi-graph-up-arrow', 'bi-diagram-3', 'bi-tree'] },
                { category: 'ความปลอดภัย', items: ['bi-shield', 'bi-shield-check', 'bi-shield-x', 'bi-shield-exclamation', 'bi-lock', 'bi-unlock', 'bi-key', 'bi-fingerprint'] }
            ];

            let options = '<option value="">เลือกไอคอน</option>';
            icons.forEach(category => {
                options += `<optgroup label="${category.category}">`;
                category.items.forEach(icon => {
                    const displayName = icon.replace('bi-', '').replace(/-/g, ' ');
                    options += `<option value="bi ${icon}">${displayName}</option>`;
                });
                options += '</optgroup>';
            });

            $('#moduleIcon, #subModuleIcon').html(options);
        }

        function bindEvents() {
            // Icon preview
            $('#moduleIcon').on('change', function() {
                const icon = $(this).val();
                $('#iconPreview').attr('class', icon);
            });

            $('#subModuleIcon').on('change', function() {
                const icon = $(this).val();
                $('#subIconPreview').attr('class', icon);
            });

            // Save module
            $('#saveModuleBtn').on('click', saveModule);
            
            // Save sub module
            $('#saveSubModuleBtn').on('click', saveSubModule);

            // Reset form when modal closes
            $('#addModuleModal').on('hidden.bs.modal', function() {
                resetModuleForm();
            });

            $('#addSubModuleModal').on('hidden.bs.modal', function() {
                resetSubModuleForm();
            });
        }

        function formatSubModuleTable(d) {
            if (!d.subModules || d.subModules.length === 0) {
                return `<div class="p-4 text-center text-muted">
                    <i class="bi bi-folder2-open fs-1"></i>
                    <p class="mt-2">ไม่มีโมดูลย่อย</p>
                    <button type="button" class="btn btn-primary btn-sm add-sub-module" data-parent-id="${d.Id}" data-parent-name="${d.Name}">
                        <i class="bi bi-plus-lg"></i> เพิ่มโมดูลย่อย
                    </button>
                </div>`;
            }

            let table = `
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0 text-primary"><i class="bi bi-arrow-return-right"></i> โมดูลย่อยของ ${d.Name}</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm add-sub-module" data-parent-id="${d.Id}" data-parent-name="${d.Name}">
                            <i class="bi bi-plus-lg"></i> เพิ่มโมดูลย่อย
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 60px">ลำดับ</th>
                                    <th>ชื่อโมดูลย่อย</th>
                                    <th>รายละเอียด</th>
                                    <th style="width: 100px">Controller</th>
                                    <th style="width: 100px">Action</th>
                                    <th class="text-center" style="width: 60px">ไอคอน</th>
                                    <th class="text-center" style="width: 80px">สถานะ</th>
                                    <th class="text-center" style="width: 120px">จัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            d.subModules.forEach(subModule => {
                table += `
                    <tr>
                        <td class="text-center"><span class="badge bg-secondary">${subModule.Order}</span></td>
                        <td><strong>${subModule.Name}</strong></td>
                        <td class="text-muted">${subModule.Description || '-'}</td>
                        <td><code class="text-info">${subModule.Controller || '-'}</code></td>
                        <td><code class="text-success">${subModule.Action || '-'}</code></td>
                        <td class="text-center">
                            ${subModule.Icon ? `<i class="${subModule.Icon}" style="font-size: 1.2rem;"></i>` : '<span class="text-muted">-</span>'}
                        </td>
                        <td class="text-center">
                            <div class="form-check form-switch d-flex justify-content-center">
                                <input class="form-check-input toggle-sub-status" 
                                    type="checkbox" id="subSwitch${subModule.Id}" 
                                    ${subModule.IsActive ? 'checked' : ''} 
                                    data-id="${subModule.Id}">
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-warning edit-sub-module" data-id="${subModule.Id}" title="แก้ไข">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger delete-sub-module" data-id="${subModule.Id}" title="ลบ">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            table += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;

            return table;
        }

        function initializeMainModuleTable() {
            try {
                showLoading();
                mainModuleTable = $('#moduleTable').DataTable({
                    processing: true,
                    serverSide: false,
                    searching: true,
                    paging: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    pageLength: 10,
                    language: {
                        processing: "กำลังโหลดข้อมูล...",
                        search: "ค้นหา:",
                        lengthMenu: "แสดง _MENU_ รายการ",
                        info: "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                        infoEmpty: "แสดง 0 ถึง 0 จาก 0 รายการ",
                        infoFiltered: "(กรองจากทั้งหมด _MAX_ รายการ)",
                        emptyTable: "ไม่พบข้อมูล",
                        zeroRecords: "ไม่พบข้อมูลที่ค้นหา",
                        paginate: {
                            first: "หน้าแรก",
                            last: "หน้าสุดท้าย",
                            next: "ถัดไป",
                            previous: "ก่อนหน้า"
                        }
                    },
                    ajax: {
                        url: appBasePath + 'Module/GetModules',
                        type: 'GET',
                        dataSrc: '',
                        beforeSend: function() {
                            showLoading();
                        },
                        complete: function() {
                            hideLoading();
                        }
                    },
                    columns: [
                        {
                            className: 'dt-control text-center',
                            orderable: false,
                            data: null,
                            defaultContent: '<i class="bi bi-plus-circle text-primary expand-icon" style="cursor: pointer; font-size: 1.1rem;" title="ดูโมดูลย่อย"></i>',
                            width: "30px"
                        },
                        {
                            data: 'Order',
                            className: 'text-center',
                            render: function(data) {
                                return `<span class="badge bg-primary">${data}</span>`;
                            }
                        },
                        {
                            data: 'Name',
                            render: function(data) {
                                return `<strong>${data}</strong>`;
                            }
                        },
                        {
                            data: 'Description',
                            className: 'text-muted',
                            render: function(data) {
                                return data || '-';
                            }
                        },
                        {
                            data: 'Icon',
                            className: 'text-center',
                            render: function(data) {
                                return data ? `<i class="${data}" style="font-size: 1.5rem;"></i>` : '<span class="text-muted">-</span>';
                            }
                        },
                        {
                            data: 'IsActive',
                            className: 'text-center',
                            render: function(data, type, row) {
                                return `
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input toggle-status" 
                                            type="checkbox" id="customSwitch${row.Id}" ${data ? 'checked' : ''} 
                                            data-id="${row.Id}">
                                    </div>
                                `;
                            }
                        },
                        {
                            data: null,
                            className: 'text-center',
                            orderable: false,
                            render: function(data, type, row) {
                                return `
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-warning edit-module" 
                                            data-id="${row.Id}" title="แก้ไข">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger delete-module" 
                                            data-id="${row.Id}" title="ลบ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                `;
                            }
                        }
                    ],
                    order: [[1, 'asc']],
                    drawCallback: function() {
                        // Update icon in expand/collapse indicator
                        const api = this.api();
                        $('#moduleTable tbody tr').each(function() {
                            const row = api.row(this);
                            const $icon = $(this).find('td.dt-control .expand-icon');
                            if (row.child.isShown()) {
                                $icon.removeClass('bi-plus-circle text-primary')
                                     .addClass('bi-dash-circle text-secondary')
                                     .attr('title', 'ซ่อนโมดูลย่อย');
                            } else {
                                $icon.removeClass('bi-dash-circle text-secondary')
                                     .addClass('bi-plus-circle text-primary')
                                     .attr('title', 'ดูโมดูลย่อย');
                            }
                        });
                    }
                });

                // เพิ่ม event handler สำหรับไอคอนขยาย/ย่อ
                $('#moduleTable tbody').on('click', 'td.dt-control', async function () {
                    const tr = $(this).closest('tr');
                    const row = mainModuleTable.row(tr);
                    const $icon = $(this).find('.expand-icon');

                    if (row.child.isShown()) {
                        row.child.hide();
                        tr.removeClass('shown');
                        $icon.removeClass('bi-dash-circle text-secondary')
                             .addClass('bi-plus-circle text-primary')
                             .attr('title', 'ดูโมดูลย่อย');
                    } else {
                        try {
                            // แสดงไอคอนโหลด
                            $icon.removeClass('bi-plus-circle text-primary')
                                 .addClass('bi-hourglass-split text-warning')
                                 .attr('title', 'กำลังโหลด...');
                            
                            const response = await $.get(appBasePath + 'Module/GetSubModules', { 
                                parentId: row.data().Id 
                            });
                            row.data().subModules = response;
                            row.child(formatSubModuleTable(row.data())).show();
                            tr.addClass('shown');
                            
                            $icon.removeClass('bi-hourglass-split text-warning')
                                 .addClass('bi-dash-circle text-secondary')
                                 .attr('title', 'ซ่อนโมดูลย่อย');
                        } catch (error) {
                            console.error('Error loading submodules:', error);
                            showError('ไม่สามารถโหลดข้อมูลโมดูลย่อยได้');
                            $icon.removeClass('bi-hourglass-split text-warning')
                                 .addClass('bi-plus-circle text-primary')
                                 .attr('title', 'ดูโมดูลย่อย');
                        }
                    }
                });

                // Event handlers for main module actions
                $('#moduleTable tbody').on('click', '.edit-module', function() {
                    const id = $(this).data('id');
                    editModule(id);
                });

                $('#moduleTable tbody').on('click', '.delete-module', function() {
                    const id = $(this).data('id');
                    deleteModule(id);
                });

                $('#moduleTable tbody').on('change', '.toggle-status', function() {
                    const id = $(this).data('id');
                    const isActive = $(this).prop('checked');
                    toggleModuleStatus(id, isActive, $(this));
                });

            } catch (error) {
                console.error('Error initializing DataTable:', error);
                showError('ไม่สามารถโหลดตารางข้อมูลได้');
            }
        }

        function resetModuleForm() {
            $('#moduleForm')[0].reset();
            $('#moduleId').val('');
            $('#iconPreview').attr('class', '');
            $('#addModuleModalLabel').text('เพิ่มโมดูลหลัก');
            isEditing = false;
        }

        function resetSubModuleForm() {
            $('#subModuleForm')[0].reset();
            $('#subModuleId').val('');
            $('#subModuleParentId').val('');
            $('#subIconPreview').attr('class', '');
            $('#addSubModuleModalLabel').text('เพิ่มโมดูลย่อย');
            isEditing = false;
        }

        function editModule(id) {
            $.get(appBasePath + 'Module/GetModuleById', { id: id })
                .done(function(response) {
                    if (response.success) {
                        const module = response.data;
                        $('#moduleId').val(module.Id);
                        $('#moduleOrder').val(module.Order);
                        $('#moduleName').val(module.Name);
                        $('#moduleDescription').val(module.Description);
                        $('#moduleIcon').val(module.Icon);
                        $('#moduleStatus').prop('checked', module.IsActive);
                        $('#iconPreview').attr('class', module.Icon || '');
                        $('#addModuleModalLabel').text('แก้ไขโมดูล');
                        isEditing = true;
                        $('#addModuleModal').modal('show');
                    } else {
                        showError('ไม่สามารถโหลดข้อมูลโมดูลได้');
                    }
                })
                .fail(function() {
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                });
        }

        function deleteModule(id) {
            if (confirm('คุณต้องการลบโมดูลนี้ใช่หรือไม่? (จะลบโมดูลย่อยทั้งหมดด้วย)')) {
                $.ajax({
                    url: appBasePath + 'Module/DeleteModule',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            showSuccess('ลบโมดูลเรียบร้อยแล้ว');
                            mainModuleTable.ajax.reload();
                        } else {
                            showError(response.message || 'ไม่สามารถลบโมดูลได้');
                        }
                    },
                    error: function() {
                        showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                    }
                });
            }
        }

        function toggleModuleStatus(id, isActive, $switch) {
            $.ajax({
                url: appBasePath + 'Module/ToggleModuleStatus',
                type: 'POST',
                data: { id: id, isActive: isActive },
                success: function(response) {
                    if (response.success) {
                        showSuccess(`${isActive ? 'เปิด' : 'ปิด'}การใช้งานโมดูลเรียบร้อยแล้ว`);
                        mainModuleTable.ajax.reload();
                    } else {
                        $switch.prop('checked', !isActive);
                        showError(response.message || 'ไม่สามารถเปลี่ยนสถานะได้');
                    }
                },
                error: function() {
                    $switch.prop('checked', !isActive);
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                }
            });
        }

        function saveModule() {
            const moduleData = {
                Order: $('#moduleOrder').val(),
                Name: $('#moduleName').val(),
                Description: $('#moduleDescription').val(),
                Icon: $('#moduleIcon').val(),
                IsActive: $('#moduleStatus').is(':checked')
            };

            if (!moduleData.Name || !moduleData.Order) {
                showError('กรุณากรอกข้อมูลให้ครบถ้วน');
                return;
            }

            if (isEditing) {
                moduleData.Id = $('#moduleId').val();
            }

            const url = isEditing ? appBasePath + 'Module/UpdateModule' : appBasePath + 'Module/AddModule';
            
            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(moduleData),
                success: function(response) {
                    if (response.success) {
                        showSuccess(isEditing ? 'แก้ไขโมดูลเรียบร้อยแล้ว' : 'เพิ่มโมดูลเรียบร้อยแล้ว');
                        $('#addModuleModal').modal('hide');
                        mainModuleTable.ajax.reload();
                    } else {
                        showError(response.message || 'ไม่สามารถบันทึกข้อมูลได้');
                    }
                },
                error: function() {
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                }
            });
        }

        function editSubModule(id) {
            $.get(appBasePath + 'Module/GetModuleById', { id: id })
                .done(function(response) {
                    if (response.success) {
                        const module = response.data;
                        $('#subModuleId').val(module.Id);
                        $('#subModuleParentId').val(module.ParentId);
                        $('#subModuleOrder').val(module.Order);
                        $('#subModuleName').val(module.Name);
                        $('#subModuleDescription').val(module.Description);
                        $('#subModuleController').val(module.Controller);
                        $('#subModuleAction').val(module.Action);
                        $('#subModuleIcon').val(module.Icon);
                        $('#subModuleStatus').prop('checked', module.IsActive);
                        $('#subIconPreview').attr('class', module.Icon || '');
                        $('#addSubModuleModalLabel').text('แก้ไขโมดูลย่อย');
                        isEditing = true;
                        $('#addSubModuleModal').modal('show');
                    } else {
                        showError('ไม่สามารถโหลดข้อมูลโมดูลย่อยได้');
                    }
                })
                .fail(function() {
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                });
        }

        function deleteSubModule(id) {
            if (confirm('คุณต้องการลบโมดูลย่อยนี้ใช่หรือไม่?')) {
                $.ajax({
                    url: appBasePath + 'Module/DeleteModule',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            showSuccess('ลบโมดูลย่อยเรียบร้อยแล้ว');
                            mainModuleTable.ajax.reload();
                        } else {
                            showError(response.message || 'ไม่สามารถลบโมดูลย่อยได้');
                        }
                    },
                    error: function() {
                        showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                    }
                });
            }
        }

        function toggleSubModuleStatus(id, isActive, $switch) {
            $.ajax({
                url: appBasePath + 'Module/ToggleModuleStatus',
                type: 'POST',
                data: { id: id, isActive: isActive },
                success: function(response) {
                    if (response.success) {
                        showSuccess(`${isActive ? 'เปิด' : 'ปิด'}การใช้งานโมดูลย่อยเรียบร้อยแล้ว`);
                        mainModuleTable.ajax.reload();
                    } else {
                        $switch.prop('checked', !isActive);
                        showError(response.message || 'ไม่สามารถเปลี่ยนสถานะได้');
                    }
                },
                error: function() {
                    $switch.prop('checked', !isActive);
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์');
                }
            });
        }

        function saveSubModule() {
            const subModuleData = {
                Order: $('#subModuleOrder').val(),
                Name: $('#subModuleName').val(),
                Description: $('#subModuleDescription').val(),
                Controller: $('#subModuleController').val(),
                Action: $('#subModuleAction').val(),
                Icon: $('#subModuleIcon').val(),
                IsActive: $('#subModuleStatus').is(':checked'),
                ParentId: $('#subModuleParentId').val()
            };

            console.log('Sub Module Data:', subModuleData);
            console.log('Is Editing:', isEditing);

            if (!subModuleData.Name || !subModuleData.Order || !subModuleData.ParentId) {
                console.log('Validation failed:', {
                    Name: subModuleData.Name,
                    Order: subModuleData.Order,
                    ParentId: subModuleData.ParentId
                });
                showError('กรุณากรอกข้อมูลให้ครบถ้วน (ชื่อโมดูล, ลำดับ)');
                return;
            }

            if (isEditing) {
                subModuleData.Id = $('#subModuleId').val();
            }

            const url = isEditing ? appBasePath + 'Module/UpdateSubModule' : appBasePath + 'Module/AddSubModule';
            console.log('URL:', url);
            
            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(subModuleData),
                success: function(response) {
                    console.log('Response:', response);
                    if (response.success) {
                        showSuccess(isEditing ? 'แก้ไขโมดูลย่อยเรียบร้อยแล้ว' : 'เพิ่มโมดูลย่อยเรียบร้อยแล้ว');
                        $('#addSubModuleModal').modal('hide');
                        mainModuleTable.ajax.reload();
                    } else {
                        showError(response.message || 'ไม่สามารถบันทึกข้อมูลได้');
                    }
                },
                error: function(xhr, status, error) {
                    console.log('Error details:', {
                        xhr: xhr,
                        status: status,
                        error: error,
                        responseText: xhr.responseText
                    });
                    showError('เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์: ' + error);
                }
            });
        }

        // Event handlers for sub module actions
        $(document).on('click', '.add-sub-module', function() {
            const parentId = $(this).data('parent-id');
            const parentName = $(this).data('parent-name');
            
            // Reset form ก่อน แล้วค่อยตั้งค่า ParentId
            resetSubModuleForm();
            $('#subModuleParentId').val(parentId);
            $('#addSubModuleModalLabel').text(`เพิ่มโมดูลย่อยใน ${parentName}`);
            $('#addSubModuleModal').modal('show');
        });

        $(document).on('click', '.edit-sub-module', function() {
            const id = $(this).data('id');
            editSubModule(id);
        });

        $(document).on('click', '.delete-sub-module', function() {
            const id = $(this).data('id');
            deleteSubModule(id);
        });

        $(document).on('change', '.toggle-sub-status', function() {
            const id = $(this).data('id');
            const isActive = $(this).prop('checked');
            toggleSubModuleStatus(id, isActive, $(this));
        });

    </script>
}



