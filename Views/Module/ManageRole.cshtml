@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@model IEnumerable<IPS_TH.Models.sys_role>

@{
    ViewData["Title"] = "จัดการสิทธิ์การใช้งาน";
}

<link rel="stylesheet" href="~/css/manage-role.css" />

<div class="container-fluid mt-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-user-shield text-primary me-2"></i>จัดการสิทธิ์การใช้งาน
            </h2>
            <p class="text-muted mb-0">จัดการสิทธิ์การเข้าถึงระบบและโมดูลต่างๆ</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg shadow-sm" id="addNewRoleButton">
            <i class="fas fa-plus me-2"></i>เพิ่มสิทธิ์การใช้งาน
        </button>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2 text-primary"></i>รายการสิทธิ์การใช้งาน
                </h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="refreshTable">
                        <i class="fas fa-sync-alt me-1"></i>รีเฟรช
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="roleTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px" class="text-center">
                                <i class="fas fa-expand-alt text-muted"></i>
                            </th>
                            <th>
                                <i class="fas fa-user-tag me-1 text-primary"></i>ชื่อสิทธิ์
                            </th>
                            <th>
                                <i class="fas fa-info-circle me-1 text-primary"></i>รายละเอียด
                            </th>
                            <th class="text-center" style="width: 100px">
                                <i class="fas fa-toggle-on me-1 text-primary"></i>สถานะ
                            </th>
                            <th class="text-center" style="width: 120px">
                                <i class="fas fa-cogs me-1 text-primary"></i>จัดการ
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- DataTable will populate this -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i>
                <span id="successMessage">ดำเนินการสำเร็จ</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-exclamation-circle me-2"></i>
                <span id="errorMessage">เกิดข้อผิดพลาด</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i>แก้ไขสิทธิ์การใช้งาน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editRoleForm">
                    <input type="hidden" id="editRoleId">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-user-tag me-1 text-primary"></i>ชื่อสิทธิ์
                        </label>
                        <input type="text" class="form-control form-control-lg" id="editRoleName" 
                               placeholder="กรอกชื่อสิทธิ์การใช้งาน" required>
                        <div class="form-text">ชื่อที่ใช้เรียกสิทธิ์การใช้งานนี้</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-info-circle me-1 text-primary"></i>รายละเอียด
                        </label>
                        <textarea class="form-control" id="editRoleDescription" rows="4" 
                                  placeholder="อธิบายรายละเอียดของสิทธิ์การใช้งานนี้"></textarea>
                        <div class="form-text">คำอธิบายเพิ่มเติมเกี่ยวกับสิทธิ์การใช้งาน</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="editRoleStatus">
                            <label class="form-check-label fw-semibold" for="editRoleStatus">
                                <i class="fas fa-toggle-on me-1 text-success"></i>เปิดใช้งาน
                            </label>
                        </div>
                        <div class="form-text">เปิด/ปิดการใช้งานสิทธิ์นี้</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-primary" id="saveRoleChanges">
                    <i class="fas fa-save me-1"></i>บันทึกการเปลี่ยนแปลง
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ประกาศตัวแปร appBasePath
    var appBasePath = '@Url.Content("~/")';
    
    $(document).ready(function() {
        // Initialize DataTable with improved styling
        var table = $('#roleTable').DataTable({
            processing: true,
            serverSide: false,
            pageLength: 10,
            lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
            language: {
                url: appBasePath + 'js/datatables/i18n/th.json'
            },
            ajax: {
                url: appBasePath + 'Module/GetRoles',
                type: 'GET',
                dataSrc: function(json) {
                    console.log('Received data:', json);
                    return json || [];
                },
                error: function(xhr, error, thrown) {
                    console.error('DataTables error:', error);
                    showToast('error', 'ไม่สามารถโหลดข้อมูลได้');
                }
            },
            columns: [
                {
                    className: 'details-control text-center',
                    orderable: false,
                    data: null,
                    render: function(data, type, row) {
                        return '<i class="fas fa-chevron-right text-muted" style="cursor: pointer;" data-role-id="' +
                            row.Id + '" title="คลิกเพื่อดูสิทธิ์โมดูล"></i>';
                    }
                },
                {
                    data: 'RoleName',
                    title: 'ชื่อสิทธิ์',
                    render: function(data) {
                        return data || '-';
                    }
                },
                {
                    data: 'RoleDescription',
                    title: 'รายละเอียด',
                    render: function(data) {
                        return data || '-';
                    }
                },
                {
                    data: 'IsActive',
                    className: 'text-center',
                    title: 'สถานะ',
                    render: function(data, type, row) {
                        const isActive = row.IsActive;
                        return `
                            <div class="d-flex justify-content-center">
                                <div class="form-check form-switch">
                                    <input class="form-check-input status-switch" type="checkbox" 
                                        ${isActive ? 'checked' : ''} 
                                        data-role-id="${row.Id}" 
                                        data-bs-toggle="tooltip" 
                                        title="${isActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}">
                                </div>
                                <span class="badge rounded-pill ms-2 ${isActive ? 'bg-success' : 'bg-danger'}">
                                    ${isActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
                                </span>
                            </div>`;
                    }
                },
                {
                    data: null,
                    className: 'text-center',
                    title: 'จัดการ',
                    orderable: false,
                    render: function(data, type, row) {
                        return `
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-primary edit-role" 
                                        title="แก้ไขสิทธิ์" data-bs-toggle="tooltip"
                                        data-role-id="${row.Id}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info view-permissions" 
                                        title="ดูสิทธิ์โมดูล" data-bs-toggle="tooltip"
                                        data-role-id="${row.Id}">
                                    <i class="fas fa-shield-alt"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger delete-role" 
                                        title="ลบสิทธิ์" data-bs-toggle="tooltip"
                                        data-role-id="${row.Id}">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>`;
                    }
                }
            ],
            order: [
                [1, 'asc']
            ],
            responsive: true,
            drawCallback: function(settings) {
                // Initialize tooltips after table is drawn
                $('[data-bs-toggle="tooltip"]').tooltip();
            }
        });

        // Toast function
        function showToast(type, message) {
            const toastId = type === 'success' ? 'successToast' : 'errorToast';
            const messageId = type === 'success' ? 'successMessage' : 'errorMessage';
            
            $(`#${messageId}`).text(message);
            const toast = new bootstrap.Toast(document.getElementById(toastId));
            toast.show();
        }

        // Refresh table button
        $('#refreshTable').click(function() {
            table.ajax.reload();
            showToast('success', 'รีเฟรชข้อมูลเรียบร้อยแล้ว');
        });

        // Add New Role Button Click
        $('#addNewRoleButton').click(function() {
            Swal.fire({
                title: '<i class="fas fa-plus-circle text-primary me-2"></i>เพิ่มสิทธิ์การใช้งานใหม่',
                html: `
                    <form id="newRoleForm">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user-tag me-1 text-primary"></i>ชื่อสิทธิ์
                            </label>
                            <input type="text" id="newRoleName" class="form-control form-control-lg" 
                                   placeholder="กรอกชื่อสิทธิ์การใช้งาน" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-info-circle me-1 text-primary"></i>รายละเอียด
                            </label>
                            <textarea id="newRoleDescription" class="form-control" rows="4" 
                                      placeholder="อธิบายรายละเอียดของสิทธิ์การใช้งานนี้"></textarea>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="newRoleStatus" checked>
                            <label class="form-check-label fw-semibold">
                                <i class="fas fa-toggle-on me-1 text-success"></i>เปิดใช้งาน
                            </label>
                        </div>
                    </form>`,
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-save me-1"></i>บันทึก',
                cancelButtonText: '<i class="fas fa-times me-1"></i>ยกเลิก',
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                preConfirm: () => {
                    const roleName = $('#newRoleName').val().trim();
                    if (!roleName) {
                        Swal.showValidationMessage('กรุณากรอกชื่อสิทธิ์');
                        return false;
                    }
                    return {
                        roleName: roleName,
                        roleDescription: $('#newRoleDescription').val().trim(),
                        isActive: $('#newRoleStatus').is(':checked')
                    };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: appBasePath + 'Role/AddRole',
                        type: 'POST',
                        data: JSON.stringify(result.value),
                        contentType: 'application/json',
                        success: function(response) {
                            if (response.success) {
                                showToast('success', 'เพิ่มสิทธิ์การใช้งานเรียบร้อยแล้ว');
                                table.ajax.reload();
                            } else {
                                showToast('error', response.message || 'ไม่สามารถเพิ่มสิทธิ์ได้');
                            }
                        },
                        error: function() {
                            showToast('error', 'เกิดข้อผิดพลาดในการเชื่อมต่อ');
                        }
                    });
                }
            });
        });

        // Event handlers for table buttons
        $('#roleTable tbody').on('click', '.edit-role', function() {
            const roleId = $(this).data('role-id');
            const row = table.row($(this).closest('tr'));
            const data = row.data();
            
            $('#editRoleId').val(data.Id);
            $('#editRoleName').val(data.RoleName);
            $('#editRoleDescription').val(data.RoleDescription);
            $('#editRoleStatus').prop('checked', data.IsActive);
            
            $('#editRoleModal').modal('show');
        });

        $('#roleTable tbody').on('click', '.view-permissions', function() {
            const roleId = $(this).data('role-id');
            const row = table.row($(this).closest('tr'));
            const data = row.data();
            
            // Show module permissions modal
            $('#modulePermissionsModal').modal('show');
            loadModulePermissions(roleId, data.RoleName);
        });

        $('#roleTable tbody').on('click', '.delete-role', function() {
            const roleId = $(this).data('role-id');
            const row = table.row($(this).closest('tr'));
            const data = row.data();
            
            Swal.fire({
                title: '<i class="fas fa-exclamation-triangle text-warning me-2"></i>ยืนยันการลบ',
                html: `คุณแน่ใจหรือไม่ที่จะลบสิทธิ์ <strong>${data.RoleName}</strong>?<br><small class="text-muted">การดำเนินการนี้ไม่สามารถยกเลิกได้</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-trash me-1"></i>ลบ',
                cancelButtonText: '<i class="fas fa-times me-1"></i>ยกเลิก',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                    url: appBasePath + 'Role/DeleteRole',
                        type: 'POST',
                        data: { id: roleId },
                        success: function(response) {
                            if (response.success) {
                                showToast('success', 'ลบสิทธิ์การใช้งานเรียบร้อยแล้ว');
                                table.ajax.reload();
                            } else {
                                showToast('error', response.message || 'ไม่สามารถลบสิทธิ์ได้');
                            }
                        },
                        error: function() {
                            showToast('error', 'เกิดข้อผิดพลาดในการเชื่อมต่อ');
                        }
                    });
                }
            });
        });

        // Status toggle
        $('#roleTable tbody').on('change', '.status-switch', function() {
            const roleId = $(this).data('role-id');
            const isChecked = $(this).prop('checked');
            const row = table.row($(this).closest('tr'));
            const data = row.data();
            
            $.ajax({
                url: appBasePath + 'Role/ToggleRoleStatus',
                type: 'POST',
                data: { id: roleId, status: isChecked },
                success: function(response) {
                    if (response.success) {
                        showToast('success', `เปลี่ยนสถานะสิทธิ์ ${data.RoleName} เรียบร้อยแล้ว`);
                        table.ajax.reload();
                    } else {
                        showToast('error', response.message || 'ไม่สามารถเปลี่ยนสถานะได้');
                        // Revert the checkbox
                        $(this).prop('checked', !isChecked);
                    }
                },
                error: function() {
                    showToast('error', 'เกิดข้อผิดพลาดในการเชื่อมต่อ');
                    // Revert the checkbox
                    $(this).prop('checked', !isChecked);
                }
            });
        });

        // Save role changes
        $('#saveRoleChanges').click(function() {
            const roleId = $('#editRoleId').val();
            const roleName = $('#editRoleName').val().trim();
            const roleDescription = $('#editRoleDescription').val().trim();
            const isActive = $('#editRoleStatus').is(':checked');
            
            if (!roleName) {
                showToast('error', 'กรุณากรอกชื่อสิทธิ์');
                return;
            }
            
            $.ajax({
            url: appBasePath + 'Role/UpdateRole',
                type: 'POST',
                data: JSON.stringify({
                    Id: roleId,
                    RoleName: roleName,
                    RoleDescription: roleDescription,
                    IsActive: isActive
                }),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        showToast('success', 'อัปเดตสิทธิ์การใช้งานเรียบร้อยแล้ว');
                        $('#editRoleModal').modal('hide');
                        table.ajax.reload();
                    } else {
                        showToast('error', response.message || 'ไม่สามารถอัปเดตสิทธิ์ได้');
                    }
                },
                error: function() {
                    showToast('error', 'เกิดข้อผิดพลาดในการเชื่อมต่อ');
                }
            });
        });

        // Load module permissions
        function loadModulePermissions(roleId, roleName) {
            $('#modulePermissionsContent').html(`
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">กำลังโหลด...</span>
                    </div>
                    <p class="mt-2 text-muted">กำลังโหลดสิทธิ์โมดูลสำหรับ ${roleName}</p>
                </div>
            `);
            
            // Load permissions here
            // This will be implemented based on your existing permission loading logic
        }

        // Expand/collapse row details
        $('#roleTable tbody').on('click', '.details-control', function() {
            const tr = $(this).closest('tr');
            const row = table.row(tr);
            const rowData = row.data();
            const roleId = rowData && rowData.Id ? rowData.Id : null;

            if (!roleId) {
                showToast('error', 'ไม่พบข้อมูล roleId');
                return;
            }

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                $(this).find('i').removeClass('fa-chevron-down').addClass('fa-chevron-right');
            } else {
                row.child(formatModulePermissions(rowData)).show();
                tr.addClass('shown');
                $(this).find('i').removeClass('fa-chevron-right').addClass('fa-chevron-down');
                initializePermissionHandlers(roleId);
            }
        });

        function formatModulePermissions(rowData) {
            console.log('Formatting module permissions for:', rowData);
            
            if (!rowData || !rowData.Id) {
                console.error('Invalid rowData or missing Id:', rowData);
                return `
                <div class="module-permissions-container">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center py-4">
                            <i class="fas fa-exclamation-triangle text-danger fa-2x mb-2"></i>
                            <p class="text-danger mb-0">ไม่พบข้อมูลสิทธิ์</p>
                            <small class="text-muted">rowData: ${JSON.stringify(rowData)}</small>
                        </div>
                    </div>
                </div>`;
            }
            
            console.log('Creating permissions table for roleId:', rowData.Id);
            
            return `
            <div class="module-permissions-container">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-gradient-primary text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fas fa-shield-alt me-2"></i>
                                สิทธิ์การใช้งานของ: <strong>${rowData.RoleName || 'ไม่ระบุ'}</strong>
                            </h6>
                            <button type="button" class="btn btn-outline-light btn-sm" onclick="refreshPermissions(${rowData.Id})">
                                <i class="fas fa-sync-alt me-1"></i>รีเฟรช
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 permission-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 25%; padding: 15px;">
                                            <i class="fas fa-folder text-primary me-2"></i>โมดูล
                                        </th>
                                        <th class="text-center" style="width: 12%;">
                                            <i class="fas fa-eye text-info me-1"></i>ดูข้อมูล
                                        </th>
                                        <th class="text-center" style="width: 12%;">
                                            <i class="fas fa-plus-circle text-success me-1"></i>เพิ่มข้อมูล
                                        </th>
                                        <th class="text-center" style="width: 12%;">
                                            <i class="fas fa-edit text-warning me-1"></i>แก้ไขข้อมูล
                                        </th>
                                        <th class="text-center" style="width: 12%;">
                                            <i class="fas fa-trash text-danger me-1"></i>ลบข้อมูล
                                        </th>
                                        <th class="text-center" style="width: 12%;">
                                            <i class="fas fa-check-circle text-success me-1"></i>อนุมัติ
                                        </th>
                                        <th class="text-center" style="width: 15%;">
                                            <i class="fas fa-chart-bar text-primary me-1"></i>ดูรายงาน
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="modulePermissions_${rowData.Id}">
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">กำลังโหลด...</span>
                                            </div>
                                            <p class="mt-2 text-muted">กำลังโหลดสิทธิ์การใช้งาน...</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        // Refresh permissions function
        function refreshPermissions(roleId) {
            console.log('Refreshing permissions for roleId:', roleId);
            
            if (!roleId) {
                showToast('error', 'ไม่พบข้อมูล roleId');
                return;
            }
            
            const tbodyId = `modulePermissions_${roleId}`;
            console.log('Looking for tbody with ID:', tbodyId);
            
            const tbody = $(`#${tbodyId}`);
            if (tbody.length === 0) {
                console.error('ไม่พบ tbody ด้วย ID:', tbodyId);
                console.log('Available tbody elements:', $('tbody[id^="modulePermissions_"]').map(function() { return this.id; }).get());
                showToast('error', 'ไม่พบตารางสิทธิ์');
                return;
            }
            
            tbody.html(`
                <tr>
                    <td colspan="7" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">กำลังโหลด...</span>
                        </div>
                        <p class="mt-2 text-muted">กำลังโหลดสิทธิ์การใช้งาน...</p>
                    </td>
                </tr>
            `);
            
            try {
                initializePermissionHandlers(roleId);
            } catch (error) {
                console.error('Error in refreshPermissions:', error);
                showToast('error', 'เกิดข้อผิดพลาดในการรีเฟรช');
            }
        }

        async function initializePermissionHandlers(roleId) {
            try {
                console.log("เริ่มโหลดข้อมูลโมดูลหลักสำหรับ roleId:", roleId);
                
                if (!roleId) {
                    throw new Error("roleId is required");
                }
                
                const tbodyId = `modulePermissions_${roleId}`;
                console.log('Looking for tbody with ID:', tbodyId);
                
                const tbody = $(`#${tbodyId}`);
                if (tbody.length === 0) {
                    console.error('ไม่พบ tbody ด้วย ID:', tbodyId);
                    console.log('Available tbody elements:', $('tbody[id^="modulePermissions_"]').map(function() { return this.id; }).get());
                    throw new Error("ไม่พบตารางสิทธิ์สำหรับ roleId: " + roleId);
                }
                
                const modules = await             $.ajax({
                url: appBasePath + 'Role/GetMainModule',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(roleId)
                });
                
                console.log("ได้รับข้อมูลโมดูล:", modules);
                
                tbody.empty();
                
                if (!modules || modules.error) {
                    console.error("ข้อมูลโมดูลไม่ถูกต้อง:", modules);
                    throw new Error(modules?.error || "ไม่สามารถโหลดข้อมูลได้");
                }
                
                if (modules.length === 0) {
                    tbody.html(`
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-info-circle text-muted fa-2x mb-2"></i>
                                <p class="text-muted mb-0">ไม่พบโมดูลที่สามารถจัดการสิทธิ์ได้</p>
                            </td>
                        </tr>
                    `);
                    return;
                }
                
                modules.forEach(function(module) {
                    console.log('Processing module:', module);
                    
                    if (!module || !module.Id) {
                        console.warn('Invalid module data:', module);
                        return;
                    }
                    
                    const row = $(`
                        <tr class="align-middle">
                            <td style="padding: 12px 15px;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-folder text-primary me-2"></i>
                                                                        <span class="fw-medium">${module.Name || 'ไม่ระบุ'}</span>
                            </div>
                            ${module.HasChildren ? `
                                <button type="button" class="btn btn-sm btn-outline-primary show-child-modules" 
                                        data-bs-toggle="tooltip" 
                                        data-module-id="${module.Id}"
                                        data-role-id="${roleId}"
                                        title="แสดงโมดูลย่อย">
                                    <i class="fas fa-sitemap me-1"></i>โมดูลย่อย
                                </button>` : ''}
                                </div>
                            </td>
                            ${['IsView', 'IsAdd', 'IsEdit', 'IsDelete', 'IsApprove', 'IsReport'].map(permission => `
                                <td class="text-center" style="padding: 8px;">
                                    <div class="form-check d-flex justify-content-center mb-0">
                                        <input type="checkbox" class="form-check-input permission-checkbox" 
                                               style="cursor: pointer; transform: scale(1.2);"
                                               data-module-id="${module.Id}" data-role-id="${roleId}" 
                                               data-permission="${permission.toLowerCase()}" 
                                               ${(module.Permissions && module.Permissions[permission]) ? 'checked' : ''}>
                                    </div>
                                </td>
                            `).join('')}
                        </tr>
                    `);
                    tbody.append(row);
                });
                
                // Initialize tooltips
                $('[data-bs-toggle="tooltip"]').tooltip();
                
                // Initialize permission change events
                initializePermissionEvents(roleId);
                
            } catch (error) {
                console.error('Error loading main modules:', error);
                const tbodyId = `modulePermissions_${roleId}`;
                const tbody = $(`#${tbodyId}`);
                if (tbody.length > 0) {
                    tbody.html(`
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-exclamation-triangle text-danger fa-2x mb-2"></i>
                                <p class="text-danger mb-0">เกิดข้อผิดพลาดในการโหลดข้อมูล</p>
                                <small class="text-muted">${error.message}</small>
                            </td>
                        </tr>
                    `);
                } else {
                    console.error('ไม่พบตารางสำหรับแสดงข้อผิดพลาด, tbodyId:', tbodyId);
                }
            }
        }

        function initializePermissionEvents(roleId) {
            // Permission checkbox change event
            $(document).off('change', '.permission-checkbox').on('change', '.permission-checkbox', function() {
                const checkbox = $(this);
                const moduleId = checkbox.data('module-id');
                const roleId = checkbox.data('role-id');
                const permission = checkbox.data('permission');
                const isChecked = checkbox.prop('checked');
                
                // Visual feedback
                const td = checkbox.closest('td');
                td.css('background-color', '#e8f5e9');
                setTimeout(() => td.css('background-color', ''), 300);
                
                updatePermission(moduleId, roleId, permission, isChecked, checkbox);
            });

            // Show child modules button click
            $(document).off('click', '.show-child-modules').on('click', '.show-child-modules', function() {
                const moduleId = $(this).data('module-id');
                const roleId = $(this).data('role-id');
                const row = $(this).closest('tr');
                const icon = $(this);
                
                // Toggle button state
                if (icon.hasClass('btn-outline-primary')) {
                    icon.removeClass('btn-outline-primary').addClass('btn-primary');
                    icon.html('<i class="fas fa-sitemap me-1"></i>ซ่อนโมดูลย่อย');
                } else {
                    icon.removeClass('btn-primary').addClass('btn-outline-primary');
                    icon.html('<i class="fas fa-sitemap me-1"></i>แสดงโมดูลย่อย');
                }
                
                // Toggle child modules
                const childContainer = row.next('.child-modules-row');
                if (childContainer.length) {
                    childContainer.toggle();
                    return;
                }
                
                loadChildModules(moduleId, roleId, row);
            });
        }

        function loadChildModules(moduleId, roleId, parentRow) {
            $.ajax({
                    url: appBasePath + 'Role/GetSubModules',
                type: 'GET',
                data: {
                    roleId: roleId,
                    moduleId: moduleId
                },
                success: function(response) {
                    console.log("ข้อมูลโมดูลย่อยที่ได้รับ:", response);
                    
                    if (!response.success) {
                        console.error("การโหลดโมดูลย่อยไม่สำเร็จ:", response.error);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.error || 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                            confirmButtonText: 'ตกลง'
                        });
                        return;
                    }
                    
                    const childModules = response.data;
                    
                    if (Array.isArray(childModules) && childModules.length > 0) {
                        const childContainer = $('<tr class="child-modules-row">');
                        const childContent = $('<td colspan="7">');
                        const childTable = $(`
                            <div class="ms-4 me-2 my-2">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-light py-2 px-3" style="border-bottom: 1px solid #e9ecef;">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-code-branch text-secondary me-2"></i>
                                            <span class="fw-medium">โมดูลย่อย</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 25%; padding: 12px;">
                                                            <i class="fas fa-folder-open text-primary me-2"></i>ชื่อโมดูล
                                                        </th>
                                                        <th class="text-center" style="width: 12%;">
                                                            <i class="fas fa-eye text-info"></i>
                                                        </th>
                                                        <th class="text-center" style="width: 12%;">
                                                            <i class="fas fa-plus-circle text-success"></i>
                                                        </th>
                                                        <th class="text-center" style="width: 12%;">
                                                            <i class="fas fa-edit text-warning"></i>
                                                        </th>
                                                        <th class="text-center" style="width: 12%;">
                                                            <i class="fas fa-trash text-danger"></i>
                                                        </th>
                                                        <th class="text-center" style="width: 12%;">
                                                            <i class="fas fa-check-circle text-success"></i>
                                                        </th>
                                                        <th class="text-center" style="width: 15%;">
                                                            <i class="fas fa-chart-bar text-primary"></i>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                        `);
                        
                        childModules.forEach(function(child) {
                            const permissions = child.Permissions || {};
                            const childRow = $(`
                                <tr class="align-middle" style="transition: all 0.2s;">
                                    <td style="padding: 10px 12px;">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-angle-right text-secondary me-2"></i>
                                            <span>${child.Name || '-'}</span>
                                        </div>
                                    </td>
                                    ${['IsView', 'IsAdd', 'IsEdit', 'IsDelete', 'IsApprove', 'IsReport'].map(permission => `
                                        <td class="text-center" style="padding: 8px;">
                                            <div class="form-check d-flex justify-content-center mb-0">
                                                <input type="checkbox" 
                                                       class="form-check-input permission-checkbox" 
                                                       style="cursor: pointer; transform: scale(1.1);"
                                                       data-module-id="${child.Id}" 
                                                       data-role-id="${roleId}" 
                                                       data-permission="${permission.toLowerCase()}" 
                                                       ${permissions[permission] ? 'checked' : ''}>
                                            </div>
                                        </td>
                                    `).join('')}
                                </tr>
                            `);
                            childTable.find('tbody').append(childRow);
                        });
                        
                        childTable.append(`
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `);
                        childContent.append(childTable);
                        childContainer.append(childContent);
                        childContainer.insertAfter(parentRow);
                        
                        // เพิ่ม hover effect และ animation
                        addEffectsToTable(childContainer);
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'ไม่พบโมดูลย่อย',
                            text: 'โมดูลนี้ไม่มีโมดูลย่อย',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error("เกิดข้อผิดพลาดในการโหลดโมดูลย่อย:", error);
                    console.error("สถานะ:", status);
                    console.error("รายละเอียด:", xhr.responseText);
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                        confirmButtonText: 'ตกลง'
                    });
                }
            });
        }

        function addEffectsToTable(container) {
            // Hover effect
            container.find('tr').hover(
                function() {
                    $(this).css({
                        'background-color': '#f8f9fa',
                        'transition': 'background-color 0.2s ease'
                    });
                },
                function() {
                    $(this).css('background-color', '');
                }
            );
            // Checkbox animation
            container.find('.permission-checkbox').on('change', function() {
                const checkbox = $(this);
                const td = checkbox.closest('td');
                td.css({
                    'transform': 'scale(1.05)',
                    'transition': 'transform 0.2s ease'
                });
                setTimeout(() => td.css('transform', ''), 200);
            });
        }

        function updatePermission(moduleId, roleId, permission, isChecked, checkbox) {
            // Add loading state
            checkbox.prop('disabled', true);
            
            $.ajax({
                url: appBasePath + 'Role/UpdateRolePermission',
                type: 'POST',
                data: {
                    roleId: roleId,
                    moduleId: moduleId,
                    permissionType: permission,
                    isGranted: isChecked
                },
                success: function(response) {
                    if (response.success) {
                        showToast('success', 'อัปเดตสิทธิ์สำเร็จ');
                    } else {
                        showToast('error', response.message || 'ไม่สามารถอัปเดตสิทธิ์ได้');
                        checkbox.prop('checked', !isChecked); // Revert change
                    }
                },
                error: function() {
                    showToast('error', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้');
                    checkbox.prop('checked', !isChecked); // Revert change
                },
                complete: function() {
                    checkbox.prop('disabled', false);
                }
            });
        }

        function updateCheckboxes(moduleId, roleId, permissions) {
            const selector = `#modulePermissions_${roleId} input[data-module-id="${moduleId}"]`;
            const checkboxes = $(selector);
            if (checkboxes.length === 0) {
                console.warn(`No checkboxes found for selector: ${selector}`);
                return;
            }
            checkboxes.each(function() {
                const $checkbox = $(this);
                const permission = $checkbox.data('permission').toLowerCase();
                const currentValue = $checkbox.prop('checked');
                const newValue = permissions[permission] || false;
                if (currentValue !== newValue) {
                    console.log(`Updating ${permission} from ${currentValue} to ${newValue}`);
                    $checkbox.prop('checked', newValue);
                }
            });
        }
        
        // เพิ่ม CSS สำหรับ visual feedback 
        $('<style>')
            .text(`
                .permission-checkbox {
                    transition: all 0.2s ease;
                }
                .permission-checkbox:checked {
                    background-color: #4CAF50;
                    border-color: #4CAF50;
                }
                .permission-checkbox:disabled {
                    opacity: 0.6;
                    cursor: not-allowed;
                }
            `)
            .appendTo('head');
    });
</script>
} 