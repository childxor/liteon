@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@model IEnumerable<IPS_TH.Models.sys_role>

    @{
    ViewData["Title"] = "จัดการสิทธิ์การใช้งาน";
    }

    <div class="container-fluid">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">
                <i class="fas fa-user-shield me-2"></i>จัดการสิทธิ์การใช้งาน
            </h2>
            <button type="button" class="btn btn-primary" id="addNewRoleButton">
                <i class="fas fa-plus me-2"></i>เพิ่มสิทธิ์การใช้งาน
            </button>
        </div>

        <!-- Data Table Card -->
        <div class="card shadow-sm">
            <div class="card-body">
                <table id="roleTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50px"></th>
                            <th>ชื่อสิทธิ์</th>
                            <th>รายลเอียด</th>
                            <th class="text-center">สถานะ</th>
                            <th class="text-center" style="width: 120px">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- DataTable will populate this -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Edit Role Modal -->
    <div class="modal fade" id="editRoleModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">แก้ไขสิทธิ์การใช้งาน</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="editRoleForm" class="row g-3">
                        <input type="hidden" id="editRoleId">
                        <div class="col-12">
                            <label class="form-label">ชื่อสิทธิ์</label>
                            <input type="text" class="form-control" id="editRoleName" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รายละเอียด</label>
                            <textarea class="form-control" id="editRoleDescription" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="editRoleStatus">
                                <label class="form-check-label" for="editRoleStatus">เปิดใช้งาน</label>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    <button type="button" class="btn btn-primary" id="saveRoleChanges">บันทึก</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Module Permissions Modal -->
    <div class="modal fade" id="modulePermissionsModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">จัดการสิทธิ์การใช้งานโมดูล</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="modulePermissionsContent" class="table-responsive">
                        <!-- Permission content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sub Module Modal -->
    <div class="modal fade" id="subModuleModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">จัดการโมดูลย่อย</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="subModuleContent" class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">ชื่อโมดูล</th>
                                    <th class="text-center">รายละเอียด</th>
                                    <th class="text-center">สถานะ</th>
                                    <th class="text-center">จัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Sub module data will be populated here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with improved styling
            var table = $('#roleTable').DataTable({
                processing: true,
                serverSide: false,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/th.json'
                },
                ajax: {
                    url: '@Url.Action("GetRoles", "Module")',
                    type: 'GET',
                    dataSrc: function(json) {
                        console.log('Received data:', json); // Debug log
                        return json || [];
                    },
                    error: function(xhr, error, thrown) {
                        console.error('DataTables error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถโหลดข้อมูลได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                },
                columns: [{
                        className: 'details-control',
                        orderable: false,
                        data: null,
                        render: function(data, type, row) {
                            return '<i class="fas fa-plus-circle text-primary" data-role-id="' +
                                row.Id + '"></i>';
                        }
                    },
                    {
                        data: 'RoleName',
                        title: 'ชื่อสิทธิ์',
                        render: function(data) {
                            return data
                        }
                    },
                    {
                        data: 'RoleDescription',
                        title: 'รายละเอียด',
                        render: function(data) {
                            return data
                        }
                    },
                    {
                        data: 'isActive',
                        className: 'text-center',
                        title: 'สถานะ',
                        render: function(data, type, row) {
                            console.log(row.IsActive);
                            return `<div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input status-switch" type="checkbox" 
                                            ${row.IsActive ? 'checked' : ''} 
                                            data-role-id="${row.Id}" 
                                            data-bs-toggle="tooltip" 
                                            title="${row.IsActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}">
                                    </div>`;
                        }
                    },
                    {
                        data: null,
                        className: 'text-center',
                        title: 'จัดการ',
                        orderable: false,
                        render: function() {
                            return `
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary edit-role" title="แก้ไข">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger delete-role" title="ลบ">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                order: [
                    [1, 'asc']
                ],
                responsive: true,
                drawCallback: function(settings) {
                    console.log('Table redrawn:', settings); // Debug log
                }
            });
            // Add New Role Button Click
            $('#addNewRoleButton').click(function() {
                Swal.fire({
                    title: 'เพิ่มสิทธิ์การใช้งานใหม่',
                    html: `
                        <form id="newRoleForm">
                            <div class="mb-3">
                                <label class="form-label">ชื่อสิทธิ์</label>
                                <input type="text" id="newRoleName" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">รายละเอียด</label>
                                <textarea id="newRoleDescription" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="newRoleStatus" checked>
                                <label class="form-check-label">เปิดใช้งาน</label>
                            </div>
                        </form>`,
                    showCancelButton: true,
                    confirmButtonText: 'บันทึก',
                    cancelButtonText: 'ยกเลิก',
                    preConfirm: () => {
                        return {
                            roleName: $('#newRoleName').val(),
                            roleDescription: $('#newRoleDescription').val(),
                            isActive: $('#newRoleStatus').is(':checked')
                        };
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("AddRole", "Role")',
                            type: 'POST',
                            data: JSON.stringify(result.value),
                            contentType: 'application/json',
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('สำเร็จ',
                                        'เพิ่มสิทธิ์การใช้งานเรียบร้อยแล้ว',
                                        'success');
                                    table.ajax.reload();
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            }
                        });
                    }
                });
            });
            // Row details click (Module Permissions)
            $('#roleTable tbody').on('click', 'td.details-control', function() {
                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var icon = $(this).find('i');
                var roleId = row.data().Id;
                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    icon.removeClass('fa-minus-circle').addClass('fa-plus-circle');
                } else {
                    row.child(formatModulePermissions(row.data())).show();
                    tr.addClass('shown');
                    icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
                    console.log(roleId);
                    initializePermissionHandlers(roleId);
                }
            });
            // New event handler for opening sub module modal
            $(document).on('click', '.open-sub-module', function() {
                var roleId = $(this).data('role-id'); // Get role ID from data attribute
                loadSubModuleContent(roleId); // Load sub module content
                $('#subModuleModal').modal('show'); // Show the modal
            });

            function loadSubModuleContent(roleId) {
                // AJAX call to load sub module data
                $.ajax({
                    url: '@Url.Action("GetSubModules", "Role")',
                    type: 'GET',
                    data: {
                        roleId: roleId,
                        moduleId: 0 // โมดูลหลัก (Parent ID = 0)
                    },
                    success: function(response) {
                        if (response.success) {
                            const subModules = response.data;
                            
                            // สร้างเนื้อหาตาราง
                            let tableContent = `
                            <table class="table table-striped table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 50px;">ลำดับ</th>
                                        <th class="text-center">ชื่อโมดูล</th>
                                        <th class="text-center">รายละเอียด</th>
                                        <th class="text-center" style="width: 100px;">Controller</th>
                                        <th class="text-center" style="width: 100px;">Action</th>
                                        <th class="text-center" style="width: 80px;">ไอคอน</th>
                                        <th class="text-center" style="width: 80px;">สถานะ</th>
                                        <th class="text-center" style="width: 120px;">จัดการสิทธิ์</th>
                                    </tr>
                                </thead>
                                <tbody>`;
                            
                            if (subModules.length > 0) {
                                subModules.forEach(module => {
                                    tableContent += `
                                    <tr>
                                        <td class="text-center">${module.order || '-'}</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span>${module.name}</span>
                                                ${module.hasChildren ? `
                                                    <i class="fas fa-plus-circle text-primary ms-2 show-child-modules" 
                                                    style="cursor: pointer;" 
                                                    data-bs-toggle="tooltip" 
                                                    data-module-id="${module.id}"
                                                    data-role-id="${roleId}"
                                                    title="แสดงโมดูลย่อย"></i>` : ''}
                                            </div>
                                        </td>
                                        <td>${module.description || '-'}</td>
                                        <td class="text-center">${module.controller || '-'}</td>
                                        <td class="text-center">${module.action || '-'}</td>
                                        <td class="text-center">${module.icon ? `<i class="${module.icon}"></i>` : '-'}</td>
                                        <td class="text-center">
                                            <span class="badge ${module.isActive ? 'bg-success' : 'bg-danger'}">
                                                ${module.isActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-primary edit-module-permissions"
                                                data-module-id="${module.id}" 
                                                data-role-id="${roleId}">
                                                <i class="fas fa-cog me-1"></i>จัดการ
                                            </button>
                                        </td>
                                    </tr>`;
                                });
                            } else {
                                tableContent += `
                                <tr>
                                    <td colspan="8" class="text-center">ไม่พบข้อมูลโมดูลย่อย</td>
                                </tr>`;
                            }
                            
                            tableContent += `
                                </tbody>
                            </table>`;
                            
                            $('#subModuleContent').html(tableContent);
                            
                            // เพิ่ม event สำหรับปุ่มจัดการสิทธิ์
                            $('.edit-module-permissions').on('click', function() {
                                const moduleId = $(this).data('module-id');
                                const roleId = $(this).data('role-id');
                                showPermissionEditor(moduleId, roleId);
                            });
                            
                            // เปิดใช้งาน tooltips
                            $('[data-bs-toggle="tooltip"]').tooltip();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: response.error || 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                                confirmButtonText: 'ตกลง'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            }
            
            // ฟังก์ชันแสดงหน้าต่างจัดการสิทธิ์
            function showPermissionEditor(moduleId, roleId) {
                // TODO: สร้างหน้าต่างสำหรับจัดการสิทธิ์ของโมดูล
                Swal.fire({
                    title: 'จัดการสิทธิ์การใช้งาน',
                    html: `
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">ดูข้อมูล</th>
                                    <th class="text-center">เพิ่มข้อมูล</th>
                                    <th class="text-center">แก้ไขข้อมูล</th>
                                    <th class="text-center">ลบข้อมูล</th>
                                    <th class="text-center">อนุมัติ</th>
                                    <th class="text-center">ดูรายงาน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isView">
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isAdd">
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isEdit">
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isDelete">
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isApprove">
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="perm_isReport">
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>`,
                    didOpen: () => {
                        // โหลดข้อมูลสิทธิ์ปัจจุบัน
                        $.get('@Url.Action("GetRoleDetails", "Role")', {
                            roleId: roleId,
                            moduleId: moduleId
                        }, function(data) {
                            $('#perm_isView').prop('checked', data.isView);
                            $('#perm_isAdd').prop('checked', data.isAdd);
                            $('#perm_isEdit').prop('checked', data.isEdit);
                            $('#perm_isDelete').prop('checked', data.isDelete);
                            $('#perm_isApprove').prop('checked', data.isApprove);
                            $('#perm_isReport').prop('checked', data.isReport);
                        });
                    },
                    showCancelButton: true,
                    confirmButtonText: 'บันทึก',
                    cancelButtonText: 'ยกเลิก',
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        // บันทึกการเปลี่ยนแปลงสิทธิ์
                        const permissions = {
                            isView: $('#perm_isView').is(':checked'),
                            isAdd: $('#perm_isAdd').is(':checked'),
                            isEdit: $('#perm_isEdit').is(':checked'),
                            isDelete: $('#perm_isDelete').is(':checked'),
                            isApprove: $('#perm_isApprove').is(':checked'),
                            isReport: $('#perm_isReport').is(':checked')
                        };
                        
                        // บันทึกทีละสิทธิ์
                        const promises = [];
                        for (const [perm, value] of Object.entries(permissions)) {
                            promises.push(
                                $.post('@Url.Action("UpdateRolePermission", "Role")', {
                                    moduleId: moduleId,
                                    roleId: roleId,
                                    permissionType: perm,
                                    isGranted: value
                                })
                            );
                        }
                        
                        return Promise.all(promises)
                            .then(() => {
                                return { success: true };
                            })
                            .catch(() => {
                                Swal.showValidationMessage('ไม่สามารถบันทึกสิทธิ์ได้');
                                return { success: false };
                            });
                    }
                }).then((result) => {
                    if (result.isConfirmed && result.value.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ',
                            text: 'อัพเดทสิทธิ์การใช้งานเรียบร้อยแล้ว',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                });
            }

            function formatModulePermissions(rowData) {
                return `<div class="module-permissions-container p-3" style="background: #f8f9fa;">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3" style="border-bottom: 2px solid #e9ecef;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    สิทธิ์การใช้งานของ: ${rowData.roleName}
                                </h6>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0" style="border-collapse: separate; border-spacing: 0;">
                                    <thead class="bg-light">
                                        <tr>
                                            <th style="width: 25%; padding: 15px;">
                                                <i class="fas fa-folder text-primary me-2"></i>โมดูล
                                            </th>
                                            <th class="text-center" style="width: 12%;">
                                                <i class="fas fa-eye text-info me-1"></i>ดูข้อมูล
                                            </th>
                                            <th class="text-center" style="width: 12%;">
                                                <i class="fas fa-plus-circle text-success me-1"></i>เพิ่มข้อมูล
                                            </th>
                                            <th class="text-center" style="width: 12%;">
                                                <i class="fas fa-edit text-warning me-1"></i>แก้ไขข้อมูล
                                            </th>
                                            <th class="text-center" style="width: 12%;">
                                                <i class="fas fa-trash text-danger me-1"></i>ลบข้อมูล
                                            </th>
                                            <th class="text-center" style="width: 12%;">
                                                <i class="fas fa-check-circle text-success me-1"></i>อนุมัติ
                                            </th>
                                            <th class="text-center" style="width: 15%;">
                                                <i class="fas fa-chart-bar text-primary me-1"></i>ดูรายงาน
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="modulePermissions_${rowData.id}">
                                        <!-- Permissions will be loaded here -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>`;
            }

            async function initializePermissionHandlers(roleId) {
                try {
                    console.log("เริ่มโหลดข้อมูลโมดูลหลักสำหรับ roleId:", roleId);
                    
                    const modules = await $.ajax({
                        url: '@Url.Action("GetMainModule", "Role")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(roleId),  // ส่ง roleId เป็น JSON string
                        success: function(response) {
                            console.log("ได้รับข้อมูลจาก GetMainModule สำเร็จ:", response);
                        },
                        error: function(xhr, status, error) {
                            console.error("เกิดข้อผิดพลาดในการโหลดข้อมูลโมดูล:", error);
                            console.error("สถานะ:", status);
                            console.error("รายละเอียด:", xhr.responseText);
                        }
                    });
                    
                    const tbody = $(`#modulePermissions_${roleId}`);
                    tbody.empty();
                    
                    if (!modules || modules.error) {
                        console.error("ข้อมูลโมดูลไม่ถูกต้อง:", modules);
                        throw new Error(modules?.error || "ไม่สามารถโหลดข้อมูลได้");
                    }
                    
                    modules.forEach(function(module) {
                        const row = $(`
                            <tr>
                                <td>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>${module.name}</span>
                                        ${module.hasChildren ? `
                                            <i class="fas fa-plus-circle text-primary ms-2 show-child-modules" 
                                               style="cursor: pointer;" 
                                               data-bs-toggle="tooltip" 
                                               data-module-id="${module.id}"
                                               data-role-id="${roleId}"
                                               title="แสดงโมดูลย่อย"></i>` : ''}
                                    </div>
                                </td>
                                ${['isView', 'isAdd', 'isEdit', 'isDelete', 'isApprove', 'isReport'].map(permission => `
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center mb-0">
                                            <input type="checkbox" class="form-check-input permission-checkbox" 
                                                   data-module-id="${module.id}" data-role-id="${roleId}" 
                                                   data-permission="${permission}" 
                                                   ${module.permissions[permission] ? 'checked' : ''}>
                                        </div>
                                    </td>
                                `).join('')}
                            </tr>
                        `);
                        tbody.append(row);
                    });
                    initializeEvents(roleId);
                } catch (error) {
                    console.error('Error loading main modules:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'ไม่สามารถโหลดข้อมูลได้',
                        confirmButtonText: 'ตกลง'
                    });
                }
            }

            function initializeEvents(roleId) {
                // ลบ event handlers เดิมก่อน
                $(document).off('change', '.permission-checkbox');
                $(document).off('click', '.details-control2');
                // bind event handlers ใหม่แบบ delegate
                $(document).on('change', '.permission-checkbox', function() {
                    const checkbox = $(this);
                    const moduleId = checkbox.data('module-id');
                    const roleId = checkbox.data('role-id');
                    const permission = checkbox.data('permission');
                    const isChecked = checkbox.prop('checked');
                    // เพิ่ม visual feedback
                    const td = checkbox.closest('td');
                    td.css('background-color', '#e8f5e9');
                    setTimeout(() => td.css('background-color', ''), 300);
                    updatePermission(moduleId, roleId, permission, isChecked, checkbox);
                });
                $(document).on('click', '.details-control2', function() {
                    const moduleId = $(this).data('module-id');
                    const roleId = $(this).data('role-id');
                    const icon = $(this);
                    const parentRow = icon.closest('tr');
                    icon.toggleClass('fa-plus-circle fa-minus-circle');
                    const childContainer = parentRow.next('.child-modules');
                    if (childContainer.length) {
                        childContainer.toggle();
                        return;
                    }
                    loadChildModules(moduleId, roleId, parentRow);
                });
            }

            function loadChildModules(moduleId, roleId, parentRow) {
                $.ajax({
                    url: '@Url.Action("GetSubModules", "Role")',
                    type: 'GET',
                    data: {
                        roleId: roleId,
                        moduleId: moduleId
                    },
                    success: function(response) {
                        console.log("ข้อมูลโมดูลย่อยที่ได้รับ:", response);
                        
                        if (!response.success) {
                            console.error("การโหลดโมดูลย่อยไม่สำเร็จ:", response.error);
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: response.error || 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                                confirmButtonText: 'ตกลง'
                            });
                            return;
                        }
                        
                        const childModules = response.data;
                        
                        if (childModules.length > 0) {
                            const childContainer = $('<tr class="child-modules">');
                            const childContent = $('<td colspan="7">');
                            const childTable = $(`
                                <div class="ms-4 me-2 my-2">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-light py-2 px-3" style="border-bottom: 1px solid #e9ecef;">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-code-branch text-secondary me-2"></i>
                                                <span class="fw-medium">โมดูลย่อย</span>
                                            </div>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 25%; padding: 12px;">
                                                                <i class="fas fa-folder-open text-primary me-2"></i>ชื่อโมดูล
                                                            </th>
                                                            <th class="text-center" style="width: 12%;">
                                                                <i class="fas fa-eye text-info"></i>
                                                            </th>
                                                            <th class="text-center" style="width: 12%;">
                                                                <i class="fas fa-plus-circle text-success"></i>
                                                            </th>
                                                            <th class="text-center" style="width: 12%;">
                                                                <i class="fas fa-edit text-warning"></i>
                                                            </th>
                                                            <th class="text-center" style="width: 12%;">
                                                                <i class="fas fa-trash text-danger"></i>
                                                            </th>
                                                            <th class="text-center" style="width: 12%;">
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            </th>
                                                            <th class="text-center" style="width: 15%;">
                                                                <i class="fas fa-chart-bar text-primary"></i>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                    `);
                            childModules.forEach(function(child) {
                                const permissions = child.permissions || {};
                                const childRow = $(`
                                    <tr class="align-middle" style="transition: all 0.2s;">
                                        <td style="padding: 10px 12px;">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-angle-right text-secondary me-2"></i>
                                                <span>${child.name}</span>
                                            </div>
                                        </td>
                                        ${['isView', 'isAdd', 'isEdit', 'isDelete', 'isApprove', 'isReport'].map(permission => `
                                            <td class="text-center" style="padding: 8px;">
                                                <div class="form-check d-flex justify-content-center mb-0">
                                                    <input type="checkbox" 
                                                           class="form-check-input permission-checkbox" 
                                                           style="cursor: pointer; transform: scale(1.1);"
                                                           data-module-id="${child.id}" 
                                                           data-role-id="${roleId}" 
                                                           data-permission="${permission}" 
                                                           ${permissions[permission] ? 'checked' : ''}>
                                                </div>
                                            </td>
                                        `).join('')}
                                    </tr>
                                `);
                                childTable.find('tbody').append(childRow);
                            });
                            childTable.append(`
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `);
                            childContent.append(childTable);
                            childContainer.append(childContent);
                            childContainer.insertAfter(parentRow);
                            // เพิ่ม hover effect และ animation
                            addEffectsToTable(childContainer);
                        } else {
                            Swal.fire({
                                icon: 'info',
                                title: 'ไม่พบโมดูลย่อย',
                                text: 'โมดูลนี้ไม่มีโมดูลย่อย',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("เกิดข้อผิดพลาดในการโหลดโมดูลย่อย:", error);
                        console.error("สถานะ:", status);
                        console.error("รายละเอียด:", xhr.responseText);
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            }

            function addEffectsToTable(container) {
                // Hover effect
                container.find('tr').hover(
                    function() {
                        $(this).css({
                            'background-color': '#f8f9fa',
                            'transition': 'background-color 0.2s ease'
                        });
                    },
                    function() {
                        $(this).css('background-color', '');
                    }
                );
                // Checkbox animation
                container.find('.permission-checkbox').on('change', function() {
                    const checkbox = $(this);
                    const td = checkbox.closest('td');
                    td.css({
                        'transform': 'scale(1.05)',
                        'transition': 'transform 0.2s ease'
                    });
                    setTimeout(() => td.css('transform', ''), 200);
                });
            }

            function updatePermission(moduleId, roleId, permission, isChecked, checkbox) {
                // เพิ่ม loading state
                checkbox.prop('disabled', true);
                $.ajax({
                    url: '@Url.Action("UpdateRolePermission", "Role")',
                    type: 'POST',
                    data: {
                        roleId: roleId,
                        moduleId: moduleId,
                        permissionType: permission,
                        isGranted: isChecked
                    },
                    success: function(response) {
                        if (response.success) {
                            // แสดง toast notification แทน Swal
                            toastr.success('อัพเดทสิทธิ์สำเร็จ', '', {
                                timeOut: 1000,
                                positionClass: 'toast-top-right',
                                progressBar: true
                            });
                        } else {
                            // กรณีไม่สำเร็จ
                            toastr.error(response.message || 'ไม่สามารถอัพเดทสิทธิ์ได้');
                            checkbox.prop('checked', !isChecked); // revert การเปลี่ยนแปลง
                        }
                    },
                    error: function() {
                        toastr.error('ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้');
                        checkbox.prop('checked', !isChecked); // revert การเปลี่ยนแปลง
                    },
                    complete: function() {
                        checkbox.prop('disabled', false);
                    }
                });
            }

            function updateCheckboxes(moduleId, roleId, permissions) {
                const selector = `#modulePermissions_${roleId} input[data-module-id="${moduleId}"]`;
                const checkboxes = $(selector);
                if (checkboxes.length === 0) {
                    console.warn(`No checkboxes found for selector: ${selector}`);
                    return;
                }
                checkboxes.each(function() {
                    const $checkbox = $(this);
                    const permission = $checkbox.data('permission').toLowerCase();
                    const currentValue = $checkbox.prop('checked');
                    const newValue = permissions[permission] || false;
                    if (currentValue !== newValue) {
                        console.log(`Updating ${permission} from ${currentValue} to ${newValue}`);
                        $checkbox.prop('checked', newValue);
                    }
                });
            }
            
            // เพิ่ม CSS สำหรับ visual feedback 
            $('<style>')
                .text(`
                    .permission-checkbox {
                        transition: all 0.2s ease;
                    }
                    .permission-checkbox:checked {
                        background-color: #4CAF50;
                        border-color: #4CAF50;
                    }
                    .permission-checkbox:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                    }
                `)
                .appendTo('head');

            // เพิ่ม event handler สำหรับการแสดงโมดูลย่อย
            $(document).on('click', '.show-child-modules', function() {
                const moduleId = $(this).data('module-id');
                const roleId = $(this).data('role-id');
                const row = $(this).closest('tr');
                const icon = $(this);
                
                // เช็คว่ามี child row แล้วหรือไม่
                const childRow = row.next('.child-modules-row');
                if (childRow.length) {
                    // ถ้ามี child row แล้ว ให้ toggle การแสดงผล
                    childRow.toggle();
                    icon.toggleClass('fa-plus-circle fa-minus-circle');
                    return;
                }
                
                // ถ้ายังไม่มี child row ให้โหลดข้อมูลและแสดง
                $.ajax({
                    url: '@Url.Action("GetSubModules", "Role")',
                    type: 'GET',
                    data: {
                        roleId: roleId,
                        moduleId: moduleId
                    },
                    success: function(response) {
                        console.log("ข้อมูลโมดูลย่อยที่ได้รับ (show-child-modules):", response);
                        
                        if (!response.success) {
                            console.error("การโหลดโมดูลย่อยไม่สำเร็จ:", response.error);
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: response.error || 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                                confirmButtonText: 'ตกลง'
                            });
                            return;
                        }
                        
                        const childModules = response.data;
                        
                        if (childModules && childModules.length > 0) {
                            // สร้าง child row
                            const childContent = $(`
                            <tr class="child-modules-row" style="background-color: #f8f9fa;">
                                <td colspan="8">
                                    <div class="ms-4 my-3">
                                        <div class="card border-0 shadow-sm">
                                            <div class="card-header bg-light py-2">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-sitemap text-primary me-2"></i>
                                                    <span class="fw-medium">โมดูลย่อย (${childModules.length})</span>
                                                </div>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th class="text-center" style="width: 50px;">ลำดับ</th>
                                                                <th>ชื่อโมดูล</th>
                                                                <th>รายละเอียด</th>
                                                                <th class="text-center" style="width: 80px;">Controller</th>
                                                                <th class="text-center" style="width: 80px;">Action</th>
                                                                <th class="text-center" style="width: 50px;">ไอคอน</th>
                                                                <th class="text-center" style="width: 80px;">สถานะ</th>
                                                                <th class="text-center" style="width: 120px;">จัดการสิทธิ์</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            ${childModules.length > 0 ? childModules.map(child => `
                                                                <tr>
                                                                    <td class="text-center">${child.order || '-'}</td>
                                                                    <td>${child.name}</td>
                                                                    <td>${child.description || '-'}</td>
                                                                    <td class="text-center">${child.controller || '-'}</td>
                                                                    <td class="text-center">${child.action || '-'}</td>
                                                                    <td class="text-center">${child.icon ? `<i class="${child.icon}"></i>` : '-'}</td>
                                                                    <td class="text-center">
                                                                        <span class="badge ${child.isActive ? 'bg-success' : 'bg-danger'}">
                                                                            ${child.isActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
                                                                        </span>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <button class="btn btn-sm btn-primary edit-module-permissions"
                                                                            data-module-id="${child.id}" 
                                                                            data-role-id="${roleId}">
                                                                            <i class="fas fa-cog me-1"></i>จัดการ
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            `).join('') : `
                                                                <tr>
                                                                    <td colspan="8" class="text-center">ไม่พบข้อมูลโมดูลย่อย</td>
                                                                </tr>
                                                            `}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            `);
                            
                            // แทรก child row ต่อจาก row ปัจจุบัน
                            row.after(childContent);
                            
                            // เปลี่ยนไอคอน
                            icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
                            
                            // เพิ่ม event สำหรับปุ่มจัดการสิทธิ์ในโมดูลย่อย
                            $('.edit-module-permissions').off('click').on('click', function() {
                                const moduleId = $(this).data('module-id');
                                const roleId = $(this).data('role-id');
                                showPermissionEditor(moduleId, roleId);
                            });
                        } else {
                            Swal.fire({
                                icon: 'info',
                                title: 'ไม่พบโมดูลย่อย',
                                text: 'โมดูลนี้ไม่มีโมดูลย่อย',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("เกิดข้อผิดพลาดในการโหลดโมดูลย่อย:", error);
                        console.error("สถานะ:", status);
                        console.error("รายละเอียด:", xhr.responseText);
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถโหลดข้อมูลโมดูลย่อยได้',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                });
            });
        });
    </script>
    }