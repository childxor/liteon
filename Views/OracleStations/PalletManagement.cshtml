@{
    ViewData["Title"] = "จัดการกล่องพาเลท - Pallet Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-boxes me-2"></i>
                            จัดการกล่องพาเลท (Pallet Management)
                        </h4>
                        <div>
                            <a href="@Url.Action("Station", "OracleStations")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i>
                                ย้อนกลับ
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-search me-2"></i>
                                        ค้นหากล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="palletSearch" class="form-label">
                                            <i class="fas fa-barcode me-1"></i>
                                            Pallet ID / Carton No / Serial Number
                                        </label>
                                        <input type="text" class="form-control" id="palletSearch"
                                            placeholder="กรอก Pallet ID, Carton No หรือ Serial Number">
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <button type="button" class="btn btn-info" id="searchPallet">
                                            <i class="fas fa-search me-1"></i>
                                            ค้นหา
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="clearSearch">
                                            <i class="fas fa-times me-1"></i>
                                            ล้าง
                                        </button>
                                        <button type="button" class="btn btn-warning" id="debugData">
                                            <i class="fas fa-bug me-1"></i>
                                            Debug
                                        </button>
                                        <button type="button" class="btn btn-info" id="testSearchCarton">
                                            <i class="fas fa-search me-1"></i>
                                            Test Search
                                        </button>
                                        <button type="button" class="btn btn-warning" id="testMoveSerialNumbers">
                                            <i class="fas fa-exchange-alt me-1"></i>
                                            Test Move Serial
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-plus me-2"></i>
                                        สร้างพาเลทใหม่
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="newPalletId" class="form-label">
                                                <i class="fas fa-tag me-1"></i>
                                                Pallet ID *
                                            </label>
                                            <input type="text" class="form-control" id="newPalletId"
                                                placeholder="กรอก Pallet ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="workOrder" class="form-label">
                                                <i class="fas fa-file-alt me-1"></i>
                                                Work Order *
                                            </label>
                                            <input type="text" class="form-control" id="workOrder"
                                                placeholder="กรอก Work Order" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="partId" class="form-label">
                                                <i class="fas fa-microchip me-1"></i>
                                                Part ID *
                                            </label>
                                            <input type="number" class="form-control" id="partId"
                                                placeholder="กรอก Part ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="factorySelect" class="form-label">
                                                <i class="fas fa-building me-1"></i>
                                                โรงงาน (Factory)
                                            </label>
                                            <select class="form-select" id="factorySelect">
                                                <option value="">-- เลือกโรงงาน --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="stageSelect" class="form-label">
                                                <i class="fas fa-layer-group me-1"></i>
                                                ขั้นตอน (Stage)
                                            </label>
                                            <select class="form-select" id="stageSelect">
                                                <option value="">-- เลือกขั้นตอน --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="processSelect" class="form-label">
                                                <i class="fas fa-play me-1"></i>
                                                กระบวนการ (Process)
                                            </label>
                                            <select class="form-select" id="processSelect">
                                                <option value="">-- เลือกกระบวนการ --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="pdlineSelect" class="form-label">
                                                <i class="fas fa-industry me-1"></i>
                                                สายการผลิต (PDLine)
                                            </label>
                                            <select class="form-select" id="pdlineSelect">
                                                <option value="">-- เลือกสายการผลิต --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="terminalSelect" class="form-label">
                                                <i class="fas fa-desktop me-1"></i>
                                                สถานี (Terminal) *
                                            </label>
                                            <select class="form-select" id="terminalSelect" required>
                                                <option value="">-- เลือกสถานี --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="routeSelect" class="form-label">
                                                <i class="fas fa-route me-1"></i>
                                                เส้นทาง (Route)
                                            </label>
                                            <select class="form-select" id="routeSelect">
                                                <option value="">-- เลือกเส้นทาง --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="qcFlag" class="form-label">
                                                <i class="fas fa-check-circle me-1"></i>
                                                QC Flag
                                            </label>
                                            <select class="form-select" id="qcFlag">
                                                <option value="Y">ต้องตรวจสอบ QC</option>
                                                <option value="N">ไม่ต้องตรวจสอบ QC</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="mixFlag" class="form-label">
                                                <i class="fas fa-random me-1"></i>
                                                Mix Flag
                                            </label>
                                            <select class="form-select" id="mixFlag">
                                                <option value="N">ไม่ผสม Work Order</option>
                                                <option value="Y">ผสม Work Order</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3 d-flex align-items-end">
                                            <button type="button" class="btn btn-success w-100" id="createPallet">
                                                <i class="fas fa-plus me-1"></i>
                                                สร้างพาเลท
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filterMonth" class="form-label">เลือกเดือน</label>
                            <input type="month" class="form-control" id="filterMonth"
                                value="@DateTime.Now.ToString("yyyy-MM")">
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-list me-2"></i>
                                        รายการกล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="palletTable" class="table table-striped table-hover"
                                            style="width:100%">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>ลำดับ</th>
                                                    <th>Pallet ID</th>
                                                    <th>Work Order</th>
                                                    <th>Part ID</th>
                                                    <th>สถานะ</th>
                                                    <th>Terminal</th>
                                                    <th>จำนวน Serial</th>
                                                    <th>วันที่สร้าง</th>
                                                    <th>การดำเนินการ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- ข้อมูลจะถูกเติมด้วย JavaScript -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal สำหรับแสดงรายละเอียด -->
<div class="modal fade" id="palletDetailModal" tabindex="-1" aria-labelledby="palletDetailModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="palletDetailModalLabel">
                    <i class="fas fa-info-circle me-2"></i>
                    รายละเอียดกล่องพาเลท
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="palletDetailContent">
                <!-- เนื้อหาจะถูกเติมด้วย JavaScript -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" id="editPallet">
                    <i class="fas fa-edit me-1"></i>
                    แก้ไข
                </button> 
            </div>
        </div>
    </div>
</div>

<!-- Modal สำหรับย้ายกล่อง -->
<div class="modal fade" id="moveCartonModal" tabindex="-1" aria-labelledby="moveCartonModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="moveCartonModalLabel">
                    <i class="fas fa-exchange-alt me-2"></i>
                    ย้าย Serial Numbers (เลือกวิธีได้)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card border-warning">
                            <div class="card-header bg-warning text-dark">
                                <h6 class="mb-0">
                                    <i class="fas fa-box me-2"></i>
                                    กล่องต้นทาง
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">หมายเลขกล่อง:</label>
                                    <input type="text" class="form-control" id="sourceCartonId" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Work Order:</label>
                                    <input type="text" class="form-control" id="sourceWorkOrder" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">จำนวน Serial:</label>
                                    <input type="text" class="form-control" id="sourceSerialCount" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Pallet ต้นทาง:</label>
                                    <input type="text" class="form-control" id="sourcePalletId" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-arrow-right me-2"></i>
                                    กล่องปลายทาง
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label for="targetCartonSearch" class="form-label">
                                        <i class="fas fa-search me-1"></i>
                                        ค้นหากล่องปลายทาง:
                                    </label>
                                    <input type="text" class="form-control" id="targetCartonSearch" 
                                           placeholder="กรอก Carton ID หรือ Work Order">
                                </div>
                                <div class="mb-3">
                                    <button type="button" class="btn btn-success btn-sm" id="searchTargetCarton">
                                        <i class="fas fa-search me-1"></i>
                                        ค้นหา
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="clearTargetSearch">
                                        <i class="fas fa-times me-1"></i>
                                        ล้าง
                                    </button>
                                </div>
                                
                                <!-- เพิ่มตัวเลือกสำหรับย้ายไปยัง Pallet โดยตรง -->
                                <div class="mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <label for="targetPalletNo" class="form-label">
                                                <i class="fas fa-exchange-alt me-1"></i>
                                                หรือเปลี่ยน Pallet No:
                                            </label>
                                            <input type="text" class="form-control" id="targetPalletNo" 
                                                   placeholder="กรอก Pallet No ที่ต้องการเปลี่ยนไป">
                                        </div>
                                        <div class="ms-2">
                                            <button type="button" class="btn btn-primary btn-sm" id="moveToPallet">
                                                <i class="fas fa-exchange-alt me-1"></i>
                                                เปลี่ยน Pallet
                                            </button>
                                        </div>
                                        <div class="ms-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="clearPalletNo">
                                                <i class="fas fa-times me-1"></i>
                                                ล้าง
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- แสดงสถานะการเลือกวิธีย้าย -->
                                <div id="moveMethodStatus" class="mb-3" style="display: none;">
                                    <div class="alert alert-light border-info">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle me-1"></i>
                                            <span id="moveMethodText"></span>
                                        </small>
                                    </div>
                                </div>
                                
                                <!-- ข้อความแนะนำ -->
                                <div class="mb-3">
                                    <div class="alert alert-light border-secondary">
                                        <small class="text-muted">
                                            <i class="fas fa-lightbulb me-1"></i>
                                            <strong>คำแนะนำ:</strong> คุณสามารถเลือกใช้วิธีใดวิธีหนึ่งเท่านั้น
                                            <br>• <strong>วิธีที่ 1:</strong> ค้นหา Carton ปลายทาง (กรอก Carton ID หรือ Work Order แล้วกดค้นหา)
                                            <br>• <strong>วิธีที่ 2:</strong> เปลี่ยน Pallet โดยตรง (กรอก Pallet No แล้วกดย้ายไป Pallet หรือกด Enter)
                                            <br><small class="text-muted">💡 วิธีที่ 2 จะเปลี่ยนแค่ Pallet ของ Serial Numbers เท่านั้น ไม่ลบ Serial Numbers ออกจากกล่อง</small>
                                        </small>
                                    </div>
                                </div>
                                <div id="targetCartonInfo" style="display: none;">
                                    <div class="alert alert-info">
                                        <h6><i class="fas fa-info-circle me-2"></i>ข้อมูลกล่องปลายทาง</h6>
                                        <div class="row">
                                            <div class="col-6">
                                                <small><strong>Carton ID:</strong></small><br>
                                                <span id="targetCartonId"></span>
                                            </div>
                                            <div class="col-6">
                                                <small><strong>Work Order:</strong></small><br>
                                                <span id="targetWorkOrder"></span>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6">
                                                <small><strong>Part ID:</strong></small><br>
                                                <span id="targetPartId"></span>
                                            </div>
                                            <div class="col-6">
                                                <small><strong>สถานะ:</strong></small><br>
                                                <span id="targetStatus"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                                                        <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>คำเตือน:</strong> การย้าย Serial Numbers จะทำให้ Serial Numbers ทั้งหมดในกล่องต้นทางเปลี่ยน Pallet ไปยังกล่องปลายทางหรือ Pallet ปลายทาง
                                    <br><small class="text-muted">⚠️ Serial Numbers จะยังคงอยู่ในกล่องเดิม แต่จะเปลี่ยน Pallet ที่เกี่ยวข้อง</small>
                                </div>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>หมายเหตุ:</strong> หลังจากย้าย Serial Numbers สำเร็จ ระบบจะถามว่าต้องการลบกล่องต้นทางหรือไม่
                            <br><small class="text-muted">💡 แนะนำให้ลบกล่องต้นทางเพื่อป้องกันความสับสนในการจัดการข้อมูล</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-info" id="confirmMoveCarton" disabled>
                    <i class="fas fa-exchange-alt me-1"></i>
                    ย้ายไปยัง Carton
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <!-- DataTables CSS ถูกโหลดใน Layout แล้ว -->

    <style>
        /* Toast notification styles */
        .toast-container {
            z-index: 9999;
        }

        .toast {
            min-width: 300px;
        }

        .toast .toast-body {
            font-size: 0.9rem;
        }

        /* Auto-select animation */
        .form-select:focus {
            border-color: #0dcaf0;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25);
        }

        .form-select.auto-selected {
            border-color: #0dcaf0;
            background-color: #f8f9fa;
        }

        /* Card hover effects */
        .card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        /* Button hover effects */
        .btn {
            transition: all 0.2s ease-in-out;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        /* Table improvements */
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .table td {
            vertical-align: middle;
        }

        /* Badge improvements */
        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }

        /* Modal improvements */
        .modal-xl {
            max-width: 95%;
        }

        .modal-body {
            max-height: 70vh;
            overflow-y: auto;
        }
    </style>

    <!-- DataTables JS -->
    <!-- DataTables JS และ SweetAlert2 ถูกโหลดใน Layout แล้ว -->
    <script>
        var appBasePath = '@Url.Content("~/")';
        
        // Pallet Management Application
        var PalletManagementApp = {
            // กำหนดค่าเริ่มต้น
            config: {
                baseUrl: typeof appBasePath !== 'undefined' ? appBasePath + 'OracleStations' : '/OracleStations',
                serialDelimiters: ['\n', '\r\n', ',', ';'],
                maxSerialNumbers: 1000,
                defaultEmpId: 'ADMIN' // กำหนดค่าเริ่มต้นสำหรับ Employee ID
            },
            // สถานะ UI ช่วยให้ไฮไลต์รายการหลังค้นหา
            uiState: {
                highlightCartonId: null
            },

            // เริ่มต้นแอพ
            init: function() {
                console.log('PalletManagementApp initialized');
                this.bindEvents();
                this.loadDropdownData();
                this.loadPallets();
            },

            // ผูกเหตุการณ์ต่างๆ 
            bindEvents: function() {
                var self = this; // เก็บ reference ของ this
                
                // โหลดใหม่เมื่อเปลี่ยนเดือน 
                $('#filterMonth').on('change', function() { 
                    self.loadPallets();
                });

                // ปุ่มค้นหา
                $('#searchPallet').click(function() {
                    self.searchPallet(); 
                });

                // กด Enter เพื่อค้นหา (สะดวกขึ้น)
                $('#palletSearch').on('keyup', function(e){
                    if (e.key === 'Enter') {
                        self.searchPallet();
                    }
                });

                // ปุ่มล้างการค้นหา
                $('#clearSearch').click(function() {
                    self.clearSearch();
                });

                // ปุ่มสร้างพาเลท
                $('#createPallet').click(function() {
                    self.createPallet();
                });

                // ปุ่ม Debug
                $('#debugData').click(function() {
                    var searchTerm = $('#palletSearch').val();
                    if (searchTerm) {
                        // ตรวจสอบในตาราง g_pack_pallet
                        self.checkData('g_pack_pallet', 'PALLET_NO', searchTerm);
                        // ตรวจสอบในตาราง g_pack_carton
                        self.checkData('g_pack_carton', 'CARTON_NO', searchTerm);
                        // ตรวจสอบในตาราง g_sn_status
                        self.checkData('g_sn_status', 'SERIAL_NUMBER', searchTerm);
                        
                        // ทดสอบ API
                        self.testApi(searchTerm);
                        
                        // ทดสอบ Model Binding
                        self.testModelBinding(searchTerm);
                    } else {
