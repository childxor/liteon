            deleteSourceCarton: function(cartonId, palletId) {
                var self = this;
                
                // ตรวจสอบข้อมูล
                if (!cartonId || cartonId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขกล่อง');
                    return;
                }

                // แสดง loading
                self.showLoading('กำลังลบกล่องต้นทาง...');
                
                var data = {
                    cartonNo: cartonId.trim()
                };

                console.log('deleteSourceCarton - sending data:', data);
                console.log('deleteSourceCarton - cartonId:', cartonId);
                console.log('deleteSourceCarton - palletId:', palletId);

                $.ajax({
                    url: self.config.baseUrl + '/DeleteCarton',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(response) {
                        Swal.close();
                        console.log('deleteSourceCarton - response:', response);
                        
                        if (response.success) {
                            self.showSuccess('ลบกล่องต้นทางสำเร็จ: ' + response.message);
                            // ปิด modal ย้าย Serial Numbers
                            $('#moveCartonModal').modal('hide');
                            // รีเฟรช modal รายละเอียด
                            $('#palletDetailModal').modal('hide');
                            // เปิด modal ใหม่เพื่อแสดงข้อมูลที่อัปเดต
                            setTimeout(function() {
                                $('[data-pallet="' + palletId + '"]').click();
                            }, 1500); // เพิ่มเวลารอเป็น 1.5 วินาที
                        } else {
                            self.showError('เกิดข้อผิดพลาดในการลบกล่องต้นทาง: ' + response.message);
                            // แม้จะลบไม่สำเร็จ ก็ให้รีเฟรชข้อมูล
                            $('#moveCartonModal').modal('hide');
                            $('#palletDetailModal').modal('hide');
                            setTimeout(function() {
                                $('[data-pallet="' + palletId + '"]').click();
                            }, 1500); // เพิ่มเวลารอเป็น 1.5 วินาที
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.close();
                        
                        // ตรวจสอบประเภทของ error
                        var errorMessage = 'เกิดข้อผิดพลาดในการลบกล่องต้นทาง';
                        if (xhr.status === 400) {
                            errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                        } else if (xhr.status === 500) {
                            errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                        } else if (xhr.status === 0) {
                            errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                        } else if (xhr.responseText) {
                            try {
                                var errorResponse = JSON.parse(xhr.responseText);
                                if (errorResponse.message) {
                                    errorMessage = errorResponse.message;
                                }
                            } catch (e) {
                                errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                            }
                        }
                        
                        self.showError(errorMessage);
                        // แม้จะลบไม่สำเร็จ ก็ให้รีเฟรชข้อมูล
                        $('#moveCartonModal').modal('hide');
                        $('#palletDetailModal').modal('hide'); 
                        setTimeout(function() {
                            $('[data-pallet="' + palletId + '"]').click();
                        }, 1500); // เพิ่มเวลารอเป็น 1.5 วินาที
                    }
                });
            },

            // ทดสอบ Move Serial Numbers
            testMoveSerialNumbers: function() {
                var self = this;
                
                // ข้อมูลทดสอบ
                var testData = {
                    sourceCartonNo: 'C0307834271037',
