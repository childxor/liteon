            // แสดง modal ย้ายกล่อง
            showMoveCartonModal: function(cartonId) {
                var self = this;
                var palletId = $('#palletDetailModal').data('pallet-id');
                
                console.log('showMoveCartonModal - cartonId:', cartonId);
                console.log('showMoveCartonModal - palletId:', palletId);
                
                // ตรวจสอบว่า modal รายละเอียดพาเลทถูกแสดงอยู่หรือไม่
                if (!$('#palletDetailModal').hasClass('show')) {
                    console.log('showMoveCartonModal - palletDetailModal is not visible');
                    this.showError('กรุณาเปิดรายละเอียดพาเลทก่อน');
                    return;
                }
                
                // เก็บข้อมูลกล่องที่ต้องการย้าย
                $('#moveCartonModal').data('source-carton', cartonId);
                $('#moveCartonModal').data('source-pallet', palletId);
                
                // ตรวจสอบว่า tab "กล่อง" ถูกเปิดอยู่หรือไม่
                var $cartonsTab = $('#tab-cartons');
                var $cartonsTabButton = $('#tab-cartons-tab');
                
                if (!$cartonsTab.hasClass('show active')) {
                    console.log('showMoveCartonModal - switching to cartons tab');
                    $cartonsTabButton.tab('show');
                    // รอให้ tab เปลี่ยนก่อนแล้วค่อยหาข้อมูล
                    setTimeout(function() {
                        self.populateCartonData(cartonId);
                    }, 100);
                } else {
                    self.populateCartonData(cartonId);
                }
                
                // แสดงข้อมูล Pallet ต้นทาง
                $('#sourcePalletId').val(palletId);
                
                // ล้างข้อมูลปลายทาง (ไม่ล้างข้อมูลต้นทาง)
                this.clearTargetCartonInfo();
                
                // แสดง modal
                $('#moveCartonModal').modal('show');
                
                // ตรวจสอบว่าข้อมูลต้นทางถูกแสดงผลหรือไม่
                setTimeout(function() {
                    var sourceCartonId = $('#sourceCartonId').val();
                    var sourceWorkOrder = $('#sourceWorkOrder').val();
                    var sourceSerialCount = $('#sourceSerialCount').val();
                    var sourcePalletId = $('#sourcePalletId').val();
                    
                    console.log('showMoveCartonModal - final check of source data:', {
                        sourceCartonId: sourceCartonId,
                        sourceWorkOrder: sourceWorkOrder,
                        sourceSerialCount: sourceSerialCount,
                        sourcePalletId: sourcePalletId
                    });
                    
                    if (!sourceCartonId || !sourceWorkOrder || !sourceSerialCount) {
                        console.log('showMoveCartonModal - source data is missing, trying to repopulate');
                        self.populateCartonData(cartonId);
                    }
                }, 200);
                
                // เพิ่มการตรวจสอบการกรอกข้อมูลในฟิลด์ทั้งสอง
                this.checkMoveMethodConflict();
            },

            // เติมข้อมูลกล่องในฟอร์ม
            populateCartonData: function(cartonId) {
                console.log('populateCartonData - cartonId:', cartonId);
                
                // หาข้อมูลกล่องจากตาราง
                var cartonData = this.findCartonData(cartonId);
                console.log('populateCartonData - cartonData:', cartonData);
                
                if (cartonData) {
                    $('#sourceCartonId').val(cartonData.CartonId);
                    $('#sourceWorkOrder').val(cartonData.WorkOrder);
                    $('#sourceSerialCount').val(cartonData.SerialCount);
                    console.log('populateCartonData - data populated successfully');
                } else {
                    console.log('populateCartonData - failed to find carton data');
                    // แสดงข้อมูลจาก data attribute ของปุ่มแทน
                    var $button = $('.btn-move-carton[data-carton="' + cartonId + '"]');
                    if ($button.length > 0) {
                        var $row = $button.closest('tr');
                        if ($row.length > 0) {
                            var fallbackCartonId = $row.find('td:first code').text().trim();
                            var fallbackWorkOrder = $row.find('td:eq(1)').text().trim();
                            var fallbackSerialCount = $row.find('td:eq(3) .badge').text().trim();
                            
                            $('#sourceCartonId').val(fallbackCartonId);
                            $('#sourceWorkOrder').val(fallbackWorkOrder);
                            $('#sourceSerialCount').val(fallbackSerialCount);
                            console.log('populateCartonData - used fallback data');
                        }
                    }
                }
                
                // ตรวจสอบว่าข้อมูลถูกแสดงผลหรือไม่
                var displayedCartonId = $('#sourceCartonId').val();
                var displayedWorkOrder = $('#sourceWorkOrder').val();
                var displayedSerialCount = $('#sourceSerialCount').val();
                
                console.log('populateCartonData - displayed data:', {
                    CartonId: displayedCartonId,
                    WorkOrder: displayedWorkOrder,
                    SerialCount: displayedSerialCount
                });
                
                if (!displayedCartonId || !displayedWorkOrder || !displayedSerialCount) {
                    console.log('populateCartonData - some data is missing, trying alternative method');
                    // ลองใช้ข้อมูลจาก cartonId ที่ส่งมาโดยตรง
                    $('#sourceCartonId').val(cartonId);
                    // ลองหาข้อมูลจากปุ่มอื่นๆ ในตาราง
                    var $allButtons = $('.btn-move-carton');
                    if ($allButtons.length > 0) {
                        console.log('populateCartonData - found', $allButtons.length, 'move buttons');
                        $allButtons.each(function(index) {
                            var buttonCartonId = $(this).data('carton');
                            console.log('populateCartonData - button', index, 'cartonId:', buttonCartonId);
                        });
                    }
                }
            },

            // ตรวจสอบการขัดแย้งของวิธีการย้าย
            checkMoveMethodConflict: function() {
                var cartonSearch = $('#targetCartonSearch').val().trim();
                var palletNo = $('#targetPalletNo').val().trim();
                
                if (cartonSearch && palletNo) {
                    // ถ้ามีการกรอกทั้งสองฟิลด์ ให้ล้างฟิลด์ Pallet No
                    $('#targetPalletNo').val('');
                    this.showWarning('กรุณาเลือกใช้วิธีใดวิธีหนึ่งเท่านั้น: ค้นหา carton หรือระบุ Pallet No โดยตรง');
                }
            },

            // หาข้อมูลกล่องจากตาราง
            findCartonData: function(cartonId) {
                console.log('findCartonData - searching for cartonId:', cartonId);
                
                // วิธีที่ 1: หาจาก data attribute ของปุ่ม
                var $button = $('.btn-move-carton[data-carton="' + cartonId + '"]');
                if ($button.length > 0) {
                    var $row = $button.closest('tr');
                    if ($row.length > 0) {
                        var cartonIdFromRow = $row.find('td:first code').text().trim();
                        var workOrder = $row.find('td:eq(1)').text().trim();
                        var serialCount = $row.find('td:eq(3) .badge').text().trim();
                        
                        console.log('findCartonData - found data from button:', {
                            CartonId: cartonIdFromRow,
                            WorkOrder: workOrder,
                            SerialCount: serialCount
                        });
                        
                        return {
                            CartonId: cartonIdFromRow,
                            WorkOrder: workOrder,
                            SerialCount: serialCount
                        };
                    }
                }
                
                // วิธีที่ 2: หาจากตารางกล่องใน tab "กล่อง"
                var $row = $('#cartonsTable tbody tr').filter(function() {
                    var cartonIdInRow = $(this).find('td:first code').text().trim();
                    console.log('findCartonData - checking row cartonId:', cartonIdInRow);
                    return cartonIdInRow === cartonId;
                });
                
                console.log('findCartonData - found rows from table:', $row.length);
                
                if ($row.length > 0) {
                    var cartonIdFromTable = $row.find('td:first code').text().trim();
                    var workOrder = $row.find('td:eq(1)').text().trim();
