                        console.log('testMoveSerialNumbers - response:', response);
                        
                        if (response.success) {
                            self.showSuccess('ทดสอบ Move Serial Numbers สำเร็จ - ดูรายละเอียดใน Console');
                            console.log('testMoveSerialNumbers - success response:', response);
                        } else {
                            self.showError(response.message || 'ทดสอบ Move Serial Numbers ล้มเหลว');
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.close();
                        
                        // ตรวจสอบประเภทของ error
                        var errorMessage = 'เกิดข้อผิดพลาดในการทดสอบ Move Serial Numbers';
                        if (xhr.status === 400) {
                            errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                        } else if (xhr.status === 500) {
                            errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                        } else if (xhr.status === 0) {
                            errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                        } else if (xhr.responseText) {
                            try {
                                var errorResponse = JSON.parse(xhr.responseText);
                                if (errorResponse.message) {
                                    errorMessage = errorResponse.message;
                                }
                            } catch (e) {
                                errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                            }
                        }
                        
                        self.showError(errorMessage);
                    }
                });
            }
        };

        // เริ่มต้นแอพพลิเคชันเมื่อหน้าโหลดเสร็จ
        $(document).ready(function() {
            PalletManagementApp.init();
        });
    </script>
