            // เปิดพาเลท
            openPallet: function(palletId) {
                var self = this;
                
                // ตรวจสอบ palletId
                if (!palletId || palletId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขพาเลท');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการเปิดพาเลท',
                    text: 'คุณต้องการเปิดพาเลท ' + palletId + ' หรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'เปิดพาเลท',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#198754'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // ตรวจสอบข้อมูลก่อนส่ง
                        console.log('PalletId original:', palletId);
                        console.log('PalletId trimmed:', palletId.trim());
                        console.log('DefaultEmpId:', self.config.defaultEmpId);
                        
                        // ตรวจสอบว่าข้อมูลถูกต้องหรือไม่
                        if (!palletId || palletId.trim() === '') {
                            self.showError('ข้อมูล palletNo ไม่ถูกต้อง');
                            return;
                        }

                        // แสดง loading
                        self.showLoading('กำลังเปิดพาเลท...');

                        $.ajax({
                            url: self.config.baseUrl + '/OpenPallet',
                            type: 'POST',
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            data: {
                                palletNo: palletId.trim(),
                                openEmpId: self.config.defaultEmpId
                            },
                            beforeSend: function(xhr) {
                                console.log('AJAX beforeSend - Content-Type: application/x-www-form-urlencoded');
                                console.log('AJAX beforeSend - Data:', { palletNo: palletId.trim(), openEmpId: self.config.defaultEmpId });
                                console.log('AJAX beforeSend - URL:', self.config.baseUrl + '/OpenPallet');
                            },
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    self.loadPallets();
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                console.error('Error opening pallet:', error);
                                console.error('Status:', status);
                                console.error('Response Text:', xhr.responseText);
                                console.error('Status Code:', xhr.status);
                                console.error('Response Headers:', xhr.getAllResponseHeaders());
                                
                                // ตรวจสอบประเภทของ error
                                var errorMessage = 'เกิดข้อผิดพลาดในการเปิดพาเลท';
                                if (xhr.status === 400) {
                                    errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                                } else if (xhr.status === 500) {
                                    errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                                } else if (xhr.status === 0) {
                                    errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                                } else if (xhr.responseText) {
                                    try {
                                        var errorResponse = JSON.parse(xhr.responseText);
                                        if (errorResponse.message) {
                                            errorMessage = errorResponse.message;
                                        }
                                    } catch (e) {
                                        errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                                    }
                                }
                                
                                self.showError(errorMessage);
                            }
                        });
                    }
                });
            },

