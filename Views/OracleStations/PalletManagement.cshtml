                    cartons.forEach(function(carton) {
                        detailHtml += 
                        '<tr>' +
                            '<td><code>' + carton.CartonId + '</code></td>' +
                            '<td>' + carton.WorkOrder + '</td>' +
                            '<td>' + (carton.CloseFlag === 'Y' ? '<span class="badge bg-success"><i class="fas fa-lock me-1"></i>ปิดแล้ว</span>' : '<span class="badge bg-warning"><i class="fas fa-unlock me-1"></i>เปิดอยู่</span>') + '</td>' +
                            '<td><span class="badge bg-info"><i class="fas fa-barcode me-1"></i>' + carton.SerialCount + '</span></td>' +
                            '<td>' + new Date(carton.CreateTime).toLocaleDateString('th-TH') + '</td>' +
                            '<td>' +
                                (carton.CloseFlag === 'N' ?
                                '<button class="btn btn-warning btn-sm btn-close-carton" data-carton="' + carton.CartonId + '" title="ปิดกล่อง">' +
                                        '<i class="fas fa-lock"></i> ปิด' +
                                    '</button>' :
                                '<button class="btn btn-success btn-sm btn-open-carton" data-carton="' + carton.CartonId + '" title="เปิดกล่อง">' +
                                        '<i class="fas fa-unlock"></i> เปิด' +
                                    '</button>'
                            ) +
                                '<button class="btn btn-danger btn-sm btn-delete-carton" data-carton="' + carton.CartonId + '" title="ลบกล่อง">' +
                                    '<i class="fas fa-trash"></i> ลบ' +
                                '</button>' +
                            '</td>' +
                        '</tr>';
                    });

                    detailHtml += 
                                    '</tbody>' +
                                '</table>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
                }

                $('#palletDetailContent').html(detailHtml);
                $('#palletDetailModal').modal('show');
            },

            // ค้นหาพาเลท
            searchPallet: function() {
                var searchTerm = $('#palletSearch').val();
                if (searchTerm) {
                    var table = $('#palletTable').DataTable();
                    table.search(searchTerm).draw();
                    this.showSuccess('ค้นหา: "' + searchTerm + '"');
                } else {
                    this.showWarning('กรุณากรอกคำค้นหา');
                }
            },

            // ล้างการค้นหา
            clearSearch: function() {
                $('#palletSearch').val('');
                var table = $('#palletTable').DataTable();
                table.search('').draw();
                this.showSuccess('ล้างการค้นหาเรียบร้อย');
            },

            // สร้างพาเลทใหม่
            createPallet: function() {
                var self = this;
                var palletId = $('#newPalletId').val();
                var workOrder = $('#workOrder').val();
                var partId = $('#partId').val();
                var terminalId = $('#terminalSelect').val();
                var qcFlag = $('#qcFlag').val();
                var mixFlag = $('#mixFlag').val();
                
                // ตรวจสอบข้อมูลที่จำเป็น
                if (!palletId || palletId.trim() === '') {
                    this.showWarning('กรุณาระบุหมายเลขพาเลท');
                    return;
                }
                
                if (!workOrder || workOrder.trim() === '') {
                    this.showWarning('กรุณาระบุ Work Order');
                    return;
                }
                
                if (!partId || isNaN(parseInt(partId)) || parseInt(partId) <= 0) {
                    this.showWarning('กรุณาระบุ Part ID ที่ถูกต้อง');
                    return;
                }
                
                if (!terminalId || isNaN(parseInt(terminalId)) || parseInt(terminalId) <= 0) {
                    this.showWarning('กรุณาระบุ Terminal ที่ถูกต้อง');
                    return;
                }

                var data = {
                    palletNo: palletId.trim(),
                    workOrder: workOrder.trim(),
                    partId: parseInt(partId),
                    terminalId: parseInt(terminalId),
                    createEmpId: this.config.defaultEmpId,
                    qcFlag: qcFlag,
                    mixFlag: mixFlag
                };

                Swal.fire({
                    title: 'ยืนยันการสร้าง',
                    text: 'คุณต้องการสร้างพาเลท ' + palletId + ' หรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'สร้าง',
                    cancelButtonText: 'ยกเลิก'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // แสดง loading
                        self.showLoading('กำลังสร้างพาเลท...');

                        $.ajax({
                            url: self.config.baseUrl + '/CreatePallet',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(data),
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    // ล้างฟอร์ม
                                    self.clearCreateForm();
                                    // โหลดข้อมูลใหม่
                                    self.loadPallets();
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                console.error('Error creating pallet:', error);
                                self.showError('เกิดข้อผิดพลาดในการสร้างพาเลท');
                            }
                        });
                    }
                });
            },

            // ล้างฟอร์มสร้างพาเลท
            clearCreateForm: function() {
                $('#newPalletId').val('');
                $('#workOrder').val('');
                $('#partId').val('');
                $('#factorySelect').val('');
                $('#stageSelect').val('');
                $('#processSelect').val('');
                $('#pdlineSelect').val('');
                $('#terminalSelect').val('');
                $('#routeSelect').val('');
                $('#qcFlag').val('Y');
                $('#mixFlag').val('N');
            },
 
            // ลบพาเลท
            deletePallet: function(palletId) {
                var self = this;
                
                // ตรวจสอบ palletId
                if (!palletId || palletId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขพาเลท');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการลบ',
                    text: 'คุณต้องการลบพาเลท ' + palletId + ' หรือไม่?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ลบ',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#dc3545'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        var data = {
                            palletNo: palletId.trim()
                        };

                        // แสดง loading
                        self.showLoading('กำลังลบพาเลท...');

                        $.ajax({
                            url: self.config.baseUrl + '/DeletePallet',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(data),
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    self.loadPallets();
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                console.error('Error deleting pallet:', error);
                                self.showError('เกิดข้อผิดพลาดในการลบพาเลท');
                            }
                        });
                    }
                });
            },

            // ลบกล่อง
            deleteCarton: function(cartonId) {
                var self = this;
                var palletId = $('#palletDetailModal').data('pallet-id');
                
                // ตรวจสอบ cartonId
                if (!cartonId || cartonId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขกล่อง');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการลบ',
                    text: 'คุณต้องการลบกล่อง ' + cartonId + ' หรือไม่?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ลบ',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#dc3545'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        var data = {
                            cartonNo: cartonId.trim()
                        };

                        // แสดง loading
                        self.showLoading('กำลังลบกล่อง...');

                        $.ajax({
                            url: self.config.baseUrl + '/DeleteCarton',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(data),
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    // รีเฟรช modal
                                    $('#palletDetailModal').modal('hide');
                                    // เปิด modal ใหม่เพื่อแสดงข้อมูลที่อัปเดต
                                    setTimeout(function() {
                                        $('[data-pallet="' + palletId + '"]').click();
                                    }, 500);
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                console.error('Error deleting carton:', error);
                                self.showError('เกิดข้อผิดพลาดในการลบกล่อง');
                            }
                        });
                    }
                });
            },

            // Cascading dropdown functions
            onFactoryChange: function() {
                var self = this;
                var factoryId = $('#factorySelect').val();
                
                // ล้างและโหลด stages ที่เกี่ยวข้อง
                this.clearDropdown('#stageSelect');
                this.clearDropdown('#processSelect');
                this.clearDropdown('#pdlineSelect');
                this.clearDropdown('#terminalSelect');
                this.clearDropdown('#routeSelect');

                if (factoryId) {
                    // โหลด stages ของ factory นี้
                    $.get(this.config.baseUrl + '/GetStages', { factoryId: factoryId })
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#stageSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading stages:', error);
                        });

                    // โหลด pdlines ของ factory นี้
                    $.get(this.config.baseUrl + '/GetPdlines', { factoryId: factoryId })
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#pdlineSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading pdlines:', error);
                        });

                    // โหลด routes ของ factory นี้
                    $.get(this.config.baseUrl + '/GetRoutes', { factoryId: factoryId })
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#routeSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading routes:', error);
                        });
                }
            },

            onStageChange: function() {
                var self = this;
                var stageId = $('#stageSelect').val();
                var factoryId = $('#factorySelect').val();
                
                // ล้างและโหลด processes ที่เกี่ยวข้อง
                this.clearDropdown('#processSelect');
                this.clearDropdown('#terminalSelect');

                if (stageId) {
                    // โหลด processes ของ stage นี้
                    $.get(this.config.baseUrl + '/GetProcesses', { stageId: stageId })
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#processSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading processes:', error);
                        });

                    // โหลด terminals ของ stage นี้
                    $.get(this.config.baseUrl + '/GetTerminals', { stageId: stageId })
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#terminalSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading terminals:', error);
                        });

                    // โหลด pdlines ของ factory (ไม่ filter ด้วย stage)
                    if (factoryId) {
                        $.get(this.config.baseUrl + '/GetPdlines', { factoryId: factoryId })
                            .done(function(data) {
                                self.clearAndPopulateDropdown('#pdlineSelect', data);
                            })
                            .fail(function(error) {
                                console.error('Error loading pdlines:', error);
                        });
                    }
                }
            },

            onProcessChange: function() {
                var self = this;
                var processId = $('#processSelect').val();
                var stageId = $('#stageSelect').val();
                var pdlineId = $('#pdlineSelect').val();
                
                // ล้างและโหลด terminals ที่เกี่ยวข้อง
                this.clearDropdown('#terminalSelect');

                if (processId) {
                    // โหลด terminals ของ process นี้
                    var params = { processId: processId };
                    
                    if (stageId) params.stageId = stageId;
                    if (pdlineId) params.pdlineId = pdlineId;

                    $.get(this.config.baseUrl + '/GetTerminals', params)
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#terminalSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading terminals:', error);
                        });
                }
            },

            onPdlineChange: function() {
                var self = this;
                var pdlineId = $('#pdlineSelect').val();
                var processId = $('#processSelect').val();
                var stageId = $('#stageSelect').val();
                
                // ล้างและโหลด terminals ที่เกี่ยวข้อง
                this.clearDropdown('#terminalSelect');

                if (pdlineId) {
                    // โหลด terminals ของ pdline นี้
                    var params = { pdlineId: pdlineId };
                    
                    if (processId) params.processId = processId;
                    if (stageId) params.stageId = stageId;

                    $.get(this.config.baseUrl + '/GetTerminals', params)
                        .done(function(data) {
                            self.clearAndPopulateDropdown('#terminalSelect', data);
                        })
                        .fail(function(error) {
                            console.error('Error loading terminals:', error);
                        });
                }
            },

            // ล้าง dropdown
            clearDropdown: function(selector) {
                var $select = $(selector);
                var defaultOption = $select.find('option').first();
                $select.empty().append(defaultOption);
                
                // ล้าง badge จำนวนตัวเลือก
                this.updateDropdownCount(selector, 0);
            },

            // ล้าง dropdown และเลือกอัตโนมัติถ้ามีตัวเลือกเดียว
            clearAndPopulateDropdown: function(selector, data) {
                this.clearDropdown(selector);
                this.populateDropdown(selector, data);
            },

            // Clean up pallet detail modal
            cleanupPalletDetailModal: function() {
                // เคลียร์ข้อมูล
                $('#palletDetailContent').empty();
                $('#palletDetailModal').removeData('pallet-id');
            },

            // แสดงข้อความแจ้งเตือน
            showSuccess: function(message) {
                Swal.fire({
                    title: 'สำเร็จ',
                    text: message,
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
            },

            showError: function(message) {
                Swal.fire({
                    title: 'ข้อผิดพลาด',
                    text: message,
                    icon: 'error',
                    confirmButtonText: 'ตกลง'
                });
            },

            showWarning: function(message) {
                Swal.fire({
                    title: 'คำเตือน',
                    text: message,
                    icon: 'warning',
                    confirmButtonText: 'ตกลง'
                });
            },

            showLoading: function(message) {
                Swal.fire({
                    title: message,
                    allowOutsideClick: false,
                    didOpen: function() {
                        Swal.showLoading();
                    }
                });
            },

            // ฟังก์ชันสำหรับตรวจสอบข้อมูลในฐานข้อมูล
            checkData: function(tableName, columnName, value) {
                var self = this;
                console.log(`Checking data: ${tableName}.${columnName} = '${value}'`);
                
                $.get(this.config.baseUrl + '/CheckData', { 
                    tableName: tableName, 
                    columnName: columnName, 
                    value: value 
                })
                .done(function(response) {
                    console.log('CheckData response:', response);
                    if (response.success) {
                        self.showSuccess(response.message);
                    } else {
                        self.showError(response.message);
                    }
                })
                .fail(function(error) {
                    console.error('Error checking data:', error);
                    self.showError('เกิดข้อผิดพลาดในการตรวจสอบข้อมูล');
                });
            },

            // ฟังก์ชันสำหรับทดสอบ API
            testApi: function(value) {
                var self = this;
                var testData = {
                    cartonNo: value,
                    openEmpId: this.config.defaultEmpId
                };
                
                console.log('Testing API with data:', testData);
                console.log('Test data JSON:', JSON.stringify(testData));
                
                $.ajax({
                    url: this.config.baseUrl + '/TestOpenCarton',
                    type: 'POST',
                    contentType: 'application/json',
                    dataType: 'json',
                    data: JSON.stringify(testData),
                    success: function(response) {
                        console.log('Test API response:', response);
                        self.showSuccess('ทดสอบ API สำเร็จ - ดูรายละเอียดใน Console');
                    },
                    error: function(xhr, status, error) {
                        console.error('Test API error:', error);
                        console.error('Status:', status);
                        console.error('Response Text:', xhr.responseText);
                        self.showError('ทดสอบ API ล้มเหลว: ' + error);
                    }
                });
            },

            // ฟังก์ชันสำหรับทดสอบ Model Binding
            testModelBinding: function(value) {
                var self = this;
                var testData = {
                    cartonNo: value,
                    openEmpId: this.config.defaultEmpId
                };
                
                console.log('Testing Model Binding with data:', testData);
                console.log('Test data JSON:', JSON.stringify(testData));
                
                $.ajax({
                    url: this.config.baseUrl + '/TestModelBinding',
                    type: 'POST',
                    contentType: 'application/json',
                    dataType: 'json',
                    data: JSON.stringify(testData),
                    success: function(response) {
                        console.log('Test Model Binding response:', response);
                        self.showSuccess('ทดสอบ Model Binding สำเร็จ - ดูรายละเอียดใน Console');
                    },
                    error: function(xhr, status, error) {
                        console.error('Test Model Binding error:', error);
                        console.error('Status:', status);
                        console.error('Response Text:', xhr.responseText);
                        self.showError('ทดสอบ Model Binding ล้มเหลว: ' + error);
                    }
                });
            }
        };

        // เริ่มต้นแอพพลิเคชันเมื่อหน้าโหลดเสร็จ
        $(document).ready(function() {
            PalletManagementApp.init();
        });
    </script>
}