                if (highlightCartonId) {
                    var $rows = $('#palletDetailContent table tbody tr');
                    var $target = null;
                    $rows.each(function(){
                        var idText = $(this).find('td:first code').text().trim();
                        if (idText === highlightCartonId) {
                            $target = $(this);
                            return false;
                        }
                    });
                    if ($target && $target.length) {
                        $target.addClass('table-warning');
                        // เลื่อนเข้าเห็น
                        var container = $('#palletDetailModal .modal-body');
                        container.animate({ scrollTop: $target.offset().top - container.offset().top + container.scrollTop() - 40 }, 400);
                        // เอาไฮไลต์ออกภายหลัง
                        setTimeout(function(){
                            $target.removeClass('table-warning');
