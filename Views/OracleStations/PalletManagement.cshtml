@{
    ViewData["Title"] = "จัดการกล่องพาเลท - Pallet Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-boxes me-2"></i>
                            จัดการกล่องพาเลท (Pallet Management)
                        </h4>
                        <div>
                            <a href="@Url.Action("Station", "OracleStations")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i>
                                ย้อนกลับ
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-search me-2"></i>
                                        ค้นหากล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="palletSearch" class="form-label">
                                            <i class="fas fa-barcode me-1"></i>
                                            Pallet ID หรือ Serial Number
                                        </label>
                                        <input type="text" class="form-control" id="palletSearch" 
                                               placeholder="กรอก Pallet ID หรือ Serial Number">
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <button type="button" class="btn btn-info" id="searchPallet">
                                            <i class="fas fa-search me-1"></i>
                                            ค้นหา
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="clearSearch">
                                            <i class="fas fa-times me-1"></i>
                                            ล้าง
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-plus me-2"></i>
                                        สร้างพาเลทใหม่
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="newPalletId" class="form-label">
                                                <i class="fas fa-tag me-1"></i>
                                                Pallet ID *
                                            </label>
                                            <input type="text" class="form-control" id="newPalletId" 
                                                   placeholder="กรอก Pallet ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="workOrder" class="form-label">
                                                <i class="fas fa-file-alt me-1"></i>
                                                Work Order *
                                            </label>
                                            <input type="text" class="form-control" id="workOrder" 
                                                   placeholder="กรอก Work Order" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="partId" class="form-label">
                                                <i class="fas fa-microchip me-1"></i>
                                                Part ID *
                                            </label>
                                            <input type="number" class="form-control" id="partId" 
                                                   placeholder="กรอก Part ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="terminalId" class="form-label">
                                                <i class="fas fa-desktop me-1"></i>
                                                Terminal ID *
                                            </label>
                                            <input type="number" class="form-control" id="terminalId" 
                                                   placeholder="กรอก Terminal ID" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="qcFlag" class="form-label">
                                                <i class="fas fa-check-circle me-1"></i>
                                                QC Flag
                                            </label>
                                            <select class="form-select" id="qcFlag">
                                                <option value="Y">ต้องตรวจสอบ QC</option>
                                                <option value="N">ไม่ต้องตรวจสอบ QC</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="mixFlag" class="form-label">
                                                <i class="fas fa-random me-1"></i>
                                                Mix Flag
                                            </label>
                                            <select class="form-select" id="mixFlag">
                                                <option value="N">ไม่ผสม Work Order</option>
                                                <option value="Y">ผสม Work Order</option>
                                            </select>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-success" id="createPallet">
                                        <i class="fas fa-plus me-1"></i>
                                        สร้างพาเลท
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filterMonth" class="form-label">เลือกเดือน</label>
                            <input type="month" class="form-control" id="filterMonth" value="@DateTime.Now.ToString("yyyy-MM")">
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-list me-2"></i>
                                        รายการกล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="palletTable" class="table table-striped table-hover" style="width:100%">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>ลำดับ</th>
                                                    <th>Pallet ID</th>
                                                    <th>Work Order</th>
                                                    <th>Part ID</th>
                                                    <th>สถานะ</th>
                                                    <th>Terminal</th>
                                                    <th>จำนวน Serial</th>
                                                    <th>วันที่สร้าง</th>
                                                    <th>การดำเนินการ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- ข้อมูลจะถูกเติมด้วย JavaScript -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal สำหรับแสดงรายละเอียด -->
<div class="modal fade" id="palletDetailModal" tabindex="-1" aria-labelledby="palletDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="palletDetailModalLabel">
                    <i class="fas fa-info-circle me-2"></i>
                    รายละเอียดกล่องพาเลท
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="palletDetailContent">
                <!-- เนื้อหาจะถูกเติมด้วย JavaScript -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" id="editPallet">
                    <i class="fas fa-edit me-1"></i>
                    แก้ไข
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/pallet-management.js"></script>
    
    <script>
        $(document).ready(function () {
            PalletManagementApp.init();
        });
    </script>
} 