            // เปิดพาเลท
            openPallet: function(palletId) {
                var self = this;
                
                // ตรวจสอบ palletId
                if (!palletId || palletId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขพาเลท');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการเปิดพาเลท',
                    text: 'คุณต้องการเปิดพาเลท ' + palletId + ' หรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'เปิดพาเลท',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#198754'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // ตรวจสอบข้อมูลก่อนส่ง
                        console.log('PalletId original:', palletId);
                        console.log('PalletId trimmed:', palletId.trim());
                        console.log('DefaultEmpId:', self.config.defaultEmpId);
                        
                        // ตรวจสอบว่าข้อมูลถูกต้องหรือไม่
                        if (!palletId || palletId.trim() === '') {
                            self.showError('ข้อมูล palletNo ไม่ถูกต้อง');
                            return;
                        }

                        // แสดง loading
                        self.showLoading('กำลังเปิดพาเลท...');

                        $.ajax({
                            url: self.config.baseUrl + '/OpenPallet',
                            type: 'POST',
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            data: {
                                palletNo: palletId.trim(),
                                openEmpId: self.config.defaultEmpId
                            },
                            beforeSend: function(xhr) {
                                console.log('AJAX beforeSend - Content-Type: application/x-www-form-urlencoded');
                                console.log('AJAX beforeSend - Data:', { palletNo: palletId.trim(), openEmpId: self.config.defaultEmpId });
                                console.log('AJAX beforeSend - URL:', self.config.baseUrl + '/OpenPallet');
                            },
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    self.loadPallets();
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                
                                // ตรวจสอบประเภทของ error
                                var errorMessage = 'เกิดข้อผิดพลาดในการเปิดพาเลท';
                                if (xhr.status === 400) {
                                    errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                                } else if (xhr.status === 500) {
                                    errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                                } else if (xhr.status === 0) {
                                    errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                                } else if (xhr.responseText) {
                                    try {
                                        var errorResponse = JSON.parse(xhr.responseText);
                                        if (errorResponse.message) {
                                            errorMessage = errorResponse.message;
                                        }
                                    } catch (e) {
                                        errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                                    }
                                }
                                
                                self.showError(errorMessage);
                            }
                        });
                    }
                });
            },

            // ปิดพาเลท
            closePallet: function(palletId) {
                var self = this;
                
                // ตรวจสอบ palletId
                if (!palletId || palletId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขพาเลท');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการปิดพาเลท',
                    text: 'คุณต้องการปิดพาเลท ' + palletId + ' หรือไม่?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'ปิดพาเลท',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#ffc107'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        var data = {
                            palletNo: palletId.trim(),
                            closeEmpId: self.config.defaultEmpId,
                            fullFlag: 'Y'
                        };

                        // แสดง loading
                        self.showLoading('กำลังปิดพาเลท...');

                        $.ajax({
                            url: self.config.baseUrl + '/ClosePallet',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(data),
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    self.loadPallets();
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                self.showError('เกิดข้อผิดพลาดในการปิดพาเลท');
                            }
                        });
                    }
                });
            },

            // เปิดกล่อง
            openCarton: function(cartonId) {
                var self = this;
                var palletId = $('#palletDetailModal').data('pallet-id');

                // ตรวจสอบ cartonId
                if (!cartonId || cartonId.trim() === '') {
                    self.showError('กรุณาระบุหมายเลขกล่อง');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการเปิดกล่อง',
                    text: 'คุณต้องการเปิดกล่อง ' + cartonId + ' หรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'เปิดกล่อง',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#198754'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // ตรวจสอบข้อมูลก่อนส่ง
                        console.log('CartonId original:', cartonId);
                        console.log('CartonId trimmed:', cartonId.trim());
                        console.log('DefaultEmpId:', self.config.defaultEmpId);
                        
                        // ตรวจสอบว่าข้อมูลถูกต้องหรือไม่
                        if (!cartonId || cartonId.trim() === '') {
                            self.showError('ข้อมูล cartonNo ไม่ถูกต้อง');
                            return;
                        }

                        // แสดง loading
                        self.showLoading('กำลังเปิดกล่อง...');

                        $.ajax({
                            url: self.config.baseUrl + '/OpenCarton',
                            type: 'POST',
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            data: {
                                cartonNo: cartonId.trim(),
                                openEmpId: self.config.defaultEmpId
                            },
                            beforeSend: function(xhr) {
                                console.log('AJAX beforeSend - Content-Type: application/x-www-form-urlencoded');
                                console.log('AJAX beforeSend - Data:', { cartonNo: cartonId.trim(), openEmpId: self.config.defaultEmpId });
                                console.log('AJAX beforeSend - URL:', self.config.baseUrl + '/OpenCarton');
                            },
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    self.showSuccess(response.message);
                                    // รีเฟรช modal
                                    $('#palletDetailModal').modal('hide');
                                    // เปิด modal ใหม่เพื่อแสดงข้อมูลที่อัปเดต
                                    setTimeout(function() {
                                        $('[data-pallet="' + palletId + '"]').click();
                                    }, 500);
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                
                                // ตรวจสอบประเภทของ error
                                var errorMessage = 'เกิดข้อผิดพลาดในการเปิดกล่อง';
                                if (xhr.status === 400) {
                                    errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                                } else if (xhr.status === 500) {
                                    errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                                } else if (xhr.status === 0) {
                                    errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                                } else if (xhr.responseText) {
                                    try {
                                        var errorResponse = JSON.parse(xhr.responseText);
                                        if (errorResponse.message) {
                                            errorMessage = errorResponse.message;
                                        }
                                    } catch (e) {
                                        errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                                    }
                                }
                                
                                self.showError(errorMessage);
                            }
                        });
                    }
                });
            },

