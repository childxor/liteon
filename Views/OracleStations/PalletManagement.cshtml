            // แสดงข้อมูลกล่องปลายทาง
            showTargetCartonInfo: function(carton) {
                console.log('showTargetCartonInfo - carton data:', carton);
                console.log('showTargetCartonInfo - carton type:', typeof carton);
                console.log('showTargetCartonInfo - carton keys:', Object.keys(carton));
                
                // ตรวจสอบว่าข้อมูลครบถ้วนหรือไม่
                if (!carton) {
                    return;
                }

                // แสดงข้อมูลในฟิลด์ต่างๆ (ใช้ชื่อฟิลด์ที่ถูกต้องจาก API)
                var cartonId = carton.CARTONID || carton.CartonId || 'ไม่ระบุ';
                var workOrder = carton.WORKORDER || carton.WorkOrder || 'ไม่ระบุ';
                var partId = carton.PARTID || carton.PartId || 'ไม่ระบุ';
                
                console.log('showTargetCartonInfo - cartonId:', cartonId);
                console.log('showTargetCartonInfo - workOrder:', workOrder);
                console.log('showTargetCartonInfo - partId:', partId);
                
                $('#targetCartonId').text(cartonId);
                $('#targetWorkOrder').text(workOrder);
                $('#targetPartId').text(partId);
                
                // แสดงสถานะ
                var statusHtml = '';
                var closeFlag = carton.CLOSEFLAG || carton.CloseFlag;
                console.log('showTargetCartonInfo - closeFlag:', closeFlag);
                
                if (closeFlag === 'Y') {
                    statusHtml = '<span class="badge bg-success"><i class="fas fa-lock me-1"></i>ปิดแล้ว</span>';
                } else if (closeFlag === 'N') {
                    statusHtml = '<span class="badge bg-warning"><i class="fas fa-unlock me-1"></i>เปิดอยู่</span>';
                } else {
                    statusHtml = '<span class="badge bg-secondary">ไม่ระบุ</span>';
                }
                $('#targetStatus').html(statusHtml);
                
                // แสดงข้อมูลเพิ่มเติม
                var additionalInfo = '';
                var serialCount = carton.SERIALCOUNT || carton.SerialCount;
                var palletId = carton.PALLETID || carton.PalletId;
                
                console.log('showTargetCartonInfo - serialCount:', serialCount);
                console.log('showTargetCartonInfo - palletId:', palletId);
                
                if (serialCount !== undefined && serialCount !== null) {
                    additionalInfo += '<div class="row mt-2"><div class="col-12"><small><strong>จำนวน Serial:</strong> <span class="badge bg-info">' + serialCount + '</span></small></div></div>';
                }
                if (palletId) {
                    additionalInfo += '<div class="row mt-1"><div class="col-12"><small><strong>Pallet ID:</strong> <code>' + palletId + '</code></small></div></div>';
                }
                
                // เพิ่มข้อมูลเพิ่มเติมในส่วนข้อมูล
                if (additionalInfo) {
                    $('#targetCartonInfo .alert').append(additionalInfo);
                }
                
                // แสดงส่วนข้อมูล
                $('#targetCartonInfo').show();
                $('#confirmMoveCarton').prop('disabled', false);
                
                // เก็บข้อมูลกล่องปลายทาง
                $('#moveCartonModal').data('target-carton', carton);
                
                console.log('showTargetCartonInfo - completed successfully');
            },

