            // ย้าย Serial Numbers
            moveCarton: function() {
                var self = this;
                var sourceCartonId = $('#moveCartonModal').data('source-carton');
                var sourcePalletId = $('#palletDetailModal').data('pallet-id');
                var targetCarton = $('#moveCartonModal').data('target-carton');
                
                console.log('moveCarton - sourceCartonId:', sourceCartonId);
                console.log('moveCarton - sourcePalletId:', sourcePalletId);
                console.log('moveCarton - targetCarton:', targetCarton);
                
                if (!sourceCartonId || !targetCarton) {
                    self.showError('ข้อมูลไม่ครบถ้วน');
                    return;
                }

                // ใช้ชื่อฟิลด์ที่ถูกต้องจาก API response
                var targetCartonId = targetCarton.CARTONID || targetCarton.CartonId;
                
                // ตรวจสอบว่าไม่ย้ายไปยังกล่องเดียวกัน
                if (sourceCartonId === targetCartonId) {
                    self.showError('ไม่สามารถย้าย Serial Numbers ไปยังกล่องเดียวกันได้');
                    return;
                }

                Swal.fire({
                    title: 'ยืนยันการย้าย Serial Numbers',
                    text: 'คุณต้องการย้าย Serial Numbers จากกล่อง ' + sourceCartonId + ' ไปยังกล่อง ' + targetCartonId + ' หรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'ย้าย Serial Numbers',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#0dcaf0'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // แปลง MoveEmpId เป็น decimal ตามที่ DTO ต้องการ
                        var moveEmpId = 1; // ใช้ค่า default เป็น 1 แทน string
                        
                        var data = {
                            sourceCartonNo: sourceCartonId,
                            targetCartonNo: targetCartonId,
                            moveEmpId: moveEmpId
                        };

                        console.log('moveCarton - sending data:', data);
                        console.log('moveCarton - data JSON:', JSON.stringify(data));

                        // แสดง loading
                        self.showLoading('กำลังย้าย Serial Numbers...');

                        $.ajax({
                            url: self.config.baseUrl + '/MoveSerialNumbers',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(data),
                            beforeSend: function(xhr) {
                                console.log('AJAX beforeSend - Content-Type: application/json');
                                console.log('AJAX beforeSend - Data:', data);
                                console.log('AJAX beforeSend - URL:', self.config.baseUrl + '/MoveSerialNumbers');
                            },
                            success: function(response) {
                                Swal.close();
                                console.log('moveCarton - response:', response);
                                
                                if (response.success) {
                                    // เก็บข้อมูลกล่องต้นทางเพื่อใช้ในการลบ
                                    var sourceCartonId = $('#moveCartonModal').data('source-carton');
                                    
                                    // ถามว่าจะลบกล่องเก่าหรือไม่
                                    Swal.fire({
                                        title: 'ย้าย Serial Numbers สำเร็จ',
                                        html: response.message + 
                                               '<br><br><strong>คุณต้องการลบกล่องต้นทางหรือไม่?</strong>' +
                                               '<br><small>กล่องต้นทาง: <code>' + sourceCartonId + '</code></small>' +
                                               '<br><small>หมายเหตุ: กล่องต้นทางจะถูกลบออกจากตาราง g_pack_carton</small>' +
                                               '<br><br><small class="text-muted">⚠️ กรุณาตอบคำถามนี้ก่อนดำเนินการต่อ</small>',
                                        icon: 'success',
                                        showCancelButton: true,
                                        confirmButtonText: 'ลบกล่องต้นทาง',
                                        cancelButtonText: 'ไม่ลบ',
                                        confirmButtonColor: '#dc3545',
                                        cancelButtonColor: '#6c757d',
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    }).then(function(result) {
                                        if (result.isConfirmed) {
                                            // ลบกล่องเก่า
                                            self.deleteSourceCarton(sourceCartonId, sourcePalletId);
                                        } else {
                                            // แสดงข้อความสำเร็จและรีเฟรชข้อมูล
                                            self.showSuccess(response.message);
                                            // ปิด modal ย้าย Serial Numbers
                                            $('#moveCartonModal').modal('hide');
                                            // รีเฟรช modal รายละเอียด
                                            $('#palletDetailModal').modal('hide');
                                            // เปิด modal ใหม่เพื่อแสดงข้อมูลที่อัปเดต
                                            setTimeout(function() {
                                                $('[data-pallet="' + sourcePalletId + '"]').click();
                                            }, 1000); // เพิ่มเวลารอเป็น 1 วินาที
                                        }
                                    });
                                } else {
                                    self.showError(response.message);
                                }
                            },
                            error: function(xhr, status, error) {
                                Swal.close();
                                
                                // ตรวจสอบประเภทของ error
                                var errorMessage = 'เกิดข้อผิดพลาดในการย้าย Serial Numbers';
                                if (xhr.status === 400) {
                                    errorMessage = 'ข้อมูลที่ส่งไม่ถูกต้อง (Bad Request)';
                                } else if (xhr.status === 500) {
                                    errorMessage = 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (Server Error)';
                                } else if (xhr.status === 0) {
                                    errorMessage = 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้';
                                } else if (xhr.responseText) {
                                    try {
                                        var errorResponse = JSON.parse(xhr.responseText);
                                        if (errorResponse.message) {
                                            errorMessage = errorResponse.message;
                                        }
                                    } catch (e) {
                                        errorMessage = 'เกิดข้อผิดพลาด: ' + error;
                                    }
                                }
                                
                                self.showError(errorMessage);
                            }
                        });
                    }
                });
            },

