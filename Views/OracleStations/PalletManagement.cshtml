                    var q = ($('#cartonsFilter').val() || '').toLowerCase();
                    var status = $('#cartonsStatusFilter').val();
                    $('#cartonsTable tbody tr').each(function(){
                        var text = $(this).text().toLowerCase();
                        var closeFlag = $(this).data('close-flag');
                        var passText = text.indexOf(q) !== -1;
                        var passStatus = (status === 'all') || (status === 'open' && closeFlag === 'N') || (status === 'closed' && closeFlag === 'Y');
                        $(this).toggle(passText && passStatus);
                    });
                }
                $('#cartonsFilter').on('keyup', filterCartonRows);
                $('#cartonsStatusFilter').on('change', filterCartonRows);
            },

            // ค้นหาพาเลท
            searchPallet: function() {
                var self = this;
                var searchTerm = $('#palletSearch').val();
                if (!searchTerm || searchTerm.trim() === '') {
                    this.showWarning('กรุณากรอกคำค้นหา');
                    return;
                }

                var keyword = searchTerm.trim();

                // 1) ลองค้นหาแบบ client-side ในตารางก่อน (เร็ว)
                var table = $('#palletTable').DataTable();
                if ($.fn.dataTable.isDataTable('#palletTable')) {
                    table.search(keyword).draw();
                }

                // 2) เรียกใช้ SearchPallet เพื่อดูว่าพบ pallet โดยตรงหรือไม่
                $.get(this.config.baseUrl + '/SearchPallet', { searchTerm: keyword })
                    .done(function(resp) {
                        if (resp && resp.success && resp.pallet) {
                            // ถ้าพบ Pallet โดยตรง เปิดรายละเอียดเลย
                            self.viewPalletDetails(resp.pallet.PalletId || resp.pallet.PALLETID || keyword);
                            self.showSuccess('พบ Pallet: ' + (resp.pallet.PalletId || resp.pallet.PALLETID));
                        } else {
                            // 3) ถ้าไม่พบ pallet ให้ลองค้นหา Carton
                            $.get(self.config.baseUrl + '/SearchCarton', { searchTerm: keyword })
                                .done(function(cResp){
                                    if (cResp && cResp.success && cResp.carton) {
                                        var carton = cResp.carton;
                                        var palletId = carton.PALLETID || carton.PalletId;
                                        var cartonId = carton.CARTONID || carton.CartonId || keyword;

                                        if (palletId) {
                                            // บันทึกสถานะเพื่อไฮไลต์กล่องใน modal รายละเอียด
                                            self.uiState.highlightCartonId = cartonId;
                                            // เปิดรายละเอียดพาเลทที่กล่องนี้สังกัด
                                            self.viewPalletDetails(palletId);
                                            self.showSuccess('พบ Carton: ' + cartonId + ' ใน Pallet: ' + palletId);
                                        } else {
                                            self.showWarning('พบ Carton: ' + cartonId + ' แต่ไม่พบ Pallet ที่สังกัด');
                                        }
                                    } else {
                                        self.showError(cResp && cResp.message ? cResp.message : 'ไม่พบ Pallet/Carton ที่ค้นหา');
                                    }
                                })
                                .fail(function(){
                                    self.showError('เกิดข้อผิดพลาดในการค้นหา Carton');
                                });
                        }
                    })
                    .fail(function(){
                        self.showError('เกิดข้อผิดพลาดในการค้นหา Pallet');
                    });
            },

            // ล้างการค้นหา
            clearSearch: function() {
                $('#palletSearch').val('');
                var table = $('#palletTable').DataTable();
                table.search('').draw();
