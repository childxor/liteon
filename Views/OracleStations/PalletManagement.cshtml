@{
    ViewData["Title"] = "จัดการกล่องพาเลท - Pallet Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-boxes me-2"></i>
                            จัดการกล่องพาเลท (Pallet Management)
                        </h4>
                        <div>
                            <a href="@Url.Action("Station", "OracleStations")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i>
                                ย้อนกลับ
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-search me-2"></i>
                                        ค้นหากล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="palletSearch" class="form-label">
                                            <i class="fas fa-barcode me-1"></i>
                                            Pallet ID หรือ Serial Number
                                        </label>
                                        <input type="text" class="form-control" id="palletSearch"
                                            placeholder="กรอก Pallet ID หรือ Serial Number">
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <button type="button" class="btn btn-info" id="searchPallet">
                                            <i class="fas fa-search me-1"></i>
                                            ค้นหา
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="clearSearch">
                                            <i class="fas fa-times me-1"></i>
                                            ล้าง
                                        </button>
                                        <button type="button" class="btn btn-warning" id="debugData">
                                            <i class="fas fa-bug me-1"></i>
                                            Debug
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-plus me-2"></i>
                                        สร้างพาเลทใหม่
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="newPalletId" class="form-label">
                                                <i class="fas fa-tag me-1"></i>
                                                Pallet ID *
                                            </label>
                                            <input type="text" class="form-control" id="newPalletId"
                                                placeholder="กรอก Pallet ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="workOrder" class="form-label">
                                                <i class="fas fa-file-alt me-1"></i>
                                                Work Order *
                                            </label>
                                            <input type="text" class="form-control" id="workOrder"
                                                placeholder="กรอก Work Order" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="partId" class="form-label">
                                                <i class="fas fa-microchip me-1"></i>
                                                Part ID *
                                            </label>
                                            <input type="number" class="form-control" id="partId"
                                                placeholder="กรอก Part ID" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="factorySelect" class="form-label">
                                                <i class="fas fa-building me-1"></i>
                                                โรงงาน (Factory)
                                            </label>
                                            <select class="form-select" id="factorySelect">
                                                <option value="">-- เลือกโรงงาน --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="stageSelect" class="form-label">
                                                <i class="fas fa-layer-group me-1"></i>
                                                ขั้นตอน (Stage)
                                            </label>
                                            <select class="form-select" id="stageSelect">
                                                <option value="">-- เลือกขั้นตอน --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="processSelect" class="form-label">
                                                <i class="fas fa-play me-1"></i>
                                                กระบวนการ (Process)
                                            </label>
                                            <select class="form-select" id="processSelect">
                                                <option value="">-- เลือกกระบวนการ --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="pdlineSelect" class="form-label">
                                                <i class="fas fa-industry me-1"></i>
                                                สายการผลิต (PDLine)
                                            </label>
                                            <select class="form-select" id="pdlineSelect">
                                                <option value="">-- เลือกสายการผลิต --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="terminalSelect" class="form-label">
                                                <i class="fas fa-desktop me-1"></i>
                                                สถานี (Terminal) *
                                            </label>
                                            <select class="form-select" id="terminalSelect" required>
                                                <option value="">-- เลือกสถานี --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="routeSelect" class="form-label">
                                                <i class="fas fa-route me-1"></i>
                                                เส้นทาง (Route)
                                            </label>
                                            <select class="form-select" id="routeSelect">
                                                <option value="">-- เลือกเส้นทาง --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="qcFlag" class="form-label">
                                                <i class="fas fa-check-circle me-1"></i>
                                                QC Flag
                                            </label>
                                            <select class="form-select" id="qcFlag">
                                                <option value="Y">ต้องตรวจสอบ QC</option>
                                                <option value="N">ไม่ต้องตรวจสอบ QC</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="mixFlag" class="form-label">
                                                <i class="fas fa-random me-1"></i>
                                                Mix Flag
                                            </label>
                                            <select class="form-select" id="mixFlag">
                                                <option value="N">ไม่ผสม Work Order</option>
                                                <option value="Y">ผสม Work Order</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3 d-flex align-items-end">
                                            <button type="button" class="btn btn-success w-100" id="createPallet">
                                                <i class="fas fa-plus me-1"></i>
                                                สร้างพาเลท
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filterMonth" class="form-label">เลือกเดือน</label>
                            <input type="month" class="form-control" id="filterMonth"
                                value="@DateTime.Now.ToString("yyyy-MM")">
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-list me-2"></i>
                                        รายการกล่องพาเลท
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="palletTable" class="table table-striped table-hover"
                                            style="width:100%">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>ลำดับ</th>
                                                    <th>Pallet ID</th>
                                                    <th>Work Order</th>
                                                    <th>Part ID</th>
                                                    <th>สถานะ</th>
                                                    <th>Terminal</th>
                                                    <th>จำนวน Serial</th>
                                                    <th>วันที่สร้าง</th>
                                                    <th>การดำเนินการ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- ข้อมูลจะถูกเติมด้วย JavaScript -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal สำหรับแสดงรายละเอียด -->
<div class="modal fade" id="palletDetailModal" tabindex="-1" aria-labelledby="palletDetailModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="palletDetailModalLabel">
                    <i class="fas fa-info-circle me-2"></i>
                    รายละเอียดกล่องพาเลท
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="palletDetailContent">
                <!-- เนื้อหาจะถูกเติมด้วย JavaScript -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" id="editPallet">
                    <i class="fas fa-edit me-1"></i>
                    แก้ไข
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <!-- DataTables CSS ถูกโหลดใน Layout แล้ว -->

    <style>
        /* Toast notification styles */
        .toast-container {
            z-index: 9999;
        }

        .toast {
            min-width: 300px;
        }

        .toast .toast-body {
            font-size: 0.9rem;
        }

        /* Auto-select animation */
        .form-select:focus {
            border-color: #0dcaf0;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25);
        }

        .form-select.auto-selected {
            border-color: #0dcaf0;
            background-color: #f8f9fa;
        }

        /* Card hover effects */
        .card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        /* Button hover effects */
        .btn {
            transition: all 0.2s ease-in-out;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        /* Table improvements */
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .table td {
            vertical-align: middle;
        }

        /* Badge improvements */
        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }

        /* Modal improvements */
        .modal-xl {
            max-width: 95%;
        }

        .modal-body {
            max-height: 70vh;
            overflow-y: auto;
        }
    </style>

    <!-- DataTables JS -->
    <!-- DataTables JS และ SweetAlert2 ถูกโหลดใน Layout แล้ว -->
    <script>
        var appBasePath = '@Url.Content("~/")';
        
        // Pallet Management Application
        var PalletManagementApp = {
            // กำหนดค่าเริ่มต้น
            config: {
                baseUrl: typeof appBasePath !== 'undefined' ? appBasePath + 'OracleStations' : '/OracleStations',
                serialDelimiters: ['\n', '\r\n', ',', ';'],
                maxSerialNumbers: 1000,
                defaultEmpId: 'ADMIN' // กำหนดค่าเริ่มต้นสำหรับ Employee ID
            },

            // เริ่มต้นแอพ
            init: function() {
                console.log('PalletManagementApp initialized');
                this.bindEvents();
                this.loadDropdownData();
                this.loadPallets();
            },

            // ผูกเหตุการณ์ต่างๆ 
            bindEvents: function() {
                var self = this; // เก็บ reference ของ this
                
                // โหลดใหม่เมื่อเปลี่ยนเดือน 
                $('#filterMonth').on('change', function() { 
                    self.loadPallets();
                });

                // ปุ่มค้นหา
                $('#searchPallet').click(function() {
                    self.searchPallet(); 
                });

                // ปุ่มล้างการค้นหา
                $('#clearSearch').click(function() {
                    self.clearSearch();
                });

                // ปุ่มสร้างพาเลท
                $('#createPallet').click(function() {
                    self.createPallet();
                });

                // ปุ่ม Debug
                $('#debugData').click(function() {
                    var searchTerm = $('#palletSearch').val();
                    if (searchTerm) {
                        // ตรวจสอบในตาราง g_pack_pallet
                        self.checkData('g_pack_pallet', 'PALLET_NO', searchTerm);
                        // ตรวจสอบในตาราง g_pack_carton
                        self.checkData('g_pack_carton', 'CARTON_NO', searchTerm);
                        // ตรวจสอบในตาราง g_sn_status
                        self.checkData('g_sn_status', 'SERIAL_NUMBER', searchTerm);
                        
                        // ทดสอบ API
                        self.testApi(searchTerm);
                        
                        // ทดสอบ Model Binding
                        self.testModelBinding(searchTerm);
                    } else {
                        self.showWarning('กรุณากรอกข้อมูลที่ต้องการตรวจสอบ');
                    }
                });

                // Event handlers สำหรับตาราง
                $('#palletTable').on('click', '.btn-view', function(e) {
                    var palletId = $(this).data('pallet');
                    self.viewPalletDetails(palletId);
                });

                $('#palletTable').on('click', '.btn-close', function(e) {
                    var palletId = $(this).data('pallet');
                    self.closePallet(palletId);
                });

                $('#palletTable').on('click', '.btn-open', function(e) {
                    var palletId = $(this).data('pallet');
                    self.openPallet(palletId);
                });

                $('#palletTable').on('click', '.btn-delete', function(e) {
                    var palletId = $(this).data('pallet');
                    self.deletePallet(palletId);
                });

                // Event handlers สำหรับกล่องใน modal
                $('#palletDetailContent').on('click', '.btn-close-carton', function(e) {
                    var cartonId = $(this).data('carton');
                    self.closeCarton(cartonId);
                });

                $('#palletDetailContent').on('click', '.btn-open-carton', function(e) {
                    var cartonId = $(this).data('carton');
                    self.openCarton(cartonId);
                });

                $('#palletDetailContent').on('click', '.btn-delete-carton', function(e) {
                    var cartonId = $(this).data('carton');
                    self.deleteCarton(cartonId);
                });

                // Cascading dropdown events สำหรับฟอร์มสร้างพาเลท
                $('#factorySelect').change(function() {
                    self.onFactoryChange();
                });

                $('#stageSelect').change(function() {
                    self.onStageChange();
                });

                $('#processSelect').change(function() {
                    self.onProcessChange();
                });

                $('#pdlineSelect').change(function() {
                    self.onPdlineChange();
                });

                // Modal events
                $('#palletDetailModal').on('hidden.bs.modal', function() {
                    self.cleanupPalletDetailModal();
                });
            },

            // โหลดข้อมูลสำหรับ dropdown
            loadDropdownData: function() {
                var self = this;
                
                // โหลด factories
                $.get(this.config.baseUrl + '/GetFactories')
                    .done(function(data) {
                        self.populateDropdown('#factorySelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading factories:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลโรงงานได้');
                    });

                // โหลด stages (ทั้งหมด)
                $.get(this.config.baseUrl + '/GetStages')
                    .done(function(data) {
                        self.populateDropdown('#stageSelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading stages:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลขั้นตอนได้');
                    });

                // โหลด processes (ทั้งหมด)
                $.get(this.config.baseUrl + '/GetProcesses')
                    .done(function(data) {
                        self.populateDropdown('#processSelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading processes:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลกระบวนการได้');
                    });

                // โหลด pdlines (ทั้งหมด)
                $.get(this.config.baseUrl + '/GetPdlines')
                    .done(function(data) {
                        self.populateDropdown('#pdlineSelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading pdlines:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลสายการผลิตได้');
                    });

                // โหลด terminals (ทั้งหมด)
                $.get(this.config.baseUrl + '/GetTerminals')
                    .done(function(data) {
                        self.populateDropdown('#terminalSelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading terminals:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลสถานีได้');
                    });

                // โหลด routes (ทั้งหมด)
                $.get(this.config.baseUrl + '/GetRoutes')
                    .done(function(data) {
                        self.populateDropdown('#routeSelect', data);
                    })
                    .fail(function(error) {
                        console.error('Error loading routes:', error);
                        self.showError('ไม่สามารถโหลดข้อมูลเส้นทางได้');
                    });
            },

            // เติมข้อมูลใน dropdown
            populateDropdown: function(selector, data) {
                var self = this;
                var $select = $(selector);
                var defaultOption = $select.find('option').first();
                
                $select.empty().append(defaultOption);

                if (data && data.length > 0) {
                    data.forEach(function(item) {
                        var option = $('<option>')
                            .val(item.Id)
                            .text(item.Name + (item.Description ? ' - ' + item.Description : ''));
                        $select.append(option);
                    });

                    // แสดงจำนวนตัวเลือก
                    this.updateDropdownCount(selector, data.length);
                    
                    // ถ้ามีตัวเลือกเพียงตัวเดียว ให้เลือกตัวเลือกนั้นทันที
                    if (data.length === 1) {
                        $select.val(data[0].Id);
                        
                        // เพิ่ม visual feedback
                        $select.addClass('auto-selected');
                        setTimeout(function() {
                            $select.removeClass('auto-selected');
                        }, 2000);
                        
                        // Trigger change event เพื่อให้ cascading dropdown ทำงาน
                        $select.trigger('change');
                        
                        // แสดงข้อความแจ้งเตือน
                        var optionText = data[0].Name + (data[0].Description ? ' - ' + data[0].Description : '');
                        self.showAutoSelectMessage(selector, optionText);
                    }
                }
            },

            // แสดงข้อความแจ้งเตือนเมื่อเลือกอัตโนมัติ
            showAutoSelectMessage: function(selector, optionText) {
                var self = this;
                var fieldName = this.getFieldName(selector);
                
                // สร้าง toast notification
                var toastHtml = 
                    '<div class="toast align-items-center text-white bg-info border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                        '<div class="d-flex">' +
                            '<div class="toast-body">' +
                                '<i class="fas fa-magic me-2"></i>' +
                                '<strong>' + fieldName + '</strong> เลือกอัตโนมัติ: <strong>' + optionText + '</strong>' +
                            '</div>' +
                            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>' +
                        '</div>' +
                    '</div>';

                // เพิ่ม toast container ถ้ายังไม่มี
                if ($('#toastContainer').length === 0) {
                    $('body').append('<div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>');
                }

                // เพิ่ม toast และแสดง
                $('#toastContainer').append(toastHtml);
                var toastElement = $('#toastContainer .toast').last();
                var toast = new bootstrap.Toast(toastElement);
                toast.show();

                // ลบ toast หลังจาก 3 วินาที
                setTimeout(function() {
                    toastElement.remove();
                }, 3000);
            },

            // รับชื่อฟิลด์จาก selector
            getFieldName: function(selector) {
                var fieldNames = {
                    '#factorySelect': 'โรงงาน',
                    '#stageSelect': 'ขั้นตอน', 
                    '#processSelect': 'กระบวนการ',
                    '#pdlineSelect': 'สายการผลิต',
                    '#terminalSelect': 'สถานี',
                    '#routeSelect': 'เส้นทาง'
                };
                return fieldNames[selector] || 'ฟิลด์';
            },

            // อัพเดทจำนวนตัวเลือกใน dropdown
            updateDropdownCount: function(selector, count) {
                var $select = $(selector);
                var $label = $select.closest('.mb-3').find('.form-label');
                
                // ลบ badge เดิม
                $label.find('.badge').remove();
                
                // เพิ่ม badge ใหม่
                var badgeClass = count === 0 ? 'bg-secondary' : count === 1 ? 'bg-success' : 'bg-primary';
                var badgeText = count === 0 ? 'ไม่มีตัวเลือก' : count === 1 ? '1 ตัวเลือก' : count + ' ตัวเลือก';
                
                $label.append(' <span class="badge ' + badgeClass + ' ms-2">' + badgeText + '</span>');
            },

            // โหลดข้อมูลพาเลท
            loadPallets: function() {
                var self = this;
                var yyyymm = $('#filterMonth').val();
                
                // แสดง loading
                this.showLoading('กำลังโหลดข้อมูลพาเลท...');
                
                $.get(this.config.baseUrl + '/GetPallets', { yyyymm: yyyymm }) 
                    .done(function(data) {
                        Swal.close();
                        if (data && data.length > 0) {
                            self.updatePalletTable(data);
                            self.showSuccess('โหลดข้อมูลพาเลทสำเร็จ: ' + data.length + ' รายการ');
