@{
    ViewData["Title"] = "Set Process - กำหนดกระบวนการ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-cogs me-2"></i>
                        กำหนดกระบวนการ (Set Process)
                    </h4>
                </div>
                <div class="card-body">
                    <form id="setProcessForm">
                        <div class="row">
                            <!-- Serial Numbers Input -->
                            <div class="col-md-6">
                                <div class="card border-info">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0">
                                            <i class="fas fa-barcode me-2"></i>
                                            Serial Numbers
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="serialInput" class="form-label">
                                                ป้อน Serial Number (หลายรายการ)
                                            </label>
                                            <textarea 
                                                class="form-control" 
                                                id="serialInput" 
                                                rows="8" 
                                                placeholder="กรอก Serial Number แต่ละรายการในบรรทัดใหม่&#10;หรือคั่นด้วย , (comma)&#10;&#10;ตัวอย่าง:&#10;T0042540060141JV10250326M20234000360A000&#10;T0042540060141JV10250326M20234000360A001&#10;T0042540060141JV10250326M20234000360A002"
                                                required></textarea>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="fas fa-info-circle me-1"></i>
                                                รองรับการป้อนหลายรายการ
                                            </small>
                                            <div>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSerials">
                                                    <i class="fas fa-times me-1"></i>
                                                    ล้าง
                                                </button>
                                                <button type="button" class="btn btn-outline-info btn-sm" id="validateSerials">
                                                    <i class="fas fa-check me-1"></i>
                                                    ตรวจสอบ
                                                </button>
                                            </div>
                                        </div>
                                        <div id="serialCount" class="mt-2">
                                            <span class="badge bg-light text-dark">
                                                <i class="fas fa-list-ol me-1"></i>
                                                จำนวน: <span id="countNumber">0</span> รายการ
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Process Settings -->
                            <div class="col-md-6">
                                <div class="card border-success">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">
                                            <i class="fas fa-cogs me-2"></i>
                                            การตั้งค่า Process
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="factorySelect" class="form-label">
                                                    <i class="fas fa-building me-1"></i>
                                                    โรงงาน (Factory)
                                                </label>
                                                <select class="form-select" id="factorySelect">
                                                    <option value="">-- เลือกโรงงาน --</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="stageSelect" class="form-label">
                                                    <i class="fas fa-layer-group me-1"></i>
                                                    ขั้นตอน (Stage)
                                                </label>
                                                <select class="form-select" id="stageSelect">
                                                    <option value="">-- เลือกขั้นตอน --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="processSelect" class="form-label">
                                                    <i class="fas fa-play me-1"></i>
                                                    กระบวนการ (Process) *
                                                </label>
                                                <select class="form-select" id="processSelect" required>
                                                    <option value="">-- เลือกกระบวนการ --</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="pdlineSelect" class="form-label">
                                                    <i class="fas fa-industry me-1"></i>
                                                    สายการผลิต (PDLine)
                                                </label>
                                                <select class="form-select" id="pdlineSelect">
                                                    <option value="">-- เลือกสายการผลิต --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="terminalSelect" class="form-label">
                                                    <i class="fas fa-desktop me-1"></i>
                                                    สถานี (Terminal)
                                                </label>
                                                <select class="form-select" id="terminalSelect">
                                                    <option value="">-- เลือกสถานี --</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="routeSelect" class="form-label">
                                                    <i class="fas fa-route me-1"></i>
                                                    เส้นทาง (Route)
                                                </label>
                                                <select class="form-select" id="routeSelect">
                                                    <option value="">-- เลือกเส้นทาง --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="remarksInput" class="form-label">
                                                <i class="fas fa-sticky-note me-1"></i>
                                                หมายเหตุ
                                            </label>
                                            <textarea class="form-control" id="remarksInput" rows="2" placeholder="ใส่หมายเหตุ (ไม่บังคับ)"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                                        <i class="fas fa-arrow-left me-1"></i>
                                        ย้อนกลับ
                                    </button>
                                    <div>
                                        <button type="button" class="btn btn-warning me-2" id="previewBtn">
                                            <i class="fas fa-eye me-1"></i>
                                            ตรวจสอบก่อนบันทึก
                                        </button>
                                        <button type="submit" class="btn btn-success" id="submitBtn">
                                            <i class="fas fa-save me-1"></i>
                                            บันทึก
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Modal -->
    <div class="modal fade" id="resultsModal" tabindex="-1" aria-labelledby="resultsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="resultsModalLabel">
                        <i class="fas fa-chart-bar me-2"></i>
                        ผลการดำเนินการ
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="resultsContent"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Validate Serial Numbers Modal -->
    <div class="modal fade" id="validateModal" tabindex="-1" aria-labelledby="validateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl" style="max-width: 80% !important;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="validateModalLabel">
                        <i class="fas fa-search me-2"></i>
                        ตรวจสอบ Serial Numbers - สถานะปัจจุบัน
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="validateContent">
                        <div class="table-responsive">
                            <table id="validateTable" class="table table-striped table-hover" style="width:100%">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ลำดับ</th>
                                        <th>Serial Number</th>
                                        <th>Work Order</th>
                                        <th>Part ID</th>
                                        <th>สถานะปัจจุบัน</th>
                                        <th>Work Flag</th>
                                        <th>กระบวนการ</th>
                                        <th>สถานี</th>
                                        <th>ขั้นตอน</th>
                                        <th>สายการผลิต</th>
                                        <th>เข้าระบบ</th>
                                        <th>ออกระบบ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    <button type="button" class="btn btn-success" id="proceedAfterValidate">
                        <i class="fas fa-arrow-right me-1"></i>
                        ดำเนินการต่อ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="previewModalLabel">
                        <i class="fas fa-eye me-2"></i>
                        ตรวจสอบข้อมูลก่อนบันทึก
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="previewContent"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-success" id="confirmSubmit">
                        <i class="fas fa-check me-1"></i>
                        ยืนยันบันทึก
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
    
    <style>
        /* Toast notification styles */
        .toast-container {
            z-index: 9999;
        }
        
        .toast {
            min-width: 300px;
        }
        
        .toast .toast-body {
            font-size: 0.9rem;
        }
        
        /* Auto-select animation */
        .form-select:focus {
            border-color: #0dcaf0;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25);
        }
        
        .form-select.auto-selected {
            border-color: #0dcaf0;
            background-color: #f8f9fa;
        }
    </style>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/setprocess.js"></script>
    
    <script>
        $(document).ready(function () {
            SetProcessApp.init();
        });
    </script>
} 