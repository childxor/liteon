@{
    ViewData["Title"] = "Oracle Stations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-database me-2"></i>
                            Oracle Stations Management
                        </h4>
                        <div>
                            <a href="@Url.Action("SetProcess", "OracleStations")" class="btn btn-success">
                                <i class="fas fa-cogs me-2"></i>
                                Set Process
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <i class="fas fa-cogs fa-3x text-info mb-3"></i>
                                    <h5>Set Process</h5>
                                    <p class="text-muted">กำหนดกระบวนการให้กับ Serial Numbers</p>
                                    <a href="@Url.Action("SetProcess", "OracleStations")" class="btn btn-info">
                                        <i class="fas fa-arrow-right me-1"></i>
                                        เข้าสู่ระบบ
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-secondary">
                                <div class="card-body text-center">
                                    <i class="fas fa-desktop fa-3x text-secondary mb-3"></i>
                                    <h5>Station Management</h5>
                                    <p class="text-muted">จัดการสถานีและเทอร์มินัล</p>
                                    <button class="btn btn-secondary" disabled>
                                        <i class="fas fa-construction me-1"></i>
                                        กำลังพัฒนา
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <i class="fas fa-chart-bar fa-3x text-warning mb-3"></i>
                                    <h5>Reports</h5>
                                    <p class="text-muted">รายงานและสถิติ</p>
                                    <button class="btn btn-warning" disabled>
                                        <i class="fas fa-construction me-1"></i>
                                        กำลังพัฒนา
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-md-4">
                            <div class="card border-primary">
                                <div class="card-body text-center">
                                    <i class="fas fa-boxes fa-3x text-primary mb-3"></i>
                                    <h5>จัดการกล่องพาเลท</h5>
                                    <p class="text-muted">จัดการและติดตามกล่องพาเลท</p>
                                    <a href="@Url.Action("PalletManagement", "OracleStations")" class="btn btn-primary">
                                        <i class="fas fa-arrow-right me-1"></i>
                                        เข้าสู่ระบบ
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <i class="fas fa-truck fa-3x text-success mb-3"></i>
                                    <h5>จัดการการขนส่ง</h5>
                                    <p class="text-muted">ติดตามและจัดการการขนส่งสินค้า</p>
                                    <button class="btn btn-success" disabled>
                                        <i class="fas fa-construction me-1"></i>
                                        กำลังพัฒนา
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-danger">
                                <div class="card-body text-center">
                                    <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                                    <h5>จัดการข้อผิดพลาด</h5>
                                    <p class="text-muted">ตรวจสอบและแก้ไขข้อผิดพลาดในระบบ</p>
                                    <button class="btn btn-danger" disabled>
                                        <i class="fas fa-construction me-1"></i>
                                        กำลังพัฒนา
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> 
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables และ extensions ถูกโหลดใน Layout แล้ว -->
    
    <script src="~/js/oracle-stations.js"></script>
    
    <script>
        var appBasePath = '@Url.Content("~/")';
        $(document).ready(function () {
            // ไม่มี app ที่ต้อง init ในหน้านี้
        });
    </script>
} 