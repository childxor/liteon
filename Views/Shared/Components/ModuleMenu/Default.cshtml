@model IEnumerable<dynamic>

<div class="nav flex-column">
    @foreach (var module in Model)
    {
        @if (module.Children != null && module.Children.Count > 0)
        {
            <div class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center" 
                   data-bs-toggle="collapse" 
                   href="#module@(module.Id)" 
                   role="button" 
                   aria-expanded="false">
                    <span>
                        <i class="@module.Icon me-2"></i>
                        @module.Name
                    </span>
                </a>
                <div class="collapse submenu" id="module@(module.Id)">
                    <div class="nav flex-column">
                        @foreach (var child in module.Children)
                        {
                            <a class="nav-link py-2" asp-controller="@child.Controller" asp-action="@child.Action">
                                <i class="@child.Icon me-2"></i>
                                @child.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <a class="nav-link" asp-controller="@module.Controller" asp-action="@module.Action">
                <i class="@module.Icon me-2"></i>
                @module.Name
            </a>
        }
    }
</div>
